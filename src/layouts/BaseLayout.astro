---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
  /** article = analyses / dossiers (JSON-LD + og:type) */
  type?: 'website' | 'article';
  noindex?: boolean;
  /** false = masquer la barre ; true = forcer. Défaut : articles / débats (hors hubs). */
  share?: boolean;
}

import { getPublicSocialLinks } from '../config/social';
import { getPublicEcosystemLinks } from '../config/ecosystem';
import {
  pageMeta,
  organizationJsonLd,
  websiteJsonLd,
  webPageJsonLd,
} from '../lib/seo';
import CitizenCommentModule from '../components/CitizenCommentModule.astro';
import EditorialCoverImage from '../components/EditorialCoverImage.astro';
import ShareBar from '../components/ShareBar.astro';
import { DOE_FR } from '../lib/doe';
import { findEditorialByPath } from '../lib/editorial';
import { shouldShowArticleShareBar } from '../lib/share';
import GoogleSeoTools from '../components/GoogleSeoTools.astro';
import GoogleSeoBody from '../components/GoogleSeoBody.astro';
import CloudflareWebAnalytics from '../components/CloudflareWebAnalytics.astro';

const { title, description, ogImage, keywords, type, noindex, share } = Astro.props;
const editorialPost = findEditorialByPath(Astro.url.pathname);
const resolvedOgImage = ogImage || editorialPost?.cover?.src;
const socialLinks = getPublicSocialLinks();
const ecosystemLinks = getPublicEcosystemLinks();
const xLink = socialLinks.find((l) => l.id === 'x');
const siteUrl = Astro.site?.href ?? 'https://lmdpt.iarbre.org';
const isArticle =
  type === 'article' ||
  Astro.url.pathname.startsWith('/analyses/') ||
  Astro.url.pathname.startsWith('/debats/');
const meta = pageMeta({
  title,
  description,
  ogImage: resolvedOgImage,
  siteUrl,
  pathname: Astro.url.pathname,
  keywords,
  type: isArticle ? 'article' : 'website',
  noindex:
    noindex ||
    Astro.url.pathname.startsWith('/moderation'),
});
const jsonLdOrg = organizationJsonLd(siteUrl);
const jsonLdSite = websiteJsonLd(siteUrl);
const jsonLdPage = webPageJsonLd({
  siteUrl,
  title: meta.fullTitle,
  description: meta.description,
  canonical: meta.canonical,
  ogImage: meta.ogImage,
  type: meta.type,
});
const showComments =
  !Astro.url.pathname.startsWith('/moderation') &&
  !Astro.url.pathname.startsWith('/contribuer') &&
  !Astro.url.pathname.startsWith('/mentions-legales') &&
  !Astro.url.pathname.startsWith('/confidentialite') &&
  !Astro.url.pathname.startsWith('/charte') &&
  !Astro.url.pathname.startsWith('/soutenir') &&
  !Astro.url.pathname.startsWith('/pack-data') &&
  !Astro.url.pathname.startsWith('/connexion') &&
  !Astro.url.pathname.startsWith('/compte');
const commentThread =
  Astro.url.pathname.replace(/\/+$/, '') || 'accueil';
const showShareBar =
  share === true ||
  (share !== false &&
    shouldShowArticleShareBar(Astro.url.pathname, Boolean(editorialPost)));
const shareTitle = editorialPost?.title ?? title;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/og-default.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Empêche le « Auto Dark » Chrome/Android d’inverser la page en fond noir + texte noir -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4ede4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12141a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.fullTitle}</title>
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="robots" content={meta.robots} />
    <meta name="googlebot" content={meta.robots} />
    <meta name="author" content="Le Média du Premier Tour" />
    <meta name="language" content="French" />
    <link rel="canonical" href={meta.canonical} />
    <link rel="alternate" hreflang="fr" href={meta.canonical} />
    <link rel="alternate" hreflang="x-default" href={meta.canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-images.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-news.xml" title="Google News" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <GoogleSeoTools />
    <meta property="og:type" content={meta.type === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.fullTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:image:alt" content={meta.fullTitle} />
    <meta property="og:locale" content="fr_FR" />
    {xLink && <meta name="twitter:site" content={xLink.handle} />}
    {xLink && <meta name="twitter:creator" content={xLink.handle} />}
    {xLink && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="twitter:title" content={meta.fullTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrg)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPage)} />
    <style is:global>
      /*
        CONTRASTE COUPLÉ fond + texte (2026-07-27 renforcé)
        - Clair : encre quasi pure sur papier clair (WCAG AAA corps)
        - Sombre : encre claire sur fond très sombre
        - Hero / croquis : rendu N&B (filter + assets /nb/)
        Jamais noir-sur-noir ni blanc-sur-blanc.
      */
      :root {
        color-scheme: light dark;
        --bg: #f7f4ef;
        --fg: #000000;
        --muted: #1c1c1c;
        --accent: #061825;
        --accent-soft: #e8eef3;
        --border: #4a453c;
        --card: #ffffff;
        --on-accent: #ffffff;
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.1), 0 4px 16px rgba(0, 0, 0, 0.1);
        --radius: 8px;
        --radius-lg: 12px;
        --table-head-bg: #f0ebe3;
        --table-stripe: #faf8f5;
        --ink: #000000;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0d11;
          --fg: #faf8f5;
          --muted: #e4e0d8;
          --accent: #a8d4f0;
          --accent-soft: #1a2430;
          --border: #8a929c;
          --card: #141820;
          --on-accent: #0a0c10;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.45), 0 4px 16px rgba(0, 0, 0, 0.5);
          --table-head-bg: #1c222c;
          --table-stripe: #12161e;
          --ink: #faf8f5;
        }
      }
      @media (hover: none), (max-width: 900px) {
        body {
          -webkit-font-smoothing: auto;
          text-rendering: optimizeLegibility;
        }
        p, li, .tagline, .meta, .eyebrow, .news-summary {
          font-weight: 500;
        }
      }
      * { box-sizing: border-box; }
      html {
        background: var(--bg);
        color: var(--fg);
        overflow-x: clip;
        scroll-behavior: smooth;
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      body {
        margin: 0;
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.72;
        font-size: 17px;
        background: var(--bg) !important;
        color: var(--fg) !important;
        -webkit-font-smoothing: auto;
        -moz-osx-font-smoothing: auto;
        overflow-x: clip;
        min-height: 100dvh;
      }
      img, video, svg, canvas, iframe {
        max-width: 100%;
        height: auto;
      }
      /* Hero + croquis / galerie : noir & blanc + contraste encre */
      .hero-visual img,
      .hero-visual video,
      .hero-img,
      .hero-video,
      .visual-gallery img,
      .gallery-grid img,
      .daily-gallery img,
      figure.visual img,
      .croquis img {
        filter: grayscale(1) contrast(1.12);
      }
      a {
        color: var(--accent);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.12em;
        transition: color 0.15s ease;
      }
      a:hover { color: color-mix(in srgb, var(--accent) 55%, var(--fg)); }
      a:focus-visible {
        outline: 3px solid var(--fg);
        outline-offset: 2px;
      }
      /* Conteneur principal : largeur lecture + dual panels, edge-to-edge mobile */
      .wrap {
        --wrap-pad-x: 1.35rem;
        max-width: min(68rem, 100%);
        width: 100%;
        margin: 0.85rem auto;
        padding: 1.75rem var(--wrap-pad-x) 4rem;
        background: var(--card) !important;
        color: var(--fg) !important;
        border-radius: 12px;
        box-shadow: var(--shadow);
      }
      main,
      main p,
      main li,
      main h1,
      main h2,
      main h3,
      main h4,
      .card,
      .lead,
      .hero-title,
      .hero-lead,
      .home-brand,
      .home-title,
      .home-lead,
      .card-title,
      .news-summary,
      .page-intro p,
      header h1,
      .highlight-card,
      .highlight-card p,
      .highlight-card h3 {
        color: var(--fg) !important;
      }
      .tagline,
      .meta,
      .eyebrow,
      header nav a,
      footer,
      footer p,
      .news-disclaimer,
      .sync-meta,
      .news-source,
      .card-desc {
        color: var(--muted) !important;
      }
      .card,
      .hero-card,
      .hero-badge,
      .news-card,
      .news-featured {
        background: var(--card) !important;
        color: var(--fg) !important;
        border-color: var(--border) !important;
      }
      /* Hémicycle (fond sombre local) */
      .hemicycle-wrapper text {
        fill: #f1f1f1 !important;
        stroke: #111 !important;
      }
      header {
        margin-bottom: 1.75rem;
        padding: 1rem 0 1.1rem;
        border-bottom: 1px solid var(--border);
      }

      /* Global responsive improvements */
      @media (max-width: 900px) {
        .wrap {
          --wrap-pad-x: 1.1rem;
          max-width: 100%;
          margin: 0.5rem auto;
          border-radius: 10px;
        }
      }
      @media (max-width: 640px) {
        .wrap {
          --wrap-pad-x: 0.95rem;
          margin: 0;
          border-radius: 0;
          box-shadow: none;
          padding: 1rem var(--wrap-pad-x) 3rem;
          min-height: 100dvh;
        }
        header {
          margin-bottom: 1.1rem;
          padding-bottom: 0.85rem;
        }
        header h1 {
          font-size: 1.12rem;
          line-height: 1.25;
        }
        .tagline {
          font-size: 0.88rem;
        }
      }
      @media (max-width: 420px) {
        body {
          font-size: 15.5px;
        }
        .wrap {
          --wrap-pad-x: 0.85rem;
          padding: 0.85rem var(--wrap-pad-x) 2.5rem;
        }
      }
      .site-brand {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
      }
      .site-mark {
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--radius);
        background: linear-gradient(145deg, var(--accent), color-mix(in srgb, var(--accent) 65%, #000));
        color: var(--on-accent); /* never inherit dark --card in dark mode */
        font-family: system-ui, sans-serif;
        font-size: 0.82rem; /* improved min size for broad readability */
        font-weight: 800;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        box-shadow: var(--shadow);
      }
      header h1 {
        font-size: 1.28rem;
        margin: 0 0 0.2rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .tagline {
        font-size: 0.92rem;
        color: var(--muted);
        margin: 0;
        line-height: 1.4;
      }
      header nav {
        font-family: system-ui, sans-serif;
        font-size: 0.88rem;
        display: flex;
        gap: 0.35rem 0.5rem;
        flex-wrap: wrap;
        align-items: center;
      }
      header nav a {
        text-decoration: none;
        color: var(--muted);
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        border: 1px solid transparent;
        white-space: nowrap;
      }
      header nav a:hover {
        color: var(--accent);
        background: var(--accent-soft);
        border-color: color-mix(in srgb, var(--accent) 20%, transparent);
      }
      .eyebrow {
        font-family: system-ui, sans-serif;
        font-size: 0.82rem; /* improved min size for broad readability */
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin: 0 0 0.45rem;
        font-weight: 600;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.1rem 1.2rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover {
        border-color: color-mix(in srgb, var(--accent) 25%, var(--border));
      }
      .btn {
        display: inline-block;
        font-family: system-ui, sans-serif;
        font-size: 0.95rem;
        padding: 0.6rem 1.05rem;
        border-radius: 6px;
        background: var(--accent) !important;
        color: var(--on-accent) !important;
        text-decoration: none;
        font-weight: 700;
        border: 2px solid var(--accent) !important;
        transition: opacity 0.15s ease, transform 0.1s ease;
      }
      .btn:hover {
        opacity: 0.94;
        color: var(--on-accent) !important;
      }
      .btn-secondary {
        background: var(--card) !important;
        color: var(--accent) !important;
        border: 2px solid var(--accent) !important;
        font-weight: 700;
      }
      .btn-secondary:hover {
        background: var(--accent-soft) !important;
        color: var(--accent) !important;
      }
      .meta {
        font-family: system-ui, sans-serif;
        font-size: 0.88rem; /* improved for broadest readership and low vision */
        color: var(--muted);
      }
      main h2, main h3 {
        letter-spacing: -0.015em;
      }
      .page-intro {
        margin-bottom: 1.75rem;
      }
      .page-intro h2 {
        margin: 0 0 0.65rem;
        font-size: 1.45rem;
      }
      .page-intro p {
        margin: 0;
        max-width: 40rem;
      }
      .section-title {
        font-size: 1.15rem;
        margin: 0 0 1rem;
        padding-left: 0.75rem;
        border-left: 3px solid var(--accent);
      }
      .card-grid {
        display: grid;
        gap: 0.85rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      @media (min-width: 640px) {
        .card-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .card-grid .card {
        margin-bottom: 0;
        height: 100%;
      }
      .card-grid h3 {
        margin: 0 0 0.4rem;
        font-size: 1.02rem;
        line-height: 1.35;
      }
      .card-grid h3 a {
        color: inherit;
        text-decoration: none;
      }
      .card-grid h3 a:hover {
        color: var(--accent);
      }
      .status-badge {
        display: inline-block;
        margin-left: 0.35rem;
        font-family: system-ui, sans-serif;
        font-size: 0.78rem; /* accessibility */
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1rem 0.4rem;
        vertical-align: middle;
      }
      .status-badge--open {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
        background: var(--accent-soft);
      }
      ul.resources {
        padding-left: 1.2rem;
        margin: 0.5rem 0 0;
      }
      footer {
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--muted);
        font-family: system-ui, sans-serif;
      }
      footer .ecosystem { font-size: 0.85rem; margin-top: 0.45rem; }

      /* === WCAG Accessibility & Keyboard === */
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        background: var(--accent);
        color: var(--card);
        padding: 0.5rem 1rem;
        z-index: 1000;
        font-family: system-ui, sans-serif;
        font-size: 0.9rem;
        transition: top 0.1s ease;
      }
      .skip-link:focus {
        top: 0.5rem;
        left: 0.5rem;
        outline: 3px solid #fff;
        outline-offset: 2px;
      }

      /* Visible focus for keyboard navigation (WCAG) — P8-8 standard site-wide */
      a:focus-visible,
      button:focus-visible,
      select:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      summary:focus-visible,
      [tabindex]:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }
      .btn:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
      }

      /* Tableaux longs + régions focusables (atlas, programmes, circo) */
      .table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 8px;
      }
      .table-wrap:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
      table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--card);
      }

      /* Sélecteurs / filtres — cibles tactiles 44px (P8-8) */
      .filters,
      .atlas-selectors,
      .preset-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }
      .filters button,
      .filters select,
      .atlas-selectors button,
      .preset-buttons button {
        min-height: 44px;
      }
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* Current page indicator */
      nav a[aria-current="page"] {
        color: var(--accent);
        font-weight: 600;
        background: var(--accent-soft);
        border-color: color-mix(in srgb, var(--accent) 30%, var(--border));
      }

      /* === Advanced mobile / responsive === */
      @media (max-width: 640px) {
        /* Nav : défilement horizontal (thumb zone) + cibles 44px */
        header nav {
          gap: 0.3rem;
          font-size: 0.8rem;
          flex-wrap: nowrap;
          overflow-x: auto;
          overflow-y: hidden;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: thin;
          overscroll-behavior-x: contain;
          padding: 0.15rem 0 0.45rem;
          margin: 0 calc(-1 * var(--wrap-pad-x, 0.95rem));
          padding-inline: var(--wrap-pad-x, 0.95rem);
          scroll-snap-type: x proximity;
          mask-image: linear-gradient(
            to right,
            transparent 0,
            #000 0.75rem,
            #000 calc(100% - 1.25rem),
            transparent 100%
          );
        }
        header nav a {
          padding: 0.45rem 0.7rem;
          min-height: 44px;
          display: inline-flex;
          align-items: center;
          flex: 0 0 auto;
          scroll-snap-align: start;
          border: 1px solid var(--border);
          background: color-mix(in srgb, var(--bg) 55%, var(--card));
        }
        header nav a[aria-current="page"] {
          border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
        }
        .site-brand {
          flex-wrap: nowrap;
          gap: 0.6rem;
        }
        .site-brand > div {
          min-width: 0;
        }
        .site-mark {
          width: 2.1rem;
          height: 2.1rem;
          font-size: 0.75rem;
        }
      }

      /* Touch friendly cards and interactive elements */
      .card, .btn, select, .hero-card {
        min-height: 44px; /* improved for mobile */
      }
      .btn {
        text-align: center;
      }
      @media (hover: none) {
        a:hover { color: inherit; } /* avoid hover styles on touch */
        .card:hover {
          border-color: var(--border);
        }
      }

      @media (prefers-contrast: more) {
        :root {
          --fg: #000000;
          --muted: #111111;
          --bg: #ffffff;
          --card: #ffffff;
          --accent: #000000;
          --border: #000000;
        }
      }
      @media (prefers-contrast: more) and (prefers-color-scheme: dark) {
        :root {
          --fg: #ffffff;
          --muted: #eeeeee;
          --bg: #000000;
          --card: #000000;
          --accent: #ffffff;
          --border: #ffffff;
          --on-accent: #000000;
        }
      }

      /* === Parcours Citoyen guided navigation / tour === */
      .parcours-bar {
        background: var(--accent-soft);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.4rem 0.65rem;
        margin: 0.5rem 0 0.9rem;
        font-family: system-ui, sans-serif;
        font-size: 0.82rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem 0.75rem;
      }
      .parcours-bar.collapsed .parcours-steps { display: none; }
      .parcours-label {
        font-weight: 600;
        color: var(--accent);
        white-space: nowrap;
      }
      .parcours-steps {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex: 1;
      }
      .parcours-steps li a {
        color: var(--muted);
        text-decoration: none;
        padding: 0.1rem 0.35rem;
        border-radius: 3px;
        font-size: 0.78rem;
        display: inline-block;
      }
      .parcours-steps li a:hover,
      .parcours-steps li a:focus {
        background: var(--card);
        color: var(--accent);
      }
      .parcours-btn {
        font-size: 0.72rem;
        padding: 0.15rem 0.4rem;
        border: 1px solid var(--border);
        background: var(--card);
        border-radius: 3px;
        cursor: pointer;
        font-family: inherit;
        min-height: 28px;
      }
      .parcours-link { font-weight: 500; }

      /* Mobile for parcours */
      @media (max-width: 640px) {
        .parcours-bar {
          font-size: 0.76rem;
          padding: 0.35rem 0.5rem;
        }
        .parcours-steps {
          width: 100%;
          order: 3;
          margin-top: 0.25rem;
        }
        .parcours-steps li a { font-size: 0.74rem; padding: 0.15rem 0.3rem; }
      }

      /* Global improved mobile for tables and viz containers */
      .table-wrap,
      .table-scroll,
      .declared-table-wrap,
      .diff-table-wrap,
      .poll-table,
      .compare-grid {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        max-width: 100%;
      }
      /* Indicateur de scroll horizontal (ombre douce) */
      .table-wrap,
      .table-scroll,
      .declared-table-wrap {
        background:
          linear-gradient(var(--card) 30%, transparent) left center / 24px 100% no-repeat local,
          linear-gradient(transparent, var(--card) 70%) right center / 24px 100% no-repeat local,
          radial-gradient(farthest-side at 0 50%, rgba(0, 0, 0, 0.12), transparent) left center / 14px 100% no-repeat scroll,
          radial-gradient(farthest-side at 100% 50%, rgba(0, 0, 0, 0.12), transparent) right center / 14px 100% no-repeat scroll;
        background-color: var(--card);
      }
      table { border-collapse: collapse; width: 100%; }
      @media (max-width: 640px) {
        table, .comp-table { font-size: 0.82rem; }
        .card {
          padding: 0.9rem 0.95rem;
          border-radius: var(--radius-lg, 12px);
        }
        .page-intro h2,
        .section-title {
          font-size: 1.2rem;
          line-height: 1.25;
        }
        .map-wrap,
        .hemicycle-wrapper {
          margin-left: 0;
          margin-right: 0;
          max-width: 100%;
        }
        footer {
          margin-top: 2.25rem;
          font-size: 0.82rem;
          word-break: break-word;
        }
        footer p {
          line-height: 1.55;
        }
      }

      /* Tablette : grille 2 colonnes plus aérée */
      @media (min-width: 641px) and (max-width: 900px) {
        .card-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 0.95rem;
        }
      }
    </style>
  </head>
  <body>
    <GoogleSeoBody />
    <!-- Skip link for keyboard and screen reader users (WCAG 2.2) -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <div class="wrap">
      <header>
        <div class="site-brand">
          <div class="site-mark" aria-hidden="true">1er</div>
          <div>
            <h1>Le Média du Premier Tour</h1>
            <p class="tagline">Pluralité, faits sourcés, vote pour — pas contre.</p>
          </div>
        </div>
        <nav aria-label="Navigation principale">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Accueil</a>
          <a href="/atlas" aria-current={Astro.url.pathname.startsWith('/atlas') ? 'page' : undefined}>Atlas</a>
          <a href="/analyses" aria-current={Astro.url.pathname.startsWith('/analyses') ? 'page' : undefined}>Analyses</a>
          <a href="/debats" aria-current={Astro.url.pathname.startsWith('/debats') ? 'page' : undefined}>Débats</a>
          <a
            href="/liberte-d-expression"
            aria-current={
              Astro.url.pathname.startsWith('/liberte-d-expression') ||
              Astro.url.pathname.startsWith('/observatoire-censure') ||
              Astro.url.pathname.startsWith('/assemblee-influenceurs')
                ? 'page'
                : undefined
            }
            >Liberté d’expression</a
          >
          <a
            href="/observatoire-censure"
            aria-current={Astro.url.pathname.startsWith('/observatoire-censure') ? 'page' : undefined}
            >Observatoire de la censure</a
          >
          <a
            href="/assemblee-influenceurs"
            aria-current={Astro.url.pathname.startsWith('/assemblee-influenceurs') ? 'page' : undefined}
            >Assemblée des influenceurs</a
          >
          <a href="/contribuer" aria-current={Astro.url.pathname.startsWith('/contribuer') ? 'page' : undefined}>Contribuer</a>
          <a href="/charte" aria-current={Astro.url.pathname.startsWith('/charte') ? 'page' : undefined}>Charte</a>
          <a href="/a-propos" aria-current={Astro.url.pathname === '/a-propos' ? 'page' : undefined}>À propos</a>
          <a href="/sources" aria-current={Astro.url.pathname === '/sources' ? 'page' : undefined}>Sources</a>
          <a href="/soutenir" aria-current={Astro.url.pathname.startsWith('/soutenir') ? 'page' : undefined}>Soutenir</a>
          <a
            href="/connexion"
            id="nav-auth"
            aria-current={
              Astro.url.pathname === '/connexion' || Astro.url.pathname === '/compte'
                ? 'page'
                : undefined
            }
            >Connexion</a
          >
          <a href="#parcours-citoyen" class="parcours-link" aria-current={Astro.url.pathname.includes('analyse') || Astro.url.pathname === '/' ? 'page' : undefined}>Parcours citoyen</a>
        </nav>

        <!-- Parcours Citoyen : navigation guidée / guided tour (site-wide, focus AN1T + analyses) -->
        <div id="parcours-citoyen" class="parcours-bar" role="navigation" aria-label="Parcours citoyen guidé">
          <span class="parcours-label">Parcours citoyen :</span>
          <ol class="parcours-steps">
            <li><a href="/">1. Découvrir le 1er tour</a></li>
            <li><a href="/atlas">2. Explorer l’Atlas</a></li>
            <li><a href="/analyses/assemblee-premier-tour">3. Simuler l’AN1T (pluralité)</a></li>
            <li><a href="/liberte-d-expression">4. Liberté d’expression</a></li>
            <li><a href="/observatoire-censure">5. Observatoire de la censure</a></li>
            <li><a href="/assemblee-influenceurs">6. Assemblée des influenceurs</a></li>
            <li><a href="/analyses/assemblee-premier-tour-mecanismes">7. Mécanismes Assemblée 1er tour</a></li>
            <li><a href="/debats">8. Participer aux débats</a></li>
            <li><a href="/contribuer">9. Suggestions &amp; alertes</a></li>
            <li><a href="/sources">10. Vérifier les sources</a></li>
          </ol>
          <button type="button" class="parcours-btn" onclick="document.getElementById('parcours-citoyen').classList.toggle('collapsed')">Masquer / Montrer</button>
        </div>
      </header>
      <main id="main-content">
        {
          editorialPost && (
            <EditorialCoverImage cover={editorialPost.cover} eager class="editorial-cover--article" />
          )
        }
        {
          showShareBar && (
            <ShareBar title={shareTitle} url={meta.canonical} />
          )
        }
        <slot />
        {
          showComments && (
            <CitizenCommentModule
              threadId={commentThread}
              title="Commentaires citoyens sous cet article"
            />
          )
        }
      </main>
      <footer>
        <p>
          Transparence des couleurs politiques des posts et intervenants.
          Ligne <em>{DOE_FR}</em> — <a href="/charte">charte</a>.
        </p>
        <p>
          Données publiques via <a href="https://www.data.gouv.fr">data.gouv.fr</a> — faits sourcés, pas de classement éliminatoire.
          {' · '}
          <a href="/sources#methodologie-blocs">Méthodo blocs</a>
          {' · '}
          <a href="/a-propos">À propos</a>
        </p>

        <!-- Feedback → file suggestions (validation rédaction avant publication site) -->
        <div class="feedback-form" aria-labelledby="feedback-title">
          <h4 id="feedback-title" style="font-size:0.95rem; margin:0.6rem 0 0.25rem;">Votre retour citoyen</h4>
          <p class="meta" style="margin:0 0 0.35rem; font-size:0.78rem;">
            Suggestion rapide (site / clarté). Pour une <strong>alerte citoyenne</strong> sourcée :
            <a href="/contribuer">espace Contribuer</a>. Rien n’est publié sans validation éditoriale.
          </p>
          <form id="feedback-form" onsubmit="handleFeedbackSubmit(event)">
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem 0.75rem; align-items:flex-end;">
              <label style="flex:1; min-width:140px;">
                <span class="meta" style="font-size:0.72rem;display:block;">Note (1-5)</span>
                <select name="rating" required style="width:100%; padding:0.3rem; font-size:0.9rem; border:1px solid var(--border); border-radius:4px;">
                  <option value="">—</option>
                  <option value="5">5 — Excellent</option>
                  <option value="4">4 — Bon</option>
                  <option value="3">3 — Moyen</option>
                  <option value="2">2 — À améliorer</option>
                  <option value="1">1 — Insuffisant</option>
                </select>
              </label>
              <label style="flex:3; min-width:180px;">
                <span class="meta" style="font-size:0.72rem;display:block;">Commentaire / suggestion</span>
                <input type="text" name="comment" required minlength="20" placeholder="Ex: La carte AN1T est plus lisible sur mobile maintenant" style="width:100%; padding:0.35rem; font-size:0.9rem; border:1px solid var(--border); border-radius:4px;" />
              </label>
              <label style="flex:1.5; min-width:130px;">
                <span class="meta" style="font-size:0.72rem;display:block;">Email (optionnel)</span>
                <input type="email" name="email" placeholder="vous@exemple.fr" style="width:100%; padding:0.35rem; font-size:0.9rem; border:1px solid var(--border); border-radius:4px;" />
              </label>
              <button type="submit" class="btn btn-secondary" style="padding:0.35rem 0.85rem; font-size:0.82rem; min-height:36px;">Envoyer</button>
            </div>
            <label class="meta" style="display:flex; gap:0.4rem; align-items:flex-start; margin-top:0.35rem; font-size:0.72rem;">
              <input type="checkbox" name="consentContact" value="1" />
              Contact rédaction uniquement pour cette suggestion (si email).
            </label>
            <div id="feedback-thanks" style="display:none; margin-top:0.35rem; font-size:0.8rem; color:#2d6a4f;"></div>
          </form>
        </div>

        <p>
          <a href="/a-propos">À propos</a>
          {' · '}
          <a href="/charte">Charte</a>
          {' · '}
          <a href="/sources">Sources</a>
          {' · '}
          <a href="/sources#methodologie-blocs">Méthodo</a>
          {' · '}
          <a href="/soutenir">Soutenir</a>
          {' · '}
          <a href="/mentions-legales">Mentions légales</a>
          {' · '}
          <a href="/confidentialite">Confidentialité</a>
          {
            socialLinks.map((link) => (
              <>
                {' '}·{' '}
                <a href={link.url} rel="me noopener noreferrer">
                  {link.handle}
                </a>
              </>
            ))
          }
        </p>
        {
          ecosystemLinks.length > 0 && (
            <p class="ecosystem">
              Outils :{' '}
              {
                ecosystemLinks.map((link, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={link.url} rel="noopener noreferrer" title={link.description}>
                      {link.label}
                    </a>
                  </>
                ))
              }
            </p>
          )
        }
      </footer>
    </div>
    <script>
      async function handleFeedbackSubmit(e) {
        e.preventDefault();
        const form = e.target;
        const thanks = document.getElementById('feedback-thanks');
        try {
          const data = Object.fromEntries(new FormData(form).entries());
          const comment = String(data.comment || '').trim();
          const email = String(data.email || '').trim();
          const consent = data.consentContact === '1';
          if (email && !consent) {
            if (thanks) {
              thanks.style.display = 'block';
              thanks.style.color = '#9b2226';
              thanks.textContent = 'Cochez le consentement si vous laissez un email.';
            }
            return;
          }
          const res = await fetch('/api/comments/tips/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'suggestion',
              title: 'Retour site (note ' + (data.rating || '—') + ')',
              body: comment,
              displayName: 'Lecteur·rice',
              email,
              consentContact: consent,
            }),
          });
          const payload = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(payload.error || 'Échec envoi');
          if (thanks) {
            thanks.style.display = 'block';
            thanks.style.color = '#2d6a4f';
            thanks.textContent =
              'Merci ! Suggestion en file — publication sur le site uniquement après validation.';
          }
          form.reset();
          setTimeout(() => { if (thanks) thanks.style.display = 'none'; }, 6500);
        } catch (err) {
          if (thanks) {
            thanks.style.display = 'block';
            thanks.style.color = '#9b2226';
            thanks.textContent =
              (err && err.message) || 'Envoi impossible — réessayez ou utilisez /contribuer.';
          }
        }
      }
      // Ensure feedback form styles are robust on all pages
      if (!document.getElementById('feedback-style-injected')) {
        const s = document.createElement('style');
        s.id = 'feedback-style-injected';
        s.textContent = `
          .feedback-form { margin: 0.75rem 0; padding: 0.5rem 0.65rem; border:1px solid var(--border); border-radius:6px; background: rgba(0,0,0,0.015); }
          @media (max-width: 640px) {
            .feedback-form form > div { flex-direction: column; }
            .feedback-form input, .feedback-form select { font-size: 0.95rem; }
          }
        `;
        document.head.appendChild(s);
      }
    </script>
    <CloudflareWebAnalytics />
  </body>
</html>

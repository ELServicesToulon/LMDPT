---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

import { getPublicSocialLinks } from '../config/social';
import { getPublicEcosystemLinks } from '../config/ecosystem';
import { pageMeta } from '../lib/seo';

const { title, description, ogImage } = Astro.props;
const socialLinks = getPublicSocialLinks();
const ecosystemLinks = getPublicEcosystemLinks();
const xLink = socialLinks.find((l) => l.id === 'x');
const siteUrl = Astro.site?.href ?? 'https://lmdpt.iarbre.org';
const meta = pageMeta({
  title,
  description,
  ogImage,
  siteUrl,
  pathname: Astro.url.pathname,
});
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{meta.fullTitle}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Média du Premier Tour" />
    <meta property="og:title" content={meta.fullTitle} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:locale" content="fr_FR" />
    {xLink && <meta name="twitter:site" content={xLink.handle} />}
    {xLink && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="twitter:title" content={meta.fullTitle} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #f6f3ec;
        --fg: #1a1a1a;
        --muted: #5c5c5c;
        --accent: #1a4a66;
        --accent-soft: color-mix(in srgb, var(--accent) 12%, var(--card));
        --border: #d4cec2;
        --card: #ffffff;
        --shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 4px 14px rgba(26, 26, 26, 0.06);
        --radius: 8px;
        --radius-lg: 12px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1114;
          --fg: #f2f0eb;
          --muted: #a8a49c;
          --accent: #7eb8d8;
          --accent-soft: color-mix(in srgb, var(--accent) 14%, var(--card));
          --border: #2e3338;
          --card: #1a1d21;
          --shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 4px 14px rgba(0, 0, 0, 0.25);
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: Georgia, 'Times New Roman', serif;
        line-height: 1.62;
        background: var(--bg);
        color: var(--fg);
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        transition: color 0.15s ease;
      }
      a:hover { color: color-mix(in srgb, var(--accent) 75%, var(--fg)); }
      .wrap {
        max-width: 52rem;
        margin: 0 auto;
        padding: 1.25rem 1rem 3.5rem;
      }
      header {
        margin-bottom: 1.75rem;
        padding: 1rem 0 1.1rem;
        border-bottom: 1px solid var(--border);
      }
      .site-brand {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.85rem;
      }
      .site-mark {
        flex-shrink: 0;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: var(--radius);
        background: linear-gradient(145deg, var(--accent), color-mix(in srgb, var(--accent) 65%, #000));
        color: var(--card);
        font-family: system-ui, sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        box-shadow: var(--shadow);
      }
      header h1 {
        font-size: 1.28rem;
        margin: 0 0 0.2rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .tagline {
        font-size: 0.92rem;
        color: var(--muted);
        margin: 0;
        line-height: 1.4;
      }
      header nav {
        font-family: system-ui, sans-serif;
        font-size: 0.88rem;
        display: flex;
        gap: 0.35rem 0.5rem;
        flex-wrap: wrap;
      }
      header nav a {
        text-decoration: none;
        color: var(--muted);
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        border: 1px solid transparent;
      }
      header nav a:hover {
        color: var(--accent);
        background: var(--accent-soft);
        border-color: color-mix(in srgb, var(--accent) 20%, transparent);
      }
      .eyebrow {
        font-family: system-ui, sans-serif;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin: 0 0 0.45rem;
        font-weight: 600;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.1rem 1.2rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }
      .card:hover {
        border-color: color-mix(in srgb, var(--accent) 25%, var(--border));
      }
      .btn {
        display: inline-block;
        font-family: system-ui, sans-serif;
        font-size: 0.88rem;
        padding: 0.55rem 1rem;
        border-radius: 6px;
        background: var(--accent);
        color: var(--card);
        text-decoration: none;
        font-weight: 600;
        border: 1px solid transparent;
        transition: opacity 0.15s ease, transform 0.1s ease;
      }
      .btn:hover {
        opacity: 0.92;
        color: var(--card);
      }
      .btn-secondary {
        background: transparent;
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
      }
      .btn-secondary:hover {
        background: var(--accent-soft);
        color: var(--accent);
      }
      @media (prefers-color-scheme: dark) {
        .btn { color: #0f1114; }
        .btn:hover { color: #0f1114; }
      }
      .meta {
        font-family: system-ui, sans-serif;
        font-size: 0.8rem;
        color: var(--muted);
      }
      main h2, main h3 {
        letter-spacing: -0.015em;
      }
      .page-intro {
        margin-bottom: 1.75rem;
      }
      .page-intro h2 {
        margin: 0 0 0.65rem;
        font-size: 1.45rem;
      }
      .page-intro p {
        margin: 0;
        max-width: 40rem;
      }
      .section-title {
        font-size: 1.15rem;
        margin: 0 0 1rem;
        padding-left: 0.75rem;
        border-left: 3px solid var(--accent);
      }
      .card-grid {
        display: grid;
        gap: 0.85rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      @media (min-width: 640px) {
        .card-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .card-grid .card {
        margin-bottom: 0;
        height: 100%;
      }
      .card-grid h3 {
        margin: 0 0 0.4rem;
        font-size: 1.02rem;
        line-height: 1.35;
      }
      .card-grid h3 a {
        color: inherit;
        text-decoration: none;
      }
      .card-grid h3 a:hover {
        color: var(--accent);
      }
      .status-badge {
        display: inline-block;
        margin-left: 0.35rem;
        font-family: system-ui, sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.1rem 0.4rem;
        vertical-align: middle;
      }
      .status-badge--open {
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
        background: var(--accent-soft);
      }
      ul.resources {
        padding-left: 1.2rem;
        margin: 0.5rem 0 0;
      }
      footer {
        margin-top: 3rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--muted);
        font-family: system-ui, sans-serif;
      }
      footer .ecosystem { font-size: 0.8rem; margin-top: 0.45rem; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <div class="site-brand">
          <div class="site-mark" aria-hidden="true">1er</div>
          <div>
            <h1>Le Média du Premier Tour</h1>
            <p class="tagline">Pluralité, faits sourcés, vote pour — pas contre.</p>
          </div>
        </div>
        <nav aria-label="Navigation principale">
          <a href="/">Accueil</a>
          <a href="/atlas">Atlas</a>
          <a href="/analyses">Analyses</a>
          <a href="/debats">Débats</a>
          <a href="/a-propos">À propos</a>
          <a href="/sources">Sources</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>
          Données publiques via <a href="https://www.data.gouv.fr">data.gouv.fr</a> — faits sourcés, pas de classement éliminatoire.
        </p>
        <p>
          <a href="/mentions-legales">Mentions légales</a>
          {' '}·{' '}
          <a href="/confidentialite">Confidentialité</a>
          {
            socialLinks.map((link) => (
              <>
                {' '}·{' '}
                <a href={link.url} rel="me noopener noreferrer">
                  {link.handle}
                </a>
              </>
            ))
          }
        </p>
        {
          ecosystemLinks.length > 0 && (
            <p class="ecosystem">
              Outils :{' '}
              {
                ecosystemLinks.map((link, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={link.url} rel="noopener noreferrer" title={link.description}>
                      {link.label}
                    </a>
                  </>
                ))
              }
            </p>
          )
        }
      </footer>
    </div>
  </body>
</html>

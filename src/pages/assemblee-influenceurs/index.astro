---
/**
 * Assemblée des influenceurs — hémicycle fictif pédagogique (DOE).
 * Dataset : src/data/assemblee-influenceurs.json
 * JSON client : public/data/assemblee-influenceurs-client.json (npm run build:assemblee-client)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfluenceursHemicycle from '../../components/InfluenceursHemicycle.astro';
import InfluenceursSchemaDevelop from '../../components/InfluenceursSchemaDevelop.astro';
import InfluenceurBackers from '../../components/InfluenceurBackers.astro';
import {
  FAMILY_COLORS,
  FOREIGN_LINK_KIND_LABELS,
  IDEOLOGY_LINK_KIND_LABELS,
  getAssembleeInfluenceursView,
} from '../../lib/assemblee-influenceurs';
import hueEstimate from '../../data/influenceurs-network-hue-estimate.json';

const view = getAssembleeInfluenceursView();
const updated = new Date(view.updated).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});
const nameById = Object.fromEntries(
  view.influencers.map((i) => [i.id, i.display_name]),
);

/** Généré en pré-build (sync:all) — détails fiches hors HTML */
const clientDataUrl = '/data/assemblee-influenceurs-client.json';

const NETWORK_ORDER = ['youtube', 'tiktok', 'twitch', 'x', 'facebook'] as const;
const NETWORK_LABELS: Record<(typeof NETWORK_ORDER)[number], string> = {
  youtube: 'YouTube',
  tiktok: 'TikTok',
  twitch: 'Twitch',
  x: 'X',
  facebook: 'Facebook',
};
const networkRows = NETWORK_ORDER.map((id) => {
  const n = (hueEstimate.networks as Record<string, {
    n_accounts: number;
    top_family: string;
    top_label: string;
    top_pct: number;
    top3: Array<{ label: string; pct: number }>;
  }>)[id];
  if (!n) return null;
  return {
    id,
    label: NETWORK_LABELS[id],
    ...n,
    color: FAMILY_COLORS[n.top_family] ?? FAMILY_COLORS.autre,
  };
}).filter(Boolean);

/** Inventaire pédagogique — sièges avec liens d’État / étrangers documentés */
const foreignRows = [...view.seated]
  .filter((s) => s.foreignResolved.signal > 0)
  .sort((a, b) => {
    const df = b.foreignResolved.signal - a.foreignResolved.signal;
    if (df !== 0) return df;
    return a.display_name.localeCompare(b.display_name, 'fr', { sensitivity: 'base' });
  })
  .map((s) => ({
    id: s.id,
    name: s.display_name,
    signal: s.foreignResolved.signal,
    rowForeign: s.seatForeign?.row ?? s.seat.row,
    color: s.color,
    links: s.foreignResolved.links.map((l) => ({
      kindLabel: FOREIGN_LINK_KIND_LABELS[l.kind],
      entity: l.state_or_entity,
      label: l.label,
      sources: l.sources,
    })),
  }));

/** Sièges avec idéologie totalisante documentée (noir) */
const ideologyRows = [...view.seated]
  .filter((s) => s.ideologyResolved.signal > 0)
  .sort((a, b) => {
    const di = b.ideologyResolved.signal - a.ideologyResolved.signal;
    if (di !== 0) return di;
    return a.display_name.localeCompare(b.display_name, 'fr', { sensitivity: 'base' });
  })
  .map((s) => ({
    id: s.id,
    name: s.display_name,
    signal: s.ideologyResolved.signal,
    rowIdeology: s.seatIdeology?.row ?? s.seat.row,
    color: s.color,
    links: s.ideologyResolved.links.map((l) => ({
      kindLabel: IDEOLOGY_LINK_KIND_LABELS[l.kind],
      entity: l.entity,
      label: l.label,
      sources: l.sources,
    })),
  }));
---

<BaseLayout
  title="Assemblée des influenceurs"
  description="Assemblée fictive pédagogique LMDPT : influenceurs placés sur les bancs selon leur teinte politique déclarée ou estimée — description, liens, dépendances économiques et financeurs sourcés."
  type="website"
  keywords="assemblée influenceurs, hémicycle, teinte politique, dépendances économiques, liberté d'expression, LMDPT, pluralité"
  commentThread="assemblee-influenceurs"
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/liberte-d-expression">Liberté d’expression</a> → Assemblée des influenceurs
  </nav>

  <article class="ai-page">
    <header class="card ai-hero">
      <p class="eyebrow">Fiction pédagogique · Democracy Over Elimination</p>
      <h1>{view.title}</h1>
      <p class="lead">
        Chaque siège représente une <strong>figure du débat public</strong> (influenceur,
        société civile, média, élu·e documenté·e). <strong>577 sièges</strong> — étalon Assemblée nationale.
        Corpus : <strong>cible 40&nbsp;% société civile</strong> (créateurs, ONG, syndicats, vulgarisation)
        — le reste = influenceurs/médias et élu·e·s documenté·e·s.
        <strong>Premier rang = plus d’abonnés</strong> (ordres de grandeur pédagogiques) ;
        toggle <strong>rangs · liens étrangers</strong> ou
        <strong>rangs · idéologie</strong> (sièges <strong>noirs</strong> si documenté).
        Au sein de chaque rangée, axe gauche–droite pédagogique du 1er tour.
        <strong>Siège plein</strong> = position déclarée/sourcée ;
        <strong>siège en pointillé</strong> = estimation documentaire.
        Vue par défaut : <strong>Influenceurs</strong> (lisible sans zoom) — paliers Fit / Lire / Détail.
        Fiction pédagogique — <em>pas</em> la composition actuelle de l’AN.
      </p>
      <p class="meta">
        Période : {view.period.label} (depuis {view.period.from}) · mise à jour {updated} ·{' '}
        {view.counts.total} sièges · {view.counts.byCategory.influenceur} influenceurs ·{' '}
        {view.counts.byCategory['societe-civile']} société civile ·{' '}
        {view.counts.byCategory['elu-parlementaire']} élu·e·s ·{' '}
        {view.counts.declare} déclarée{view.counts.declare > 1 ? 's' : ''} ·{' '}
        {view.counts.estime} estimée{view.counts.estime > 1 ? 's' : ''} ·{' '}
        {view.backers.length} financeur{view.backers.length !== 1 ? 's' : ''} documenté{view.backers.length !== 1 ? 's' : ''}
      </p>
      <p class="meta disclaimer-box">{view.disclaimer}</p>
    </header>

    <nav class="card ai-toc" aria-label="Sommaire assemblée influenceurs">
      <ol>
        <li><a href="#hemicycle">Hémicycle</a></li>
        <li><a href="#reseaux">Couleurs par réseau</a></li>
        <li><a href="#ingerences-etrangeres">Liens d’État / étrangers</a></li>
        <li><a href="#ideologie-totalisante">Idéologie totalisante</a></li>
        <li><a href="#methode">Méthode</a></li>
        <li><a href="#fiches">Fiches (développement)</a></li>
        <li><a href="#financeurs">Financeurs de la sphère</a></li>
        <li><a href="#droit-de-reponse">Droit de réponse</a></li>
      </ol>
    </nav>

    <section class="card" id="hemicycle" aria-labelledby="hemicycle-title">
      <h2 id="hemicycle-title" class="visually-hidden">Hémicycle</h2>
      <InfluenceursHemicycle
        seated={view.seated}
        declareCount={view.counts.declare}
        estimeCount={view.counts.estime}
        dataUrl={clientDataUrl}
      />
    </section>

    <section class="card" id="reseaux" aria-labelledby="reseaux-title">
      <h2 id="reseaux-title">Couleur politique la plus représentée par réseau</h2>
      <p class="meta">
        Lecture sur les <strong>influenceurs / médias</strong> du corpus (hors élus Wikidata) :
        une fiche présente sur le réseau = une voix. Pas de pondération par abonnés.
      </p>
      <ul class="ai-net-list">
        {
          networkRows.map((row) => (
            <li class="ai-net-item" style={`border-left-color:${row!.color}`}>
              <div class="ai-net-head">
                <strong>{row!.label}</strong>
                <span class="meta"> · {row!.n_accounts} comptes</span>
              </div>
              <p class="ai-net-top">
                <span
                  class="ai-net-swatch"
                  style={`background:${row!.color}`}
                  aria-hidden="true"
                />
                <strong>{row!.top_label}</strong>
                <span class="meta"> — {row!.top_pct}&nbsp;%</span>
              </p>
              <p class="meta">
                Top 3 :{' '}
                {row!.top3.map((t) => `${t.label} ${t.pct}%`).join(' · ')}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="meta disclaimer-box">{hueEstimate.disclaimer}</p>
    </section>

    <section class="card" id="ingerences-etrangeres" aria-labelledby="ingerences-title">
      <h2 id="ingerences-title">Liens d’État / financement étranger documentés</h2>
      <p>
        Rang pédagogique parallèle aux abonnés : le toggle
        <strong>Rangs · liens étrangers</strong> place au 1er rang les fiches avec le plus de
        signaux sourcés (organe d’État, sanction UE, réseau média étranger, financement).
        <em>Pas</em> un score moral ni une accusation d’« agent ». Corpus fail-closed —
        {view.counts.foreignDocumented} fiche{view.counts.foreignDocumented > 1 ? 's' : ''} documentée{view.counts.foreignDocumented > 1 ? 's' : ''}
        sur {view.counts.total}.
      </p>
      {
        foreignRows.length === 0 ? (
          <p class="meta">Aucun lien documenté à ce jour.</p>
        ) : (
          <ol class="ai-foreign-list">
            {foreignRows.map((row, i) => (
              <li class="ai-foreign-item" style={`border-left-color:${row.color}`}>
                <div class="ai-foreign-head">
                  <span class="meta">#{i + 1}</span>
                  <strong>
                    <a href={`#hemicycle`} data-focus-seat={row.id}>
                      {row.name}
                    </a>
                  </strong>
                  <span class="meta">
                    · signal {row.signal} · rang hémicycle (mode liens) ≈ {row.rowForeign + 1}
                  </span>
                </div>
                <ul>
                  {row.links.map((l) => (
                    <li>
                      <strong>{l.kindLabel}</strong> · {l.entity} — {l.label}
                      <ul class="meta">
                        {l.sources.map((s) => (
                          <li>
                            <a href={s.url} rel="noopener noreferrer">
                              {s.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        )
      }
      <p class="meta disclaimer-box">
        Absence de fiche ≠ absence de lien. Suggestions sourcées via{' '}
        <a href="/contribuer">/contribuer</a>. Dataset :{' '}
        <code>assemblee-foreign-links.json</code>.
      </p>
    </section>

    <section class="card" id="ideologie-totalisante" aria-labelledby="ideologie-title">
      <h2 id="ideologie-title">Idéologie totalisante / organisations documentées</h2>
      <p>
        Enquête staff LMDPT (fail-closed) : organisations nommées, sanctions État/UE, réseaux média
        d’appareil. Toggle <strong>Rangs · idéologie</strong> — sièges peints en
        <strong>noir</strong> si documentés. <em>Pas</em> une liste confessionnelle ni un score moral.
        {view.counts.ideologyDocumented} fiche{view.counts.ideologyDocumented > 1 ? 's' : ''} documentée
        {view.counts.ideologyDocumented > 1 ? 's' : ''} sur {view.counts.total}.
      </p>
      {
        ideologyRows.length === 0 ? (
          <p class="meta">Aucun lien documenté à ce jour.</p>
        ) : (
          <ol class="ai-foreign-list">
            {ideologyRows.map((row, i) => (
              <li class="ai-foreign-item" style={`border-left-color:${row.color}`}>
                <div class="ai-foreign-head">
                  <span class="meta">#{i + 1}</span>
                  <strong>
                    <a href={`#hemicycle`} data-focus-seat={row.id}>
                      {row.name}
                    </a>
                  </strong>
                  <span class="meta">
                    · signal {row.signal} · rang (mode idéologie) ≈ {row.rowIdeology + 1}
                  </span>
                </div>
                <ul>
                  {row.links.map((l) => (
                    <li>
                      <strong>{l.kindLabel}</strong> · {l.entity} — {l.label}
                      <ul class="meta">
                        {l.sources.map((s) => (
                          <li>
                            <a href={s.url} rel="noopener noreferrer">
                              {s.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        )
      }
      <p class="meta disclaimer-box">
        Cas <code>partial</code> = notes staff uniquement (pas de siège noir). Dataset :{' '}
        <code>assemblee-ideology-signals.json</code>.
      </p>
    </section>

    <section class="card" id="methode" aria-labelledby="methode-title">
      <h2 id="methode-title">Méthode</h2>
      <p class="meta methodology-box">{view.methodology_note.replace(/\*\*([^*]+)\*\*/g, '$1')}</p>
      <ul>
        <li>
          <strong>Rangs par abonnés</strong> : 1er rang = audience la plus élevée (ordres de
          grandeur pédagogiques, pas un scrape live). Au sein d’une rangée : axe gauche–droite.
          Un député peu suivi peut être derrière un influenceur à plus forte audience (ex.
          Jack Le Fou, Casus Lady, Ali Babal ; Nathan Keskon = focus éditorial égal malgré
          audience plus modeste).
        </li>
        <li>
          <strong>Rangs · liens étrangers</strong> : 1er rang = plus de liens d’État /
          financement étranger documentés (<code>assemblee-foreign-links.json</code>). Kinds :
          organe d’État, sanction UE, réseau média étranger, financement. Fail-closed — pas
          d’invention. Pas un score d’« ingérence » moral.
        </li>
        <li>
          <strong>Rangs · idéologie</strong> : 1er rang = plus de liens organisationnels /
          idéologie totalisante documentés (<code>assemblee-ideology-signals.json</code>). Sièges
          <strong>noirs</strong> si signal &gt; 0. Fail-closed — pas d’invention.
        </li>
        <li>
          <strong>Évolutions d’avis</strong> : champ <code>stance_history</code> (motifs + sources).
          « Il n’y a que les imbéciles qui ne changent pas d’avis » — bascules documentées, pas un
          score moral. Bot L0 : <code>npm run manusk:lmdpt-stance-veille</code>.
        </li>
        <li>
          <strong>Déclaré</strong> : ≥ 1 URL de déclaration publique de position ; siège plein.
        </li>
        <li>
          <strong>Estimé</strong> : rationale + sources + confiance ; siège pointillé ; filtrable.
        </li>
        <li>
          Teintes = familles pédagogiques 1er tour (pas une carte d’adhésion). Voir
          <a href="/sources#methodologie-blocs">méthodologie des blocs</a>.
        </li>
        <li>
          Distinct de l’
          <a href="/observatoire-censure/">observatoire de la censure</a>
          (sanctions) et de l’
          <a href="/independance-medias/">indépendance des médias</a>
          (aides / capital presse).
        </li>
        <li>
          Pas de score moral — le classement des rangs mesure l’audience <em>ou</em> les
          liens d’État / étrangers documentés, jamais la « valeur » politique (ligne
          <em>démocratie avant l’élimination</em>).
        </li>
      </ul>
    </section>

    <section class="card" id="fiches" aria-labelledby="fiches-title">
      <h2 id="fiches-title">Fiches — développement par schéma</h2>
      <p class="meta">
        {view.counts.total} entrées : coquille <code>family</code> → <code>category</code>,
        puis liste et fiche chargées à l’ouverture (évite une liste plate de 577 noms).
      </p>
      <InfluenceursSchemaDevelop seated={view.seated} dataUrl={clientDataUrl} />
    </section>

    <section class="card" id="financeurs" aria-labelledby="financeurs-title">
      <h2 id="financeurs-title">Financeurs de la sphère</h2>
      <p>
        Principaux investisseurs, mécènes, MCN ou plateformes liés à plusieurs comptes —
        uniquement si sourcés. Distinct des aides presse de
        <a href="/independance-medias/">/independance-medias</a>.
      </p>
      <InfluenceurBackers backers={view.backers} influencerNames={nameById} />
    </section>

    <section class="card" id="droit-de-reponse" aria-labelledby="ddr-title">
      <h2 id="ddr-title">Droit de réponse</h2>
      <p>
        Toute personne ou structure nommée peut demander une correction factuelle (erreur de
        source, teinte, dépendance) via une
        <a
          href="https://github.com/iarbre/le-media-du-premier-tour/issues"
          rel="noopener noreferrer"
          >issue GitHub</a
        >
        ou la page <a href="/contribuer">Contribuer</a>. Les teintes politiques sont
        contestables : ce sont des lectures pédagogiques, pas des cartes d’adhésion.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .ai-page {
    display: grid;
    gap: 1rem;
  }
  .ai-hero .lead {
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .disclaimer-box,
  .methodology-box {
    padding: 0.65rem 0.75rem;
    border-left: 3px solid var(--border, #ccc);
    background: color-mix(in srgb, var(--card, #fff) 85%, #f0f4f8);
  }
  .ai-toc ol {
    margin: 0.25rem 0 0;
    padding-left: 1.2rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .ai-net-list {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .ai-net-item {
    border: 1px solid var(--border, #ddd);
    border-left: 4px solid #718096;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    background: var(--card, #fff);
  }
  .ai-net-head {
    margin-bottom: 0.25rem;
  }
  .ai-net-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.2rem 0;
  }
  .ai-net-swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid rgba(0, 0, 0, 0.2);
  }
  .ai-foreign-list {
    list-style: none;
    margin: 0.75rem 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .ai-foreign-item {
    border: 1px solid var(--border, #ddd);
    border-left: 4px solid #718096;
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
    background: var(--card, #fff);
  }
  .ai-foreign-head {
    margin-bottom: 0.35rem;
  }
  .ai-foreign-item ul {
    margin: 0.25rem 0 0;
    padding-left: 1.1rem;
  }
</style>

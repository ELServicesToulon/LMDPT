---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  listCandidates,
  getCandidateProgram,
  getScrutin,
  AUTEUR_LABELS,
  STATUS_LABELS,
  getThemeLabel,
} from '../../../../lib/programs';
import { formatMdeur } from '../../../../lib/program-compare';
import { getCandidateFamily } from '../../../../lib/program-families';

export function getStaticPaths() {
  const paths: Array<{ params: { scrutin: string; slug: string } }> = [];
  for (const scrutin of ['presidentielle-2017', 'presidentielle-2022', 'presidentielle-2027']) {
    for (const file of listCandidates(scrutin)) {
      paths.push({ params: { scrutin, slug: file.candidate.slug } });
    }
  }
  return paths;
}

const { scrutin, slug } = Astro.params;
const file = getCandidateProgram(scrutin!, slug!);
if (!file) throw new Error(`Programme introuvable: ${scrutin}/${slug}`);

const meta = getScrutin(scrutin!);
const family = getCandidateFamily(file.candidate.slug);
const updated = file.updated
  ? new Date(file.updated).toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
---

<BaseLayout
  title={`${file.candidate.name} — programme ${scrutin?.replace('presidentielle-', '')}`}
  description={`Mesures phares et chiffrages — ${file.candidate.name}, ${meta?.label ?? scrutin}.`}
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> →
    <a href="/analyses/programmes">Programmes</a> →
    {file.candidate.name}
  </nav>

  <section>
    <p class="eyebrow">Fiche programme · synthèse documentaire</p>
    <h2>{file.candidate.name}</h2>
    <p class="lead-programme">
      Mesures et chiffrages issus de sources documentées (campagne, Institut Montaigne ou
      estimation LMDPT — étiquetés ci-dessous). Ce n’est ni un classement ni une consigne de vote.
    </p>
    <p class="meta">
      {file.candidate.affiliation} · {family.label} · {meta?.label}
      {updated && (
        <>
          {' '}
          · MAJ <time datetime={file.updated}>{updated}</time>
        </>
      )}
    </p>
    <p class="meta">
      <a
        href={`/analyses/programmes-comparateur?scrutin=${scrutin}&family=${family.id}&view=family`}
      >
        Comparer au sein de la famille « {family.shortLabel} »
      </a>
    </p>
    {file.program.document_url && (
      <p>
        <a href={file.program.document_url} rel="noopener noreferrer">
          {file.program.document_label ?? 'Document officiel'}
        </a>
      </p>
    )}
    {file.evolution_from && (
      <p class="meta">
        Évolution documentée depuis {file.evolution_from.replace('presidentielle-', '')} —{' '}
        <a href="/analyses/programmes-comparateur?evolution=1">voir la matrice</a>
      </p>
    )}
  </section>

  <section class="card" aria-labelledby="mesures-heading">
    <h3 id="mesures-heading">Mesures phares</h3>
    <div class="table-wrap" role="region" aria-label="Mesures phares" tabindex="0">
      <table class="prog-table">
        <caption class="meta">
          {file.measures.length} mesure{file.measures.length > 1 ? 's' : ''} — {file.candidate.name}
        </caption>
        <thead>
          <tr>
            <th scope="col">Thème</th>
            <th scope="col">Sous-thème</th>
            <th scope="col">Mesure</th>
            <th scope="col">Chiffrage</th>
            <th scope="col">Évolution</th>
          </tr>
        </thead>
        <tbody>
          {file.measures.map((m) => (
            <tr>
              <td>{getThemeLabel(m.theme)}</td>
              <td>{m.subtheme || '—'}</td>
              <td>
                {m.label}
                {m.detail && <p class="meta">{m.detail}</p>}
              </td>
              <td>
                {m.chiffrage_mdeur != null
                  ? `${formatMdeur(m.chiffrage_mdeur)}${
                      m.chiffrage_auteur
                        ? ` (${AUTEUR_LABELS[m.chiffrage_auteur] ?? m.chiffrage_auteur})`
                        : ''
                    }`
                  : '—'}
              </td>
              <td>{STATUS_LABELS[m.status] ?? m.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card" aria-labelledby="chiffrages-heading">
    <h3 id="chiffrages-heading">Chiffrages</h3>
    {file.chiffrages.length === 0 ? (
      <p class="meta" role="status">
        Aucun chiffrage agrégé intégré pour ce dossier (programme partiel ou mesures non
        quantifiables). Voir le{' '}
        <a href={`/analyses/programmes-comparateur?scrutin=${scrutin}&family=${family.id}&view=family`}>
          comparateur famille
        </a>
        .
      </p>
    ) : (
      <div class="table-wrap" role="region" aria-label="Chiffrages programme" tabindex="0">
        <table class="prog-table">
          <caption class="meta">Montants en Md€/an — badges auteur obligatoires</caption>
          <thead>
            <tr>
              <th scope="col">Type</th>
              <th scope="col">Montant</th>
              <th scope="col">Auteur</th>
              <th scope="col">Horizon</th>
            </tr>
          </thead>
          <tbody>
            {file.chiffrages.map((c) => (
              <tr>
                <td>{c.type}</td>
                <td>
                  {formatMdeur(c.montant_mdeur)}
                  {c.montant_min_mdeur != null && c.montant_max_mdeur != null && (
                    <span class="meta">
                      {' '}
                      (fourchette {formatMdeur(c.montant_min_mdeur)} –{' '}
                      {formatMdeur(c.montant_max_mdeur)})
                    </span>
                  )}
                </td>
                <td>
                  {AUTEUR_LABELS[c.auteur] ?? c.auteur}
                  {c.source_url && (
                    <>
                      {' '}
                      ·{' '}
                      <a href={c.source_url} rel="noopener noreferrer">
                        source
                      </a>
                    </>
                  )}
                </td>
                <td>{c.horizon}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    {file.chiffrages.some((c) => c.auteur === 'lmdpt') && (
      <p class="meta">
        Estimations LMDPT : voir docs/PROGRAMMES-CHIFFRAGE-METHODO.md dans le dépôt.
      </p>
    )}
  </section>

  <p>
    <a href={`/analyses/programmes-comparateur?scrutin=${scrutin}&candidates=${slug}`}>
      Comparer avec d'autres candidats
    </a>
  </p>
</BaseLayout>

<style>
  .lead-programme {
    max-width: 72ch;
    line-height: 1.55;
    margin: 0 0 0.75rem;
    font-size: 1.02rem;
  }
  .table-wrap {
    overflow-x: auto;
  }
  .table-wrap:focus-visible {
    outline: 2px solid var(--accent, #1e4d6b);
    outline-offset: 2px;
  }
  .prog-table {
    width: 100%;
    border-collapse: collapse;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }
  .prog-table th,
  .prog-table td {
    border: 1px solid var(--border);
    padding: 0.45rem 0.55rem;
    text-align: left;
    vertical-align: top;
  }
  .prog-table thead th {
    position: sticky;
    top: 0;
    background: var(--card, #f7f5f0);
  }
  .prog-table caption {
    caption-side: bottom;
    text-align: left;
    padding-top: 0.35rem;
  }
</style>

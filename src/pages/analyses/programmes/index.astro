---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { listScrutins, listCandidates, getVeille2027 } from '../../../lib/programs';
import {
  getCandidateFamily,
  groupCandidatesByFamily,
} from '../../../lib/program-families';
import {
  buildProgramIntegrationReport,
  formatPct,
  programRelatedDataGouvLinks,
} from '../../../lib/program-coverage';

const scrutins = listScrutins();
const veille = getVeille2027();
const families2027 = groupCandidatesByFamily(listCandidates('presidentielle-2027'));
const integration2027 = buildProgramIntegrationReport('presidentielle-2027');
const dataGouvLinks = programRelatedDataGouvLinks();
---

<BaseLayout
  title="Programmes électoraux"
  description="Fiches programmes, comparaison factuelle et chiffrages sourcés — présidentielles 2017, 2022 et veille 2027."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> → Programmes
  </nav>

  <section>
    <h2>Programmes électoraux</h2>
    <p>
      Mesures phares, évolution entre scrutins et chiffrages (Institut Montaigne, OFCE, estimations
      LMDPT documentées). Présentation équivalente par candidat — sans classement éliminatoire.
    </p>
    <p>
      <a href="/analyses/programmes/axes?scrutin=presidentielle-2027"><strong>Grands axes</strong></a>
      — propositions des candidats par thème (fiscalité, retraites, Europe…) ·{' '}
      <a href="/analyses/programmes-comparateur">Comparateur tableau</a> ·{' '}
      <a href="/analyses/programmes-comparateur?view=coverage">couverture thématique</a>.
    </p>
    <p class="meta" role="status">
      Intégration 2027 (P10-4)&nbsp;: {integration2027.candidateCount} fiches ·{' '}
      {integration2027.measureCount} mesures · sous-thèmes {formatPct(integration2027.subthemeRate)} ·
      remplissage thèmes {formatPct(integration2027.fillRate)}
      {integration2027.thinCandidates.length > 0
        ? ` · fiches minces : ${integration2027.thinCandidates.join(', ')}`
        : ''}
      .
    </p>
  </section>

  {
    scrutins.map((s) => (
      <section class="card">
        <h3>{s.label}</h3>
        {s.id === 'presidentielle-2027' ? (
          <>
            <p class="meta">{veille.disclaimer}</p>
            <h4>Par famille politique</h4>
            <ul>
              {families2027.map((g) => (
                <li>
                  <a
                    href={`/analyses/programmes-comparateur?scrutin=presidentielle-2027&family=${g.family.id}&view=family`}
                  >
                    {g.family.label}
                  </a>
                  {' — '}
                  {g.candidates.length} fiche{g.candidates.length > 1 ? 's' : ''} ·{' '}
                  {g.candidates.filter((c) => c.chiffrages.length > 0).length} chiffrée
                  {g.candidates.filter((c) => c.chiffrages.length > 0).length > 1 ? 's' : ''}
                </li>
              ))}
            </ul>
            <h4>Fiches intégrées</h4>
            <ul>
              {listCandidates(s.id).map((f) => {
                const fam = getCandidateFamily(f.candidate.slug);
                return (
                  <li>
                    <a href={`/analyses/programmes/${s.id}/${f.candidate.slug}`}>
                      {f.candidate.name}
                    </a>
                    {' '}
                    — {f.candidate.affiliation} · {fam.shortLabel} · {f.measures.length} mesures
                    {f.chiffrages.length > 0 ? ` · ${f.chiffrages.length} chiffrage(s)` : ''} ·{' '}
                    <span class="meta">{f.program.status}</span>
                  </li>
                );
              })}
            </ul>
            <h4>Veille (non intégré)</h4>
            <ul>
              {veille.candidates
                .filter((c) => c.program_status === 'awaiting_program')
                .map((c) => (
                  <li>
                    {c.name} ({c.affiliation}) — en attente
                  </li>
                ))}
            </ul>
            <p>
              <a href="/analyses/programmes/axes?scrutin=presidentielle-2027">Grands axes 2027</a>
              {' · '}
              <a href="/analyses/programmes-comparateur?scrutin=presidentielle-2027">
                Comparateur 2027
              </a>
              {' · '}
              <a href="/analyses/programmes-comparateur?scrutin=presidentielle-2027&view=family">
                Vue familles
              </a>
              {' · '}
              <a href="/analyses/programmes-comparateur?scrutin=presidentielle-2027&view=coverage">
                Couverture thématique
              </a>
              {' · '}
              <a href="/analyses/presidentielle-2027-preparation">Dossier préparation 2027</a>
            </p>
            <h4>Granularité data.gouv (pluralité 1er tour)</h4>
            <ul>
              {dataGouvLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                  <span class="meta"> — {l.note}</span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <ul>
            {listCandidates(s.id).map((f) => (
              <li>
                <a href={`/analyses/programmes/${s.id}/${f.candidate.slug}`}>
                  {f.candidate.name}
                </a>
                {' '}
                — {f.candidate.affiliation} · {f.measures.length} mesures
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <section class="card">
    <h3>Évolution 2017 → 2022</h3>
    <p>
      <a href="/analyses/programmes-comparateur?scrutin=presidentielle-2022&evolution=1">
        Voir les évolutions par famille politique
      </a>
    </p>
  </section>
</BaseLayout>

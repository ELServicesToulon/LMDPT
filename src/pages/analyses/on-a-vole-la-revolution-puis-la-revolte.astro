---
/**
 * Tribune Manusk — On a volé la révolution, puis la révolte (5 octobre 2026)
 * Données : src/data/analyses/on-a-vole-la-revolution-puis-la-revolte.json
 * Tribune d’opinion : pas de badge d’enquête, pas d’encadré candidats.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyToc from '../../components/StickyToc.astro';
import { renderAnalysisInline, type AnalysisBlock } from '../../lib/analysis-inline';
import data from '../../data/analyses/on-a-vole-la-revolution-puis-la-revolte.json';

interface SourceLink {
  label: string;
  url: string;
}

interface SourceItem {
  label: string;
  links: SourceLink[];
  plain?: boolean;
  lead?: string;
}

type AnalysisSection = {
  kind: 'prose';
  id: string;
  title: string;
  blocks: AnalysisBlock[];
};

const published = new Date(data.date).toLocaleDateString('fr-FR', { dateStyle: 'long' });
const updated = new Date(data.updated).toLocaleDateString('fr-FR', { dateStyle: 'long' });

const sections = data.sections as AnalysisSection[];
const liensInternes = data.liens_internes as { href: string; label: string }[];

const tocItems = sections
  .map((section) => ({
    href: `#${section.id}`,
    label: section.title,
  }))
  .concat([{ href: '#sources', label: 'Sources' }]);

const keywords = [
  ...data.tags,
  'tribune',
  'Manusk',
  'lycéens',
  '1789',
  'Gilets jaunes',
  'démocratie',
].join(', ');

function isStandaloneQuote(text: string): boolean {
  const trimmed = text.trim();
  return trimmed.startsWith('«') && trimmed.endsWith('»');
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  keywords={keywords}
>
  <nav class="meta" aria-label="Fil d'Ariane" slot="lede">
    <a href="/analyses/">Analyses</a>
    {' → '}
    {data.title}
  </nav>

  <section class="enq-intro" aria-labelledby="enq-title" slot="lede">
    <p class="eyebrow">{data.eyebrow}</p>
    <h1 id="enq-title">{data.title}</h1>
    <p class="meta kicker"><em>{data.kicker}</em></p>
    <p class="meta">
      {data.type_label}
      {' · '}
      {data.author}, {data.author_role}
      {' · '}
      Rédigé le <time datetime={data.date}>{published}</time>
      {' · '}
      Mise à jour <time datetime={data.updated}>{updated}</time>
    </p>
    <p class="lead">{data.chapo}</p>
    <blockquote class="disclaimer-box">{data.disclaimer}</blockquote>
  </section>

  <StickyToc title="Sommaire" items={tocItems} />

  {
    sections.map((section) => {
      return (
        <section
          class:list={['card', { reserves: section.id === 'reserves' }]}
          id={section.id}
          aria-labelledby={`${section.id}-title`}
        >
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          {section.blocks.map((block) => {
            if (block.type === 'p') {
              if (isStandaloneQuote(block.text)) {
                return <blockquote set:html={renderAnalysisInline(block.text)} />;
              }
              return <p set:html={renderAnalysisInline(block.text)} />;
            }
            if (block.type === 'h3') {
              return <h3 set:html={renderAnalysisInline(block.text)} />;
            }
            if (block.type === 'ul') {
              return (
                <ul>
                  {block.items.map((item) => (
                    <li set:html={renderAnalysisInline(item)} />
                  ))}
                </ul>
              );
            }
            if (block.type === 'ol') {
              return (
                <ol>
                  {block.items.map((item) => (
                    <li set:html={renderAnalysisInline(item)} />
                  ))}
                </ol>
              );
            }
            if (block.type === 'table') {
              return (
                <div class="table-wrap" role="region" aria-label={block.caption} tabindex="0">
                  <table class="enq-table">
                    <caption class="visually-hidden">{block.caption}</caption>
                    <thead>
                      <tr>
                        {block.headers.map((header) => (
                          <th scope="col" set:html={renderAnalysisInline(header)} />
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.rows.map((row) => (
                        <tr>
                          {row.map((cell, index) =>
                            index === 0 ? (
                              <th scope="row" set:html={renderAnalysisInline(cell)} />
                            ) : (
                              <td set:html={renderAnalysisInline(cell)} />
                            ),
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            }
            const _exhaustive: never = block;
            return _exhaustive;
          })}
        </section>
      );
    })
  }

  <section class="card" id="sources" aria-labelledby="sources-title">
    <h2 id="sources-title">Sources</h2>
    <p>{data.sources_intro}</p>
    {
      data.sources_groups.map((group) => (
        <div>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item: SourceItem) => (
              <li>
                {item.links.length > 0 ? (
                  <>
                    {item.lead && <>{item.lead}{' : '}</>}
                    {item.links.map((link, index) => (
                      <>
                        {index > 0 && ' · '}
                        <a href={link.url} rel="noopener noreferrer">
                          {link.label}
                        </a>
                      </>
                    ))}
                  </>
                ) : (
                  <span set:html={renderAnalysisInline(item.label)} />
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    {
      data.sources_closing.split('\n\n').map((para) => (
        <p set:html={renderAnalysisInline(para)} />
      ))
    }
    {
      liensInternes.length > 0 && (
        <>
          <h3>Liens LMDPT</h3>
          <ul>
            {liensInternes.map((lien) => (
              <li>
                <a href={lien.href}>{lien.label}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  .enq-intro {
    margin-bottom: 1.25rem;
  }
  .enq-intro .lead {
    max-width: 48rem;
    line-height: 1.55;
    font-size: 1.02rem;
  }
  .kicker {
    margin-bottom: 0.35rem;
  }
  .disclaimer-box,
  blockquote {
    border-left: 3px solid var(--accent, #0e6b6e);
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--accent, #0e6b6e) 8%, transparent);
    line-height: 1.5;
    margin: 0.75rem 0;
  }
  .reserves {
    border-left: 3px solid var(--accent, #0e6b6e);
  }
  .enq-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .enq-table th,
  .enq-table td {
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    text-align: left;
    vertical-align: top;
  }
  h3 {
    margin-top: 1.25rem;
    font-size: 1.05rem;
  }
</style>

---
/**
 * Chronique Terrorisme : chacun son ratio, et tout le monde a raison (30 octobre 2026)
 * Données : src/data/analyses/terrorisme-chacun-son-ratio.json
 * Vignette : public/illustrations/unes/analyses/terrorisme-chacun-son-ratio.jpg
 * Alt : Aquarelle d'une balance ancienne en laiton sur une table en bois, entourée de rapports aux graphiques en barres et en camembert et d'une loupe, devant une carte d'Europe punaisée au mur.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyToc from '../../components/StickyToc.astro';
import PoliticalHueBadges from '../../components/PoliticalHueBadges.astro';
import { DOE_FR } from '../../lib/doe';
import { renderAnalysisInline, type AnalysisBlock } from '../../lib/analysis-inline';
import data from '../../data/analyses/terrorisme-chacun-son-ratio.json';

interface SourceLink {
  label: string;
  url: string;
}

interface SourceItem {
  label: string;
  links: SourceLink[];
  plain?: boolean;
  lead?: string;
  id?: string;
}

interface CandidatTable {
  caption: string;
  headers: string[];
  rows: string[][];
}

type AnalysisSection =
  | { kind: 'prose'; id: string; title: string; blocks: AnalysisBlock[] }
  | {
      kind: 'candidats';
      id: string;
      title: string;
      intro: string;
      table: CandidatTable;
      note: string;
      conclusion: string;
    };

const published = new Date(data.date).toLocaleDateString('fr-FR', { dateStyle: 'long' });
const updated = new Date(data.updated).toLocaleDateString('fr-FR', { dateStyle: 'long' });

const sections = data.sections as AnalysisSection[];

function renderWithNotes(src: string): string {
  return renderAnalysisInline(src).replace(
    /\[(\d+)\]/g,
    '<a class="fn-ref" href="#source-$1">[$1]</a>',
  );
}

const tocItems = sections
  .filter((section) => section.title)
  .map((section) => ({
    href: `#${section.id}`,
    label: section.title,
  }))
  .concat([{ href: '#sources', label: 'Sources' }]);

const keywords = [
  ...data.tags,
  'présidentielle 2027',
  'terrorisme',
  'Europol',
  'PNAT',
  'extrême gauche',
  'extrême droite',
].join(', ');
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  keywords={keywords}
>
  <nav class="meta" aria-label="Fil d'Ariane" slot="lede">
    <a href="/analyses/">Analyses</a>
    {' → '}
    {data.title}
  </nav>

  <section class="enq-intro" aria-labelledby="enq-title" slot="lede">
    <p class="eyebrow">{data.eyebrow}</p>
    <h1 id="enq-title">{data.title}</h1>
    <p class="meta kicker"><em>{data.kicker}</em></p>
    <p class="meta">
      {data.type_label}
      {' · '}
      Rédigé le <time datetime={data.date}>{published}</time>
      {' · '}
      Mise à jour <time datetime={data.updated}>{updated}</time>
    </p>
    <PoliticalHueBadges hues={data.hues} showMeta />
    <p class="lead">{data.chapo}</p>
    {data.disclaimer ? <blockquote class="disclaimer-box">{data.disclaimer}</blockquote> : null}
    <p class="meta">{DOE_FR}.</p>
  </section>

  <StickyToc title="Sommaire" items={tocItems} />

  {
    sections.map((section) => {
      if (section.kind === 'candidats') {
        return (
          <aside class="card candidats" id={section.id} aria-labelledby={`${section.id}-title`}>
            <h2 id={`${section.id}-title`}>{section.title}</h2>
            {section.intro ? (
              <p class="candidats-intro" set:html={renderWithNotes(section.intro)} />
            ) : null}
            <div class="table-wrap" role="region" aria-label={section.table.caption} tabindex="0">
              <table class="enq-table">
                <caption class="visually-hidden">{section.table.caption}</caption>
                <thead>
                  <tr>
                    {section.table.headers.map((header) => (
                      <th scope="col" set:html={renderWithNotes(header)} />
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, index) =>
                        index === 0 ? (
                          <th scope="row" set:html={renderWithNotes(cell)} />
                        ) : (
                          <td set:html={renderWithNotes(cell)} />
                        ),
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {section.note ? <p set:html={renderWithNotes(section.note)} /> : null}
            {section.conclusion ? (
              <p set:html={renderWithNotes(section.conclusion)} />
            ) : null}
          </aside>
        );
      }
      if (section.kind === 'prose') {
        return (
      <section
        class="card"
        id={section.id}
        aria-labelledby={section.title ? `${section.id}-title` : undefined}
        aria-label={section.title ? undefined : 'Ouverture'}
      >
        {section.title ? <h2 id={`${section.id}-title`}>{section.title}</h2> : null}
        {section.blocks.map((block) => {
          if (block.type === 'p') {
            return <p set:html={renderWithNotes(block.text)} />;
          }
          if (block.type === 'h3') {
            return <h3 set:html={renderWithNotes(block.text)} />;
          }
          if (block.type === 'ul') {
            return (
              <ul>
                {block.items.map((item) => (
                  <li set:html={renderWithNotes(item)} />
                ))}
              </ul>
            );
          }
          if (block.type === 'ol') {
            return (
              <ol>
                {block.items.map((item) => (
                  <li set:html={renderWithNotes(item)} />
                ))}
              </ol>
            );
          }
          if (block.type === 'table') {
            return (
              <div class="table-wrap" role="region" aria-label={block.caption} tabindex="0">
                <table class="enq-table">
                  <caption class="visually-hidden">{block.caption}</caption>
                  <thead>
                    <tr>
                      {block.headers.map((header) => (
                        <th scope="col" set:html={renderWithNotes(header)} />
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {block.rows.map((row) => (
                      <tr>
                        {row.map((cell, index) =>
                          index === 0 ? (
                            <th scope="row" set:html={renderWithNotes(cell)} />
                          ) : (
                            <td set:html={renderWithNotes(cell)} />
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            );
          }
          const _exhaustive: never = block;
          return _exhaustive;
        })}
      </section>
        );
      }
      const _unknown: never = section;
      return _unknown;
    })
  }

  <section class="card" id="sources" aria-labelledby="sources-title">
    <h2 id="sources-title">Sources</h2>
    <p>{data.sources_intro}</p>
    {
      data.sources_groups.map((group) => (
        <div>
          {group.title ? <h3>{group.title}</h3> : null}
          <ul>
            {group.items.map((item: SourceItem) => (
              <li id={item.id}>
                {item.links.length > 0 ? (
                  <>
                    {item.lead && (
                      <>
                        <span set:html={renderWithNotes(item.lead)} />
                        {' : '}
                      </>
                    )}
                    {item.links.map((link, index) => (
                      <>
                        {index > 0 && ' · '}
                        <a href={link.url} rel="noopener noreferrer">
                          {link.label}
                        </a>
                      </>
                    ))}
                  </>
                ) : (
                  <span set:html={renderWithNotes(item.label)} />
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <p set:html={renderWithNotes(data.sources_closing)} />
    <h3>Liens LMDPT</h3>
    <ul>
      {
        data.liens_internes.map((lien) => (
          <li>
            <a href={lien.href}>{lien.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .enq-intro {
    margin-bottom: 1.25rem;
  }
  .enq-intro .lead {
    max-width: 48rem;
    line-height: 1.55;
    font-size: 1.02rem;
  }
  .kicker {
    margin-bottom: 0.35rem;
  }
  .disclaimer-box {
    border-left: 3px solid var(--accent, #0e6b6e);
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--accent, #0e6b6e) 8%, transparent);
    line-height: 1.5;
    margin: 0.75rem 0;
  }
  .enq-table {
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .enq-table th,
  .enq-table td {
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    text-align: left;
    vertical-align: top;
  }
  #doe .enq-table {
    min-width: 40rem;
  }
  #chiffres .enq-table {
    min-width: 48rem;
  }
  h3 {
    margin-top: 1.25rem;
    font-size: 1.05rem;
  }
  code {
    font-size: 0.92em;
    word-break: break-all;
  }
  .fn-ref {
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
  }
  .candidats {
    border-left: 3px solid var(--accent, #0e6b6e);
  }
  .candidats-intro {
    font-size: 0.98rem;
  }
</style>

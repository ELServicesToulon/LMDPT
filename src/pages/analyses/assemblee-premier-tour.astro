    .hemicycle-wrapper svg { max-height: 155px; width: 100%; }
    .hemicycle-controls, .hybrid-legend { font-size: 0.8rem; }
    .hemicycle-controls fieldset { margin-bottom: 0.4rem; }
    table, .comp-table, .poll-table table, .compare-grid { font-size: 0.78rem; }
    .compare-row, .bar-cell { gap: 0.25rem; }
    .scenarios-grid > div { margin-bottom: 0.75rem; }
  }
  @media (max-width: 420px) {
    .hemicycle-wrapper svg { max-height: 138px; }
    .poll-table th, .poll-table td, .comp-table th, .comp-table td { padding: 0.2rem 0.25rem; }

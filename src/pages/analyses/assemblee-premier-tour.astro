---
import BaseLayout from '../../layouts/BaseLayout.astro';
import An1tComparatorMap from '../../components/An1tComparatorMap.astro';
import An1tSeatCompare from '../../components/An1tSeatCompare.astro';
import AssembleeHemicycle from '../../components/AssembleeHemicycle.astro';
import An1tSimulator from '../../components/An1tSimulator.astro';
import DualAssembleeCompare from '../../components/DualAssembleeCompare.astro';
import analysis from '../../data/analyses/assemblee-premier-tour-2024.json';
import leg2024National from '../../data/elections/2024-legislatives-1er-tour-national.json';
import {
  compareSeatAllocations,
  countCircosByBloc,
  simulateAn1tSeats,
  simulateFromVoteShares,
} from '../../lib/an1t';
import { getCirconscriptionResults } from '../../lib/circonscriptions';
import type { ElectionDataset } from '../../lib/election-types';
import {
  allocToHemiRows,
  buildPollAn1tBundle,
} from '../../lib/poll-to-an1t';
import { buildScrutinDual } from '../../lib/scrutin-dual';
import sondages2027 from '../../data/elections/2027-sondages-candidats.json';

// Import programmes 2027 existants pour lien AN1T (utilisation données veille/institutions)
import bardellaProg from '../../data/programmes/presidentielle-2027/bardella.json';
import attalProg from '../../data/programmes/presidentielle-2027/attal.json';
import melenchonProg from '../../data/programmes/presidentielle-2027/melenchon.json';
import retailleauProg from '../../data/programmes/presidentielle-2027/retailleau.json';
import philippeProg from '../../data/programmes/presidentielle-2027/philippe.json';

const t1 = new Date(analysis.date_premier_tour).toLocaleDateString('fr-FR', { dateStyle: 'long' });
const t2 = new Date(analysis.date_second_tour).toLocaleDateString('fr-FR', { dateStyle: 'long' });

const dataset = leg2024National as ElectionDataset;
const circos = getCirconscriptionResults('2024-legislatives');
const seatsFull = analysis.method.seats_full;
const seatsProposal = analysis.method.seats_proposal;
const threshold = analysis.method.threshold_pct;

const an1t577 = simulateAn1tSeats(dataset, seatsFull, threshold);
const an1t150 = simulateAn1tSeats(dataset, seatsProposal, threshold);
const comparison577 = compareSeatAllocations(an1t577, analysis.an_reelle.blocs, seatsFull);
const circoBlocs = circos ? countCircosByBloc(circos) : [];

/** Fil directeur multi-scrutins — cas législatives 2024 */
const dual2024 = buildScrutinDual('2024-legislatives')!;
const firstRoundPure = dual2024.firstRound;
const realAssembly = dual2024.real;

// === Sondages illustration — branchés sur 2027-sondages-candidats.json (P7-5) ===
// Intentions présidentielles → blocs AN1T → Sainte-Laguë. Pédagogique uniquement (DOE).
const pollBundle = buildPollAn1tBundle(sondages2027, seatsFull, threshold);
const sondagesBase = allocToHemiRows(pollBundle.baseAlloc);
const sondagesUnie = allocToHemiRows(pollBundle.unieAlloc);
const sondagesDivisee = allocToHemiRows(pollBundle.diviseeAlloc);
const sondagesBaseTotal = sondagesBase.reduce((s, a) => s + a.seats, 0);
const pollWaveLabel = pollBundle.waveLabel;
const pollUpdated = pollBundle.updated;

// === Scénarios 2027 liés aux programmes candidats (intégration programmes + AN1T) ===
// Utilise simulateFromVoteShares (lib/an1t) pour cohérence Sainte-Laguë. % voix = hypothèses pédagogiques alignées sur mesures phares "institutions" des programmes 2027 (veille partielle).
// Lien : mesures programmes → mobilisation bloc → % voix T1 → sièges AN1T → placement dans hémicycle hybride (quartiers du modèle officiel).
const bardellaShares = [
  { id: 'rn', label: 'RN & alliés (Bardella)', color: '#0d378a', pct: 36 },
  { id: 'nfp', label: 'NFP', color: '#cc2443', pct: 22 },
  { id: 'ensemble', label: 'Ensemble', color: '#ffeb00', pct: 12 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 9 },
  { id: 'autres', label: 'Autres', color: '#dddddd', pct: 21 },
];
const scenarioBardella = simulateFromVoteShares(bardellaShares, 577, 3);

const attalShares = [
  { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: 28 },
  { id: 'nfp', label: 'NFP', color: '#cc2443', pct: 26 },
  { id: 'ensemble', label: 'Ensemble (Attal)', color: '#ffeb00', pct: 19 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 12 },
  { id: 'autres', label: 'Autres', color: '#dddddd', pct: 15 },
];
const scenarioAttal = simulateFromVoteShares(attalShares, 577, 3);

const melenchonShares = [
  { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: 27 },
  { id: 'nfp', label: 'NFP (Mélenchon)', color: '#cc2443', pct: 30 },
  { id: 'ensemble', label: 'Ensemble', color: '#ffeb00', pct: 13 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 9 },
  { id: 'autres', label: 'Autres', color: '#dddddd', pct: 21 },
];
const scenarioMelenchon = simulateFromVoteShares(melenchonShares, 577, 3);

// Variantes supplémentaires — différents seuils & hypothèses programmes (pédagogiques, pas prédictives)
const seuil5Shares = [
  { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: 35.5 },
  { id: 'nfp', label: 'NFP', color: '#cc2443', pct: 23 },
  { id: 'ensemble', label: 'Ensemble', color: '#ffeb00', pct: 13 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 9 },
  { id: 'autres', label: 'Autres (sous seuil ajusté)', color: '#dddddd', pct: 19.5 },
];
const scenarioSeuil5 = simulateFromVoteShares(seuil5Shares, 577, 5);

const rnMajoriteShares = [
  { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: 42 },
  { id: 'nfp', label: 'NFP', color: '#cc2443', pct: 20 },
  { id: 'ensemble', label: 'Ensemble', color: '#ffeb00', pct: 10 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 7 },
  { id: 'autres', label: 'Autres', color: '#dddddd', pct: 21 },
];
const scenarioRNMajorite = simulateFromVoteShares(rnMajoriteShares, 577, 3);

const centreGaucheShares = [
  { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: 25 },
  { id: 'nfp', label: 'NFP', color: '#cc2443', pct: 28.5 },
  { id: 'ensemble', label: 'Ensemble (Philippe/Attal)', color: '#ffeb00', pct: 22.5 },
  { id: 'lr', label: 'LR', color: '#0066cc', pct: 9.5 },
  { id: 'autres', label: 'Autres', color: '#dddddd', pct: 14.5 },
];
const scenarioCentreGauche = simulateFromVoteShares(centreGaucheShares, 577, 3);

// === Scénarios enrichis depuis le rapport data (assemblee-premier-tour-2024.json + simulations an1t) ===
// Utilisés pour illustrations factuelles 2024 (pluralité T1 vs réalité post-T2). Pédagogiques uniquement.
const an1t2024Alloc = an1t577.map((a: any) => ({
  id: a.id,
  label: a.label,
  color: a.color,
  seats: a.seats,
  pct: a.pctSeats ? parseFloat(a.pctSeats) : 0,
  pollPct: a.pctExprimes ? parseFloat(a.pctExprimes.toFixed(1)) : undefined
}));

// Allocation réelle 2024 post second tour (depuis analysis.an_reelle, pour comparatifs hybrides)
const reelle2024Alloc = analysis.an_reelle.blocs.map((b: any) => ({
  id: b.id,
  label: b.label,
  color: b.color,
  seats: b.seats,
  pct: seatsFull > 0 ? parseFloat(((b.seats / seatsFull) * 100).toFixed(1)) : 0
}));
---

<BaseLayout
  title="L'Assemblée du Premier Tour 2027 — projections & hémicycle"
  description="Représentation graphique interactive des sièges de l'Assemblée nationale basée sur le premier tour. Priorité 2027 : projections à partir de sondages et pluralité du 1er tour."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> → L'Assemblée du Premier Tour 2027
  </nav>

  <section>
    <h2>L'Assemblée du Premier Tour : un même 1er tour, deux traductions en sièges</h2>
    <p class="lead">
      Visualisation principale en <strong>deux hémicycles côte à côte</strong> (même modèle géométrique Wikimedia — 577 sièges) :
    </p>
    <ul class="layers-summary">
      <li>
        <strong>À gauche — Assemblée 100&nbsp;% 1er tour</strong> :
        répartition <em>Sainte-Laguë</em> sur les voix exprimées du 1er tour des législatives 2024 uniquement
        (modèle AN1T LMDPT). Sièges placés le long de l’arc selon le <strong>spectre de proximité de programmes</strong>
        (teintes proches = familles d’idées proches).
      </li>
      <li>
        <strong>À droite — Assemblée réelle</strong> :
        composition issue des législatives qui ont <em>suivi</em> ce premier tour (second tour, désistements, uninominal).
        Couleurs des blocs institutionnels.
      </li>
    </ul>
    <p class="meta">
      Données de référence : open data 1er tour législatives 2024 (data.gouv.fr / Ministère de l’Intérieur). Illustration pédagogique — pas une prédiction.
    </p>

    <!-- Strengthened disclaimer (editorial UX) -->
    <div class="strong-disclaimer" role="note" aria-label="Avertissement éditorial renforcé">
      <strong>⚠ Avertissement renforcé — Neutralité &amp; pédagogie :</strong> Ces deux hémicycles documentent un écart mesurable entre la pluralité du 1er tour et l’Assemblée élue. <strong>Aucune prédiction, aucune recommandation de réforme, aucun jugement sur le mode de scrutin actuel.</strong> Conformément à la ligne Democracy Over Elimination.
    </div>

    <!-- ===== VISUEL PRINCIPAL : 100% T1 vs Assemblée réelle ===== -->
    <DualAssembleeCompare
      firstRoundAlloc={firstRoundPure}
      realAlloc={realAssembly}
      totalSeats={dual2024.totalSeats}
      t1Label={dual2024.t1Label}
      t2Label={dual2024.realLabel}
      firstRoundTitle={dual2024.firstRoundTitle}
      realTitle={dual2024.realTitle}
      firstRoundMeta={dual2024.firstRoundMeta}
      realMeta={dual2024.realMeta}
      realPending={dual2024.realPending}
      differential={dual2024.differential}
    />
    <p class="meta">
      Même fil directeur sur <a href="/atlas">tous les scrutins</a> : pour les présidentielles,
      le différentiel compare l’Assemblée du 1er tour présidentiel aux <strong>législatives qui ont suivi</strong>
      (2017 · 2022 · 2027 en attente).
      {' · '}
      <a href="/analyses/gouvernance-an1t-droit"><strong>Droit, chemins d’application & gouvernance non bloquée →</strong></a>
    </p>

    <!-- ===================== MINI-GUIDE AMÉLIORÉ : POURQUOI LE 1ER TOUR COMPTE POUR LA REPRÉSENTATION ===================== -->
    <section class="card disclaimer-reinforced" aria-labelledby="guide-title">
      <h3 id="guide-title">Mini-guide : pourquoi le premier tour compte pour la représentation</h3>
      <p>
        Le premier tour n’est pas un simple tour préparatoire. C’est le moment où chaque voix exprimée compte de manière égale et directe pour révéler la pluralité réelle des préférences des Français. La représentation finale à l’Assemblée est fortement influencée par ce qui se passe ensuite (second tour, désistements, reports).
      </p>
      <ul style="margin:0.35rem 0 0.5rem 1.1rem; font-size:0.91rem; line-height:1.5;">
        <li><strong>Pluralité brute et complète</strong> : Plusieurs candidats par circonscription. Les scores du 1er tour reflètent la diversité des opinions sans réduction binaire « pour ou contre ».</li>
        <li><strong>Transparence et vérifiabilité</strong> : Résultats officiels publiés immédiatement (open data data.gouv.fr / Ministère de l’Intérieur). Chacun peut vérifier les voix exprimées par nuance et par circonscription.</li>
        <li><strong>Base potentielle d’une représentation fidèle</strong> : Une répartition proportionnelle des voix du 1er tour (Sainte-Laguë) produirait une Assemblée dont la composition reflète plus directement les premiers choix des électeurs, avant les stratégies du second tour.</li>
        <li><strong>Mise en évidence des écarts de représentation</strong> : Comparer T1 vs résultat post-T2 montre concrètement les effets des alliances, désistements (ex. 215 en 2024) et du vote stratégique sur qui siège finalement.</li>
        <li><strong>Outil pédagogique concret</strong> : Les hémicycles hybrides (couches transparence + couleurs pleines) et simulateurs permettent de visualiser ces écarts spatialement, dans les quartiers réels de l’Assemblée.</li>
      </ul>
      <p class="meta" style="font-size:0.8rem; margin-top:0.3rem;">
        <strong>Neutralité</strong> : Ces explications sont factuelles et pédagogiques (ligne éditoriale Democracy Over Elimination). Elles ne constituent ni un appel au changement du mode de scrutin ni une critique du système actuel. L’objectif est une meilleure compréhension de ce que le premier tour révèle sur la pluralité et la représentation. 
        <a href="/analyses/assemblee-premier-tour-mecanismes">Voir les mécanismes concrets</a> (seuils, dose prop., mixtes, meilleurs perdants) et <a href="/debats/assemblee-premier-tour">le débat associé</a>.
      </p>
    </section>

    <!-- Parcours Citoyen guidé spécifique à AN1T (guided tour / navigation UX) -->
    <section class="card parcours-an1t" aria-labelledby="parcours-an1t-title">
      <h3 id="parcours-an1t-title">Parcours citoyen AN1T — suivez l’explication pas à pas</h3>
      <ol style="margin:0.4rem 0 0.5rem 1.1rem; font-size:0.9rem; line-height:1.55;">
        <li><strong>Découvrez</strong> pourquoi le 1er tour compte (ci-dessus).</li>
        <li><strong>Explorez</strong> l’hémicycle hybride interactif et les scénarios (légende cliquable, toggles, granularité).</li>
        <li><strong>Testez</strong> le simulateur % voix + seuil (plus bas dans la page ou <a href="#an1t-sim-title">simulateur</a>).</li>
        <li><strong>Comparez</strong> avec les mécanismes détaillés : <a href="/analyses/assemblee-premier-tour-mecanismes">seuils, dose proportionnelle, mixtes, meilleurs perdants</a>.</li>
        <li><strong>Reliez</strong> à l’Atlas 2024 pour la géographie locale et au débat citoyen.</li>
      </ol>
      <p class="meta" style="font-size:0.78rem;">Ce parcours rend la compréhension accessible à tous. Utilisez les liens et contrôles pour naviguer ; le site est conçu pour lecture linéaire ou exploration libre.</p>
    </section>

    <!-- Simulateur intégré (vanilla JS accessible dans cette page) : sliders + calcul Sainte-Laguë client-side pour pédagogie. -->

    <figure style="margin: 1rem 0 1.5rem;">
      <img 
        src="/illustrations/assemblee-reelle-2025.svg" 
        alt="Schéma officiel de la XVIIe législature de l'Assemblée nationale — modèle de référence avec groupes parlementaires" 
        style="max-width:100%; height:auto; border:1px solid #333; border-radius:4px;" 
      />
      <figcaption class="meta" style="text-align:center; margin-top:0.4rem;">
        Modèle officiel utilisé : Assemblée nationale réelle (source : <a href="https://fr.wikipedia.org/wiki/Fichier:XVII%C3%A8me_l%C3%A9gislature_de_l%27Assembl%C3%A9e_nationale_en_France_au_14-10-2025.svg" target="_blank" rel="noopener">Wikimedia Commons</a>). Les « quartiers » colorés correspondent aux groupes parlementaires actuels.
      </figcaption>
    </figure>
  </section>

  <!-- SECTION PÉDAGOGIQUE AMÉLIORÉE : Comment lire l'hémicycle hybride (deux couches) -->
  <section class="card" aria-labelledby="comment-lire-title">
    <h3 id="comment-lire-title">Comment lire l’hémicycle hybride : les deux couches expliquées</h3>
    <p class="meta">Chaque visualisation utilise le composant hybride existant pour superposer <strong>deux couches</strong> sur le même modèle officiel de 577 positions. Cela rend la comparaison intuitive tout en restant fidèle à la géographie parlementaire réelle. Explications précises :</p>

    <div class="layer-explain-grid">
      <div class="layer-explain-box">
        <strong>Couche 1 — Arrière-plan (transparence / faible opacité) :</strong>
        Les groupes actuels de l’Assemblée nationale (législature en cours). Les positions et « quartiers » (gauche NFP, centre, LR, RN à droite, etc.) sont <em>exactement</em> celles du modèle officiel Wikimedia (XVII<sup>e</sup> législature). Affichées en transparence pour ne pas masquer la couche avant, elles fournissent les repères spatiaux familiers.
        <span class="layer-explain-role">Rôle pédagogique : ancrer la lecture dans la réalité actuelle. Vous reconnaissez immédiatement « où » les groupes siègent aujourd’hui.</span>
      </div>
      <div class="layer-explain-box">
        <strong>Couche 2 — Avant-plan (couleurs pleines) :</strong>
        Les sièges projetés selon les voix ou intentions du premier tour (répartition Sainte-Laguë). <em>Placés dans les quartiers correspondants</em> du modèle officiel : les projections « NFP » vont dans la zone gauche actuelle, les projections « RN » dans la zone droite, etc. (mapping déterministe des blocs).
        <span class="layer-explain-role">Rôle pédagogique : visualiser l’impact direct de la pluralité du 1er tour sur la même carte. Les couleurs pleines se distinguent clairement de la transparence.</span>
      </div>
      <div>
        <strong>Ce que révèle la superposition (pour la représentation) :</strong>
        <ul style="margin:0.35rem 0 0.35rem 1.1rem; font-size:0.92rem;">
          <li>Écarts chiffrés entre pluralité brute du 1er tour et composition finale après second tour / désistements.</li>
          <li>Comment les forces se « déplaceraient » spatialement si l’on alignait plus fidèlement sur les suffrages du premier tour.</li>
          <li>L’effet du scrutin majoritaire uninominal à deux tours : le 1er tour compte toutes les voix ; le 2nd les filtre et les agrège.</li>
        </ul>
        <span class="meta">Lecture neutre et factuelle : cette visualisation documente un écart mesurable entre deux approches de représentation. Elle ne juge pas le système ni ne propose de réforme.</span>
      </div>
    </div>
    <p class="meta" style="font-size:0.8rem; margin-top:0.5rem;">
      Utilisez la légende interactive (cliquable), les boutons de mode (Hybride / Projection pure / Structure actuelle) et la granularité pour explorer. 
      <strong>Liens vers les mécanismes</strong> : <a href="/analyses/assemblee-premier-tour-mecanismes">Mécanismes pour une Assemblée du Premier Tour</a> (seuils, dose proportionnelle 5-25 %, mixtes, meilleurs perdants, voies législatives) — et le débat <a href="/debats/assemblee-premier-tour">/debats/assemblee-premier-tour</a>.
    </p>
  </section>

  <!-- Hémicycle hybride : groupes actuels (transparence) + projection 2027 -->
  <AssembleeHemicycle
    title="Hémicycle hybride — Structure actuelle + Projection 1er tour"
    allocations={sondagesBase}
    totalSeats={sondagesBaseTotal}
    subtitle="Couche 1 (arrière-plan, transparence) : groupes actuels dans les quartiers du modèle officiel. Couche 2 (avant-plan, couleurs pleines) : projections 1er tour placées dans les quartiers correspondants. Utilisez la légende améliorée pour comparer."
    sourceNote="Illustration pédagogique uniquement. Les projections sont superposées spatialement sur les quartiers actuels correspondants (transparence + plein). Utilisez la légende cliquable et les modes pour explorer. Voir mécanismes pour les calculs."
  />

  <!-- Section pédagogique sur les interactions + amélioration légende (clarté renforcée) -->
  <section class="card" style="margin:0.75rem 0 1rem;">
    <h3>Comment utiliser ces visualisations hybrides et lire la légende</h3>
    <p class="meta" style="margin-bottom:0.4rem;">La légende (améliorée pour clarté) sépare explicitement les deux couches : <strong>Couche 1 (transparence)</strong> avec le comptage actuel entre parenthèses ; <strong>Couche 2 (couleurs pleines)</strong> avec sièges projetés + %. Cliquez n’importe quel item de légende pour surligner simultanément le quartier (arrière-plan) et les projections placées dedans, et voir l’écart. Cela illustre directement l’effet de la pluralité du 1er tour sur la représentation.</p>
    <ul style="font-size:0.9rem; line-height:1.55; margin:0.4rem 0 0.3rem 1.1rem;">
      <li><strong>Sélection de groupes</strong> : Cliquez sur un élément de légende ou un siège pour surligner le quartier correspondant dans les deux couches. Cliquez à nouveau ou sur fond pour désélectionner. Affiche le delta sièges projetés vs actuels.</li>
      <li><strong>Modes de vue</strong> : « Hybride » (les deux couches), « Projection pure » (projections sans ancrage aux zones), « Structure actuelle » (seulement la transparence). Utile pour isoler et comparer.</li>
      <li><strong>Granularité</strong> : 5 blocs majeurs (recommandé) ou groupes détaillés (12) pour la couche arrière. Les projections sont placées dans les quartiers correspondants quel que soit le niveau.</li>
      <li><strong>Lisibilité</strong> : Étiquettes de zones + légende structurée en deux sections claires. Swatches : transparence = arrière-plan actuel ; plein = projection 1er tour.</li>
      <li><strong>Accessibilité & responsive</strong> : Navigation clavier (Tab + Entrée), aria labels, bon contraste, mobile-friendly.</li>
    </ul>
    <p class="meta" style="font-size:0.78rem;">
      Le style reste neutre et fidèle au modèle officiel (Wikimedia Commons). Toutes les projections sont <em>illustratives et pédagogiques</em>. 
      <strong>Intégration mécanismes</strong> : <a href="/analyses/assemblee-premier-tour-mecanismes">Voir la page Mécanismes</a> (catalogue des leviers : seuils, dose proportionnelle, mixtes, meilleurs perdants + exemples chiffrés et voies d’intégration dans le Code électoral).
    </p>
  </section>

  <!-- Nouveaux scénarios intégrés programmes candidats 2027 + variantes seuils -->
  <section class="card">
    <h3>Nouveaux scénarios 2027 — Programmes candidats & variantes</h3>
    <p class="meta">Scénarios alignés sur mesures phares des programmes (Bardella, Attal, Mélenchon...) et hypothèses de seuils. <strong>Ces visualisations sont pédagogiques et factuelles dans leur construction</strong> (modèle spatial fidèle au SVG officiel de l’Assemblée). Cliquez sur les légendes des hémicycles pour sélectionner un groupe et comparer la projection aux sièges actuels dans le quartier. <a href="#programmes-an1t">Voir analyse détaillée alignement programmes ↔ AN1T / hémicycle hybride ci-dessous</a>.</p>

    <div class="scenarios-grid" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
      <div>
        <AssembleeHemicycle
          title="Scénario Bardella — Projection hybride"
          allocations={scenarioBardella}
          totalSeats={scenarioBardella.reduce((s,a)=>s+a.seats,0)}
          subtitle="Couche 1 (transparence) : structure actuelle. Couche 2 (pleine) : projection placée dans quartiers correspondants (RN/alliés)."
          sourceNote="Pédagogique. Légende interactive + modes. Voir mécanismes pour calculs."
        />
        <p class="meta small">Hypothèse continuité RN + institutions. Voir Mécanismes d’intégration ci-dessus.</p>
      </div>
      <div>
        <AssembleeHemicycle
          title="Scénario Attal — Projection hybride"
          allocations={scenarioAttal}
          totalSeats={scenarioAttal.reduce((s,a)=>s+a.seats,0)}
          subtitle="Couche 1 (transparence) : structure actuelle. Couche 2 (pleine) : projection placée dans quartiers centre correspondants."
          sourceNote="Illustration pédagogique uniquement. Voir légende améliorée."
        />
        <p class="meta small">Hypothèse programmes centre. Voir section Mécanismes.</p>
      </div>
      <div>
        <AssembleeHemicycle
          title="Scénario Mélenchon — Projection hybride"
          allocations={scenarioMelenchon}

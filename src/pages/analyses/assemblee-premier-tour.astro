</style>

<script>
  // === Interactive Assemblee Simulator (vanilla JS, WCAG friendly, no deps) ===
  function sainteLagueSimple(shares, totalSeats = 577) {
    // shares: [{id, label, color, pct}]
    // returns allocations with seats. Simple Sainte-Laguë for pedagogy.
    const blocs = shares.map(s => ({...s, votes: Math.max(0.001, s.pct)})); // avoid zero
    const quotients = blocs.map((b, i) => ({idx: i, q: b.votes / 1}));
    let seats = new Array(blocs.length).fill(0);
    let allocated = 0;

    while (allocated < totalSeats) {
      // find highest quotient
      let best = 0;
      let bestIdx = 0;
      quotients.forEach((q, i) => {
        const curQ = blocs[i].votes / (seats[i] + 1);
        if (curQ > best) { best = curQ; bestIdx = i; }
      });
      seats[bestIdx]++;
      allocated++;
      if (allocated > totalSeats * 2) break; // safety
    }

    return blocs.map((b, i) => ({
      id: b.id,
      label: b.label,
      color: b.color,
      pct: b.pct,
      seats: seats[i],
      pctSeats: totalSeats ? ((seats[i] / totalSeats) * 100).toFixed(1) : '0'
    }));
  }

  function updateLiveValues() {
    const ids = ['rn','nfp','ens','lr','aut'];
    let total = 0;
    ids.forEach(id => {
      const inp = document.getElementById('pct-' + id);
      const val = document.getElementById('val-' + id);
      if (inp && val) {
        const v = parseFloat(inp.value);
        val.textContent = v.toFixed(1);
        total += v;
      }
    });
    const totEl = document.getElementById('sim-total');
    if (totEl) totEl.textContent = `Total: ${total.toFixed(1)}%`;
    return total;
  }

  function runSimulation() {
    const inputs = {
      rn: parseFloat(document.getElementById('pct-rn')?.value || '0'),
      nfp: parseFloat(document.getElementById('pct-nfp')?.value || '0'),
      ens: parseFloat(document.getElementById('pct-ens')?.value || '0'),
      lr: parseFloat(document.getElementById('pct-lr')?.value || '0'),
      aut: parseFloat(document.getElementById('pct-aut')?.value || '0'),
    };

    const shares = [
      { id: 'rn', label: 'RN & alliés', color: '#0d378a', pct: inputs.rn },
      { id: 'nfp', label: 'Nouveau Front populaire', color: '#cc2443', pct: inputs.nfp },
      { id: 'ensemble', label: 'Ensemble / centre', color: '#ffeb00', pct: inputs.ens },
      { id: 'lr', label: 'Droite républicaine', color: '#0066cc', pct: inputs.lr },
      { id: 'autres', label: 'Autres & divers', color: '#dddddd', pct: inputs.aut },
    ];

    const results = sainteLagueSimple(shares, 577);
    const container = document.getElementById('sim-seats');
    const resultsBox = document.getElementById('sim-results');
    if (!container || !resultsBox) return;

    container.innerHTML = '';
    let totalSeats = 0;

    results.forEach(r => {
      totalSeats += r.seats;
      const div = document.createElement('div');
      div.className = 'sim-seat';
      const barWidth = Math.max(4, Math.round((r.seats / 577) * 260));
      div.innerHTML = `
        <span class="swatch" style="background:${r.color};width:12px;height:12px;border-radius:2px;display:inline-block;flex-shrink:0;"></span>
        <span class="label"><strong>${r.label}</strong> — ${r.seats} sièges (${r.pctSeats}%)</span>
        <span class="bar" style="width:${barWidth}px; background:${r.color};" aria-hidden="true"></span>
      `;
      container.appendChild(div);
    });

    const totalEl = document.createElement('div');
    totalEl.className = 'meta';
    totalEl.style.marginTop = '0.35rem';
    totalEl.textContent = `Total sièges calculés : ${totalSeats} / 577`;
    container.appendChild(totalEl);

    resultsBox.style.display = 'block';
    resultsBox.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  function loadScenario(sc) {
    const map = {
      base: {rn:32, nfp:24, ens:14, lr:10, aut:20},
      unie: {rn:33, nfp:25, ens:14, lr:10, aut:18},
      bardella: {rn:36, nfp:22, ens:12, lr:9, aut:21},
      attal: {rn:28, nfp:26, ens:19, lr:12, aut:15},
      melenchon: {rn:27, nfp:30, ens:13, lr:9, aut:21},
    };
    const vals = map[sc] || map.base;
    Object.keys(vals).forEach(k => {
      const el = document.getElementById('pct-' + (k === 'ens' ? 'ens' : k === 'aut' ? 'aut' : k));
      if (el) el.value = vals[k];
    });
    updateLiveValues();
    runSimulation();
  }

  // Note: les scénarios programmes (bardella/attal/melenchon) sont maintenant alignés sur les % des shares dans le frontmatter (simulés via simulateFromVoteShares). Les boutons client JS restent des raccourcis pédagogiques.

  function initSimulator() {
    const form = document.getElementById('sim-form');
    if (!form) return;

    const ids = ['rn','nfp','ens','lr','aut'];
    ids.forEach(id => {
      const inp = document.getElementById('pct-' + id);
      const val = document.getElementById('val-' + id);
      if (inp) {
        inp.addEventListener('input', () => {
          if (val) val.textContent = parseFloat(inp.value).toFixed(1);
          const totEl = document.getElementById('sim-total');
          if (totEl) {
            let t = 0; ids.forEach(iid => {
              const iel = document.getElementById('pct-' + iid); if (iel) t += parseFloat(iel.value||'0');
            });
            totEl.textContent = `Total: ${t.toFixed(1)}%`;
          }
        });
      }
    });

    const btnCalc = document.getElementById('btn-calc');
    const btnReset = document.getElementById('btn-reset');

    btnCalc?.addEventListener('click', runSimulation);
    btnReset?.addEventListener('click', () => {
      const defaults = {rn:'32', nfp:'24', ens:'14', lr:'10', aut:'20'};
      Object.keys(defaults).forEach(k => {
        const el = document.getElementById('pct-' + k); if (el) el.value = defaults[k];
      });
      updateLiveValues();
      const res = document.getElementById('sim-results'); if (res) res.style.display = 'none';
    });

    // Scenario buttons (comparateur)
    document.querySelectorAll('.sim-scenario').forEach(btn => {
      btn.addEventListener('click', () => {
        const sc = btn.getAttribute('data-sc') || 'base';
        loadScenario(sc);
      });
    });

    // Keyboard: allow Enter on form to calc
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        runSimulation();
      }
    });

    // init values display
    updateLiveValues();
    // Auto calc on load for immediate pedagogical value (optional)
    // runSimulation(); // commented to avoid auto noise; user triggers
  }

  // Boot
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulator);
  } else {
    initSimulator();
  }
</script>

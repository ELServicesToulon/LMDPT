---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsFeed from '../../components/NewsFeed.astro';
import AlerteCitoyenne from '../../components/AlerteCitoyenne.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import { ANALYSIS_CATALOG } from '../../lib/analyses';
import { listEditorialPosts } from '../../lib/editorial';
import renifleur from '../../data/renifleur/latest.json';
import type { RenifleurSnapshot } from '../../lib/renifleur';

const analysisPosts = listEditorialPosts().filter((p) => p.kind === 'analyse');
const bySlug = new Map(analysisPosts.map((p) => [p.slug, p]));

const feed = renifleur as RenifleurSnapshot;
---

<BaseLayout
  title="Analyses"
  description="Dossiers pédagogiques sur la pluralité du premier tour et la distorsion du second — faits sourcés."
>
  <section class="page-intro">
    <p class="eyebrow">Dossiers documentés</p>
    <h2>Analyses</h2>
    <p>
      Mécanismes électoraux, désistements, distorsion entre premier et second tour.
      Comparaisons factuelles — pas de classement éliminatoire.
    </p>
    <p class="meta">
      <strong>Principe de base</strong> : On expose des idées, pas des idéologies. Aucun signe religieux ostentatoire : blocage immédiat. (sauf direct YouTube)
    </p>
  </section>

  <section>
    <p class="meta" style="margin-bottom:0.75rem;"><strong>Pour la préparation 2027</strong> : commencez par le <a href="/analyses/assemblee-premier-tour">simulateur d’Assemblée du Premier Tour</a> (nouveau) et le <a href="/analyses/presidentielle-2027-preparation">dossier calendrier & programmes</a>.</p>
    <h3 class="section-title">Tous les dossiers</h3>
    <ul class="card-grid">
      {
        ANALYSIS_CATALOG.map((a) => {
          const post = bySlug.get(a.slug);
          return post ? (
            <li>
              <EditorialCard post={post} badge={a.preparation ? 'En préparation' : undefined} />
            </li>
          ) : null;
        })
      }
    </ul>
  </section>

  <AlerteCitoyenne previewLimit={3} />

  {
    feed.enabled && feed.items.length > 0 && (
      <NewsFeed items={feed.items} limit={4} disclaimer={feed.disclaimer} fetchedAt={feed.fetched_at} feedsOk={feed.feeds_ok} />
    )
  }
</BaseLayout>
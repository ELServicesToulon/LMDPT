---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsFeed from '../../components/NewsFeed.astro';
import { ANALYSIS_CATALOG } from '../../lib/analyses';
import renifleur from '../../data/renifleur/latest.json';
import type { RenifleurSnapshot } from '../../lib/renifleur';

const feed = renifleur as RenifleurSnapshot;
---

<BaseLayout
  title="Analyses"
  description="Dossiers pédagogiques sur la pluralité du premier tour et la distorsion du second — faits sourcés."
>
  <section class="page-intro">
    <p class="eyebrow">Dossiers documentés</p>
    <h2>Analyses</h2>
    <p>
      Mécanismes électoraux, désistements, distorsion entre premier et second tour.
      Comparaisons factuelles — pas de classement éliminatoire.
    </p>
  </section>

  {
    feed.enabled && feed.items.length > 0 && (
      <NewsFeed items={feed.items} limit={4} disclaimer={feed.disclaimer} fetchedAt={feed.fetched_at} feedsOk={feed.feeds_ok} />
    )
  }

  <section>
    <h3 class="section-title">Tous les dossiers</h3>
    <ul class="card-grid">
      {
        ANALYSIS_CATALOG.map((a) => (
          <li>
            <article class="card">
              <h3>
                <a href={a.href}>{a.title}</a>
                {a.preparation && <span class="status-badge">En préparation</span>}
              </h3>
              <p>{a.description}</p>
              <p class="meta">
                <time datetime={a.date}>
                  {new Date(a.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
                </time>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
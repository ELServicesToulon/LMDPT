---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssembleeHemicycle from '../../components/AssembleeHemicycle.astro';
import analysis from '../../data/analyses/assemblee-premier-tour-2024.json';
import mecanismesData from '../../data/analyses/assemblee-premier-tour-mecanismes.json';
import leg2024National from '../../data/elections/2024-legislatives-1er-tour-national.json';
import { simulateAn1tSeats, simulateFromVoteShares } from '../../lib/an1t';
import type { ElectionDataset } from '../../lib/election-types';

const dataset = leg2024National as ElectionDataset;
const an1t2024 = simulateAn1tSeats(dataset, 577, 3);

const t1Date = new Date(analysis.date_premier_tour).toLocaleDateString('fr-FR', { dateStyle: 'long' });

// Agrégat pédagogique juil. 2026 — intentions présidentielles → blocs législatifs (Ifop, Harris, Elabe…)
const pollShares2027 = [
  { id: 'rn', label: 'Rassemblement national & alliés', color: '#0d378a', pct: 35 },
  { id: 'nfp', label: 'Nouveau Front populaire', color: '#cc2443', pct: 26 },
  { id: 'ensemble', label: 'Ensemble / centre', color: '#ffeb00', pct: 16 },
  { id: 'lr', label: 'Droite républicaine', color: '#0066cc', pct: 8 },
  { id: 'autres', label: 'Autres & divers', color: '#dddddd', pct: 15 },
];
const an1t2027 = simulateFromVoteShares(pollShares2027, 577, 3);

const allocations2027 = an1t2027.map((a) => ({
  id: a.id,
  label: a.label,
  color: a.color,
  seats: a.seats,
}));

const allocationsAn1t2024 = an1t2024.map((a) => ({
  id: a.id,
  label: a.label,
  color: a.color,
  seats: a.seats,
}));

const blocOrder = ['rn', 'nfp', 'ensemble', 'lr', 'autres'] as const;
const blocLabels: Record<string, string> = {
  rn: 'RN & alliés',
  nfp: 'Nouveau Front populaire',
  ensemble: 'Ensemble / centre',
  lr: 'Droite républicaine',
  autres: 'Autres & divers',
};

function seatsById(alloc: { id: string; seats: number }[]): Record<string, number> {
  return Object.fromEntries(alloc.map((a) => [a.id, a.seats]));
}

const seats2027 = seatsById(allocations2027);
const seatsAn1t2024 = seatsById(allocationsAn1t2024);

const comparisonRows = blocOrder.map((id) => ({
  id,
  label: blocLabels[id],
  y2027: seats2027[id] ?? 0,
  an1t2024: seatsAn1t2024[id] ?? 0,
}));
---

<BaseLayout
  title="Mécanismes pour une Assemblée du Premier Tour"
  description="Comparaison visuelle : scénario Assemblée 2027 (sondages) vs Assemblée du premier tour 2024 (Sainte-Laguë, seuil 3 %). Pédagogique, neutre."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> → <a href="/analyses/assemblee-premier-tour">L’Assemblée du Premier Tour</a> → Mécanismes
  </nav>

  <section>
    <h2>Assemblée 2027 et Assemblée du premier tour</h2>
    <p class="lead">
      Deux hémicycles côte à côte : une <strong>projection 2027</strong> à partir d’agrégats de sondages récents
      (juillet 2026, regroupés en blocs législatifs) et l’<strong>Assemblée du premier tour</strong> calculée
      sur les voix réelles du 1er tour législatives ({t1Date}), réparties en Sainte-Laguë (seuil 3&nbsp;%).
    </p>
    <p class="meta disclaimer">
      Illustration pédagogique — pas une prédiction ni une proposition de réforme.
    </p>
  </section>

  <section class="hemicycle-grid">
    <div class="hemicycle-panel">
      <AssembleeHemicycle
        title="Assemblée 2027 (scénario sondages)"
        allocations={allocations2027}
        totalSeats={577}
        subtitle="Hybride : structure actuelle (transparence) + projection sondages juil. 2026 dans les quartiers correspondants."
        initialMode="hybrid"
        showControls={false}
      />
    </div>
    <div class="hemicycle-panel">
      <AssembleeHemicycle
        title="Assemblée du premier tour (2024)"
        allocations={allocationsAn1t2024}
        totalSeats={577}
        subtitle={`577 sièges — voix du 1er tour législatives ${t1Date}, Sainte-Laguë, seuil 3 %.`}
        initialMode="projection"
        showControls={false}
      />
    </div>
  </section>

  <section class="card">
    <h3>Écarts par bloc (577 sièges)</h3>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          <th>Scénario 2027 (sondages)</th>
          <th>AN1T 2024 (1er tour réel)</th>
          <th>Écart</th>
        </tr>
      </thead>
      <tbody>
        {comparisonRows.map((row) => {
          const delta = row.y2027 - row.an1t2024;
          const deltaLabel = delta > 0 ? `+${delta}` : `${delta}`;
          return (
            <tr>
              <td>{row.label}</td>
              <td>{row.y2027}</td>
              <td>{row.an1t2024}</td>
              <td class="meta">{deltaLabel}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="meta">
      Le scénario 2027 traduit des intentions de vote actuelles ; l’AN1T 2024 part des suffrages officiels
      du premier tour. Les deux utilisent la même méthode (Sainte-Laguë, seuil 3&nbsp;%) — seules les sources de voix diffèrent.
    </p>
  </section>

  <section class="card links-card">
    <h3>Aller plus loin</h3>
    <ul>
      <li><a href="/analyses/assemblee-premier-tour">Simulateur interactif</a> — hybride, seuils, autres scénarios 2027</li>
      <li><a href="/debats/assemblee-premier-tour">Débat associé</a> — faut-il une chambre élue sur le seul 1er tour ?</li>
      <li><a href="/analyses/legislatives-2024-desistements">Désistements 2024</a> — impact sur la recomposition</li>
    </ul>
  </section>

  <section>
    <h3>Sources</h3>
    <ul class="meta sources-list">
      {mecanismesData.sources.slice(0, 4).map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>
      ))}
      <li>Sondages 2027 (illustration) : agrégats Elabe, Verian, OpinionWay, Harris, Ifop (7–12 juil. 2026).</li>
    </ul>
    <p class="meta">{mecanismesData.method_note}</p>
  </section>

  <style>
    .lead { font-size: 1.05rem; line-height: 1.5; max-width: 42rem; }
    .disclaimer {
      margin-top: 0.5rem;
      padding: 0.5rem 0.65rem;
      border-left: 3px solid var(--accent);
      background: var(--card);
    }
    .hemicycle-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.25rem;
      margin: 1.25rem 0 1.5rem;
    }
    .hemicycle-panel {
      padding: 0.85rem 1rem;
      background: var(--card);
      border: 1px solid var(--border, #ddd);
      border-radius: var(--radius-lg, 10px);
    }
    .hemicycle-panel :global(.hemicycle h3) {
      margin-top: 0;
      font-size: 1.1rem;
    }
    .comp-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin: 0.5rem 0;
    }
    .comp-table th,
    .comp-table td {
      padding: 0.45rem 0.55rem;
      border-bottom: 1px solid var(--border, #ddd);
      text-align: left;
    }
    .comp-table th {
      font-size: 0.78rem;
      color: var(--muted, #3a3732);
      background: rgba(0, 0, 0, 0.02);
    }
    .links-card ul {
      margin: 0.25rem 0 0;
      padding-left: 1.2rem;
      line-height: 1.6;
    }
    .sources-list {
      font-size: 0.85rem;
      line-height: 1.5;
      padding-left: 1.2rem;
    }
    @media (max-width: 640px) {
      .comp-table { font-size: 0.82rem; display: block; overflow-x: auto; white-space: nowrap; }
      .hemicycle-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
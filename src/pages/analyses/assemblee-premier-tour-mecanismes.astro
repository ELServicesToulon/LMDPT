---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssembleeHemicycle from '../../components/AssembleeHemicycle.astro';
import analysis from '../../data/analyses/assemblee-premier-tour-2024.json';
import mecanismesData from '../../data/analyses/assemblee-premier-tour-mecanismes.json';
import leg2024National from '../../data/elections/2024-legislatives-1er-tour-national.json';
import { simulateAn1tSeats, simulateFromVoteShares, AN1T_BLOCS } from '../../lib/an1t';
import type { ElectionDataset } from '../../lib/election-types';

const dataset = leg2024National as ElectionDataset;
const t1Date = new Date(analysis.date_premier_tour).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});

const TOTAL = 577;
const blocOrder = ['rn', 'nfp', 'ensemble', 'lr', 'autres'] as const;
const blocLabels: Record<string, string> = {
  rn: 'RN & alliés',
  nfp: 'Nouveau Front populaire',
  ensemble: 'Ensemble / centre',
  lr: 'Droite républicaine',
  autres: 'Autres & divers',
};
const blocColors: Record<string, string> = Object.fromEntries(
  AN1T_BLOCS.map((b) => [b.id, b.color]),
);

function seatsById(alloc: { id: string; seats: number }[]): Record<string, number> {
  return Object.fromEntries(alloc.map((a) => [a.id, a.seats]));
}

function orderedSeats(map: Record<string, number>) {
  return blocOrder.map((id) => ({
    id,
    label: blocLabels[id],
    color: blocColors[id] ?? '#888',
    seats: map[id] ?? 0,
  }));
}

// —— Seuils 0 / 3 / 5 % (voix T1 2024 réelles) ——
const thresholdTable = [0, 3, 5].map((thr) => {
  const alloc = simulateAn1tSeats(dataset, TOTAL, thr);
  return { thr, seats: seatsById(alloc), rows: orderedSeats(seatsById(alloc)) };
});

// —— Scénario sondages 2027 (agrégat pédagogique) ——
const pollShares2027 = [
  { id: 'rn', label: 'Rassemblement national & alliés', color: blocColors.rn, pct: 35 },
  { id: 'nfp', label: 'Nouveau Front populaire', color: blocColors.nfp, pct: 26 },
  { id: 'ensemble', label: 'Ensemble / centre', color: blocColors.ensemble, pct: 16 },
  { id: 'lr', label: 'Droite républicaine', color: blocColors.lr, pct: 8 },
  { id: 'autres', label: 'Autres & divers', color: blocColors.autres, pct: 15 },
];
const an1t2027 = simulateFromVoteShares(pollShares2027, TOTAL, 3);
const an1t2024 = simulateAn1tSeats(dataset, TOTAL, 3);
const seats2027 = seatsById(an1t2027);
const seatsAn1t2024 = seatsById(an1t2024);

const comparisonRows = blocOrder.map((id) => ({
  id,
  label: blocLabels[id],
  y2027: seats2027[id] ?? 0,
  an1t2024: seatsAn1t2024[id] ?? 0,
}));

// —— Assemblée réelle (groupes 2025, agrégés en blocs LMDPT) ——
// Source : data/assemblee-current-groups-2025.json (sièges affichés sur le site)
const reelle2025: Record<string, number> = {
  nfp: 17 + 71 + 38 + 68, // GDR + LFI + Eco + SOC
  ensemble: 37 + 91 + 35, // Démocrates + EPR + Horizons
  lr: 48, // Droite républicaine
  rn: 17 + 122, // UDR + RN
  autres: 23 + 10, // LIOT + Indépendants
};
const realVsAn1t = blocOrder.map((id) => ({
  id,
  label: blocLabels[id],
  reelle: reelle2025[id] ?? 0,
  an1t: seatsAn1t2024[id] ?? 0,
  delta: (seatsAn1t2024[id] ?? 0) - (reelle2025[id] ?? 0),
}));

// —— Doses proportionnelles 25 / 50 / 100 % ——
// Pédagogique : part des sièges en Sainte-Laguë T1 ; le reste « majoritaire caricature »
// = distribution des sièges restants proportionnelle aux têtes de circo T1 (countCircos)
// simplifiée ici via un bonus au premier : on alloue le majoritaire comme Sainte-Laguë
// avec seuil 12 % (effet majorisant léger) pour illustrer la concentration.
function doseMix(dosePct: number) {
  const propSeats = Math.round((TOTAL * dosePct) / 100);
  const majSeats = TOTAL - propSeats;
  const prop = seatsById(simulateAn1tSeats(dataset, propSeats, 3));
  const maj =
    majSeats > 0 ? seatsById(simulateAn1tSeats(dataset, majSeats, 12)) : seatsById([]);
  const total: Record<string, number> = {};
  for (const id of blocOrder) {
    total[id] = (prop[id] ?? 0) + (maj[id] ?? 0);
  }
  // normalise arrondis → 577
  let sum = blocOrder.reduce((s, id) => s + total[id], 0);
  while (sum < TOTAL) {
    const top = blocOrder.reduce((a, b) => (total[a] >= total[b] ? a : b));
    total[top] += 1;
    sum += 1;
  }
  while (sum > TOTAL) {
    const top = blocOrder.reduce((a, b) => (total[a] >= total[b] ? a : b));
    if (total[top] > 0) {
      total[top] -= 1;
      sum -= 1;
    } else break;
  }
  return { dosePct, propSeats, majSeats, seats: total };
}
const doseTable = [25, 50, 100].map(doseMix);

// —— Meilleurs perdants (illustration) ——
// Sièges « bonus » nationaux pour les meilleures deuxièmes places T1 non élues.
// Ici : 50 sièges bonus Sainte-Laguë + 527 restants comme AN1T seuil 3.
const meilleursPerdantsBonus = 50;
const mpBase = seatsById(simulateAn1tSeats(dataset, TOTAL - meilleursPerdantsBonus, 3));
const mpBonus = seatsById(simulateAn1tSeats(dataset, meilleursPerdantsBonus, 0));
const mpTotal: Record<string, number> = {};
for (const id of blocOrder) {
  mpTotal[id] = (mpBase[id] ?? 0) + (mpBonus[id] ?? 0);
}

const allocations2027 = an1t2027.map((a) => ({
  id: a.id,
  label: a.label,
  color: a.color,
  seats: a.seats,
}));
const allocationsAn1t2024 = an1t2024.map((a) => ({
  id: a.id,
  label: a.label,
  color: a.color,
  seats: a.seats,
}));
---

<BaseLayout
  title="Mécanismes pour une Assemblée du Premier Tour"
  description="Seuils 0/3/5 %, doses prop 25/50/100 %, meilleurs perdants, AN1T vs Assemblée réelle — pédagogie neutre (Sainte-Laguë, données T1 2024)."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> →
    <a href="/analyses/assemblee-premier-tour">L’Assemblée du Premier Tour</a> → Mécanismes
  </nav>

  <section>
    <h2>Mécanismes pour une Assemblée du Premier Tour</h2>
    <p class="lead">
      Comment traduire la <strong>pluralité du 1er tour</strong> en sièges sans prétendre
      « inventer » le résultat du second tour ? Cette page compare des
      <strong>leviers électoraux</strong> (seuils, dose proportionnelle, meilleurs perdants)
      et confronte l’<strong>AN1T 2024</strong> (Sainte-Laguë sur les voix T1) à une
      <strong>Assemblée réelle 2025</strong> (groupes parlementaires) et à un
      <strong>scénario sondages 2027</strong>.
    </p>
    <p class="meta disclaimer">
      Illustration pédagogique — pas une prédiction, ni un projet de loi. Méthode :
      Sainte-Laguë (<code>lib/an1t.ts</code>), données 1er tour législatives {t1Date}.
    </p>
  </section>

  <!-- Schéma de flux -->
  <section class="card flow-card" aria-labelledby="flux-title">
    <h3 id="flux-title">Schéma de flux (de la voix au siège)</h3>
    <ol class="flow-steps">
      <li>
        <strong>1. Voix T1</strong>
        <span>Bulletins du 1er tour (circonscriptions → agrégat national)</span>
      </li>
      <li>
        <strong>2. Blocs civiques</strong>
        <span>Nuances CodNuaCand → RN / NFP / Ensemble / LR / Autres</span>
      </li>
      <li>
        <strong>3. Filtre seuil</strong>
        <span>0&nbsp;% · 3&nbsp;% · 5&nbsp;% des exprimés (éliminer ou garder les petites listes)</span>
      </li>
      <li>
        <strong>4. Répartition</strong>
        <span>Sainte-Laguë (diviseurs 1, 3, 5…) sur 577 sièges — ou mixte dose prop + majoritaire</span>
      </li>
      <li>
        <strong>5. Lecture</strong>
        <span>Hémicycle, tableaux d’écarts, comparaison Assemblée réelle / scénarios</span>
      </li>
    </ol>
    <p class="meta">
      Variante <em>meilleurs perdants</em> : une fraction de sièges nationaux récompense les
      secondes places T1 les plus fortes (ici : 50 sièges bonus, illustration).
    </p>
  </section>

  <!-- Hémicycles -->
  <section class="hemicycle-grid">
    <div class="hemicycle-panel">
      <AssembleeHemicycle
        title="Assemblée 2027 (scénario sondages)"
        allocations={allocations2027}
        totalSeats={TOTAL}
        subtitle="Hybride pédagogique : agrégats Elabe/Verian/OpinionWay/Harris/Ifop (juil. 2026) → blocs, Sainte-Laguë seuil 3 %."
        initialMode="hybrid"
        showControls={false}
      />
    </div>
    <div class="hemicycle-panel">
      <AssembleeHemicycle
        title="Assemblée du premier tour (2024)"
        allocations={allocationsAn1t2024}
        totalSeats={TOTAL}
        subtitle={`577 sièges — voix du 1er tour législatives ${t1Date}, Sainte-Laguë, seuil 3 %.`}
        initialMode="projection"
        showControls={false}
      />
    </div>
  </section>

  <section class="card">
    <h3>Écarts scénario 2027 vs AN1T 2024 (577 sièges)</h3>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          <th>Scénario 2027 (sondages)</th>
          <th>AN1T 2024 (1er tour réel)</th>
          <th>Écart</th>
        </tr>
      </thead>
      <tbody>
        {comparisonRows.map((row) => {
          const delta = row.y2027 - row.an1t2024;
          const deltaLabel = delta > 0 ? `+${delta}` : `${delta}`;
          return (
            <tr>
              <td>{row.label}</td>
              <td>{row.y2027}</td>
              <td>{row.an1t2024}</td>
              <td class="meta">{deltaLabel}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>

  <!-- Seuils -->
  <section class="card" id="seuils">
    <h3>Variante A — Seuils d’accès (0&nbsp;% / 3&nbsp;% / 5&nbsp;%)</h3>
    <p>
      Même pool de voix T1 2024 ; seul le <strong>seuil national</strong> change avant Sainte-Laguë.
      Plus le seuil est haut, plus les « petits » blocs (ici <em>Autres</em>) disparaissent au profit
      des quatre blocs principaux.
    </p>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          {thresholdTable.map((t) => (
            <th>Seuil {t.thr}&nbsp;%</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {blocOrder.map((id) => (
          <tr>
            <td>{blocLabels[id]}</td>
            {thresholdTable.map((t) => (
              <td>{t.seats[id] ?? 0}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="meta">
      Lecture : à 0&nbsp;%, les divers obtiennent des sièges ; dès 3&nbsp;% (et ici 5&nbsp;%), ils
      passent à zéro avec ces parts de voix 2024. Terra Nova et les notes France Stratégie soulignent
      ce levier comme le plus simple (Code électoral, sans révision constitutionnelle).
    </p>
  </section>

  <!-- Doses -->
  <section class="card" id="doses">
    <h3>Variante B — Dose proportionnelle (25&nbsp;% / 50&nbsp;% / 100&nbsp;%)</h3>
    <p>
      Une <strong>dose</strong> fixe le pourcentage de sièges élus à la proportionnelle nationale
      (Sainte-Laguë, seuil 3&nbsp;%) ; le reste est alloué avec un effet majorisant pédagogique
      (seuil 12&nbsp;% sur la fraction « circonscription ») pour illustrer la concentration du
      scrutin uninominal — <em>pas</em> une simulation circo par circo.
    </p>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          {doseTable.map((d) => (
            <th>
              Dose {d.dosePct}&nbsp;%
              <span class="th-sub">({d.propSeats} prop + {d.majSeats} maj.)</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {blocOrder.map((id) => (
          <tr>
            <td>{blocLabels[id]}</td>
            {doseTable.map((d) => (
              <td>{d.seats[id] ?? 0}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="meta">
      100&nbsp;% = AN1T pur. 25&nbsp;% se rapproche des propositions « dose limitée » débattues depuis
      les années 1980–2010 (dont l’expérience 1986 et les travaux Villani / Terra Nova).
    </p>
  </section>

  <!-- Meilleurs perdants -->
  <section class="card" id="meilleurs-perdants">
    <h3>Variante C — Meilleurs perdants (illustration 50 sièges)</h3>
    <p>
      Principe : une part de sièges (ici <strong>{meilleursPerdantsBonus}</strong>) est réservée
      aux meilleures « deuxièmes places » du 1er tour non qualifiées ou non élues, redistribuées
      nationalement (Sainte-Laguë sans seuil sur le bonus). Le reste suit l’AN1T seuil 3&nbsp;%.
    </p>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          <th>AN1T seuil 3&nbsp;% (577)</th>
          <th>Base {TOTAL - meilleursPerdantsBonus} + bonus {meilleursPerdantsBonus}</th>
          <th>Écart</th>
        </tr>
      </thead>
      <tbody>
        {blocOrder.map((id) => {
          const base = seatsAn1t2024[id] ?? 0;
          const mix = mpTotal[id] ?? 0;
          const d = mix - base;
          return (
            <tr>
              <td>{blocLabels[id]}</td>
              <td>{base}</td>
              <td>{mix}</td>
              <td class="meta">{d > 0 ? `+${d}` : `${d}`}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p class="meta">
      Mécanisme utilisé dans d’autres démocraties (listes complémentaires, « best losers »). Ici
      purement illustratif : pas de fichier des deuxièmes de circonscription branché.
    </p>
  </section>

  <!-- AN1T vs réelle -->
  <section class="card" id="an1t-vs-reelle">
    <h3>AN1T 2024 vs Assemblée réelle (groupes 2025)</h3>
    <p>
      L’Assemblée « réelle » regroupe les sièges issus du second tour et des désistements
      (groupes parlementaires 2025, agrégés en blocs LMDPT). L’AN1T montre ce que donnerait une
      chambre <em>uniquement</em> proportionnelle au 1er tour.
    </p>
    <table class="comp-table">
      <thead>
        <tr>
          <th>Bloc</th>
          <th>Assemblée réelle (2025)</th>
          <th>AN1T 2024 (seuil 3&nbsp;%)</th>
          <th>Δ AN1T − réelle</th>
        </tr>
      </thead>
      <tbody>
        {realVsAn1t.map((row) => (
          <tr>
            <td>{row.label}</td>
            <td>{row.reelle}</td>
            <td>{row.an1t}</td>
            <td class="meta">{row.delta > 0 ? `+${row.delta}` : `${row.delta}`}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="meta">
      Agrégation groupes : NFP = GDR+LFI+Écolo+SOC · Ensemble = Démocrates+EPR+Horizons · RN =
      RN+UDR · Autres = LIOT+NI. Totaux 577.
    </p>
  </section>

  <!-- Notes institutionnelles -->
  <section class="card" id="notes-institutionnelles">
    <h3>Notes institutionnelles</h3>
    <ul class="inst-list">
      <li>
        <strong>Base légale</strong> — Le mode de scrutin des députés relève du
        <em>Code électoral</em> (loi ordinaire). {mecanismesData.constitutional_note}
      </li>
      <li>
        <strong>Minimal</strong> — Abaisser un seuil ou introduire une petite dose
        proportionnelle : révision législative simple (précédent 1985–1986).
      </li>
      <li>
        <strong>Moyen</strong> — Dose ~25&nbsp;% + seuils : réforme électorale majeure, débats
        Terra Nova / notes d’impact type Villani (2018).
      </li>
      <li>
        <strong>Ambitieux</strong> — Chambre 100&nbsp;% 1er tour ou nouvelle assemblée : risque
        constitutionnel (art.&nbsp;24, Titre&nbsp;IV) — voir aussi l’analyse
        <a href="/analyses/gouvernance-an1t-droit">Gouvernance AN1T & droit</a>.
      </li>
      <li>
        <strong>Gouvernance</strong> — Une photo T1 plus proportionnelle n’impose pas le 49.3 ni
        l’inverse ; elle change la composition, pas les outils constitutionnels du gouvernement.
      </li>
    </ul>
  </section>

  <section class="card links-card">
    <h3>Aller plus loin</h3>
    <ul>
      <li>
        <a href="/analyses/assemblee-premier-tour">Simulateur interactif</a> — hybride, seuils,
        scénarios 2027
      </li>
      <li>
        <a href="/analyses/gouvernance-an1t-droit">Gouvernance & droit</a> — doses, chemins
        juridiques
      </li>
      <li>
        <a href="/debats/assemblee-premier-tour">Débat associé</a> — chambre élue sur le seul 1er
        tour ?
      </li>
      <li>
        <a href="/analyses/legislatives-2024-desistements">Désistements 2024</a> — écart T1 / T2
      </li>
    </ul>
  </section>

  <section>
    <h3>Sources</h3>
    <ul class="meta sources-list">
      {mecanismesData.sources.map((s) => (
        <li>
          <a href={s.url} target="_blank" rel="noopener">
            {s.label}
          </a>
        </li>
      ))}
      <li>
        Sondages 2027 (illustration) : agrégats Elabe, Verian, OpinionWay, Harris, Ifop (7–12 juil.
        2026).
      </li>
      <li>Groupes parlementaires 2025 : fichier site LMDPT <code>assemblee-current-groups-2025.json</code>.</li>
    </ul>
    <p class="meta">{mecanismesData.method_note}</p>
  </section>

  <style>
    .lead {
      font-size: 1.05rem;
      line-height: 1.5;
      max-width: 44rem;
    }
    .disclaimer {
      margin-top: 0.5rem;
      padding: 0.5rem 0.65rem;
      border-left: 3px solid var(--accent);
      background: var(--card);
    }
    .flow-steps {
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.55rem;
    }
    .flow-steps li {
      display: grid;
      grid-template-columns: minmax(7rem, 11rem) 1fr;
      gap: 0.5rem 1rem;
      padding: 0.55rem 0.7rem;
      background: rgba(0, 0, 0, 0.02);
      border: 1px solid var(--border, #ddd);
      border-radius: 8px;
      align-items: start;
    }
    .flow-steps strong {
      font-size: 0.92rem;
    }
    .flow-steps span {
      font-size: 0.9rem;
      color: var(--muted, #3a3732);
      line-height: 1.4;
    }
    .hemicycle-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.25rem;
      margin: 1.25rem 0 1.5rem;
    }
    .hemicycle-panel {
      padding: 0.85rem 1rem;
      background: var(--card);
      border: 1px solid var(--border, #ddd);
      border-radius: var(--radius-lg, 10px);
    }
    .hemicycle-panel :global(.hemicycle h3) {
      margin-top: 0;
      font-size: 1.1rem;
    }
    .comp-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin: 0.5rem 0;
    }
    .comp-table th,
    .comp-table td {
      padding: 0.45rem 0.55rem;
      border-bottom: 1px solid var(--border, #ddd);
      text-align: left;
      vertical-align: top;
    }
    .comp-table th {
      font-size: 0.78rem;
      color: var(--muted, #3a3732);
      background: rgba(0, 0, 0, 0.02);
    }
    .th-sub {
      display: block;
      font-weight: 400;
      font-size: 0.72rem;
      opacity: 0.85;
      margin-top: 0.15rem;
    }
    .inst-list {
      margin: 0.35rem 0 0;
      padding-left: 1.2rem;
      line-height: 1.55;
    }
    .inst-list li {
      margin-bottom: 0.45rem;
    }
    .links-card ul {
      margin: 0.25rem 0 0;
      padding-left: 1.2rem;
      line-height: 1.6;
    }
    .sources-list {
      font-size: 0.85rem;
      line-height: 1.5;
      padding-left: 1.2rem;
    }
    @media (max-width: 640px) {
      .comp-table {
        font-size: 0.82rem;
        display: block;
        overflow-x: auto;
        white-space: nowrap;
      }
      .hemicycle-grid {
        grid-template-columns: 1fr;
      }
      .flow-steps li {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import analysis from '../../data/analyses/presidentielle-2027-preparation.json';
import renifleur from '../../data/renifleur/latest.json';
import { getVeille2027, PROGRAM_STATUS_LABELS } from '../../lib/programs';
import { partyLogoForAffiliation, partyLogoSrc } from '../../lib/party-logos';
import { formatXHandle, xForAffiliation, xForCandidateName } from '../../lib/x-officiels';

const veilleProgrammes = getVeille2027();

const calendarTitle =
  analysis.calendar.status === 'official' ? 'Calendrier officiel' : 'Calendrier indicatif';

const t1 = new Date(analysis.calendar.premier_tour_indicatif).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});
const t2 = new Date(analysis.calendar.second_tour_indicatif).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});
const liste = new Date(analysis.calendar.publication_liste_candidats_indicatif).toLocaleDateString(
  'fr-FR',
  { dateStyle: 'long' },
);
const updated = new Date(analysis.updated).toLocaleDateString('fr-FR', { dateStyle: 'long' });
const officialized =
  analysis.calendar.officialized &&
  new Date(analysis.calendar.officialized).toLocaleDateString('fr-FR', { dateStyle: 'long' });

const statusLabels: Record<string, string> = {
  intention_declaree: 'Intention déclarée',
  candidat_declare: 'Candidature déclarée',
  designe_parti: 'Désigné par le parti',
  candidature_soumise_eligibilite: 'Candidature — éligibilité en cours de décision',
};

const sortedCandidatures = [...analysis.candidatures_veille.entries].sort((a, b) =>
  a.name.localeCompare(b.name, 'fr'),
);
const renifleurUpdated = renifleur.fetched_at
  ? new Date(renifleur.fetched_at).toLocaleString('fr-FR', {
      dateStyle: 'long',
      timeStyle: 'short',
    })
  : null;
---

<BaseLayout
  title="Présidentielle 2027 — préparation"
  description="Dossier de préparation — calendrier officialisé, veille factuelle et feuille de route pour documenter le premier tour 2027."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/analyses">Analyses</a> → Présidentielle 2027
  </nav>

  <section>
    <p class="eyebrow">Dossier en préparation</p>
    <h2>{analysis.title}</h2>

    <img 
      src="/illustrations/2027/dessin-urne-2027.jpg" 
      alt="Croquis humoristique style X : urne transparente du 1er tour et miroir de la France — illustration civique laïque" 
      style="width:100%; max-height: 380px; object-fit: cover; border-radius: 10px; margin: 0.75rem 0 1rem; border: 1px solid var(--border);"
      loading="eager"
      decoding="async"
    />

    <p>
      Ce dossier recense les <strong>sources officielles</strong> et la feuille de route éditoriale
      pour couvrir le premier tour de la présidentielle 2027 selon la ligne Democracy Over
      Elimination. Aucun résultat ni liste officielle de candidats n'est publié ici avant
      publication par le Conseil constitutionnel.
    </p>

    <!-- 3 piliers (P15-1 / P8-7) — focus 2027 -->
    <div class="piliers-2027" role="list" aria-label="Trois piliers appliqués au dossier 2027">
      <a class="pilier-2027" role="listitem" href="/sources">
        <span class="p-kicker">Pilier 1</span>
        <strong>Sécurité &amp; faits</strong>
        <span class="p-desc">Calendrier officiel, data.gouv, licences — zéro prédiction.</span>
      </a>
      <a class="pilier-2027" role="listitem" href="/atlas/2027-presidentielle">
        <span class="p-kicker">Pilier 2</span>
        <strong>Pluralité réelle</strong>
        <span class="p-desc">Atlas 2027 + AN1T : spectre complet du 1er tour, pas le duel.</span>
      </a>
      <a class="pilier-2027" role="listitem" href="/charte">
        <span class="p-kicker">Pilier 3</span>
        <strong>Democracy Over Elimination</strong>
        <span class="p-desc">Pas de tier list, pas de favori — vote pour, pas contre.</span>
      </a>
    </div>
    <p class="meta" role="note">
      <strong>Disclaimer :</strong> toute projection 2027 (atlas, simulateur) est
      <em>pédagogique uniquement</em> — pas un pronostic électoral.
    </p>

    <p>
      <strong>Nouveau :</strong> <a href="/atlas/2027-presidentielle">Atlas Présidentielle 2027</a> — placeholder national avec projection de pluralité 1er tour + lien vers scénarios AN1T (en attendant données réelles).
    </p>
    <p>
      <strong>Déclarations X :</strong>
      <a href="/analyses/declarations-x-candidats">fil chronologique</a>
      des posts publics des comptes officiels candidats (registre X + collecte auto).
    </p>
    <p class="meta">
      Dernière mise à jour : <time datetime={analysis.updated}>{updated}</time>
    </p>
  </section>

  <style>
    .piliers-2027 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
      margin: 1rem 0 0.75rem;
    }
    @media (min-width: 700px) {
      .piliers-2027 {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .pilier-2027 {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.85rem 1rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg, 10px);
      background: var(--card);
      text-decoration: none;
      color: var(--fg);
      border-top: 3px solid var(--accent);
      min-height: 6rem;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .pilier-2027:nth-child(1) { border-top-color: #1d4ed8; }
    .pilier-2027:nth-child(2) { border-top-color: #059669; }
    .pilier-2027:nth-child(3) { border-top-color: var(--accent, #c2410c); }
    .pilier-2027:hover {
      border-color: var(--accent);
      box-shadow: 0 6px 16px -6px rgb(0 0 0 / 0.12);
    }
    .pilier-2027:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 2px;
    }
    .pilier-2027 .p-kicker {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .pilier-2027 strong {
      font-size: 0.95rem;
      line-height: 1.25;
    }
    .pilier-2027 .p-desc {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.4;
    }
  </style>

  <section class="card">
    <h3>{calendarTitle}</h3>
    <p class="meta">{analysis.calendar.note}</p>
    {
      officialized && (
        <p class="meta">
          Annoncé le <time datetime={analysis.calendar.officialized}>{officialized}</time>
        </p>
      )
    }
    <dl class="fact-grid">
      <div>
        <dt>Publication liste candidats (indicatif)</dt>
        <dd>
          <time datetime={analysis.calendar.publication_liste_candidats_indicatif}>{liste}</time>
        </dd>
      </div>
      <div>
        <dt>Premier tour</dt>
        <dd>
          <time datetime={analysis.calendar.premier_tour_indicatif}>{t1}</time>
        </dd>
      </div>
      <div>
        <dt>Second tour</dt>
        <dd>
          <time datetime={analysis.calendar.second_tour_indicatif}>{t2}</time>
        </dd>
      </div>
    </dl>
    {analysis.calendar.overseas_note && <p class="meta">{analysis.calendar.overseas_note}</p>}
    {
      analysis.calendar.constitutional_window && (
        <p class="meta">{analysis.calendar.constitutional_window}</p>
      )
    }
  </section>

  <section class="card" id="veille">
    <h3>Veille factuelle</h3>
    <p class="meta">
      <a href="/analyses/alerte-citoyenne">Alerte citoyenne — débat public (11 points FR/UE) →</a>
    </p>
    <ul class="veille-list">
      {
        analysis.veille.map((item) => (
          <li>
            <time datetime={item.date}>
              {new Date(item.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
            </time>
            — <strong>{item.label}</strong> : {item.fact}{' '}
            <a href={item.source_url} rel="noopener noreferrer">
              ({item.source_label})
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    renifleur.enabled && renifleur.items.length > 0 && (
      <section class="card" id="renifleur-presse">
        <h3>Renifleur — presse traditionnelle</h3>
        <p class="meta">{renifleur.disclaimer}</p>
        {
          renifleurUpdated && (
            <p class="meta">
              Dernier passage : <time datetime={renifleur.fetched_at}>{renifleurUpdated}</time> ·{' '}
              {renifleur.feeds_ok} flux OK
            </p>
          )
        }
        <ul class="renifleur-list">
          {
            renifleur.items.map((item) => (
              <li>
                <time datetime={item.published}>
                  {new Date(item.published).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
                </time>
                —{' '}
                <a href={item.url} rel="noopener noreferrer">
                  {item.title}
                </a>
                <span class="meta"> ({item.source_label})</span>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  <section class="card">
    <h3>Candidatures — veille (non officielle)</h3>
    <p class="meta">{analysis.candidatures_veille.disclaimer}</p>
    <table class="candidatures-table">
      <thead>
        <tr>
          <th scope="col">Personnalité</th>
          <th scope="col">Étiquette</th>
          <th scope="col">X (officiel)</th>
          <th scope="col">Statut documenté</th>
          <th scope="col">Source</th>
        </tr>
      </thead>
      <tbody>
        {
          sortedCandidatures.map((entry) => {
            const party = partyLogoForAffiliation(entry.affiliation);
            const xCand = xForCandidateName(entry.name);
            const xParty = xForAffiliation(entry.affiliation);
            return (
              <tr>
                <td>{entry.name}</td>
                <td>
                  <span class="party-logo-row">
                    <img
                      class="party-logo"
                      src={partyLogoSrc(party)}
                      alt=""
                      width="28"
                      height="28"
                      loading="lazy"
                      decoding="async"
                    />
                    <span>{entry.affiliation}</span>
                  </span>
                </td>
                <td>
                  {xCand?.url ? (
                    <a href={xCand.url} rel="noopener noreferrer">
                      {formatXHandle(xCand.handle)}
                    </a>
                  ) : (
                    <span class="meta">—</span>
                  )}
                  {xParty?.url && (
                    <>
                      {' · '}
                      <a href={xParty.url} rel="noopener noreferrer" title={xParty.label}>
                        parti
                      </a>
                    </>
                  )}
                </td>
                <td>{statusLabels[entry.status] ?? entry.status}</td>
                <td>
                  <a href={entry.source_url} rel="noopener noreferrer">
                    {entry.source_label}
                  </a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </section>

  <section class="card">
    <h3>Périmètre prévu</h3>
    <p>{analysis.scope.objectif}</p>
    <h4>Inclus</h4>
    <ul>
      {analysis.scope.inclus.map((item) => <li>{item}</li>)}
    </ul>
    <h4>Exclu</h4>
    <ul>
      {analysis.scope.exclu.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="card">
    <h3>Feuille de route</h3>
    <ol class="milestones">
      {
        analysis.milestones.map((step) => (
          <li>
            <strong>{step.phase}</strong> — {step.label}
            <span class="meta"> (gate : {step.gate})</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="card" id="programmes-2027">
    <h3>Programmes — veille 2027</h3>
    <p class="meta">{veilleProgrammes.disclaimer}</p>
    <p>
      <a href="/analyses/programmes">Index programmes</a> ·{' '}
      <a href="/analyses/programmes-comparateur?scrutin=presidentielle-2022">
        Comparateur (référence 2022)
      </a>
      {veilleProgrammes.program_press_hits != null && (
        <span class="meta">
          {' '}
          · Dernier scan : {veilleProgrammes.program_press_hits} article(s) « programme » dans le
          renifleur
        </span>
      )}
    </p>
    <table class="candidatures-table">
      <thead>
        <tr>
          <th>Candidat (veille)</th>
          <th>Programme intégré</th>
          <th>Signaux presse</th>
          <th>Chiffrage</th>
        </tr>
      </thead>
      <tbody>
        {
          veilleProgrammes.candidates.map((c) => (
            <tr>
              <td>
                {c.name}
                <span class="meta"> — {c.affiliation}</span>
              </td>
              <td>{PROGRAM_STATUS_LABELS[c.program_status] ?? c.program_status}</td>
              <td>
                {c.press_signals?.length ? (
                  <ul class="press-signals">
                    {c.press_signals.map((s) => (
                      <li>
                        <a href={s.url} rel="noopener noreferrer">
                          {s.title}
                        </a>
                        <span class="meta"> — presse, {s.published ?? s.detected_at}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <span class="meta">—</span>
                )}
              </td>
              <td>{c.chiffrage_available ? 'oui' : '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="card">
    <h3>Croquis X 2027 — à partager</h3>
    <p class="meta">
      Croquis humoristiques style X (encre + aquarelle) pour accompagner la couverture du premier tour —
      légers sur les mécanismes, jamais sur les personnes.
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; margin-top: 0.5rem;">
      <img src="/illustrations/2027/meme-1er-tour-ne-ment-pas.jpg" alt="Croquis mème : Le 1er tour ne ment pas" style="width:100%; border-radius:6px;" loading="lazy" decoding="async" />
      <img src="/illustrations/2027/illustration-voix-egales.jpg" alt="Croquis : toutes les voix égales au 1er tour" style="width:100%; border-radius:6px;" loading="lazy" decoding="async" />
      <img src="/illustrations/2027/democracy-over-elimination.jpg" alt="Croquis : Democracy Over Elimination" style="width:100%; border-radius:6px;" loading="lazy" decoding="async" />
    </div>
    <p class="meta" style="margin-top:0.6rem;">
      <a href="/#visuels-2027">Voir tous les croquis &amp; l’animation sur l’accueil →</a>
    </p>
  </section>

  <section>
    <h3>Sources à surveiller</h3>
    <ul class="sources-list">
      {
        analysis.sources.map((source) => (
          <li>
            <a href={source.url} rel="noopener noreferrer">
              {source.label}
            </a>
            <span class="meta"> — {source.role}</span>
          </li>
        ))
      }
    </ul>
    <p class="meta">
      Voir aussi le <a href="/sources">catalogue open data</a> synchronisé et le journal{' '}
      <a href="/sources#mises-a-jour">mises à jour</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem 1rem;
    margin: 1rem 0;
    font-family: system-ui, sans-serif;
  }
  .fact-grid dt {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }
  .fact-grid dd {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .veille-list {
    margin: 0;
    padding-left: 1.25rem;
  }
  .veille-list li + li {
    margin-top: 0.65rem;
  }
  .renifleur-list {
    margin: 0;
    padding-left: 1.25rem;
  }
  .renifleur-list li + li {
    margin-top: 0.55rem;
  }
  .party-logo-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .party-logo {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    object-fit: cover;
    border: 1px solid var(--border, #ddd);
    background: var(--bg, #fff);
  }
  .candidatures-table {
    width: 100%;
    border-collapse: collapse;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  .candidatures-table th,
  .candidatures-table td {
    border: 1px solid var(--border, #ddd);
    padding: 0.45rem 0.55rem;
    text-align: left;
    vertical-align: top;
  }
  .candidatures-table th {
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }
  .milestones {
    margin: 0;
    padding-left: 1.25rem;
  }
  .milestones li + li {
    margin-top: 0.65rem;
  }
  .sources-list {
    padding-left: 1.25rem;
  }
  .sources-list li + li {
    margin-top: 0.5rem;
  }
  h4 {
    font-size: 0.95rem;
    margin: 1rem 0 0.35rem;
  }
  .press-signals {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
  }
  .press-signals li + li {
    margin-top: 0.35rem;
  }
</style>

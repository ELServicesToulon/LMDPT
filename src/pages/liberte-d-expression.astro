import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Liberté d’expression"
  description="Dossier LMDPT : pluralité de l’Assemblée du 1er tour, liberté d’expression et observatoire de la censure — conditions d’un débat public sourcé avant 2027."
  type="website"
  keywords="liberté d'expression, pluralité Assemblée, AN1T, observatoire de la censure, débat public, démocratie avant l’élimination, LMDPT"
  commentThread="liberte-d-expression"
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a> → Liberté d’expression
  </nav>

  <section class="liberte-hero" aria-labelledby="liberte-title">
    <p class="eyebrow">Rubrique prioritaire · débat public</p>
    <h1 id="liberte-title">Liberté d’expression</h1>
    <p class="lead">
      Sans <strong>pluralité des voix</strong> à l’Assemblée et sans conditions d’expression
      sourcées, le miroir du premier tour se brouille. Cette rubrique regroupe les pages utiles —
      ligne <em>La démocratie avant l’élimination</em>, synthèse documentaire, pas d’avis juridique.
    </p>
    <p class="meta disclaimer-box">
      Contenu informatif civique — à vérifier sur Légifrance, EUR-Lex, Arcom et les décisions
      officielles. LMDPT ne délivre pas de conseil juridique.
    </p>
  </section>

  <nav class="liberte-jump" aria-label="Sommaire de la rubrique">
    <a href="#pilier-1">1 · Pluralité de l’Assemblée</a>
    <a href="#pilier-2">2 · Expression &amp; censure</a>
    <a href="#suite">Suite du dossier</a>
  </nav>

  <!-- ========== PILIER 1 ========== -->
  <section class="card liberte-pilier liberte-pilier--1" id="pilier-1" aria-labelledby="p1-title">
    <p class="pilier-num" aria-hidden="true">1</p>
    <div class="pilier-body">
      <h2 id="p1-title">Pluralité de l’Assemblée</h2>
      <p>
        Le premier tour est le moment où la France vote <strong>pour</strong> des idées, avant les
        logiques d’élimination du second tour. L’Assemblée du Premier Tour (AN1T) rend visible
        cette pluralité en sièges — pédagogique, données ouvertes, sans « favori ».
      </p>
      <ul class="liberte-links">
        <li>
          <a href="/analyses/assemblee-premier-tour"
            ><strong>Simuler l’AN1T</strong> — 577 sièges calés sur le 1er tour</a
          >
        </li>
        <li>
          <a href="/analyses/assemblee-premier-tour-mecanismes"
            ><strong>Mécanismes</strong> — comment une Assemblée du 1er tour peut se penser</a
          >
        </li>
        <li>
          <a href="/analyses/gouvernance-an1t-droit"
            ><strong>Droit &amp; gouvernance</strong> — cadre documentaire AN1T</a
          >
        </li>
        <li>
          <a href="/debats/assemblee-premier-tour"
            ><strong>Débat</strong> — positions à égalité sur l’Assemblée du 1er tour</a
          >
        </li>
        <li>
          <a href="/debats/vote-utile-pluralite"
            ><strong>Vote utile vs pluralité</strong> — débat civique sourcé</a
          >
        </li>
        <li>
          <a href="/atlas"><strong>Atlas électoral</strong> — cartes en données ouvertes du 1er tour</a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ========== PILIER 2 ========== -->
  <section class="card liberte-pilier liberte-pilier--2" id="pilier-2" aria-labelledby="p2-title">
    <p class="pilier-num" aria-hidden="true">2</p>
    <div class="pilier-body">
      <h2 id="p2-title">Liberté d’expression &amp; observatoire de la censure</h2>
      <p>
        Documenter les textes et projets (France / UE) qui encadrent le débat public, et les
        cas sourcés où médias ou comptes ont été fermés, suspendus ou sanctionnés depuis 2017 —
        motif <strong>officiel</strong> vs lecture <strong>secondaire</strong>, badges politiques
        pédagogiques.
      </p>

      <div class="liberte-duo">
        <article class="liberte-subcard">
          <h3>Liberté d’expression — alerte citoyenne</h3>
          <p>
            Tour d’horizon documenté des points cités comme touchant à la liberté d’expression
            et au débat politique avant le premier tour 2027.
          </p>
          <ul class="liberte-links compact">
            <li>Points France et Union européenne, statut de vérification</li>
            <li>Signal de départ + sources de recoupement</li>
            <li>Angle LMDPT : faits sourcés, pas de moralisation partisane</li>
          </ul>
          <p class="cta-row">
            <a class="btn-primary-link" href="/analyses/alerte-citoyenne"
              >Ouvrir l’alerte citoyenne →</a
            >
          </p>
        </article>

        <article class="liberte-subcard liberte-subcard--emphasis">
          <h3>Observatoire de la censure (depuis 2017)</h3>
          <p>
            Cas documentés de médias et gros comptes touchés par fermetures, suspensions,
            non-renouvellements, sanctions ou restrictions plateformes — motifs officiel /
            officieux, badges.
          </p>
          <p class="cta-row">
            <a class="btn-primary-link" href="/observatoire-censure/"
              >Ouvrir l’observatoire de la censure →</a
            >
          </p>
        </article>

        <article class="liberte-subcard liberte-subcard--emphasis">
          <h3>Assemblée des influenceurs</h3>
          <p>
            Hémicycle fictif pédagogique : chaque siège = un influenceur, teinte politique
            déclarée (plein) ou estimée (pointillé), description, liens et dépendances
            économiques sourcées — pas un score moral.
          </p>
          <p class="cta-row">
            <a class="btn-primary-link" href="/assemblee-influenceurs/"
              >Ouvrir l’assemblée des influenceurs →</a
            >
          </p>
        </article>

        <article class="liberte-subcard">
          <h3>Temps de parole — équité d’exposition</h3>
          <p>
            Indices en données ouvertes Arcom : part de temps de parole vs étalon (égalité 1/n, puis
            sondages en dénominateur pour 2027). Sur/sous-exposition documentée — pas de
            prédiction.
          </p>
          <p class="cta-row">
            <a class="btn-primary-link" href="/analyses/temps-parole-equite"
              >Voir les indices →</a
            >
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ========== Suite ========== -->
  <section class="card" id="suite" aria-labelledby="suite-title">
    <h2 id="suite-title">Suite du dossier</h2>
    <ul class="liberte-links">
      <li>
        <a href="/analyses/alerte-citoyenne">Alerte citoyenne</a> — dossier liberté d’expression /
        débat public
      </li>
      <li>
        <a href="/observatoire-censure/">Observatoire de la censure</a> — médias &amp; comptes depuis
        2017
      </li>
      <li>
        <a href="/assemblee-influenceurs/">Assemblée des influenceurs</a> — hémicycle pédagogique
        (déclaré / estimé)
      </li>
      <li>
        <a href="/analyses/temps-parole-equite">Temps de parole — équité</a> — indices Arcom open
        data
      </li>
      <li>
        <a href="/debats">Débats</a> — questions civiques, positions à égalité
      </li>
      <li>
        <a href="/charte">Charte</a> — zéro biais, modération, démocratie avant l’élimination
      </li>
      <li>
        <a href="/sources">Sources</a> — données ouvertes et références institutionnelles
      </li>
      <li>
        <a href="/contribuer">Contribuer</a> — suggestions &amp; alertes citoyennes sourcées
      </li>
    </ul>
  </section>

  <section class="card" aria-labelledby="garde-title">
    <h2 id="garde-title">Garde-fous</h2>
    <ul>
      <li>Pas de soutien partisan déguisé en « défense de la liberté ».</li>
      <li>Les textes juridiques sont cités avec lien ; la synthèse reste documentaire.</li>
      <li>
        Haine et appels à la violence : hors charte — voir <a href="/charte">/charte</a>.
      </li>
      <li>
        Ne jamais confondre mesure d’autorité publique (Arcom, justice, UE) et modération privée
        de plateforme.
      </li>
    </ul>
  </section>

  <!-- CTA monétisation éthique (après le fond) — rail don, pas paywall -->
  <section class="card liberte-soutenir" aria-labelledby="soutenir-title">
    <h2 id="soutenir-title">Soutenir ce travail</h2>
    <p>
      Si ce dossier (pluralité, liberté d’expression, observatoire) vous est utile : vous pouvez
      soutenir LMDPT. Indépendance éditoriale · pas de favori · pas de classement éliminatoire.
    </p>
    <p class="cta-row">
      <a class="btn-primary-link" href="/soutenir?utm_source=site&utm_medium=hub&utm_campaign=soutenir_liberte"
        >Soutenir LMDPT →</a
      >
      {' · '}
      <a href="/pack-data-an1t">Lot de données AN1T (gratuit)</a>
    </p>
  </section>
</BaseLayout>


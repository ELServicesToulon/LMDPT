---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mon compte"
  description="Compte lecteur LMDPT — pseudonyme, providers liés, déconnexion."
  noindex={true}
>
  <section>
    <p class="eyebrow">Espace lecteur</p>
    <h1>Mon compte</h1>
    <p class="lead meta" id="compte-loading">Chargement de la session…</p>
  </section>

  <section class="card" id="compte-guest" hidden>
    <p>Vous n’êtes pas connecté.</p>
    <h2 class="compte-oauth-title">Continuer avec</h2>
    <div class="auth-providers" id="compte-auth-providers">
      <a
        class="btn btn-primary auth-btn"
        href="/api/auth/start/google?next=%2Fcompte"
        data-provider="google"
      >
        Google
      </a>
      <a
        class="btn btn-primary auth-btn"
        href="/api/auth/start/x?next=%2Fcompte"
        data-provider="x"
      >
        X
      </a>
    </div>
    <p class="meta" id="compte-providers-status" role="status">Vérification des providers…</p>
    <p class="meta">
      <a href="/connexion?next=/compte">Email ou autres options</a>
    </p>
  </section>

  <section class="card" id="compte-user" hidden>
    <h2>Profil affiché</h2>
    <p>
      <strong id="user-name">—</strong>
      <span class="meta" id="user-id"></span>
    </p>
    <p class="meta">
      Providers liés : <span id="user-providers">—</span>
    </p>
    <p class="meta">
      L’email n’est jamais publié. La teinte politique s’applique aux <em>messages</em>, pas à votre
      identité de compte.
    </p>
    <form id="profile-form">
      <label>
        <span class="meta">Pseudonyme par défaut</span>
        <input type="text" name="displayName" maxlength="40" autocomplete="nickname" />
      </label>
      <button type="submit" class="btn btn-primary">Enregistrer</button>
      <p class="meta" id="profile-status" role="status"></p>
    </form>
    <hr />
    <button type="button" class="btn btn-secondary" id="logout-btn">Se déconnecter</button>
  </section>
</BaseLayout>

<script>
  (async () => {
    const loading = document.getElementById('compte-loading');
    const guest = document.getElementById('compte-guest');
    const userBox = document.getElementById('compte-user');
    const providersStatus = document.getElementById('compte-providers-status');

    async function refreshProviders() {
      try {
        const res = await fetch('/api/auth/providers', { credentials: 'include' });
        const data = await res.json();
        const map = Object.fromEntries((data.providers || []).map((p: { id: string; enabled: boolean }) => [p.id, p.enabled]));
        document.querySelectorAll<HTMLAnchorElement>('#compte-auth-providers [data-provider]').forEach((a) => {
          const id = a.dataset.provider!;
          if (!map[id]) {
            a.classList.add('is-disabled');
            a.setAttribute('aria-disabled', 'true');
            a.href = '#';
            a.title = 'Provider non configuré (secrets manquants)';
          }
        });
        if (providersStatus) {
          providersStatus.textContent = data.authEnabled
            ? 'Google et X renvoient vers /compte après autorisation.'
            : 'Auth serveur encore désactivée (LMDPT_AUTH_ENABLED).';
        }
      } catch {
        if (providersStatus) providersStatus.textContent = 'Impossible de joindre l’API auth.';
      }
    }

    async function refresh() {
      const res = await fetch('/api/auth/me', { credentials: 'include' });
      const data = await res.json();
      if (loading) loading.hidden = true;
      if (!data.authenticated || !data.user) {
        guest!.hidden = false;
        userBox!.hidden = true;
        await refreshProviders();
        return;
      }
      guest!.hidden = true;
      userBox!.hidden = false;
      document.getElementById('user-name')!.textContent = data.user.displayName || 'Citoyen·ne';
      document.getElementById('user-id')!.textContent = `(${data.user.id})`;
      document.getElementById('user-providers')!.textContent = (data.user.providers || []).join(', ') || '—';
      const input = document.querySelector('#profile-form input[name="displayName"]') as HTMLInputElement;
      if (input) input.value = data.user.displayName || '';
    }

    try {
      await refresh();
    } catch {
      if (loading) loading.textContent = 'API auth indisponible.';
    }

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
      location.href = '/';
    });

    document.getElementById('profile-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('profile-status');
      const fd = new FormData(e.target as HTMLFormElement);
      try {
        const res = await fetch('/api/auth/profile', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ displayName: String(fd.get('displayName') || '') }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Échec');
        if (status) status.textContent = 'Enregistré.';
        await refresh();
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Erreur';
        if (status) status.textContent = message;
      }
    });
  })();
</script>

<style>
  .compte-oauth-title {
    font-size: 1.05rem;
    margin: 0.85rem 0 0.35rem;
  }
  .auth-providers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0.75rem 0;
  }
  .auth-btn.is-disabled {
    opacity: 0.45;
    pointer-events: none;
  }
  #profile-form label {
    display: block;
    margin: 0.75rem 0;
  }
  #profile-form input {
    width: 100%;
    max-width: 20rem;
    padding: 0.45rem 0.6rem;
    font: inherit;
  }
</style>

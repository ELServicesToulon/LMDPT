---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DualAssembleeCompare from '../../components/DualAssembleeCompare.astro';
import StickyToc from '../../components/StickyToc.astro';
import { ELECTION_CATALOG } from '../../lib/elections';
import { listScrutinDuals } from '../../lib/scrutin-dual';

const duals = listScrutinDuals();
const tocItems = [
  { href: '#scrutins', label: 'Liste des scrutins' },
  ...duals.map((d) => ({ href: `#${d.slug}`, label: d.title })),
  { href: '/sources#methodologie-blocs', label: 'Méthodo : nuances → blocs' },
];
---

<BaseLayout
  title="Atlas"
  description="Écart visible : pluralité du 1er tour vs résultat réel — atlas open data pour chaque scrutin."
>
  <section>
    <h2>Atlas : ce que le 1er tour montre (et ce que le second compressé)</h2>
    <p class="lead">
      <strong>Même urne, deux Assemblées.</strong> Pour chaque présidentielle : sièges calés sur le
      <strong>1er tour</strong> (Sainte-Laguë) vs Assemblée réelle des
      <strong>législatives qui ont suivi</strong>. Tableau Δ sièges — sans ranking.
    </p>
    <p class="meta">
      Documenter le 1er tour, pas le transformer en classement. Illustration pédagogique, pas de prédiction.
      {' · '}
      Agrégation nuances → blocs :
      <a href="/sources#methodologie-blocs">méthodologie</a>.
    </p>
  </section>

  <StickyToc title="Sommaire Atlas" items={tocItems} />

  <section id="scrutins">
    <h3>Scrutins</h3>
    <ul class="election-list">
      {
        ELECTION_CATALOG.map((e) => (
          <li class="card">
            <h4>
              <a href={`/atlas/${e.slug}`}>{e.title}</a>
            </h4>
            <p class="meta">
              <time datetime={e.date}>
                {new Date(e.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
              </time>
              {' '}· tour {e.tour}
            </p>
            {e.distorsion_note && <p class="meta distorsion">{e.distorsion_note}</p>}
          </li>
        ))
      }
    </ul>
  </section>

  {
    duals.map((dual) => (
      <section class="scrutin-block" id={dual.slug} aria-labelledby={`h-${dual.slug}`}>
        <h3 id={`h-${dual.slug}`}>
          <a href={`/atlas/${dual.slug}`}>{dual.title}</a>
        </h3>
        {dual.distorsionNote && <p class="meta">{dual.distorsionNote}</p>}
        <DualAssembleeCompare
          firstRoundAlloc={dual.firstRound}
          realAlloc={dual.real}
          totalSeats={dual.totalSeats}
          t1Label={dual.t1Label}
          t2Label={dual.realLabel}
          firstRoundTitle={dual.firstRoundTitle}
          realTitle={dual.realTitle}
          firstRoundMeta={dual.firstRoundMeta}
          realMeta={dual.realMeta}
          realPending={dual.realPending}
          differential={dual.differential}
        />
      </section>
    ))
  }
</BaseLayout>

<style>
  .lead {
    max-width: 52rem;
    line-height: 1.55;
    font-size: 1.05rem;
  }
  .election-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.75rem;
  }
  .election-list h4 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
  .distorsion {
    margin-top: 0.35rem;
    font-size: 0.9rem;
  }
  .scrutin-block {
    margin: 1.75rem 0 2rem;
  }
  .scrutin-block h3 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }
  .fil-directeur-tag {
    font-size: 0.95rem;
    line-height: 1.45;
  }
</style>

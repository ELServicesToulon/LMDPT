---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ELECTION_CATALOG } from '../../lib/elections';
---

<BaseLayout
  title="Atlas"
  description="Atlas des premiers tours — résultats officiels, pluralité et distorsions documentées."
>
  <section>
    <h2>Atlas des premiers tours : découvrez la vraie France (Orgueil &amp; Sécurité)</h2>
    <p>
      <strong>Sécurité</strong> : résultats officiels, faits sourcés, sans filtre ni manipulation.<br />
      <strong>Nouveauté</strong> : la photographie la plus proche de la pluralité des préférences — avant les désistements et le "vote contre".<br />
      <strong>Orgueil &amp; Sympathie</strong> : comprenez comment chaque voix compte vraiment, pour une démocratie où l'on vote <em>pour</em>, pas contre. Explorez sans classement éliminatoire (Confort).
    </p>
    <p class="meta">
      <strong>Principe de base</strong> : On expose des idées, pas des idéologies. Aucun signe religieux ostentatoire, aucune autorité religieuse, aucune idéologie autoritaire ou religieuse. Blocage immédiat. (Sauf live YouTube)
    </p>
  </section>

  <section>
    <h3>Élections disponibles</h3>
    <ul class="election-list">
      {
        ELECTION_CATALOG.map((e) => (
          <li class="card">
            <h4>
              <a href={`/atlas/${e.slug}`}>{e.title}</a>
            </h4>
            <p class="meta">
              <time datetime={e.date}>
                {new Date(e.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
              </time>
              {' '}· tour {e.tour}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="meta">
      Législatives 2024 : tableau des 577 circonscriptions avec filtre département.
    </p>
  </section>
</BaseLayout>

<style>
  .election-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .election-list h4 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
</style>

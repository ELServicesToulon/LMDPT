---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ELECTION_CATALOG } from '../../lib/elections';
---

<BaseLayout
  title="Atlas"
  description="Atlas des premiers tours — résultats officiels, pluralité et distorsions documentées."
>
  <section>
    <h2>Atlas des premiers tours : la photographie officielle du vote</h2>
    <p>
      Résultats officiels, faits sourcés, sans filtre. La photographie la plus proche de la pluralité des préférences — avant les désistements et le « vote contre ».
      Explorez sans classement éliminatoire : chaque voix compte pour une démocratie où l’on vote <em>pour</em>, pas contre.
    </p>
    <p class="meta">
      Ligne éditoriale : Democracy Over Elimination — documenter le 1er tour, pas le transformer en ranking.
    </p>
  </section>

  <section>
    <h3>Élections disponibles</h3>
    <ul class="election-list">
      {
        ELECTION_CATALOG.map((e) => (
          <li class="card">
            <h4>
              <a href={`/atlas/${e.slug}`}>{e.title}</a>
            </h4>
            <p class="meta">
              <time datetime={e.date}>
                {new Date(e.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
              </time>
              {' '}· tour {e.tour}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="meta">
      Législatives 2024 : tableau des 577 circonscriptions avec filtre département.
    </p>
  </section>
</BaseLayout>

<style>
  .election-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .election-list h4 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DepartmentLeaderGrid from '../../components/DepartmentLeaderGrid.astro';
import NationalSummary from '../../components/NationalSummary.astro';
import ResultsBarChart from '../../components/ResultsBarChart.astro';
import { getElection } from '../../lib/elections';
import { getDepartmentResults } from '../../lib/departments';

const slug = '2022-presidentielle';
const dataset = getElection(slug);
const deptData = getDepartmentResults(slug);

if (!dataset) {
  throw new Error(`Dataset manquant : ${slug}`);
}

const dateLabel = new Date(dataset.date).toLocaleDateString('fr-FR', { dateStyle: 'long' });
---

<BaseLayout
  title="Présidentielle 2022 — 1er tour"
  description="Résultats officiels du premier tour de la présidentielle 2022 — pluralité nationale documentée."
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/atlas">Atlas</a> → Présidentielle 2022
  </nav>

  <section>
    <h2>{dataset.election}</h2>
    <p class="meta">
      <time datetime={dataset.date}>{dateLabel}</time> · Source :{' '}
      <a href={dataset.source} rel="noopener noreferrer">{dataset.source_label}</a>
    </p>
    <p>
      Douze candidats au premier tour : la tripolarisation Macron / Le Pen / Mélenchon capte
      <strong>72,95 %</strong> des suffrages exprimés, mais la pluralité des voix reste visible
      sur l’ensemble du spectre — ce que le second tour ne reflète plus.
    </p>
  </section>

  <section class="card">
    <h3>Participation</h3>
    <NationalSummary national={dataset.national} />
  </section>

  <ResultsBarChart candidats={dataset.national.candidats} />

  {deptData && <DepartmentLeaderGrid departements={deptData.departements} />}

  <section class="card">
    <h3>Premier tour vs second tour</h3>
    <p>
      Au second tour (24 avril 2022), seuls Emmanuel Macron (58,55 %) et Marine Le Pen (41,45 %)
      restaient en lice. Les <strong>21,95 %</strong> de Jean-Luc Mélenchon et les autres voix
      du premier tour ne sont plus représentés dans ce duel binaire — illustration typique de la
      distorsion induite par le scrutin à deux tours et le vote stratégique.
    </p>
    <p class="meta">
      Chiffres second tour : résultats officiels Ministère de l'Intérieur. Analyse pédagogique,
      pas de prédiction ni de moralisation du vote tactique.
    </p>
  </section>

  <section>
    <h3>Méthodologie</h3>
    <ul>
      <li>Données nationales agrégées depuis les résultats définitifs officiels.</li>
      <li>Pourcentages des exprimés et des inscrits recalculés à partir des totaux publiés.</li>
      <li>Téléchargement des jeux bruts : page <a href="/sources">Sources</a>.</li>
    </ul>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsFeed from '../components/NewsFeed.astro';
import renifleur from '../data/renifleur/latest.json';
import type { RenifleurSnapshot } from '../lib/renifleur';

const feed = renifleur as RenifleurSnapshot;
---

<BaseLayout
  title="Accueil"
  description="Le premier tour : le miroir le plus fidèle de la France politique. Média civique, faits sourcés, Democracy Over Elimination."
>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Democracy Over Elimination</p>
      <h2>Le premier tour, miroir de la pluralité</h2>
      <p class="lead">
        Documenter exhaustivement les résultats du <strong>premier tour</strong> — là où s'exprime
        le plus fidèlement la diversité des préférences — et rendre visible la distorsion induite
        par les désistements et le vote stratégique au second tour.
      </p>
      <p class="cta-row">
        <a class="btn" href="/atlas">Explorer l'Atlas</a>
        <a class="btn btn-secondary" href="/debats">Débats ouverts</a>
        <a class="btn btn-secondary" href="/analyses/presidentielle-2027-preparation">Présidentielle 2027</a>
      </p>
    </div>
  </section>

  {
    feed.enabled && feed.items.length > 0 && (
      <NewsFeed
        items={feed.items}
        limit={6}
        disclaimer={feed.disclaimer}
        fetchedAt={feed.fetched_at}
        feedsOk={feed.feeds_ok}
      />
    )
  }

  <section class="card highlight-card">
    <p class="eyebrow">Dossier à la une</p>
    <h3>
      <a href="/analyses/presidentielle-2027-preparation">Présidentielle 2027 — veille & calendrier</a>
    </h3>
    <p>
      Arrêt d'appel du 7 juillet dans l'affaire des assistants européens du FN, inéligibilité,
      candidature 2027 : nous documentons les faits sourcés — sans prédiction ni tier list.
    </p>
    <p class="meta">
      <a href="/analyses/presidentielle-2027-preparation">Lire le dossier →</a>
    </p>
  </section>

  <section class="card">
    <h3>Pourquoi ce média ?</h3>
    <p>
      Au premier tour, un citoyen peut voter pour un programme proche de ses convictions.
      Au second tour, il vote souvent <em>contre</em> — pour barrer un camp plutôt que pour adhérer.
      Cet « esprit éliminer » fausse la représentation nationale que le premier tour capture le mieux.
    </p>
    <p class="meta">
      Nous ne moralisons pas le vote tactique : nous le <strong>documentons</strong>, avec des données
      officielles, pour que chacun choisisse en connaissance de cause.
    </p>
  </section>

  <section class="content-section">
    <h3 class="section-title">Débats ouverts</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/debats/assemblee-premier-tour">Faut-il une chambre élue sur le seul premier tour ?</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>
            Simulation 2024 : hémicycle virtuel AN1T vs Assemblée réelle — carte et comparatif chiffré.
          </p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3>
            <a href="/debats/vote-utile-pluralite">Le vote utile respecte-t-il la pluralité démocratique ?</a>
          </h3>
          <p>
            Positions sourcées des deux côtés — discussion modérée sur GitHub. Pas de classement
            éliminatoire.
          </p>
          <p class="meta">
            <a href="/debats">Voir tous les débats →</a>
          </p>
        </article>
      </li>
    </ul>
  </section>

  <section class="content-section">
    <h3 class="section-title">Atlas & analyses</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/analyses/assemblee-premier-tour">Assemblée du premier tour — simulation 2024</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>Hémicycle virtuel AN1T (577 sièges) vs Assemblée élue — comparatif chiffré.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2024-legislatives">Législatives 2024 — 1er tour</a></h3>
          <p>RN 29,26 % · UG 27,99 % · ENS 20,04 % — 577 circonscriptions, data.gouv.fr.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/presidentielle-distorsion">Distorsion 1er / 2nd tour</a></h3>
          <p>Pluralité au premier tour, duel binaire au second — 2017 et 2022.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/legislatives-2024-desistements">Législatives 2024 — désistements</a></h3>
          <p>306 triangulaires potentielles → 89 après 215 désistements officiels.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2022-presidentielle">Présidentielle 2022 — 1er tour</a></h3>
          <p>Macron 27,85 % · Le Pen 23,15 % · Mélenchon 21,95 %.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2017-presidentielle">Présidentielle 2017 — 1er tour</a></h3>
          <p>Macron 24,01 % · Le Pen 21,30 % · quadruple polarisation.</p>
        </article>
      </li>
    </ul>
  </section>

  <section class="card principles">
    <h3>Notre ligne</h3>
    <ul>
      <li>Sources officielles traçables (<a href="/sources">data.gouv.fr</a>)</li>
      <li>Comparaisons factuelles, sans classement éliminatoire</li>
      <li>Revue éditoriale humaine avant publication automatique</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    margin: -0.25rem -1rem 2rem;
    padding: 2rem 1rem 2.25rem;
    background: linear-gradient(
      165deg,
      color-mix(in srgb, var(--accent) 14%, var(--bg)) 0%,
      var(--bg) 55%
    );
    border-bottom: 1px solid var(--border);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }
  .hero-inner {
    max-width: 42rem;
  }
  .hero h2 {
    font-size: clamp(1.55rem, 4vw, 2rem);
    margin: 0 0 1rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .lead {
    font-size: 1.05rem;
    margin: 0 0 1.35rem;
    max-width: 38rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0;
  }
  .highlight-card h3 {
    margin: 0.35rem 0 0.65rem;
    font-size: 1.15rem;
  }
  .highlight-card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .highlight-card h3 a:hover {
    color: var(--accent);
  }
  .content-section {
    margin-bottom: 2rem;
  }
  .principles ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
</style>
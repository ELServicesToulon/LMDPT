---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsFeed from '../components/NewsFeed.astro';
import renifleur from '../data/renifleur/latest.json';
import type { RenifleurSnapshot } from '../lib/renifleur';
import candidaturesDeclarees from '../data/elections/2027-candidatures-declarees.json';
import { partyLogoForAffiliation, partyLogoSrc } from '../lib/party-logos';

const feed = renifleur as RenifleurSnapshot;

type CandidatureEntry = (typeof candidaturesDeclarees.entries)[number];

const statusDeclareLabels: Record<string, string> = {
  candidature_declaree: 'Candidature déclarée',
  designe_parti: 'Désigné par le parti',
  conditionnelle: 'Sous condition',
  primaire: 'Primaire (pas ticket final)',
  retrait: 'Retrait documenté',
  substitution_parti: 'Substitution de parti (non ticket principal)',
};

const categoryOrder = ['declarees', 'parti_designe', 'conditionnelle', 'retrait'] as const;

const declaredUpdated = new Date(candidaturesDeclarees.updated).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});

const declaredByCategory = categoryOrder
  .map((id) => {
    const meta = candidaturesDeclarees.categories.find((c) => c.id === id);
    const entries = candidaturesDeclarees.entries
      .filter((e: CandidatureEntry) => e.category === id)
      .sort((a: CandidatureEntry, b: CandidatureEntry) => a.name.localeCompare(b.name, 'fr'));
    return { id, meta, entries };
  })
  .filter((g) => g.entries.length > 0);

const countDeclarees = candidaturesDeclarees.entries.filter(
  (e) => e.category === 'declarees' || e.category === 'parti_designe',
).length;
---

<BaseLayout
  title="Accueil"
  description="Le premier tour : le miroir le plus fidèle de la France politique. Média civique, faits sourcés, Democracy Over Elimination."
>
  <!-- Manifeste — en tête de page -->
  <section class="why-media" id="pourquoi-ce-media" aria-labelledby="why-media-title">
    <h2 id="why-media-title">Pourquoi ce média ?</h2>
    <p class="why-media-lead">
      Au premier tour, chaque voix exprime des convictions. Le second tour « contre » efface une partie de cette pluralité.
      Nous documentons les faits du 1er tour pour choisir en connaissance de cause.
    </p>
    <p class="why-media-tagline">
      Faits officiels • Sans filtre • Pour une démocratie où l’on vote <strong>pour</strong>, pas contre.
    </p>
  </section>

  <!-- HERO REDESIGN (WCAG 2.2 AA, neutral, professional dark-leaning contrast) -->
  <section class="hero">
    <!-- Badge discret -->
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <span>Focus Présidentielle 2027</span>
      <span class="sep">•</span>
      <strong>Idées, pas idéologies</strong>
    </div>

    <div class="hero-grid">
      <!-- Visual (now using premium inclusive illustration) 
           RÈGLE SITE-WIDE : Ce principe d'aucun signe religieux ostentatoire est valable pour l'intégralité du site 
           (photos, illustrations, mèmes, vidéos, textes, UI). Tenues neutres uniquement.
      -->
      <div class="hero-visual">
        <img 
          src="/illustrations/2027/hero-premier-tour-2027.jpg" 
          alt="Citoyens divers (tous âges et origines) en tenues quotidiennes neutres, déposant leur bulletin dans une urne transparente dans un bureau de vote français. Illustration civique professionnelle et inclusive pour l'élection présidentielle 2027."
          class="hero-img"
        />
      </div>

      <!-- Texte + CTAs -->
      <div class="hero-inner">
        <h1 class="hero-title">Le premier tour 2027 : préparez-vous avec les faits</h1>

        <p class="hero-lead">
          Données officielles. Pluralité réelle.<br>
          <strong>Faits sourcés</strong> — rien d’autre.
        </p>

        <div class="cta-row">
          <a class="btn btn-primary" href="/analyses/presidentielle-2027-preparation">Dossier complet 2027 →</a>
          <a class="btn btn-secondary" href="/analyses/presidentielle-2027-preparation#calendrier">Calendrier officiel</a>
          <a class="btn btn-secondary" href="/analyses/assemblee-premier-tour">Simulation interactive</a>
        </div>

        <p class="meta">1er tour : 18 avril 2027 • 2e tour : 2 mai 2027 • Données open data • 100 % transparent</p>
      </div>
    </div>

    <!-- 3 cartes utiles (remplace les éléments vides / invisibles) -->
    <!-- Accessibilité : liens clairs, icônes décoratives, contraste élevé -->
    <div class="hero-cards">
      <a href="/analyses/presidentielle-2027-preparation#calendrier" class="hero-card">
        <div class="card-icon">📅</div>
        <div>
          <div class="card-title">Calendrier officiel &amp; dates clés 2027</div>
          <div class="card-desc">Inscriptions, campagnes, Conseil constitutionnel</div>
        </div>
      </a>
      <a href="/analyses/assemblee-premier-tour" class="hero-card">
        <div class="card-icon">📊</div>
        <div>
          <div class="card-title">Explorer les données open data &amp; simulations</div>
          <div class="card-desc">Atlas, projections 1er tour, hémicycle AN1T</div>
        </div>
      </a>
      <a href="/analyses/presidentielle-2027-preparation" class="hero-card">
        <div class="card-icon">📄</div>
        <div>
          <div class="card-title">Dossier complet PDF (à venir)</div>
          <div class="card-desc">Synthèse programmes + sources officielles</div>
        </div>
      </a>
    </div>
  </section>

  {
    feed.enabled && feed.items.length > 0 && (
      <NewsFeed
        items={feed.items}
        limit={6}
        disclaimer={feed.disclaimer}
        fetchedAt={feed.fetched_at}
        feedsOk={feed.feeds_ok}
      />
    )
  }

  <section class="card highlight-card">
    <p class="eyebrow">Focus 2027 — Principal</p>
    <h3>
      <a href="/analyses/presidentielle-2027-preparation">Présidentielle 2027 : calendrier officiel & veille</a>
    </h3>
    <p>
      1er tour le <strong>18 avril 2027</strong>. Calendrier validé, candidatures en cours, programmes partiels intégrés (Attal, Bardella, Le Pen, Mélenchon, PS...).
    </p>
    <p class="meta">
      <a href="/analyses/presidentielle-2027-preparation">Lire le dossier complet 2027 →</a> · 
      <a href="/analyses/programmes/presidentielle-2027">Comparer les programmes →</a>
    </p>
  </section>

  <!-- Liste des candidatures déclarées (pas liste Conseil constitutionnel) -->
  <section class="card declared-board" id="candidatures-declarees-2027" aria-labelledby="declared-2027-title">
    <p class="eyebrow">Présidentielle 2027 — pluralité documentée</p>
    <h3 id="declared-2027-title">{candidaturesDeclarees.title}</h3>
    <p class="declared-disclaimer">{candidaturesDeclarees.disclaimer}</p>
    <p class="meta">
      <strong>{countDeclarees}</strong> candidatures déclarées / désignées en lice
      · {candidaturesDeclarees.entries.length} entrées au total (y compris conditionnelles &amp; retraits)
      · Mise à jour <time datetime={candidaturesDeclarees.updated}>{declaredUpdated}</time>
    </p>
    <p class="meta declared-legal">{candidaturesDeclarees.legal_note}</p>

    {
      declaredByCategory.map((group) => (
        <div class="declared-group">
          <h4 class="declared-group-title">
            {group.meta?.label ?? group.id}
            <span class="declared-count">{group.entries.length}</span>
          </h4>
          {group.meta?.description && <p class="meta declared-group-desc">{group.meta.description}</p>}
          <div class="declared-table-wrap" role="region" aria-label={group.meta?.label ?? group.id} tabindex="0">
            <table class="declared-table">
              <thead>
                <tr>
                  <th scope="col">Nom</th>
                  <th scope="col">Affiliation</th>
                  <th scope="col">Statut</th>
                  <th scope="col">Depuis</th>
                  <th scope="col">Source</th>
                </tr>
              </thead>
              <tbody>
                {group.entries.map((c: CandidatureEntry) => {
                  const party = partyLogoForAffiliation(c.affiliation);
                  return (
                    <tr class:list={[{ 'declared-row--retrait': c.category === 'retrait' }]}>
                      <td>
                        <strong>{c.name}</strong>
                        {c.note && <p class="poll-note">{c.note}</p>}
                      </td>
                      <td class="poll-aff">
                        <span class="party-logo-row">
                          <img
                            class="party-logo"
                            src={partyLogoSrc(party)}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="party-logo-label">{c.affiliation}</span>
                        </span>
                      </td>
                      <td>
                        <span class="poll-tag">{statusDeclareLabels[c.status] ?? c.status}</span>
                      </td>
                      <td class="declared-date">
                        <time datetime={c.declared_at}>{c.declared_at}</time>
                      </td>
                      <td class="poll-src">
                        <a href={c.source_url} rel="noopener noreferrer">
                          {c.source_label}
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }

    <p class="meta" style="margin-top:1rem;">
      Sources :{' '}
      {candidaturesDeclarees.sources.map((s, i) => (
        <>
          {i > 0 && ' · '}
          <a href={s.url} rel="noopener noreferrer">
            {s.label}
          </a>
        </>
      ))}
      {' · '}
      <a href="/analyses/presidentielle-2027-preparation">Dossier 2027</a>
      {' · '}
      <a href="/analyses/programmes/presidentielle-2027">Programmes</a>
    </p>
  </section>

  <!-- Parcours utilisateur clair pour préparation 2027 -->
  <section class="card" aria-labelledby="parcours-2027">
    <h3 id="parcours-2027">Parcours recommandé pour se préparer au 1er tour</h3>
    <ol style="margin:0.5rem 0 0; padding-left:1.3rem; font-size:0.95rem; line-height:1.6;">
      <li><a href="/analyses/presidentielle-2027-preparation#calendrier">Consultez le calendrier officiel</a></li>
      <li><a href="/analyses/assemblee-premier-tour">Testez le simulateur interactif d’Assemblée (1er tour)</a> — ajustez % et comparez scénarios</li>
      <li><a href="/analyses/programmes-comparateur">Comparez les programmes des candidats</a></li>
      <li><a href="/atlas/2024-legislatives">Explorez l’Atlas et les 577 circonscriptions</a> (filtre + recherche)</li>
      <li><a href="/debats/assemblee-premier-tour">Participez au débat : une Assemblée sur le 1er tour ?</a></li>
    </ol>
    <p class="meta" style="margin-top:0.5rem;">Parcours accessible au clavier et mobile. Tout est pédagogique et sourcé.</p>
  </section>

  <section class="card">
    <p class="eyebrow">Outil clé 2027</p>
    <h3>
      <a href="/analyses/assemblee-premier-tour">Assemblée du Premier Tour 2027 — simulation interactive</a>
    </h3>
    <p>
      Hémicycle AN1T, projections de sièges à partir du 1er tour, scénarios et programmes candidats.
    </p>
    <p class="meta">
      <a href="/analyses/assemblee-premier-tour">Explorer la simulation 2027 →</a>
    </p>
  </section>

  <section class="content-section">
    <h3 class="section-title">Débats ouverts</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/debats/assemblee-premier-tour">Faut-il une chambre élue sur le seul premier tour ?</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>
            Simulation 2024 : hémicycle virtuel AN1T vs Assemblée réelle — carte et comparatif chiffré.
          </p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3>
            <a href="/debats/vote-utile-pluralite">Le vote utile respecte-t-il la pluralité démocratique ?</a>
          </h3>
          <p>
            Positions sourcées des deux côtés — discussion modérée sur GitHub. Pas de classement
            éliminatoire.
          </p>
          <p class="meta">
            <a href="/debats">Voir tous les débats →</a>
          </p>
        </article>
      </li>
    </ul>
  </section>

  <section class="content-section">
    <h3 class="section-title">Atlas & analyses</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/analyses/assemblee-premier-tour">Assemblée du premier tour — simulation 2024</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>Hémicycle virtuel AN1T (577 sièges) vs Assemblée élue — comparatif chiffré.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2024-legislatives">Législatives 2024 — 1er tour</a></h3>
          <p>RN 29,26 % · UG 27,99 % · ENS 20,04 % — 577 circonscriptions, data.gouv.fr.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/presidentielle-distorsion">Distorsion 1er / 2nd tour</a></h3>
          <p>Pluralité au premier tour, duel binaire au second — 2017 et 2022.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/legislatives-2024-desistements">Législatives 2024 — désistements</a></h3>
          <p>306 triangulaires potentielles → 89 après 215 désistements officiels.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2022-presidentielle">Présidentielle 2022 — 1er tour</a></h3>
          <p>Macron 27,85 % · Le Pen 23,15 % · Mélenchon 21,95 %.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2017-presidentielle">Présidentielle 2017 — 1er tour</a></h3>
          <p>Macron 24,01 % · Le Pen 21,30 % · quadruple polarisation.</p>
        </article>
      </li>
    </ul>
  </section>

  <!-- 
    PRINCIPE DE BASE (intégralité du site, sauf live YouTube) :
    - On expose des idées, pas des idéologies.
    - Aucun signe religieux ostentatoire, et encore moins toute autorité religieuse.
    - ne doit être diffusée.
    - Blocage immédiat de tout contenu contrevenant.
  -->
  <section class="card principles">
    <h3>Notre ligne</h3>
    <ul>
      <li><strong>Zéro biais · zéro parti pris</strong> — le média ne soutient aucun camp.</li>
      <li><strong>Transparence des couleurs politiques</strong> — posts et intervenants affichés avec teinte d’idées 1er tour (pas une carte d’adhésion).</li>
      <li><strong>Modératrice IA</strong> — aucune autorité religieuse ou idéologique ne passe les fourches caudines ; les idées politiques du débat restent bienvenues.</li>
      <li>Sources officielles traçables (<a href="/sources">data.gouv.fr</a>)</li>
      <li>Comparaisons factuelles, sans classement éliminatoire</li>
      <li><strong>Democracy Over Elimination</strong> — pluralité du 1er tour, sans ranking ni favori.</li>
      <li>Lisibilité maximale (WCAG 2.2 AA+), revue humaine après filtre IA.</li>
      <li>Document complet : <a href="/charte"><strong>Charte publique</strong></a>.</li>
    </ul>
  </section>

  <!-- Visuels & illustrations 2027 -->
  <section class="visuals-section">
    <h3 class="section-title">Illustrations, dessins, mèmes &amp; animations — Élection 2027</h3>
    <p class="lead" style="max-width: 52rem;">
      Pour incarner le premier tour : pluralité réelle, démocratie sans élimination prématurée.
      Dessins, photos illustratives et mèmes civiques à partager — alignés sur la ligne éditoriale DOE.
    </p>

    <div class="visuals-grid">
      <figure class="visual-card">
        <img src="/illustrations/2027/democracy-over-elimination.jpg" alt="Illustration Democracy Over Elimination : citoyen brisant les flèches du second tour — dessin civique" />
        <figcaption>Dessin — Democracy Over Elimination</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/pluralite-1er-tour.jpg" alt="Illustration pluralité : urne débordant de bulletins colorés — dessin civique" />
        <figcaption>Dessin — La pluralité au 1er tour</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/dessin-urne-2027.jpg" alt="Dessin ligne claire : urne transparente Premier Tour 2027 avec miroir tricolore — illustration civique" />
        <figcaption>Dessin — L'urne du 1er Tour</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/photo-citoyens-data-2027.jpg" alt="Scène illustrative : citoyens consultent les données ouvertes du 1er tour — illustration civique" />
        <figcaption>Photo illustrative — Données &amp; citoyens</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/meme-1er-tour-ne-ment-pas.jpg" alt="Mème civique : Le 1er Tour ne ment pas — illustration civique" />
        <figcaption>Mème — Le 1er tour ne ment pas</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/meme-vote-pensee.jpg" alt="Mème : Je vote ce que je pense vraiment au premier tour — illustration civique" />
        <figcaption>Mème — Vote ce que vous pensez</figcaption>
      </figure>
      <figure class="visual-card">
        <img src="/illustrations/2027/illustration-voix-egales.jpg" alt="Illustration : toutes les voix égales au premier tour — illustration civique" />
        <figcaption>Dessin — Toutes les voix comptent</figcaption>
      </figure>
    </div>

    <div class="video-embed">
      <h4>Animation — Le vote au 1er Tour</h4>
      <video controls playsinline preload="metadata" width="100%" style="max-width: 820px; border-radius: 8px; box-shadow: var(--shadow);">
        <source src="/videos/2027/hero-voting-animation.mp4" type="video/mp4" />
        Votre navigateur ne supporte pas la vidéo.
      </video>
      <p class="meta">Animation douce : citoyens votant, urne transparente, fierté civique (6s) — </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* =====================================================
     POURQUOI CE MÉDIA — en tête de page
  ===================================================== */
  .why-media {
    margin: 0 0 1.75rem;
    padding: 1.25rem 1.35rem 1.35rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
    border-left: 4px solid var(--accent, #2563a8);
    max-width: 52rem;
  }
  .why-media h2 {
    margin: 0 0 0.65rem;
    font-size: 1.45rem;
    line-height: 1.25;
    color: #0a0a0a !important;
  }
  .why-media-lead {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: #0a0a0a !important;
    max-width: 46rem;
  }
  .why-media-tagline {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.45;
    color: #0a0a0a !important;
    font-weight: 600;
  }
  .why-media-tagline strong {
    color: #0a0a0a !important;
  }
  @media (prefers-color-scheme: dark) {
    .why-media h2,
    .why-media-lead,
    .why-media-tagline,
    .why-media-tagline strong {
      color: #f5f2eb !important;
    }
  }

  /* =====================================================
     HERO REDESIGN — Professional, high-contrast, inclusive
     - WCAG 2.2 AA focus (contrast + visible focus states)
     - Mobile-first
     - Neutral civic aesthetic
     - Strong dark mode support (per design brief)
  ===================================================== */

  .hero {
    margin: -0.25rem -1rem 2.5rem;
    padding: 1.75rem 1rem 2rem;
    background: transparent;
    border-bottom: 1px solid var(--border);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem; /* improved for readability across ages and vision levels */
    font-family: system-ui, sans-serif;
    background: var(--card);
    border: 1px solid var(--border);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    color: var(--muted);
  }

  .badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }

  .hero-badge .sep { opacity: 0.4; }

  .hero-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 2rem;
    }
  }

  .hero-inner {
    max-width: 42rem;
  }

  .hero-title {
    font-size: clamp(1.65rem, 4.2vw, 2.35rem);
    line-height: 1.1;
    margin: 0 0 0.85rem;
    letter-spacing: -0.025em;
    font-weight: 700;
    color: var(--fg) !important;
  }

  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0 0 1.1rem;
    color: var(--fg) !important;
    max-width: 38ch;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
  }

  .btn-primary {
    background: var(--accent) !important;
    color: var(--on-accent) !important;
    border: 2px solid var(--accent) !important;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    color: var(--on-accent) !important;
  }
  .btn-secondary {
    background: var(--card) !important;
    color: var(--accent) !important;
    border: 2px solid var(--accent) !important;
  }
  .highlight-card h3 {
    margin: 0.35rem 0 0.65rem;
    font-size: 1.15rem;
    color: var(--fg) !important;
  }
  .highlight-card h3 a {
    color: var(--accent) !important;
    text-decoration: none;
  }
  .highlight-card h3 a:hover {
    filter: brightness(1.1);
  }
  .highlight-card p {
    color: var(--fg) !important;
  }
  .content-section {
    margin-bottom: 2rem;
  }
  .principles ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }

  /* 3 cartes secondaires visibles et utiles (fix for empty rectangles) */
  .hero-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .hero-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-card {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1rem;
    background: var(--card) !important;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--fg) !important;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
  }

  .hero-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px -2px rgb(0 0 0 / 0.08);
    transform: translateY(-1px);
  }

  .hero-card:focus-visible {
    outline: 3px solid var(--accent);

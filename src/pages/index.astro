              <strong>{item.title}</strong>
              <span class="visual-wit">{item.wit}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="video-embed">
      <h4>Animation — croquis 1er tour (6&nbsp;s)</h4>
      <video
        id="daily-gallery-video"
        class="gallery-video"
        controls
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        width="100%"
        poster={dailySet.galleryVideo?.poster ?? dailySet.heroPosterWebp}
      >
        <source src={dailySet.galleryVideo?.src ?? dailySet.heroVideo} type="video/mp4" />
        Votre navigateur ne supporte pas la vidéo.
      </video>
      <p class="meta" id="daily-gallery-caption">
        {dailySet.galleryVideo?.caption ??
          'Six secondes : croquis animé — on vote pour, pas pour éliminer.'}
      </p>
    </div>
  </section>
</BaseLayout>


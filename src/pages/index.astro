---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsFeed from '../components/NewsFeed.astro';
import AlerteCitoyenne from '../components/AlerteCitoyenne.astro';
import renifleur from '../data/renifleur/latest.json';
import type { RenifleurSnapshot } from '../lib/renifleur';
import candidaturesDeclarees from '../data/elections/2027-candidatures-declarees.json';
import { partyLogoForAffiliation, partyLogoSrc } from '../lib/party-logos';
import { formatXHandle, xForAffiliation, xForCandidate } from '../lib/x-officiels';
import DualAssembleeCompare from '../components/DualAssembleeCompare.astro';
import DailyVisuals from '../components/DailyVisuals.astro';
import { buildScrutinDual } from '../lib/scrutin-dual';
import {
  applyHeroDailyOverride,
  pickDailyVisuals,
  type HeroDailyOverride,
  type VisualDailyPool,
} from '../lib/visual-daily';
import visualDailyPool from '../../public/illustrations/2027/visual-daily-pool.json';
import heroDailyOverrideJson from '../../public/illustrations/2027/hero-daily-override.json';

const feed = renifleur as RenifleurSnapshot;
const dailyVisual = pickDailyVisuals(visualDailyPool as VisualDailyPool);
const dailySet = applyHeroDailyOverride(
  dailyVisual.set,
  heroDailyOverrideJson as HeroDailyOverride,
  dailyVisual.dayKey,
);
/** Fil directeur — exemple phare (présidentielle 2022 T1 vs T2) */
const dualHome = buildScrutinDual('2022-presidentielle');

type CandidatureEntry = (typeof candidaturesDeclarees.entries)[number];

const statusDeclareLabels: Record<string, string> = {
  candidature_declaree: 'Candidature déclarée',
  designe_parti: 'Désigné par le parti',
  conditionnelle: 'Sous condition',
  primaire: 'Primaire (pas ticket final)',
  retrait: 'Retrait documenté',
  substitution_parti: 'Substitution de parti (non ticket principal)',
};

const categoryOrder = ['declarees', 'parti_designe', 'conditionnelle', 'retrait'] as const;

const declaredUpdated = new Date(candidaturesDeclarees.updated).toLocaleDateString('fr-FR', {
  dateStyle: 'long',
});

const declaredByCategory = categoryOrder
  .map((id) => {
    const meta = candidaturesDeclarees.categories.find((c) => c.id === id);
    const entries = candidaturesDeclarees.entries
      .filter((e: CandidatureEntry) => e.category === id)
      .sort((a: CandidatureEntry, b: CandidatureEntry) => a.name.localeCompare(b.name, 'fr'));
    return { id, meta, entries };
  })
  .filter((g) => g.entries.length > 0);

const countDeclarees = candidaturesDeclarees.entries.filter(
  (e) => e.category === 'declarees' || e.category === 'parti_designe',
).length;
---

<BaseLayout
  title="Accueil"
  description="Le 1er tour est la photo réelle de la France politique. Atlas open data, Assemblée AN1T, dossier 2027 (18 avril) — Democracy Over Elimination : faits sourcés, zéro sondage « favori », zéro tier list."
  keywords="premier tour, présidentielle 2027, LMDPT, open data élections, pluralité, Democracy Over Elimination, atlas électoral, alerte citoyenne, programmes candidats"
>
  <DailyVisuals initialDayKey={dailyVisual.dayKey} initialIndex={dailyVisual.index} />
  <!--
    HERO FIRST (Créateur de site · cycle 2026-07-17)
    Pattern adapté (pas copié) des leaders news : value prop ≤ 5 s + CTA piliers above the fold.
    Visuels quotidiens : pool curated Europe/Paris (P17).
  -->
  <section class="hero" id="top" aria-labelledby="hero-title" data-daily-visual-set={dailySet.id}>
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <span>Média civique · open data</span>
      <span class="sep">•</span>
      <strong>Democracy Over Elimination</strong>
      <span class="sep">•</span>
      <span id="daily-visual-badge" class="daily-visual-badge">Visuel du jour · {dailySet.id}</span>
    </div>

    <div class="hero-grid">
      <div class="hero-visual hero-visual--animated">
        <!-- Croquis X + micro-vidéo · rotation quotidienne (poster = LCP) -->
        <video
          id="daily-hero-video"
          class="hero-img hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={dailySet.heroPosterWebp}
          width="1280"
          height="720"
          aria-label={dailySet.heroAlt}
        >
          <source src={dailySet.heroVideo} type="video/mp4" />
        </video>
        <picture class="hero-static-fallback">
          <source
            id="daily-hero-webp"
            type="image/webp"
            srcset={dailySet.heroPosterWebp}
          />
          <img
            id="daily-hero-img"
            src={dailySet.heroPosterJpg}
            alt={dailySet.heroAlt}
            class="hero-img"
            width="1280"
            height="720"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <div class="hero-inner">
        <h1 class="hero-title" id="hero-title">
          Le 1er tour&nbsp;: la France telle qu’elle vote, pas telle qu’on l’élimine
        </h1>

        <p class="hero-lead">
          Ouvre l’atlas, simule l’Assemblée du 1er tour, suis 2027.
          <strong>Faits officiels</strong> — zéro sondage «&nbsp;favori&nbsp;», zéro tier list.
        </p>

        <div class="cta-row" role="group" aria-label="Actions principales">
          <a class="btn btn-primary" href="/analyses/assemblee-premier-tour"
            >Voir l’Assemblée du 1er tour →</a
          >
          <a class="btn btn-secondary" href="/analyses/presidentielle-2027-preparation"
            >Dossier 2027 · 18 avril</a
          >
          <a class="btn btn-secondary" href="/atlas">Atlas des scrutins</a>
          <a class="btn btn-secondary" href="/soutenir">Soutenir le média</a>
        </div>

        <p class="meta">
          1er tour 2027&nbsp;: <strong>18 avril</strong> · 2e tour&nbsp;: <strong>2 mai</strong> · Sources
          data.gouv / Ministère de l’Intérieur
        </p>
      </div>
    </div>

    <!-- 3 piliers éditoriaux (P15-1 / P8-7) — above the fold, WCAG focus rings -->
    <div
      class="hero-cards pilier-cards"
      role="list"
      aria-label="Trois piliers du média"
    >
      <a href="/sources" class="hero-card pilier-card" role="listitem" data-pilier="faits">
        <div class="card-icon" aria-hidden="true">1</div>
        <div>
          <div class="pilier-kicker">Pilier 1</div>
          <div class="card-title">Faits, pas rumeurs</div>
          <div class="card-desc">
            data.gouv / Ministère. Sources primaires, licences affichées.
          </div>
        </div>
      </a>
      <a href="/atlas" class="hero-card pilier-card" role="listitem" data-pilier="pluralite">
        <div class="card-icon" aria-hidden="true">2</div>
        <div>
          <div class="pilier-kicker">Pilier 2</div>
          <div class="card-title">Toute la pluralité</div>
          <div class="card-desc">
            Atlas + AN1T : toutes les voix visibles — pas le duel.
          </div>
        </div>
      </a>
      <a href="/charte" class="hero-card pilier-card" role="listitem" data-pilier="doe">
        <div class="card-icon" aria-hidden="true">3</div>
        <div>
          <div class="pilier-kicker">Pilier 3</div>
          <div class="card-title">Vote pour, pas contre</div>
          <div class="card-desc">
            Democracy Over Elimination. Zéro favori. Zéro tier list.
          </div>
        </div>
      </a>
    </div>
    <p class="hero-disclaimer meta" role="note">
      Contenu pédagogique. Les simulations (AN1T, projections 2027) ne sont
      <strong>ni des prédictions ni des consignes de vote</strong>.
    </p>
  </section>

  <!-- Manifeste court — renforce le 5 s test -->
  <section class="why-media" id="pourquoi-ce-media" aria-labelledby="why-media-title">
    <h2 id="why-media-title">Pourquoi ce média&nbsp;?</h2>
    <p class="why-media-lead">
      Le 1er tour porte des convictions. Le second tour «&nbsp;contre&nbsp;» en efface une part.
      Ici : les faits du 1er tour, pour choisir les yeux ouverts.
    </p>
    <p class="why-media-tagline">
      Faits officiels · Sans classement éliminatoire · Vote <strong>pour</strong>, pas contre.
    </p>
    <nav class="pilier-shortcuts" aria-label="Raccourcis piliers">
      <a href="/analyses/assemblee-premier-tour">Simuler l’AN1T</a>
      <span aria-hidden="true">·</span>
      <a href="/liberte-d-expression">Liberté d’expression</a>
      <span aria-hidden="true">·</span>
      <a href="/observatoire-censure">Observatoire censure</a>
      <span aria-hidden="true">·</span>
      <a href="/analyses/presidentielle-2027-preparation">Dossier 2027</a>
      <span aria-hidden="true">·</span>
      <a href="/atlas/2022-presidentielle">Atlas 2022</a>
      <span aria-hidden="true">·</span>
      <a href="/sources">Sources</a>
    </nav>
  </section>

  <!-- Fil directeur + dual hémicycle (profondeur, après value prop) -->
  <section class="card fil-directeur" id="fil-directeur" aria-labelledby="fil-directeur-title">
    <p class="eyebrow">Fil directeur du site</p>
    <h2 id="fil-directeur-title">1er tour présidentiel → législatives — le différentiel visible</h2>
    <p>
      Sur <strong>chaque présidentielle</strong>&nbsp;: à gauche, l’Assemblée calée sur le
      <strong>1er tour présidentiel</strong> (Sainte-Laguë, proximité de programmes)&nbsp;; à droite,
      l’Assemblée réelle des <strong>législatives qui ont suivi</strong>. Tableau Δ sièges.
    </p>
    <p class="meta">
      <a href="/analyses/assemblee-premier-tour">Ouvrir le simulateur AN1T →</a>
      {' · '}
      <a href="/atlas">Tous les scrutins</a>
      {' · '}
      <a href="/atlas/2022-presidentielle">2022</a>
      {' · '}
      <a href="/atlas/2024-legislatives">Législatives 2024</a>
      {' · '}
      <a href="/analyses/gouvernance-an1t-droit">Droit &amp; gouvernance</a>
    </p>
    {
      dualHome && (
        <DualAssembleeCompare
          compact
          fullHref="/analyses/assemblee-premier-tour"
          firstRoundAlloc={dualHome.firstRound}
          realAlloc={dualHome.real}
          totalSeats={dualHome.totalSeats}
          t1Label={dualHome.t1Label}
          t2Label={dualHome.realLabel}
          firstRoundTitle={dualHome.firstRoundTitle}
          realTitle={dualHome.realTitle}
          firstRoundMeta={dualHome.firstRoundMeta}
          realMeta={dualHome.realMeta}
          realPending={dualHome.realPending}
          differential={dualHome.differential}
        />
      )
    }

  </section>

  <!-- Rubrique prioritaire : liberté d’expression (pluralité + censure) -->
  <section class="card liberte-home-card" id="liberte-expression" aria-labelledby="liberte-home-title">
    <p class="eyebrow">Rubrique prioritaire</p>
    <h2 id="liberte-home-title">
      <a href="/liberte-d-expression">Liberté d’expression</a>
    </h2>
    <p>
      Deux piliers pour un débat public digne du premier tour :
      <strong>1.</strong> pluralité de l’Assemblée ·
      <strong>2.</strong> liberté d’expression et observatoire de la censure.
    </p>
    <ul class="liberte-home-links">
      <li>
        <a href="/analyses/assemblee-premier-tour">Pluralité — simuler l’AN1T →</a>
      </li>
      <li>
        <a href="/analyses/alerte-citoyenne">Liberté d’expression — alerte citoyenne →</a>
      </li>
      <li>
        <a href="/observatoire-censure/">Observatoire de la censure (depuis 2017) →</a>
      </li>
    </ul>
    <p class="meta">
      <a href="/liberte-d-expression">Ouvrir le hub Liberté d’expression →</a>
    </p>
  </section>

  <!-- Alerte citoyenne (conditions du débat public) -->
  <AlerteCitoyenne previewLimit={4} />

  {
    feed.enabled && feed.items.length > 0 && (
      <NewsFeed
        items={feed.items}
        limit={6}
        disclaimer={feed.disclaimer}
        fetchedAt={feed.fetched_at}
        feedsOk={feed.feeds_ok}
      />
    )
  }

  <section class="card highlight-card">
    <p class="eyebrow">Focus 2027 — Principal</p>
    <h3>
      <a href="/analyses/presidentielle-2027-preparation">Présidentielle 2027 : calendrier officiel & veille</a>
    </h3>
    <p>
      1er tour le <strong>18 avril 2027</strong>. Calendrier validé, candidatures en cours, programmes partiels intégrés (Attal, Bardella, Le Pen, Mélenchon, PS...).
    </p>
    <p class="meta">
      <a href="/analyses/presidentielle-2027-preparation">Lire le dossier complet 2027 →</a> · 
      <a href="/analyses/programmes/presidentielle-2027">Comparer les programmes →</a>
    </p>
  </section>

  <!-- Liste des candidatures déclarées (pas liste Conseil constitutionnel) -->
  <section class="card declared-board" id="candidatures-declarees-2027" aria-labelledby="declared-2027-title">
    <p class="eyebrow">Présidentielle 2027 — pluralité documentée</p>
    <h3 id="declared-2027-title">{candidaturesDeclarees.title}</h3>
    <p class="declared-disclaimer">{candidaturesDeclarees.disclaimer}</p>
    <p class="meta">
      <strong>{countDeclarees}</strong> candidatures déclarées / désignées en lice
      · {candidaturesDeclarees.entries.length} entrées au total (y compris conditionnelles &amp; retraits)
      · Mise à jour <time datetime={candidaturesDeclarees.updated}>{declaredUpdated}</time>
    </p>
    <p class="meta declared-legal">{candidaturesDeclarees.legal_note}</p>

    {
      declaredByCategory.map((group) => (
        <div class="declared-group">
          <h4 class="declared-group-title">
            {group.meta?.label ?? group.id}
            <span class="declared-count">{group.entries.length}</span>
          </h4>
          {group.meta?.description && <p class="meta declared-group-desc">{group.meta.description}</p>}
          <div class="declared-table-wrap" role="region" aria-label={group.meta?.label ?? group.id} tabindex="0">
            <table class="declared-table">
              <thead>
                <tr>
                  <th scope="col">Nom</th>
                  <th scope="col">Affiliation</th>
                  <th scope="col">X (officiel)</th>
                  <th scope="col">Statut</th>
                  <th scope="col">Depuis</th>
                  <th scope="col">Source</th>
                </tr>
              </thead>
              <tbody>
                {group.entries.map((c: CandidatureEntry) => {
                  const party = partyLogoForAffiliation(c.affiliation);
                  const xCand = xForCandidate(c.slug);
                  const xParty = xForAffiliation(c.affiliation);
                  return (
                    <tr class:list={[{ 'declared-row--retrait': c.category === 'retrait' }]}>
                      <td data-label="Nom">
                        <strong>{c.name}</strong>
                        {c.note && <p class="poll-note">{c.note}</p>}
                      </td>
                      <td class="poll-aff" data-label="Affiliation">
                        <span class="party-logo-row">
                          <img
                            class="party-logo"
                            src={partyLogoSrc(party)}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                            decoding="async"
                          />
                          <span class="party-logo-label">{c.affiliation}</span>
                        </span>
                      </td>
                      <td class="x-links" data-label="X">
                        {xCand?.url ? (
                          <a
                            class="x-link x-link--person"
                            href={xCand.url}
                            rel="noopener noreferrer"
                            title={`X — ${c.name}`}
                          >
                            {formatXHandle(xCand.handle)}
                          </a>
                        ) : (
                          <span class="meta">—</span>
                        )}
                        {xParty?.url && (
                          <>
                            {' '}
                            <a
                              class="x-link x-link--party"
                              href={xParty.url}
                              rel="noopener noreferrer"
                              title={`X — ${xParty.label ?? c.affiliation}`}
                            >
                              parti
                            </a>
                          </>
                        )}
                      </td>
                      <td data-label="Statut">
                        <span class="poll-tag">{statusDeclareLabels[c.status] ?? c.status}</span>
                      </td>
                      <td class="declared-date" data-label="Depuis">
                        <time datetime={c.declared_at}>{c.declared_at}</time>
                      </td>
                      <td class="poll-src" data-label="Source">
                        <a href={c.source_url} rel="noopener noreferrer">
                          {c.source_label}
                        </a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }

    <p class="meta" style="margin-top:1rem;">
      Sources :{' '}
      {candidaturesDeclarees.sources.map((s, i) => (
        <>
          {i > 0 && ' · '}
          <a href={s.url} rel="noopener noreferrer">
            {s.label}
          </a>
        </>
      ))}
      {' · '}
      <a href="/analyses/presidentielle-2027-preparation">Dossier 2027</a>
      {' · '}
      <a href="/analyses/programmes/presidentielle-2027">Programmes</a>
    </p>
  </section>

  <!-- Parcours utilisateur clair pour préparation 2027 -->
  <section class="card" aria-labelledby="parcours-2027">
    <h3 id="parcours-2027">Parcours recommandé pour se préparer au 1er tour</h3>
    <ol style="margin:0.5rem 0 0; padding-left:1.3rem; font-size:0.95rem; line-height:1.6;">
      <li><a href="/analyses/presidentielle-2027-preparation#calendrier">Consultez le calendrier officiel</a></li>
      <li><a href="/analyses/assemblee-premier-tour">Testez le simulateur interactif d’Assemblée (1er tour)</a> — ajustez % et comparez scénarios</li>
      <li>
        <a href="/analyses/programmes/axes?scrutin=presidentielle-2027"
          >Programmes par grands axes (propositions des candidats)</a
        >
      </li>
      <li><a href="/analyses/programmes-comparateur">Comparez les programmes des candidats</a></li>
      <li><a href="/atlas/2024-legislatives">Explorez l’Atlas et les 577 circonscriptions</a> (filtre + recherche)</li>
      <li><a href="/debats/assemblee-premier-tour">Participez au débat : une Assemblée sur le 1er tour ?</a></li>
    </ol>
    <p class="meta" style="margin-top:0.5rem;">Parcours accessible au clavier et mobile. Tout est pédagogique et sourcé.</p>
  </section>

  <section class="card">
    <p class="eyebrow">Outil clé 2027</p>
    <h3>
      <a href="/analyses/assemblee-premier-tour">Assemblée du Premier Tour 2027 — simulation interactive</a>
    </h3>
    <p>
      Hémicycle AN1T, projections de sièges à partir du 1er tour, scénarios et programmes candidats.
    </p>
    <p class="meta">
      <a href="/analyses/assemblee-premier-tour">Explorer la simulation 2027 →</a>
    </p>
  </section>

  <section class="content-section">
    <h3 class="section-title">Débats ouverts</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/debats/assemblee-premier-tour">Faut-il une chambre élue sur le seul premier tour ?</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>
            Simulation 2024 : hémicycle virtuel AN1T vs Assemblée réelle — carte et comparatif chiffré.
          </p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3>
            <a href="/debats/vote-utile-pluralite">Le vote utile respecte-t-il la pluralité démocratique ?</a>
          </h3>
          <p>
            Positions sourcées des deux côtés — discussion modérée sur GitHub. Pas de classement
            éliminatoire.
          </p>
          <p class="meta">
            <a href="/debats">Voir tous les débats →</a>
          </p>
        </article>
      </li>
    </ul>
  </section>

  <section class="content-section">
    <h3 class="section-title">Atlas & analyses</h3>
    <ul class="card-grid">
      <li>
        <article class="card">
          <h3>
            <a href="/analyses/assemblee-premier-tour">Assemblée du premier tour — simulation 2024</a>
            <span class="status-badge status-badge--open">nouveau</span>
          </h3>
          <p>Hémicycle virtuel AN1T (577 sièges) vs Assemblée élue — comparatif chiffré.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2024-legislatives">Législatives 2024 — 1er tour</a></h3>
          <p>RN 29,26 % · UG 27,99 % · ENS 20,04 % — 577 circonscriptions, data.gouv.fr.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/presidentielle-distorsion">Distorsion 1er / 2nd tour</a></h3>
          <p>Pluralité au premier tour, duel binaire au second — 2017 et 2022.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/analyses/legislatives-2024-desistements">Législatives 2024 — désistements</a></h3>
          <p>306 triangulaires potentielles → 89 après 215 désistements officiels.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2022-presidentielle">Présidentielle 2022 — 1er tour</a></h3>
          <p>Macron 27,85 % · Le Pen 23,15 % · Mélenchon 21,95 %.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <h3><a href="/atlas/2017-presidentielle">Présidentielle 2017 — 1er tour</a></h3>
          <p>Macron 24,01 % · Le Pen 21,30 % · quadruple polarisation.</p>
        </article>
      </li>
    </ul>
  </section>

  <!-- 
    PRINCIPE DE BASE (intégralité du site, sauf live YouTube) :
    - On expose des idées, pas des idéologies.
    - Aucun signe religieux ostentatoire, et encore moins toute autorité religieuse.
    - ne doit être diffusée.
    - Blocage immédiat de tout contenu contrevenant.
  -->
  <section class="card principles">
    <h3>Notre ligne</h3>
    <ul>
      <li><strong>Zéro biais · zéro parti pris</strong> — le média ne soutient aucun camp.</li>
      <li><strong>Transparence des couleurs politiques</strong> — posts et intervenants affichés avec teinte d’idées 1er tour (pas une carte d’adhésion).</li>
      <li><strong>Modératrice IA</strong> — aucune autorité religieuse ou idéologique ne passe les fourches caudines ; les idées politiques du débat restent bienvenues.</li>
      <li>Sources officielles traçables (<a href="/sources">data.gouv.fr</a>)</li>
      <li>Comparaisons factuelles, sans classement éliminatoire</li>
      <li><strong>Democracy Over Elimination</strong> — pluralité du 1er tour, sans ranking ni favori.</li>
      <li>Lisibilité maximale (WCAG 2.2 AA+), revue humaine après filtre IA.</li>
      <li>Document complet : <a href="/charte"><strong>Charte publique</strong></a>.</li>
    </ul>
  </section>

  <!-- Visuels 2027 — rotation quotidienne (pool curated · Europe/Paris) -->
  <section class="visuals-section" id="visuels-2027" aria-labelledby="visuels-2027-title">
    <h3 class="section-title" id="visuels-2027-title">Croquis du jour &amp; animations — Élection 2027</h3>
    <p class="lead" style="max-width: 52rem;">
      Chaque jour, un autre regard sur le 1er tour : pluralité, mécanismes, open data.
      <strong>Croquis encre + aquarelle</strong> façon fil X — légers sur les <em>mécanismes</em>, jamais sur les personnes.
      Zéro signe religieux, zéro logo de parti, zéro caricature de camp.
    </p>

    <div class="visuals-grid">
      {
        dailySet.gallery.map((item, i) => (
          <figure class="visual-card" style={`--i: ${i}`} data-daily-gallery-item={i}>
            <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            <figcaption>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Modération commentaires"
  description="File d’attente et hiérarchie des modérateurs LMDPT — accès réservé."
>
  <section class="mod-page">
    <h2>Modération — commentaires citoyens</h2>
    <p class="meta">
      Hiérarchie : <strong>contributeur</strong> (post + validation IA) → <strong>modo</strong> (approuve/masque) →
      <strong>modo-senior</strong> (recoloration teinte) → <strong>rédaction</strong>.
    </p>
    <label class="mod-label">
      Jeton modo
      <input type="password" id="mod-token" autocomplete="off" placeholder="X-Mod-Token" />
    </label>
    <div class="mod-actions">
      <button type="button" class="btn btn-primary" id="mod-refresh">Charger la file</button>
    </div>
    <div id="mod-queue" class="mod-queue"></div>
    <p id="mod-status" class="meta" role="status"></p>
  </section>
</BaseLayout>

<script>
  const api = '/api/comments';
  const queueEl = document.getElementById('mod-queue')!;
  const statusEl = document.getElementById('mod-status')!;
  const tokenInput = document.getElementById('mod-token') as HTMLInputElement;

  async function loadQueue() {
    statusEl.textContent = 'Chargement…';
    try {
      const res = await fetch(`${api}/mod/queue`, {
        headers: { 'X-Mod-Token': tokenInput.value.trim() },
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Accès refusé');
      const queue = data.queue || [];
      if (!queue.length) {
        queueEl.innerHTML = '<p class="meta">File vide.</p>';
        statusEl.textContent = `Connecté (${data.role})`;
        return;
      }
      queueEl.innerHTML = queue
        .map(
          (c: any) => `
        <article class="mod-item" style="border-left:4px solid ${c.politicalHue?.color || '#666'}">
          <p><strong>${c.displayName}</strong> · <span class="meta">${c.politicalHue?.label}</span></p>
          <p>${c.body}</p>
          <p class="meta">Brut : ${c.raw}</p>
          <div class="mod-item-actions">
            <button type="button" data-act="approve" data-id="${c.id}">Approuver</button>
            <button type="button" data-act="hide" data-id="${c.id}">Masquer</button>
            <button type="button" data-act="recolor" data-id="${c.id}" data-slug="pluraliste">Recolor pluraliste</button>
          </div>
        </article>`,
        )
        .join('');
      statusEl.textContent = `Connecté (${data.role}) — ${queue.length} en attente`;
    } catch (e: any) {
      statusEl.textContent = e.message || 'Erreur';
      queueEl.innerHTML = '';
    }
  }

  document.getElementById('mod-refresh')?.addEventListener('click', loadQueue);
  queueEl.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    if (!btn) return;
    const action = btn.dataset.act;
    const commentId = btn.dataset.id;
    const slug = btn.dataset.slug;
    const res = await fetch(`${api}/mod/action`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Mod-Token': tokenInput.value.trim(),
      },
      body: JSON.stringify({ commentId, action, slug }),
    });
    const data = await res.json();
    if (!res.ok) {
      statusEl.textContent = data.error || 'Échec';
      return;
    }
    await loadQueue();
  });
</script>

<style>
  .mod-page {
    max-width: 40rem;
  }
  .mod-label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 1rem 0;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }
  .mod-label input {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .mod-queue {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .mod-item {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
  }
  .mod-item-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .mod-item-actions button {
    font-size: 0.8rem;
    padding: 0.3rem 0.55rem;
    cursor: pointer;
  }
</style>

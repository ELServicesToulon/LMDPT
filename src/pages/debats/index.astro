---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DebateLiveBanner from '../../components/DebateLiveBanner.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import { DEBATE_CATALOG } from '../../lib/debates';
import { listEditorialPosts } from '../../lib/editorial';

const debatePosts = new Map(
  listEditorialPosts()
    .filter((p) => p.kind === 'debat')
    .map((p) => [p.slug, p]),
);
---

<BaseLayout
  title="Débats ouverts sur le 1er tour et la présidentielle 2027"
  documentTitle="Débats ouverts sur le 1er tour et la présidentielle 2027 | LMDPT"
  description="Débats civiques sur la pluralité du premier tour et les mécanismes électoraux — positions sourcées, discussion modérée."
  pageHeading
>
  <DebateLiveBanner campaign="debats_index" />

  <section class="page-intro">
    <p class="eyebrow">Discussion modérée</p>
    <h1>Et si on discutait du 1er tour sans éliminer personne&nbsp;?</h1>
    <p>
      Questions documentées, arguments sourcés, données ouvertes. Plusieurs positions à égalité —
      le média documente, il ne tranche pas. Zéro classement éliminatoire.
    </p>
    <p class="meta">
      Ligne : la démocratie avant l’élimination.
    </p>
  </section>

  <section>
    <h2 class="section-title">Fils ouverts</h2>
    <ul class="card-grid">
      {
        DEBATE_CATALOG.map((d) => {
          const post = debatePosts.get(d.slug);
          // Pas de date de dernier commentaire au build : date d’ouverture uniquement.
          return post ? (
            <li>
              <EditorialCard
                post={post}
                badge={d.status === 'ouvert' ? 'Ouvert' : d.status === 'clos' ? 'Clos' : undefined}
                datePrefix="Ouvert le "
              />
            </li>
          ) : null;
        })
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* Titre et badge « OUVERT » ne doivent plus coller. */
  .card-grid :global(.editorial-card h3) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  .card-grid :global(.editorial-card h3 .status-badge) {
    margin-left: 0;
  }
</style>

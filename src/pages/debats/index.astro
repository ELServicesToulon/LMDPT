---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DebateLiveBanner from '../../components/DebateLiveBanner.astro';
import { DEBATE_CATALOG } from '../../lib/debates';
---

<BaseLayout
  title="Débats"
  description="Débats civiques sur la pluralité du premier tour et les mécanismes électoraux — positions sourcées, discussion modérée."
>
  <DebateLiveBanner campaign="debats_index" />

  <section class="page-intro">
    <p class="eyebrow">Discussion modérée (Sympathie &amp; Orgueil)</p>
    <h2>Débats civiques : pour une démocratie où chaque voix compte</h2>
    <p>
      <strong>Sécurité</strong> : questions documentées, arguments sourcés, open data.<br />
      <strong>Nouveauté</strong> : explorer les mécanismes du 1er tour sans filtre.<br />
      <strong>Sympathie &amp; Orgueil</strong> : plusieurs positions à égalité, pour que vous puissiez choisir avec fierté et empathie pour la pluralité.<br />
      Pas de classement éliminatoire (Confort) — le média documente, il ne tranche pas.
    </p>
    <p class="meta">
      <strong>Principe de base</strong> : On expose des idées, pas des idéologies. Aucun signe religieux ostentatoire, aucune autorité religieuse, aucune idéologie autoritaire ou religieuse. Blocage immédiat. (Sauf live YouTube)
    </p>
  </section>

  <section>
    <h3 class="section-title">Fils ouverts</h3>
    <ul class="card-grid">
      {
        DEBATE_CATALOG.map((d) => (
          <li>
            <article class="card">
              <h3>
                <a href={d.href}>{d.question}</a>
                {d.status === 'ouvert' && <span class="status-badge status-badge--open">Ouvert</span>}
                {d.status === 'clos' && <span class="status-badge">Clos</span>}
              </h3>
              <p>{d.description}</p>
              <p class="meta">
                <time datetime={d.date}>
                  {new Date(d.date).toLocaleDateString('fr-FR', { dateStyle: 'long' })}
                </time>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
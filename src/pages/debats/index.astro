---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DebateLiveBanner from '../../components/DebateLiveBanner.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import { DEBATE_CATALOG } from '../../lib/debates';
import { listEditorialPosts } from '../../lib/editorial';

const debatePosts = new Map(
  listEditorialPosts()
    .filter((p) => p.kind === 'debat')
    .map((p) => [p.slug, p]),
);
---

<BaseLayout
  title="Débats"
  description="Débats civiques sur la pluralité du premier tour et les mécanismes électoraux — positions sourcées, discussion modérée."
>
  <DebateLiveBanner campaign="debats_index" />

  <section class="page-intro">
    <p class="eyebrow">Discussion modérée</p>
    <h2>Et si on discutait du 1er tour sans éliminer personne&nbsp;?</h2>
    <p>
      Questions documentées, arguments sourcés, données ouvertes. Plusieurs positions à égalité —
      le média documente, il ne tranche pas. Zéro classement éliminatoire.
    </p>
    <p class="meta">
      Ligne : la démocratie avant l’élimination.
    </p>
  </section>

  <section>
    <h3 class="section-title">Fils ouverts</h3>
    <ul class="card-grid">
      {
        DEBATE_CATALOG.map((d) => {
          const post = debatePosts.get(d.slug);
          return post ? (
            <li>
              <EditorialCard
                post={post}
                badge={d.status === 'ouvert' ? 'Ouvert' : d.status === 'clos' ? 'Clos' : undefined}
              />
            </li>
          ) : null;
        })
      }
    </ul>
  </section>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SUPPORT_TIERS,
  PACK_DATA,
  getDonateUrl,
  donateReady,
} from '../config/soutenir';
import { SONDAGES_LIGNE } from '../lib/sondages-ligne';

const ready = donateReady();
const donateUrl = getDonateUrl();
const donateIsTest = ready && (donateUrl.includes('/test_') || donateUrl.includes('buy.stripe.com/test'));
const thankYou = Astro.url.searchParams.get('don') === 'merci';
const updated = new Date().toLocaleDateString('fr-FR', { dateStyle: 'long' });
const packPath = PACK_DATA.path;
---

<BaseLayout
  title="Soutenir le média"
  description="Soutenez Le Média du Premier Tour : dons citoyens pour l’hébergement, les données ouvertes et les outils pédagogiques — sans pub politique."
  keywords="soutenir LMDPT, don média civique, démocratie avant l’élimination, mécénat données électorales"
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a> → Soutenir
  </nav>

  {
    thankYou && (
      <p class="card thank-you" role="status">
        <strong>Merci.</strong> Votre don sécurisé via Stripe aide à garder le miroir du 1er tour
        ouvert — sans pub politique.
      </p>
    )
  }

  <section>
    <h2>Soutenir le miroir du 1er tour</h2>
    <p class="lead">
      Sans pub politique. {SONDAGES_LIGNE} Votre don paie l’hébergement,
      la synchronisation data.gouv et les simulateurs — pour que la pluralité reste lisible.
    </p>
    <p class="meta disclaimer">
      Transparence : les montants aident à couvrir hébergement (OVH), synchronisation data.gouv,
      maintenance des simulateurs et du site. Aucune donnée électorale officielle n’est
      mise derrière un péage.
    </p>
  </section>

  <section class="card" id="dons" aria-labelledby="dons-title">
    <h3 id="dons-title">Soutien citoyen (don ponctuel)</h3>
    <p>
      Don libre, <strong>en une fois</strong> (pas d’abonnement). Minimum <strong>3&nbsp;€</strong>,
      plafond indicatif <strong>500&nbsp;€</strong> — le montant est choisi sur la page Stripe.
    </p>
    <p class="meta">
      Les cartes ci‑dessous sont des <strong>suggestions indicatives</strong> (3&nbsp;/&nbsp;5&nbsp;/&nbsp;10&nbsp;€) ;
      chaque bouton ouvre <strong>le même lien</strong>. Aucun avantage matériel ou service en
      échange de ces montants : ce ne sont pas des « paliers » avec contrepartie.
    </p>
    <div class="tier-grid" role="list">
      {
        SUPPORT_TIERS.map((t) => (
          <article class="tier-card" role="listitem">
            <h4 class="tier-label">{t.label}</h4>
            <p class="tier-price">
              <strong>{t.amountEur}&nbsp;€</strong>
              <span class="meta"> suggestion</span>
            </p>
            <p class="tier-blurb">{t.blurb}</p>
            {
              ready && (
                <a
                  class="btn btn-primary"
                  href={donateUrl}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  Ouvrir le don (ex.&nbsp;{t.amountEur}&nbsp;€) →
                </a>
              )
            }
          </article>
        ))
      }
    </div>

    {
      ready ? (
        <>
          <p class="cta-block">
            <a class="btn btn-primary btn-lg" href={donateUrl} rel="noopener noreferrer" target="_blank">
              Faire un don →
            </a>
            <span class="cta-subtitle meta">
              Montant libre à partir de 3&nbsp;€ — hébergement, données, outils, temps éditorial.
            </span>
            {
              donateIsTest && (
                <span class="meta test-banner block">
                  Mode <strong>essai Stripe</strong> — carte test 4242… ; pas de vrai débit.
                </span>
              )
            }
          </p>
          <div class="legal-don card-inner">
            <p>
              <strong>Bénéficiaire du règlement :</strong> EL Services (titulaire du compte Stripe en
              production). Pas d’adresse personnelle ni de RIB affiché sur cette page.
            </p>
            <p>
              <strong>Objet :</strong> contribution volontaire au fonctionnement du site (hébergement,
              données ouvertes, outils, temps de rédaction et de contrôle) — sans contrepartie
              commerciale liée au montant du don.
            </p>
            <p>
              <strong>Financement électoral :</strong> ce dispositif ne finance pas une campagne
              électorale, un candidat ou un parti politique (art.&nbsp;L.&nbsp;52‑8 du code électoral).
            </p>
            <p>
              <strong>Fiscal :</strong> l’e‑mail ou le reçu Stripe n’équivaut pas à un reçu au sens de
              l’article&nbsp;200 du code général des impôts. Nous n’indiquons pas ici de dispositif de
              réduction d’impôt.
            </p>
            <p class="meta">
              Le Média du Premier Tour est présenté comme un projet éditorial ; cette page ne vise pas
              à décrire LMDPT comme une association, un organisme de bienfaisance ou une organisation
              politique.
            </p>
          </div>
        </>
      ) : (
        <p class="meta">
          Le lien de don n’est pas configuré correctement (variable d’environnement ou URL invalide).
          Écrivez-nous via les contacts habituels du site.
        </p>
      )
    }
  </section>

  <section class="card" id="pack-data" aria-labelledby="pack-title">
    <h3 id="pack-title">
      {PACK_DATA.name}{' '}
      <span class="badge-soon">{PACK_DATA.priceEurYear}&nbsp;€ / an · précommande intérêt</span>
    </h3>
    <p>
      Offre de données pour chercheurs, rédactions, enseignants et associations — <strong>sans bloquer</strong>{' '}
      l’atlas ni les résultats officiels gratuits.
    </p>
    <ul>
      {PACK_DATA.includes.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <p>
      <a class="btn btn-primary" href={packPath}>Fiche produit complète →</a>{' '}
      <a class="btn btn-secondary" href={PACK_DATA.interestIssueUrl} rel="noopener noreferrer"
        >Liste d’attente</a
      >
    </p>
  </section>

  <section class="card" id="ce-que-ca-finance">
    <h3>À quoi sert votre soutien</h3>
    <ul>
      <li>Serveur et certificat TLS (OVH), déploiements, backups</li>
      <li>Imports data.gouv (présidentielles, législatives) et contrôle qualité</li>
      <li>Outils pédagogiques : AN1T, mécanismes, atlas, débats</li>
      <li>Temps éditorial (sources, charte éditoriale, relectures)</li>
    </ul>
    <p class="meta">
      Nous n’acceptons pas de publicité politique ni de sponsoring partisan. Voir la{' '}
      <a href="/charte/">charte</a>.
    </p>
  </section>

  <section class="card links-card">
    <h3>Continuer la lecture</h3>
    <ul>
      <li><a href="/analyses/assemblee-premier-tour-mecanismes/">Mécanismes AN1T</a> — seuils, doses, pluralité</li>
      <li><a href="/analyses/assemblee-premier-tour/">Simulateur</a></li>
      <li><a href="/sources/">Sources & licences</a></li>
      <li><a href="/charte/">Charte — la démocratie avant l’élimination</a></li>
    </ul>
  </section>

  <p class="meta">Page mise à jour : {updated}</p>

  <style>
    .lead {
      font-size: 1.05rem;
      line-height: 1.55;
      max-width: 42rem;
    }
    .disclaimer {
      margin-top: 0.5rem;
      padding: 0.5rem 0.65rem;
      border-left: 3px solid var(--accent);
      background: var(--card);
    }
    .tier-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.85rem;
      margin: 1rem 0;
    }
    .tier-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-lg, 10px);
      padding: 0.85rem 1rem;
      background: rgba(0, 0, 0, 0.02);
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }
    .tier-label {
      margin: 0;
      font-size: 1rem;
    }
    .tier-price {
      margin: 0;
      font-size: 1.25rem;
    }
    .tier-blurb {
      margin: 0 0 0.5rem;
      font-size: 0.9rem;
      flex: 1;
    }
    .tier-card .btn {
      align-self: flex-start;
      text-decoration: none;
      display: inline-block;
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      font-size: 0.88rem;
      border: 1px solid var(--border);
    }
    .btn-primary {
      background: var(--accent);
      color: var(--on-accent) !important;
      border-color: var(--accent);
    }
    .btn-secondary {
      background: var(--card);
      color: var(--fg) !important;
    }
    .btn-lg {
      padding: 0.55rem 1.1rem;
      font-size: 1rem;
    }
    .cta-block {
      margin: 1rem 0 0.25rem;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .cta-subtitle {
      max-width: 38rem;
      line-height: 1.45;
    }
    .test-banner.block {
      display: block;
    }
    .legal-don.card-inner {
      margin-top: 1rem;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg, 10px);
      background: rgba(0, 0, 0, 0.02);
    }
    .legal-don p {
      margin: 0 0 0.65rem;
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .legal-don p:last-child {
      margin-bottom: 0;
    }
    .badge-soon {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
      background: var(--accent-soft);
      padding: 0.15rem 0.45rem;
      border-radius: 999px;
      vertical-align: middle;
    }
    .code-block {
      background: var(--accent-soft);
      padding: 0.65rem 0.85rem;
      border-radius: 8px;
      overflow-x: auto;
      font-size: 0.85rem;
    }
    .config-card h4 {
      margin-top: 0;
    }
    .links-card ul {
      margin: 0.25rem 0 0;
      padding-left: 1.2rem;
      line-height: 1.6;
    }
  </style>
</BaseLayout>

---
/**
 * Observatoire de la censure — hub documentaire (depuis 2017)
 * Dataset : src/data/observatoire-censure.json
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBar from '../../components/ShareBar.astro';
import {
  formatMeasureDate,
  latestMeasureDate,
  observatoireDataset,
  observatoireEntries,
} from '../../lib/observatoire-censure';

const dataset = observatoireDataset();
const entries = observatoireEntries();
const latestIso = latestMeasureDate(entries);
const latestLabel = formatMeasureDate(latestIso);
const filterControls = [
  { id: 'obs-type-all', value: 'all', label: 'Tous' },
  { id: 'obs-type-chaine-tv', value: 'chaîne TV', label: 'chaîne TV' },
  { id: 'obs-type-plateforme', value: 'plateforme', label: 'plateforme' },
  { id: 'obs-type-media-en-ligne', value: 'média en ligne', label: 'média en ligne' },
  { id: 'obs-type-autorite-publique', value: 'autorité publique', label: 'autorité publique' },
] as const;
---

<BaseLayout
  title="Observatoire de la censure"
  pageHeading
  description="Observatoire documentaire LMDPT : médias et gros comptes touchés par fermetures, suspensions ou sanctions depuis la présidentielle 2017 — motifs officiel/officieux."
  type="website"
  keywords="censure, Arcom, médias fermés, liberté d'expression, RT France, C8, influenceurs, présidentielle 2017, LMDPT"
  commentThread="observatoire-censure"
>
  <nav class="meta" aria-label="Fil d'Ariane">
    <a href="/liberte-d-expression/">Liberté d’expression</a> → Observatoire de la censure
  </nav>

  <section class="obs-intro" aria-labelledby="obs-title">
    <p class="eyebrow">Depuis la présidentielle 2017 · synthèse documentaire</p>
    <h1 id="obs-title">{dataset.title}</h1>
    <p class="meta">
      {
        latestIso ? (
          <>
            Dernière date documentée dans les fiches :{' '}
            <time datetime={latestIso}>{latestLabel}</time>
          </>
        ) : (
          <>Aucune date de mesure extractible des fiches.</>
        )
      }
      {' '}
      · {dataset.media_count} médias · {dataset.influencer_count} comptes
      · Période : {dataset.period_label}
    </p>
    <p>{dataset.disclaimer}</p>
    <p class="meta">{dataset.taxonomy_note}</p>
    <p class="meta">
      Rubrique parente : {' '}
      <a href="/liberte-d-expression/">Liberté d’expression</a>
      {' · '}
      <a href="/analyses/alerte-citoyenne/">Alerte citoyenne</a>
      {' · '}
      <a href="/analyses/assemblee-premier-tour/">Pluralité AN1T</a>
    </p>
    <ShareBar title="Observatoire de la censure" />
  </section>

  <nav class="obs-toc" aria-label="Sommaire observatoire">
    <a href="#tableau">Tableau</a>
    <a href="#fiches">Fiches</a>
    <a href="#methode">Méthode</a>
  </nav>

  <div class="obs-board">
    <form class="obs-filters" action="#tableau">
      <fieldset>
        <legend>Type</legend>
        {
          filterControls.map((control, i) => (
            <label class="obs-filter-opt">
              <input
                type="radio"
                name="obs-type"
                id={control.id}
                value={control.value}
                checked={i === 0}
              />
              {control.label}
            </label>
          ))
        }
      </fieldset>
    </form>

    <section id="tableau" aria-labelledby="tableau-title">
      <h2 id="tableau-title">Tableau des mesures</h2>
      <div class="table-wrap" role="region" aria-label="Tableau des mesures" tabindex="0">
        <table class="obs-table">
          <thead>
            <tr>
              <th scope="col">Nom</th>
              <th scope="col">Mesure</th>
              <th scope="col">Autorité</th>
              <th scope="col">Date</th>
              <th scope="col">Source</th>
            </tr>
          </thead>
          <tbody>
            {
              entries.map((entry) => (
                <tr class="obs-item" data-factual-type={entry.factual_type}>
                  <th scope="row">
                    <a href={`#${entry.id}`}>{entry.name}</a>
                  </th>
                  <td>{entry.action_label}</td>
                  <td>{entry.authority}</td>
                  <td>
                    {entry.measure_date ? (
                      <time datetime={entry.measure_date}>{formatMeasureDate(entry.measure_date)}</time>
                    ) : (
                      '—'
                    )}
                  </td>
                  <td>
                    {entry.official_source_url && entry.official_source_label ? (
                      <a href={entry.official_source_url} rel="noopener noreferrer">
                        {entry.official_source_label}
                      </a>
                    ) : (
                      '—'
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section id="fiches" aria-labelledby="fiches-title">
      <h2 id="fiches-title">Fiches détaillées</h2>
      <div class="obs-fiches">
        {
          entries.map((entry) => (
            <details class="obs-item obs-fiche" id={entry.id} data-factual-type={entry.factual_type}>
              <summary>
                <span class="obs-fiche-title">{entry.name}</span>
                {entry.handle ? <span class="meta"> @{entry.handle}</span> : null}
                <span class="status-badge">{entry.action_label}</span>
                <span class="obs-type-label">{entry.factual_type}</span>
                <span class="meta">
                  {entry.verification === 'documented' ? 'Documenté' : 'Partiel'}
                </span>
              </summary>
              <div class="obs-motives">
                <p>
                  <strong>Motif officiel.</strong> {entry.motif_officiel || '—'}
                </p>
                {
                  entry.motif_officieux && (
                    <p class="obs-unofficial">
                      <strong>Motif officieux</strong> (lecture secondaire). {entry.motif_officieux}
                    </p>
                  )
                }
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </div>

  <section class="card" id="methode" aria-labelledby="methode-title">
    <h2 id="methode-title">Méthode</h2>
    <span id="definition-censure"></span>
    <ul>
      <li>Période : à partir du <strong>7 mai 2017</strong> (présidentielle).</li>
      <li>
        Inclusion : impact diffusion France, au moins une source vérifiable ; doute →
        <em>vérification partielle</em>.
      </li>
      <li>
        Motif <strong>officieux</strong> toujours étiqueté lecture secondaire — jamais comme
        fait LMDPT.
      </li>
      <li>
        Voir aussi : <a href="/liberte-d-expression/">hub Liberté d’expression</a>, {' '}
        <a href="/charte/">charte</a>, <a href="/sources/">sources</a>.
      </li>
    </ul>
  </section>
</BaseLayout>

<script>
  function openObsHash() {
    const id = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (!id) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) el.open = true;
  }
  openObsHash();
  window.addEventListener('hashchange', openObsHash);
</script>

<style>
  .obs-intro {
    margin-bottom: 1rem;
  }
  .obs-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 1.25rem;
    font-weight: 600;
  }
  .obs-filters {
    margin: 0 0 1rem;
  }
  .obs-filters fieldset {
    border: 1px solid var(--border, #d0d5dd);
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    background: var(--card, var(--surface));
  }
  .obs-filters legend {
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0 0.25rem;
  }
  .obs-filter-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.92rem;
    cursor: pointer;
  }
  .obs-table {
    min-width: 36rem;
    font-size: 0.92rem;
  }
  .obs-table th,
  .obs-table td {
    padding: 0.45rem 0.55rem;
    border-bottom: 1px solid var(--border, #d0d5dd);
    text-align: left;
    vertical-align: top;
  }
  .obs-table tbody th {
    font-weight: 600;
  }
  .obs-fiches {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .obs-fiche {
    border: 1px solid var(--border, #d0d5dd);
    border-radius: 10px;
    padding: 0.35rem 0.85rem 0.45rem;
    background: var(--card, var(--surface));
    color: var(--fg);
  }
  .obs-fiche summary {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
    padding: 0.35rem 0;
    list-style: none;
  }
  .obs-fiche summary::-webkit-details-marker {
    display: none;
  }
  .obs-fiche-title {
    font-weight: 700;
    font-size: 1.02rem;
  }
  .obs-type-label {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--border, #d0d5dd);
    border-radius: 999px;
  }
  .status-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: var(--accent-soft, color-mix(in srgb, var(--accent) 18%, transparent));
    color: var(--fg);
  }
  .obs-unofficial {
    font-size: 0.92rem;
    color: var(--muted);
    border-left: 3px solid var(--border, #c5cad3);
    padding-left: 0.65rem;
  }
  .obs-motives p {
    margin: 0.45rem 0;
  }
  .obs-fiche:target {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .obs-board:has(#obs-type-chaine-tv:checked) .obs-item:not([data-factual-type='chaîne TV']),
  .obs-board:has(#obs-type-plateforme:checked) .obs-item:not([data-factual-type='plateforme']),
  .obs-board:has(#obs-type-media-en-ligne:checked) .obs-item:not([data-factual-type='média en ligne']),
  .obs-board:has(#obs-type-autorite-publique:checked) .obs-item:not([data-factual-type='autorité publique']) {
    display: none;
  }
</style>

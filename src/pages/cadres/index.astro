---
import BaseLayout from '../../layouts/BaseLayout.astro';
import cadresData from '../../data/cadres.json';

const cadres = [...cadresData.cadres].sort((a, b) => a.order - b.order);
const updated = new Date(cadresData.updated).toLocaleDateString('fr-FR', { dateStyle: 'long' });
---

<BaseLayout
  title="Cadres"
  description="Espaces de travail des cadres LMDPT — Moi, Manusk, Louison Lecourt."
>
  <section>
    <p class="eyebrow">Organisation du média</p>
    <h2>{cadresData.title}</h2>
    <p class="lead">{cadresData.disclaimer}</p>
    <p class="meta">
      Mise à jour <time datetime={cadresData.updated}>{updated}</time>
      · 3 espaces
    </p>
  </section>

  <section class="cadres-grid" aria-label="Liste des cadres">
    {
      cadres.map((c) => (
        <article class:list={['cadre-card', `cadre-card--${c.status}`]}>
          <p class="cadre-order">Cadre {c.order}</p>
          <h3>
            <a href={`/cadres/${c.slug}`}>{c.displayName}</a>
          </h3>
          <p class="cadre-role">{c.role}</p>
          <p class="cadre-status">
            <span class:list={['status-pill', `status-pill--${c.status}`]}>{c.statusLabel}</span>
          </p>
          <p class="cadre-summary">{c.summary}</p>
          <p class="meta">
            <a href={`/cadres/${c.slug}`}>Ouvrir l’espace →</a>
          </p>
        </article>
      ))
    }
  </section>

  <section class="card">
    <h3>Comment lire ces espaces</h3>
    <ul>
      <li><strong>Moi</strong> — décisions fondateur / Président, GO prod et stratégie.</li>
      <li><strong>Manusk</strong> — exécution et mémoire IA sous garde-fous DOE.</li>
      <li><strong>Louison Lecourt</strong> — espace rédaction réservé ; activation des rôles publics après accord explicite.</li>
    </ul>
    <p class="meta">
      Voir aussi <a href="/charte">Charte</a> · <a href="/a-propos">À propos</a> ·
      <a href="/moderation">Modération</a>
    </p>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 46rem;
    line-height: 1.55;
    color: #0a0a0a;
  }
  .cadres-grid {
    display: grid;
    gap: 1rem;
    margin: 1.25rem 0 1.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .cadres-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cadre-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 12px);
    padding: 1.1rem 1.15rem 1.2rem;
    border-top: 4px solid var(--accent, #2563a8);
  }
  .cadre-card--reserved {
    border-top-color: #8b6914;
  }
  .cadre-card--active {
    border-top-color: #0d6e4f;
  }
  .cadre-order {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #1a1814;
  }
  .cadre-card h3 {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
  }
  .cadre-card h3 a {
    color: #0a0a0a !important;
    text-decoration: none;
  }
  .cadre-card h3 a:hover {
    text-decoration: underline;
  }
  .cadre-role {
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: #0a0a0a;
  }
  .cadre-summary {
    margin: 0.5rem 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #0a0a0a;
  }
  .status-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg, #f4ede4);
    color: #0a0a0a;
  }
  .status-pill--active {
    background: #d1fae5;
    border-color: #059669;
  }
  .status-pill--reserved {
    background: #fef3c7;
    border-color: #b45309;
  }
</style>

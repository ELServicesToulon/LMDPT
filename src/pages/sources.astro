---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getJournalLastUpdate, getSortedJournal } from '../lib/data-journal';
import { formatLicenseLabel } from '../lib/license-labels';
import { loadSourcesManifest } from '../lib/sources';

const manifest = await loadSourcesManifest();
const dataJournal = getSortedJournal();
const journalLastUpdate = getJournalLastUpdate();
const journalLastLabel = journalLastUpdate
  ? new Date(journalLastUpdate).toLocaleDateString('fr-FR', { dateStyle: 'long' })
  : null;
const fetchedAt = new Date(manifest.fetchedAt);
const fetchedLabel = fetchedAt.toLocaleString('fr-FR', {
  dateStyle: 'long',
  timeStyle: 'short',
  timeZone: 'Europe/Paris',
});
---

<BaseLayout
  title="Sources"
  description="Traçabilité éditoriale — jeux de données data.gouv.fr utilisés pour le premier tour."
>
  <section>
    <h2>Sources open data</h2>
    <p class="meta">
      Dernière synchronisation : <time datetime={manifest.fetchedAt}>{fetchedLabel}</time>
      (fuseau Europe/Paris). Régénérer : <code>npm run sync:data</code>.
    </p>
    <p class="meta">
      <strong>Principe de base</strong> : On expose des idées, pas des idéologies. Aucun signe religieux ostentatoire, aucune autorité religieuse, aucune idéologie autoritaire ou religieuse. Blocage immédiat. (Sauf live YouTube)
    </p>
  </section>

  <section class="card" id="mises-a-jour">
    <h3>Journal des jeux intégrés au site</h3>
    <p class="meta">
      {dataJournal.length} entrée{dataJournal.length > 1 ? 's' : ''} versionnée{dataJournal.length > 1 ? 's' : ''}
      {journalLastLabel && (
        <>
          {' '}· dernière intégration : <time datetime={journalLastUpdate}>{journalLastLabel}</time>
        </>
      )}
      . Fichier source : <code>src/data/data-journal.json</code>.
    </p>
    <div class="journal-table-wrap">
      <table class="journal-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Jeu intégré</th>
            <th scope="col">Page(s)</th>
            <th scope="col">Source</th>
            <th scope="col">Licence</th>
            <th scope="col">Commande</th>
          </tr>
        </thead>
        <tbody>
          {
            dataJournal.map((entry) => (
              <tr>
                <td>
                  <time datetime={entry.date}>
                    {new Date(entry.date).toLocaleDateString('fr-FR', { dateStyle: 'short' })}
                  </time>
                </td>
                <td>
                  <strong>{entry.label}</strong>
                  {entry.licenseNote && <p class="meta note">{entry.licenseNote}</p>}
                </td>
                <td>
                  <ul class="page-links">
                    {entry.pages?.map((page) => (
                      <li>
                        <a href={page}>{page}</a>
                      </li>
                    ))}
                  </ul>
                </td>
                <td>
                  {entry.datasetUrl ? (
                    <a href={entry.datasetUrl} rel="noopener noreferrer">
                      {entry.source}
                    </a>
                  ) : (
                    entry.source
                  )}
                </td>
                <td>{formatLicenseLabel(entry.license)}</td>
                <td>{entry.script ? <code>{entry.script}</code> : <span class="meta">—</span>}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {
    manifest.catalogSearches.map((search) => (
      <section class="card">
        <h3>Catalogue : « {search.query} »</h3>
        <p class="meta">
          {search.hits.length} résultat{search.hits.length > 1 ? 's' : ''} —
          requête API <code>GET /api/1/site/catalog</code>
        </p>
        {search.hits.length === 0 ? (
          <p>Aucun jeu trouvé pour cette requête.</p>
        ) : (
          <ul>
            {search.hits.map((hit) => (
              <li>
                <a href={hit.page} rel="noopener noreferrer">
                  {hit.title}
                </a>
                {hit.organization && <span class="meta"> — {hit.organization}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  {
    manifest.datasets.length > 0 && (
      <section>
        <h2>Jeux détaillés</h2>
        <p class="meta">
          Métadonnées et ressources via <code>GET /api/1/datasets/&#123;id&#125;/</code>
        </p>
        {manifest.datasets.map((dataset) => (
          <article class="card">
            <h3>
              <a href={dataset.page} rel="noopener noreferrer">{dataset.title}</a>
            </h3>
            {dataset.organization && <p class="meta">Producteur : {dataset.organization}</p>}
            {dataset.license && (
              <p class="meta">Licence : {formatLicenseLabel(dataset.license)}</p>
            )}
            {dataset.last_update && (
              <p class="meta">
                Dernière mise à jour (métadonnées) :{' '}
                <time datetime={dataset.last_update}>{dataset.last_update}</time>
              </p>
            )}
            {dataset.description && <p>{dataset.description.slice(0, 280)}{dataset.description.length > 280 ? '…' : ''}</p>}
            {dataset.resources.length > 0 && (
              <>
                <p><strong>Ressources</strong></p>
                <ul class="resources">
                  {dataset.resources.map((resource) => (
                    <li>
                      <a href={resource.url} rel="noopener noreferrer">
                        {resource.title}
                      </a>
                      {resource.format && <span class="meta"> ({resource.format})</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .journal-table-wrap {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .journal-table {
    width: 100%;
    border-collapse: collapse;
    font-family: system-ui, sans-serif;
    font-size: 0.88rem;
  }
  .journal-table th,
  .journal-table td {
    border: 1px solid var(--border);
    padding: 0.55rem 0.65rem;
    vertical-align: top;
    text-align: left;
  }
  .journal-table th {
    background: var(--card);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .page-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .page-links li + li {
    margin-top: 0.2rem;
  }
  .note {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
  }
</style>

---
interface CompareRow {
  id: string;
  label: string;
  color: string;
  an1tSeats: number;
  reelleSeats: number;
  delta: number;
}

interface Props {
  title: string;
  totalSeats: number;
  rows: CompareRow[];
  an1tLabel?: string;
  reelleLabel?: string;
}

const {
  title,
  totalSeats,
  rows,
  an1tLabel = 'AN1T (simulation T1)',
  reelleLabel = 'AN réelle (2nd tour)',
} = Astro.props;

const maxSeats = Math.max(...rows.flatMap((r) => [r.an1tSeats, r.reelleSeats]), 1);
---

<section class="seat-compare card" aria-labelledby="seat-compare-title">
  <h3 id="seat-compare-title">{title}</h3>
  <p class="meta">{totalSeats} sièges · barres proportionnelles au nombre de sièges</p>

  <div class="compare-grid">
    <div class="compare-header" aria-hidden="true">
      <span>Bloc</span>
      <span>{an1tLabel}</span>
      <span>{reelleLabel}</span>
      <span>Écart</span>
    </div>
    {
      rows.map((row) => (
        <div class="compare-row">
          <div class="bloc-label">
            <span class="swatch" style={`background:${row.color}`} />
            <span>{row.label}</span>
          </div>
          <div class="bar-cell">
            <div
              class="bar an1t"
              style={`width:${(row.an1tSeats / maxSeats) * 100}%;background:${row.color}`}
              title={`${row.an1tSeats} sièges`}
            />
            <span class="bar-value">{row.an1tSeats}</span>
          </div>
          <div class="bar-cell">
            <div
              class="bar reelle"
              style={`width:${(row.reelleSeats / maxSeats) * 100}%;background:${row.color}`}
              title={`${row.reelleSeats} sièges`}
            />
            <span class="bar-value">{row.reelleSeats}</span>
          </div>
          <div class={`delta ${row.delta > 0 ? 'pos' : row.delta < 0 ? 'neg' : ''}`}>
            {row.delta > 0 ? `+${row.delta}` : row.delta}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .compare-grid {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1rem;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }
  .compare-header,
  .compare-row {
    display: grid;
    grid-template-columns: minmax(8rem, 1.4fr) 1fr 1fr 3.5rem;
    gap: 0.75rem;
    align-items: center;
  }
  .compare-header {
    font-size: 0.75rem;
    color: var(--muted, #666);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.35rem;
  }
  .bloc-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .bar-cell {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }
  .bar {
    height: 0.85rem;
    border-radius: 2px;
    min-width: 2px;
    opacity: 0.85;
  }
  .bar-value {
    font-variant-numeric: tabular-nums;
    min-width: 1.5rem;
  }
  .delta {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .delta.pos {
    color: #2d6a4f;
  }
  .delta.neg {
    color: #9b2226;
  }
  @media (max-width: 640px) {
    .compare-header {
      display: none;
    }
    .compare-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }
    .bar-cell::before {
      content: attr(data-label);
      font-size: 0.7rem;
      color: var(--muted, #666);
    }
  }
</style>

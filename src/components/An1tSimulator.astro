<script
  define:vars={{
    PRESET_T1_2022_CLIENT: PRESET_T1_2022,
    PRESET_T1_2017_CLIENT: PRESET_T1_2017,
    MULTI_SCRUTIN_CLIENT: MULTI_SCRUTIN,
  }}
>
  // === Miroir exact des fonctions de lib/an1t.ts pour le client (live calc) ===
  // allocateSainteLague + simulateFromVoteShares (sans dépendances, pur JS)
  function allocateSainteLagueClient(
    items: Array<{ id: string; votes: number }>,
    totalSeats: number,
    thresholdPct = 3
  ): Map<string, number> {
    const totalVotes = items.reduce((sum, i) => sum + i.votes, 0);
    if (totalVotes === 0 || totalSeats <= 0) return new Map();

    const minVotes = (totalVotes * thresholdPct) / 100;
    const eligible = items.filter((i) => i.votes >= minVotes);
    if (eligible.length === 0) return new Map();

    const seats = new Map<string, number>(eligible.map((i) => [i.id, 0]));

    for (let assigned = 0; assigned < totalSeats; assigned += 1) {
      let bestId: string | null = null;
      let bestQ = -1;
      for (const item of eligible) {
        const current = seats.get(item.id) ?? 0;
        const q = item.votes / (2 * current + 1);
        if (q > bestQ) {
          bestQ = q;
          bestId = item.id;
        }
      }
      if (!bestId) break;
      seats.set(bestId, (seats.get(bestId) ?? 0) + 1);
    }
    return seats;
  }

  function simulateFromVoteSharesClient(
    shares: Array<{ id: string; label: string; color: string; pct: number }>,
    totalSeats = 577,
    thresholdPct = 3
  ) {
    if (!shares || shares.length === 0) return [];

    const totalPct = shares.reduce((sum, s) => sum + Math.max(0, s.pct), 0) || 100;
    const items = shares.map((sh) => ({
      id: sh.id,
      votes: Math.round((sh.pct / totalPct) * 100000000),
    }));

    const seatMap = allocateSainteLagueClient(items, totalSeats, thresholdPct);

    return shares
      .map((sh) => {
        const seats = seatMap.get(sh.id) ?? 0;
        return {
          id: sh.id,
          label: sh.label,
          color: sh.color,
          pctExprimes: sh.pct,
          seats,
          pctSeats: totalSeats > 0 ? (seats / totalSeats) * 100 : 0,
        };
      })
      .sort((a, b) => b.seats - a.seats || b.pctExprimes - a.pctExprimes);
  }

  // Blocs (doivent rester synchrones avec AN1T_BLOCS côté serveur)
  const BLOCS = [
    { id: 'nfp', label: 'Nouveau Front populaire', color: '#cc2443' },
    { id: 'ensemble', label: 'Ensemble / centre présidentiel', color: '#ffeb00' },
    { id: 'rn', label: 'Rassemblement national & alliés droite', color: '#0d378a' },
    { id: 'lr', label: 'Droite républicaine', color: '#0066cc' },
    { id: 'autres', label: 'Régionalistes & divers', color: '#dddddd' },
  ];

  const DEFAULT_PCTS: Record<string, number> = {
    rn: 33.0,
    nfp: 28.0,
    ensemble: 20.0,
    lr: 6.5,
    autres: 12.5,
  };

  let REELLE: Record<string, number> = {
    nfp: 182,
    ensemble: 99,
    rn: 125,
    lr: 47,
    autres: 124,
  };
  let realPending = false;

  const PRESETS: Record<string, Record<string, number>> = {
    // Législatives 2024 T1 — agrégat blocs LMDPT (open data Min. Intérieur)
    't1-2024': { rn: 33.0, nfp: 28.0, ensemble: 20.0, lr: 6.5, autres: 12.5 },
    // Présidentielle 2022 T1 — injecté côté serveur depuis open data (aggregatePresidentialPctByBloc)
    // Source : 2022-presidentielle-1er-tour-national.json · méthodo /sources#methodologie-blocs
    't1-2022': PRESET_T1_2022_CLIENT,
    // Présidentielle 2017 T1 — open data + nuances FN/EM (P10-5)
    't1-2017': PRESET_T1_2017_CLIENT as Record<string, number>,
    // Agrégat pédagogique juil. 2026 (blocs législatifs, pas présidentielle) — RN ↑ post-Le Pen
    'base-2027': { rn: 35, nfp: 26, ensemble: 16, lr: 8, autres: 15 },
    'rn-forte': { rn: 42, nfp: 18, ensemble: 13, lr: 8, autres: 19 },
    'gauche-unie': { rn: 26, nfp: 32, ensemble: 15, lr: 8, autres: 19 },
    'centre-elargi': { rn: 24, nfp: 19, ensemble: 28, lr: 11, autres: 18 },
    // Candidats 2027 — mêmes hypothèses que assemblee-premier-tour.astro (scénarios programmes)
    'cand-bardella': { rn: 36, nfp: 22, ensemble: 12, lr: 9, autres: 21 },
    'cand-attal': { rn: 28, nfp: 26, ensemble: 19, lr: 12, autres: 15 },
    'cand-melenchon': { rn: 27, nfp: 30, ensemble: 13, lr: 9, autres: 21 },
    'cand-philippe': { rn: 25, nfp: 24, ensemble: 22, lr: 11, autres: 18 },
    'cand-retailleau': { rn: 30, nfp: 22, ensemble: 14, lr: 16, autres: 18 },
    reset: { rn: 33.0, nfp: 28.0, ensemble: 20.0, lr: 6.5, autres: 12.5 },
  };

  const MODE_TO_PRESET: Record<string, string> = {
    'legislatives-2024': 't1-2024',
    'presidentielle-2022': 't1-2022',
    'presidentielle-2017': 't1-2017',
    'presidentielle-2027': 'base-2027',
  };

  function applyScrutinMode(modeId: string) {
    const modes = (MULTI_SCRUTIN_CLIENT as { modes: Array<Record<string, unknown>> }).modes || [];
    const mode = modes.find((m) => m.id === modeId) as
      | {
          id: string;
          blocPcts: Record<string, number>;
          realSeats: Record<string, number>;
          realPending: boolean;
          realLabel: string;
          t1Label: string;
          sourceNote: string;
          defaultThreshold: number;
        }
      | undefined;
    if (!mode) return;

    REELLE = { ...mode.realSeats };
    realPending = Boolean(mode.realPending);

    const note = document.getElementById('an1t-scrutin-desc');
    if (note) note.textContent = mode.sourceNote || '';
    const realLab = document.getElementById('an1t-scrutin-real-label');
    if (realLab) {
      realLab.textContent = mode.realPending
        ? `${mode.realLabel} (en attente)`
        : mode.realLabel;
    }
    const t1Lab = document.getElementById('an1t-scrutin-t1-label');
    if (t1Lab) t1Lab.textContent = mode.t1Label || '';

    const thSelect = document.getElementById('an1t-threshold-select') as HTMLSelectElement | null;
    if (thSelect && mode.defaultThreshold != null) {
      const t = String(mode.defaultThreshold);
      if ([...thSelect.options].some((o) => o.value === t)) thSelect.value = t;
    }

    const presetKey = MODE_TO_PRESET[modeId] || 'reset';
    applyPreset(presetKey);
  }

  const TOTAL_SEATS = 577;

  function normalizePcts(pcts: Record<string, number>): Record<string, number> {
    const sum = Object.values(pcts).reduce((a, b) => a + Math.max(0, b), 0);
    if (sum < 0.001) return { ...pcts };
    const factor = 100 / sum;
    const out: Record<string, number> = {};
    Object.keys(pcts).forEach((k) => {
      out[k] = Math.round((pcts[k] * factor) * 10) / 10;
    });
    return out;
  }

  function getCurrentShares(threshold: number) {
    return BLOCS.map((b) => {
      const el = document.getElementById(`an1t-pct-${b.id}`) as HTMLInputElement | null;
      const pct = parseFloat(el?.value || '0') || 0;
      return { id: b.id, label: b.label, color: b.color, pct };
    });
  }

  function updateLiveValues() {
    const ids = BLOCS.map((b) => b.id);
    let total = 0;

    ids.forEach((id) => {
      const range = document.getElementById(`an1t-pct-${id}`) as HTMLInputElement | null;
      const valSpan = document.getElementById(`an1t-val-${id}`);
      if (range && valSpan) {
        const v = parseFloat(range.value) || 0;
        valSpan.textContent = v.toFixed(1);
        total += v;
      }
    });

    const totEl = document.getElementById('an1t-total-text');
    const warn = document.getElementById('an1t-total-warn');
    if (totEl) totEl.textContent = `Total : ${total.toFixed(1)} %`;
    if (warn) {
      const diff = Math.abs(total - 100);
      warn.hidden = diff < 1.2;
    }
    return total;
  }

  function updateThresholdDisplay() {
    const th = document.getElementById('an1t-threshold') as HTMLInputElement | null;
    const thVal = document.getElementById('an1t-threshold-val');
    const thNum = document.getElementById('an1t-threshold-num') as HTMLInputElement | null;
    if (th && thVal) {
      const v = parseFloat(th.value) || 0;
      thVal.textContent = v.toFixed(1);
    }
    if (th && thNum && thNum.value !== th.value) {
      thNum.value = th.value;
    }
  }

  function getThreshold(): number {
    const th = document.getElementById('an1t-threshold') as HTMLInputElement | null;
    return parseFloat(th?.value || '3') || 3;
  }

  function renderTable(results: any[], threshold: number) {
    const container = document.getElementById('an1t-table');
    if (!container) return;

    container.innerHTML = '';
    let totalSeatsCalc = 0;

    results.forEach((r: any) => {
      totalSeatsCalc += r.seats;
      const row = document.createElement('div');
      row.className = 'seat-row';
      row.setAttribute('role', 'row');

      const barW = Math.max(3, Math.round((r.seats / TOTAL_SEATS) * 230));
      const pctStr = r.pctSeats.toFixed(1);

      row.innerHTML = `
        <span class="swatch" style="background:${r.color};width:11px;height:11px;border-radius:2px;flex-shrink:0;"></span>
        <span class="label"><strong>${r.label}</strong></span>
        <span class="seat-bar" style="width:${barW}px; background:${r.color};" aria-hidden="true"></span>
        <span class="seat-num"><strong>${r.seats}</strong> sièges <span style="opacity:0.75;">(${pctStr}%)</span></span>
        <span class="meta" style="font-size:0.72rem;min-width:3.2rem;">${r.pctExprimes.toFixed(1)}% voix</span>
      `;
      container.appendChild(row);
    });

    const meta = document.getElementById('an1t-result-meta');
    if (meta) {
      meta.innerHTML = `${TOTAL_SEATS} sièges — seuil <span id="an1t-result-seuil">${threshold.toFixed(1)}</span>%`;
    }

    const totRow = document.createElement('div');
    totRow.className = 'meta';
    totRow.style.marginTop = '0.2rem';
    totRow.style.fontSize = '0.78rem';
    totRow.textContent = `Total sièges : ${totalSeatsCalc} / ${TOTAL_SEATS}`;
    container.appendChild(totRow);
  }

  function renderComparison(results: any[]) {
    const container = document.getElementById('an1t-compare');
    if (!container) return;
    container.innerHTML = '';

    const header = document.createElement('div');
    header.className = 'compare-row compare-header';
    header.setAttribute('role', 'row');
    header.innerHTML = `<span>Bloc</span><span>AN1T sim</span><span>Réelle 2024</span><span>Δ</span>`;
    container.appendChild(header);

    results.forEach((r: any) => {
      const real = REELLE[r.id] ?? 0;
      const delta = r.seats - real;
      const deltaClass = delta > 0 ? 'pos' : delta < 0 ? 'neg' : '';

      const row = document.createElement('div');
      row.className = 'compare-row';
      row.setAttribute('role', 'row');
      row.innerHTML = `
        <span>
          <span class="swatch" style="background:${r.color};width:8px;height:8px;border-radius:1px;display:inline-block;margin-right:3px;"></span>
          ${r.label}
        </span>
        <span><strong>${r.seats}</strong> <span class="meta">(${r.pctSeats.toFixed(1)}%)</span></span>
        <span>${real}</span>
        <span class="delta ${deltaClass}">${delta > 0 ? '+' : ''}${delta}</span>
      `;
      container.appendChild(row);
    });
  }

  /** Mini-hémicycle proportionnel (barres courbes simplifiées) — feedback temps réel P7-7 */
  function renderMiniHemicycle(results: any[]) {
    const svg = document.getElementById('an1t-mini-hemicycle') as SVGSVGElement | null;
    if (!svg) return;
    const W = 400;
    const H = 100;
    const cx = W / 2;
    const cy = H - 6;
    const R = 88;
    const total = results.reduce((s, r) => s + (r.seats || 0), 0) || TOTAL_SEATS;
    // Arc from π to 0 (demi-cercle haut)
    let angle = Math.PI;
    const parts: string[] = [];
    const legendBits: string[] = [];
    results.forEach((r) => {
      const seats = r.seats || 0;
      if (seats <= 0) return;
      const sweep = (seats / total) * Math.PI;
      const a0 = angle;
      const a1 = angle - sweep;
      const x0 = cx + R * Math.cos(a0);
      const y0 = cy - R * Math.sin(a0);
      const x1 = cx + R * Math.cos(a1);
      const y1 = cy - R * Math.sin(a1);
      const large = sweep > Math.PI ? 1 : 0;
      // annular sector approx: outer arc + inner arc reverse
      const rIn = R * 0.42;
      const xi0 = cx + rIn * Math.cos(a0);
      const yi0 = cy - rIn * Math.sin(a0);
      const xi1 = cx + rIn * Math.cos(a1);
      const yi1 = cy - rIn * Math.sin(a1);
      const d = [
        `M ${x0.toFixed(1)} ${y0.toFixed(1)}`,
        `A ${R} ${R} 0 ${large} 0 ${x1.toFixed(1)} ${y1.toFixed(1)}`,
        `L ${xi1.toFixed(1)} ${yi1.toFixed(1)}`,
        `A ${rIn} ${rIn} 0 ${large} 1 ${xi0.toFixed(1)} ${yi0.toFixed(1)}`,
        'Z',
      ].join(' ');
      parts.push(
        `<path d="${d}" fill="${r.color}" stroke="rgba(0,0,0,0.12)" stroke-width="0.6"><title>${r.label}: ${seats} sièges</title></path>`,
      );
      legendBits.push(`${r.label} ${seats}`);
      angle = a1;
    });
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute(
      'aria-label',
      `Mini-hémicycle AN1T : ${legendBits.join(', ')} — total ${total} sièges`,
    );
    svg.innerHTML =
      `<rect x="0" y="0" width="${W}" height="${H}" fill="transparent"/>` + parts.join('');
    // flash feedback
    const wrap = svg.closest('.mini-hemicycle');
    if (wrap) {
      wrap.classList.remove('flash-update');
      void (wrap as HTMLElement).offsetWidth;
      wrap.classList.add('flash-update');
    }
  }

  function runLiveSimulation() {
    const threshold = getThreshold();
    const shares = getCurrentShares(threshold);
    const results = simulateFromVoteSharesClient(shares, TOTAL_SEATS, threshold);

    renderTable(results, threshold);
    renderComparison(results);
    renderMiniHemicycle(results);
    const flash = document.getElementById('an1t-results');
    if (flash) {
      flash.classList.remove('results-flash');
      void flash.offsetWidth;
      flash.classList.add('results-flash');
    }
  }

  function applyPreset(key: string) {
    const map = PRESETS[key] || PRESETS.reset;
    const normalized = normalizePcts(map);

    BLOCS.forEach((b) => {
      const val = normalized[b.id] ?? DEFAULT_PCTS[b.id] ?? 10;
      const range = document.getElementById(`an1t-pct-${b.id}`) as HTMLInputElement | null;
      const num = document.getElementById(`an1t-num-${b.id}`) as HTMLInputElement | null;
      const valSpan = document.getElementById(`an1t-val-${b.id}`);

      if (range) range.value = val.toString();
      if (num) num.value = val.toString();
      if (valSpan) valSpan.textContent = val.toFixed(1);
    });

    updateLiveValues();

    // Reset seuil à 3% pour presets principaux (sauf reset explicite)
    const th = document.getElementById('an1t-threshold') as HTMLInputElement | null;
    const thNum = document.getElementById('an1t-threshold-num') as HTMLInputElement | null;
    const thVal = document.getElementById('an1t-threshold-val');
    if (key === 'reset' || key === 't1-2024') {
      if (th) th.value = '3';
      if (thNum) thNum.value = '3';
      if (thVal) thVal.textContent = '3.0';
      const thSelect = document.getElementById('an1t-threshold-select') as HTMLSelectElement | null;
      if (thSelect) thSelect.value = '3';
    }
    if (key === 't1-2022' || key === 't1-2017') {
      if (th) th.value = '1';
      if (thNum) thNum.value = '1';
      if (thVal) thVal.textContent = '1.0';
      const thSelect = document.getElementById('an1t-threshold-select') as HTMLSelectElement | null;
      // select n'a que 0/3/5 — garder 0 pour préserver pluralité présidentielle
      if (thSelect) thSelect.value = '0';
    }

    runLiveSimulation();
  }

  function syncInputs(id: string, fromNum: boolean) {
    const range = document.getElementById(`an1t-pct-${id}`) as HTMLInputElement | null;
    const num = document.getElementById(`an1t-num-${id}`) as HTMLInputElement | null;
    const valSpan = document.getElementById(`an1t-val-${id}`);

    if (!range || !num) return;

    let v = parseFloat(fromNum ? num.value : range.value) || 0;
    // P15-3 — pas de 0,1 % (avant : 0,5)
    v = Math.max(0, Math.min(100, Math.round(v * 10) / 10));

    range.value = v.toString();
    num.value = v.toString();
    if (valSpan) valSpan.textContent = v.toFixed(1);

    updateLiveValues();
    runLiveSimulation();
  }

  function initSimulator() {
    const ids = BLOCS.map((b) => b.id);

    // Init default values in DOM
    ids.forEach((id) => {
      const def = DEFAULT_PCTS[id] ?? 10;
      const range = document.getElementById(`an1t-pct-${id}`) as HTMLInputElement | null;
      const num = document.getElementById(`an1t-num-${id}`) as HTMLInputElement | null;
      const valSpan = document.getElementById(`an1t-val-${id}`);

      if (range) range.value = def.toString();
      if (num) num.value = def.toString();
      if (valSpan) valSpan.textContent = def.toFixed(1);
    });

    // Sliders % + num sync + live
    ids.forEach((id) => {
      const range = document.getElementById(`an1t-pct-${id}`) as HTMLInputElement | null;
      const num = document.getElementById(`an1t-num-${id}`) as HTMLInputElement | null;

      if (range) {
        range.addEventListener('input', () => {
          if (num) num.value = range.value;
          const valSpan = document.getElementById(`an1t-val-${id}`);
          if (valSpan) valSpan.textContent = parseFloat(range.value).toFixed(1);
          updateLiveValues();
          runLiveSimulation();
        });
      }
      if (num) {
        num.addEventListener('input', () => syncInputs(id, true));
        num.addEventListener('blur', () => syncInputs(id, true));
      }
    });

    // Threshold live
    const thRange = document.getElementById('an1t-threshold') as HTMLInputElement | null;
    const thNum = document.getElementById('an1t-threshold-num') as HTMLInputElement | null;

    if (thRange) {
      thRange.addEventListener('input', () => {
        updateThresholdDisplay();
        runLiveSimulation();
      });
    }
    if (thNum) {
      thNum.addEventListener('input', () => {
        const v = parseFloat(thNum.value) || 0;
        const clamped = Math.max(0, Math.min(15, Math.round(v * 2) / 2));
        if (thRange) thRange.value = clamped.toString();
        updateThresholdDisplay();
        runLiveSimulation();
      });
      thNum.addEventListener('blur', () => {
        if (thRange) thNum.value = thRange.value;
      });
    }

    // Multi-scrutin selector (P10-5)
    const scrutinSel = document.getElementById('an1t-scrutin-mode') as HTMLSelectElement | null;
    if (scrutinSel) {
      scrutinSel.addEventListener('change', () => applyScrutinMode(scrutinSel.value));
    }

    // Presets + swipe horizontal (mobile gestures P7-7)
    const presetKeys: string[] = [];
    document.querySelectorAll('.preset-buttons [data-preset]').forEach((btn) => {
      const key = btn.getAttribute('data-preset') || 'reset';
      presetKeys.push(key);
      btn.addEventListener('click', () => applyPreset(key));
    });
    let swipeStartX = 0;
    let swipeStartY = 0;
    document.querySelectorAll('.sim-presets').forEach((zone) => {
      const el = zone as HTMLElement;
      el.style.touchAction = 'pan-y';
      el.addEventListener(
        'touchstart',
        (e: TouchEvent) => {
          const t = e.changedTouches[0];
          swipeStartX = t.clientX;
          swipeStartY = t.clientY;
        },
        { passive: true },
      );
      el.addEventListener(
        'touchend',
        (e: TouchEvent) => {
          const t = e.changedTouches[0];
          const dx = t.clientX - swipeStartX;
          const dy = t.clientY - swipeStartY;
          if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
          if (!presetKeys.length) return;
          // find current nearest active-ish: use last applied stored
          const cur = (el.dataset.lastPreset || presetKeys[0]) as string;
          let idx = presetKeys.indexOf(cur);
          if (idx < 0) idx = 0;
          idx = dx < 0 ? Math.min(presetKeys.length - 1, idx + 1) : Math.max(0, idx - 1);
          const next = presetKeys[idx];
          el.dataset.lastPreset = next;
          applyPreset(next);
          setShareStatus(`Preset « ${next} » (geste glisser)`);
        },
        { passive: true },
      );
    });

    // Double-tap reset on total bar (mobile)
    let lastTap = 0;
    document.getElementById('an1t-total-text')?.addEventListener('click', () => {
      const now = Date.now();
      if (now - lastTap < 350) {
        applyPreset('reset');
        setShareStatus('Réinitialisé (double tap total %).');
      }
      lastTap = now;
    });

    // Exports (CSV / JSON / PNG hémicycle) + share URL
    document.getElementById('an1t-export-csv')?.addEventListener('click', exportCsv);
    document.getElementById('an1t-export-json')?.addEventListener('click', exportJson);
    document.getElementById('an1t-export-png')?.addEventListener('click', exportPng);
    document.getElementById('an1t-share-url')?.addEventListener('click', copyShareUrl);

    // Keyboard support
    const root = document.querySelector('.an1t-simulator');
    if (root) {
      root.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && (e.target as HTMLElement)?.tagName === 'INPUT') {
          e.preventDefault();
          runLiveSimulation();
        }
      });
    }

    // Restore from ?an1t=… share query (P16-1)
    applyShareFromUrl();

    // Initial live values + first calculation
    updateLiveValues();
    updateThresholdDisplay();
    runLiveSimulation();
  }

  function getExportRows() {
    const th = parseFloat((document.getElementById('an1t-threshold') as HTMLInputElement)?.value || '3') || 3;
    const shares = getCurrentShares(th);
    const results = simulateFromVoteSharesClient(shares, TOTAL_SEATS, th);
    return { th, shares, results };
  }

  function downloadBlob(filename: string, blob: Blob) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.rel = 'noopener';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
  }

  // Contrats d'export alignés sur src/lib/an1t-export.ts (tests vitest P15-2)
  function buildExportCsvClient(results, th) {
    const header = 'bloc_id,label,pct_voix,sieges,pct_sieges,seuil_pct,total_sieges';
    const lines = results.map(
      (r) =>
        `${r.id},"${String(r.label).replace(/"/g, '""')}",${Number(r.pctExprimes).toFixed(1)},${r.seats},${Number(r.pctSeats).toFixed(2)},${th},${TOTAL_SEATS}`,
    );
    return [header, ...lines, `# source=LMDPT AN1T pédagogique;date=${new Date().toISOString()}`].join('\n');
  }

  function buildExportJsonClient(shares, results, th) {
    return {
      meta: {
        tool: 'LMDPT AN1T simulator',
        method: 'Sainte-Laguë',
        pedagogical: true,
        threshold_pct: th,
        total_seats: TOTAL_SEATS,
        exported_at: new Date().toISOString(),
        url: typeof location !== 'undefined' ? location.href : '',
      },
      inputs: shares,
      results,
    };
  }

  function exportCsv() {
    const { th, results } = getExportRows();
    const csv = buildExportCsvClient(results, th);
    downloadBlob(`lmdpt-an1t-${Date.now()}.csv`, new Blob([csv], { type: 'text/csv;charset=utf-8' }));
  }

  function exportJson() {
    const { th, shares, results } = getExportRows();
    const payload = buildExportJsonClient(shares, results, th);
    downloadBlob(
      `lmdpt-an1t-${Date.now()}.json`,
      new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }),
    );
  }

  /** Encode compact (miroir lib/an1t-export encodeAn1tShareQuery) */
  function encodeShareQuery(shares, th) {
    const body = shares
      .map((s) => `${s.id}:${(Math.round(Math.max(0, Number(s.pct) || 0) * 10) / 10).toFixed(1)}`)
      .join(',');
    return `v1_${th}_${body}`;
  }

  function buildShareUrl() {
    const thSelect = document.getElementById('an1t-threshold-select') as HTMLSelectElement | null;
    const th =
      parseFloat(thSelect?.value || '') ||
      parseFloat((document.getElementById('an1t-threshold') as HTMLInputElement)?.value || '3') ||
      3;
    const shares = BLOCS.map((b) => {
      const el = document.getElementById(`an1t-pct-${b.id}`) as HTMLInputElement | null;
      return { id: b.id, pct: parseFloat(el?.value || '0') || 0 };
    });
    const u = new URL(location.href);
    u.searchParams.set('an1t', encodeShareQuery(shares, th));
    u.hash = 'an1t-sim-title';
    return u.toString();
  }

  function setShareStatus(msg: string, ok = true) {
    const el = document.getElementById('an1t-share-status');
    if (!el) return;
    el.hidden = false;
    el.textContent = msg;
    el.style.color = ok ? 'var(--accent, #166534)' : '#9f1239';
  }

  async function copyShareUrl() {
    const url = buildShareUrl();
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(url);
      } else {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      history.replaceState(null, '', url);
      setShareStatus('Lien copié — partage pédagogique (pas une prédiction).');
    } catch {
      setShareStatus(`Copie manuelle : ${url}`, false);
    }
  }

  function applyShareFromUrl() {
    try {
      const raw = new URL(location.href).searchParams.get('an1t');
      if (!raw) return;
      const m = raw.trim().match(/^v1_([0-9]+(?:\.[0-9]+)?)_(.+)$/);
      if (!m) return;
      const th = Math.max(0, Math.min(15, parseFloat(m[1]) || 3));
      const map = new Map();
      for (const part of m[2].split(',')) {
        const [id, pctStr] = part.split(':');
        if (id && pctStr !== undefined) map.set(id, Math.max(0, Math.min(100, parseFloat(pctStr) || 0)));
      }
      BLOCS.forEach((b) => {
        if (!map.has(b.id)) return;
        const v = map.get(b.id);
        const range = document.getElementById(`an1t-pct-${b.id}`) as HTMLInputElement | null;
        const num = document.getElementById(`an1t-num-${b.id}`) as HTMLInputElement | null;
        const valSpan = document.getElementById(`an1t-val-${b.id}`);
        if (range) range.value = String(v);
        if (num) num.value = String(v);
        if (valSpan) valSpan.textContent = Number(v).toFixed(1);
      });
      const thSelect = document.getElementById('an1t-threshold-select') as HTMLSelectElement | null;
      const thVal = [0, 3, 5].includes(th) ? String(th) : '3';
      if (thSelect) thSelect.value = thVal;
      const thRange = document.getElementById('an1t-threshold') as HTMLInputElement | null;
      const thNum = document.getElementById('an1t-threshold-num') as HTMLInputElement | null;
      if (thRange) thRange.value = thVal;
      if (thNum) thNum.value = thVal;
      setShareStatus('Scénario restauré depuis le lien partagé (pédagogique).');
    } catch {
      /* ignore malformed share */
    }
  }

  function exportPng() {
    const svg = document.getElementById('an1t-mini-hemicycle') as SVGSVGElement | null;
    if (!svg) return;
    const clone = svg.cloneNode(true) as SVGSVGElement;
    clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    if (!clone.getAttribute('width')) clone.setAttribute('width', '800');
    if (!clone.getAttribute('height')) clone.setAttribute('height', '200');
    const xml = new XMLSerializer().serializeToString(clone);
    const svgBlob = new Blob([xml], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(svgBlob);
    const img = new Image();
    img.onload = () => {
      const scale = 2;
      const w = Math.max(400, img.width || 400) * scale;
      const h = Math.max(100, img.height || 100) * scale;
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h + 48;
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        URL.revokeObjectURL(url);
        return;
      }
      ctx.fillStyle = '#faf8f5';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(img, 0, 24, w, h);
      ctx.fillStyle = '#1c1a17';
      ctx.font = '16px system-ui,sans-serif';
      ctx.fillText('LMDPT — mini-hémicycle AN1T (pédagogique)', 12, 18);
      canvas.toBlob((blob) => {
        if (blob) downloadBlob(`lmdpt-an1t-hemicycle-${Date.now()}.png`, blob);
        URL.revokeObjectURL(url);
      }, 'image/png');
    };
    img.onerror = () => URL.revokeObjectURL(url);
    img.src = url;
  }

  function initTooltips() {
    const btn = document.getElementById('btn-tip-sl');
    const tip = document.getElementById('tip-sainte-lague');
    if (!btn || !tip) return;
    btn.addEventListener('click', () => {
      const open = tip.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    btn.setAttribute('aria-expanded', 'false');
  }

  // Boot
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initSimulator();
      initTooltips();
    });
  } else {
    initSimulator();
    initTooltips();
  }
</script>

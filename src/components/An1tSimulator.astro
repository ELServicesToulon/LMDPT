---
/**
 * An1tSimulator.astro
 * Simulateur interactif pour l'Assemblée du Premier Tour (AN1T).
 * - Sliders % par bloc civique (basé sur AN1T_BLOCS)
 * - Slider seuil d'éligibilité (0-10%)
 * - Calcul live via impl JS miroir de allocateSainteLague + simulateFromVoteShares (lib/an1t.ts)
 * - Affichage tableau sièges + % 
 * - Comparaison vs Assemblée réelle 2024 (delta)
 * Neutre, pédagogique, accessible, mobile-first. Aucune prédiction.
 */
import { AN1T_BLOCS } from '../../lib/an1t';

interface Props {
  totalSeats?: number;
  defaultThreshold?: number;
}

const { totalSeats = 577, defaultThreshold = 3 } = Astro.props;

// Blocs officiels pour les contrôles (labels, couleurs, ids canoniques)
const BLOCS = AN1T_BLOCS.map((b) => ({
  id: b.id,
  label: b.label,
  color: b.color,
}));

// Valeurs par défaut initiales (agrégat T1 2024 approx + arrondi pédagogique)
const DEFAULT_PCTS: Record<string, number> = {
  rn: 33.0,
  nfp: 28.0,
  ensemble: 20.0,
  lr: 6.5,
  autres: 12.5,
};

// Sièges réels 2024 (après 2nd tour, regroupés blocs) — source: assemblee-premier-tour-2024.json
const REELLE_SEATS: Record<string, number> = {
  nfp: 182,
  ensemble: 99,
  rn: 125,
  lr: 47,
  autres: 124,
};
---

<section class="an1t-simulator card" aria-labelledby="an1t-sim-title">
  <h3 id="an1t-sim-title">Simulateur interactif AN1T — % voix &amp; seuil</h3>

  <p class="meta">
    Modifiez les intentions de vote au <strong>premier tour</strong> par bloc et le <strong>seuil d'éligibilité</strong>.
    Le calcul utilise la méthode <strong>Sainte-Laguë</strong> (diviseurs impairs) identique à <code>allocateSainteLague</code> et <code>simulateFromVoteShares</code> dans <code>lib/an1t.ts</code>.
    <strong>Illustration pédagogique uniquement.</strong> Les chiffres ne prédisent rien.
  </p>

  <div class="sim-controls">
    <!-- Sliders pourcentages par bloc -->
    <fieldset class="sim-fieldset">
      <legend class="sim-legend">1. Parts de voix au 1er tour (% exprimés)</legend>

      <div class="sim-sliders" id="an1t-sliders">
        {BLOCS.map((b) => {
          const def = DEFAULT_PCTS[b.id] ?? 10;
          return (
            <div class="sim-row" data-bloc={b.id}>
              <label for={`an1t-pct-${b.id}`}>
                <span class="swatch" style={`background:${b.color}`}></span>
                {b.label}
                <span class="val" id={`an1t-val-${b.id}`}>{def.toFixed(1)}</span>%
              </label>
              <div class="input-row">
                <input
                  type="range"
                  id={`an1t-pct-${b.id}`}
                  min="0"
                  max="60"
                  step="0.5"
                  value={def}
                  aria-describedby={`an1t-val-${b.id}`}
                />
                <input
                  type="number"
                  id={`an1t-num-${b.id}`}
                  min="0"
                  max="100"
                  step="0.5"
                  value={def}
                  class="num-input"
                  aria-label={`Pourcentage ${b.label}`}
                />
              </div>
            </div>
          );
        })}
      </div>

      <div class="sim-total" aria-live="polite">
        <span id="an1t-total-text">Total : 100,0 %</span>
        <span id="an1t-total-warn" class="warn" hidden>⚠ Somme ≠ 100 % (normalisé automatiquement)</span>
      </div>
    </fieldset>

    <!-- Seuil : sélecteur discret comme recommandé (0 / 3 / 5 %) -->
    <fieldset class="sim-fieldset">
      <legend class="sim-legend">2. Seuil d'éligibilité (exclusion en dessous)</legend>
      <div class="threshold-selector">
        <label for="an1t-threshold-select" class="meta">Choisir le seuil national :</label>
        <select id="an1t-threshold-select" aria-describedby="an1t-threshold-desc">
          <option value="0">0 % (aucun seuil — tous blocs éligibles)</option>
          <option value="3" selected>3 % (seuil pédagogique standard)</option>
          <option value="5">5 % (seuil plus restrictif)</option>
        </select>
        <span id="an1t-threshold-desc" class="meta small">Les valeurs correspondent aux simulations documentées (mécanismes, seuils 0/3/5 %). Seuil appliqué avant Sainte-Laguë.</span>
      </div>
    </fieldset>

    <!-- Presets rapides -->
    <div class="sim-presets">
      <div class="sim-legend">Profils rapides (pédagogiques)</div>
      <div class="preset-buttons" role="group" aria-label="Scénarios types">
        <button type="button" class="btn btn-secondary" data-preset="t1-2024">T1 2024 (agrégé)</button>
        <button type="button" class="btn btn-secondary" data-preset="base-2027">Base sondages 2027</button>
        <button type="button" class="btn btn-secondary" data-preset="rn-forte">RN &amp; alliés forte</button>
        <button type="button" class="btn btn-secondary" data-preset="gauche-unie">Gauche unie</button>
        <button type="button" class="btn btn-secondary" data-preset="centre-elargi">Centre élargi</button>
        <button type="button" class="btn btn-secondary" data-preset="reset">Réinitialiser (3 %)</button>
      </div>
    </div>

    <!-- Export -->
    <div class="sim-export">
      <div class="sim-legend">Exporter les résultats (pédagogiques)</div>
      <div class="export-buttons">
        <button type="button" id="an1t-export-csv" class="btn btn-secondary">Exporter CSV</button>
        <button type="button" id="an1t-export-json" class="btn btn-secondary">Exporter JSON</button>
      </div>
      <span class="meta small">Télécharge les sièges calculés + % voix actuels pour analyse personnelle ou réutilisation (format ouvert).</span>
    </div>
  </div>

  <!-- Résultats live -->
  <div id="an1t-results" class="sim-results" aria-live="polite">
    <h4>
      Répartition calculée : <span id="an1t-result-meta">577 sièges — seuil <span id="an1t-result-seuil">3</span>%</span>
    </h4>

    <div id="an1t-table" class="seats-table" role="table" aria-label="Sièges simulés par bloc"></div>

    <!-- Simple visual : mini-hémicycle (SVG généré client, proportionnel aux sièges simulés ; utilise logique de couleurs des blocs existants) -->
    <div class="mini-hemicycle" aria-label="Mini visualisation hémicycle proportionnel">
      <h5>Mini-hémicycle (répartition des sièges simulés)</h5>
      <svg id="an1t-mini-hemicycle" width="100%" height="92" viewBox="0 0 400 100" aria-hidden="false" role="img"></svg>
      <p class="meta small">Chaque « siège » représente ~5-6 sièges réels (échelle pour lisibilité). Couleurs = blocs. Illustration uniquement.</p>
    </div>

    <!-- Comparaison -->
    <div class="compare-section">
      <h5>Comparaison avec l'Assemblée réelle (résultats 2nd tour 2024)</h5>
      <p class="meta small">
        Les sièges « réels » résultent du scrutin majoritaire uninominal à deux tours (désistements inclus). 
        L'AN1T simule une répartition purement proportionnelle sur les voix du 1er tour.
      </p>
      <div id="an1t-compare" class="compare-table" role="table"></div>
    </div>

    <div class="disclaimer">
      <strong>Illustration pédagogique et factuelle uniquement.</strong><br />
      Méthode : agrégation nationale par bloc → application seuil → Sainte-Laguë (1,3,5…). 
      Identique aux fonctions <code>allocateSainteLague</code> et <code>simulateFromVoteShares</code> de la librairie.
      Aucune valeur prédictive. Données de référence 2024 : Ministère de l'Intérieur / data.gouv.fr.
    </div>
  </div>
</section>

<style>

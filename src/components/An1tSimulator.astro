---
/**
 * An1tSimulator.astro
 * Simulateur interactif pour l'Assemblée du Premier Tour (AN1T).
 * - Sliders % par bloc civique (basé sur AN1T_BLOCS)
 * - Slider seuil d'éligibilité (0-10%)
 * - Calcul live via impl JS miroir de allocateSainteLague + simulateFromVoteShares (lib/an1t.ts)
 * - Affichage tableau sièges + % 
 * - Comparaison vs Assemblée réelle 2024 (delta)
 * Neutre, pédagogique, accessible, mobile-first. Aucune prédiction.
 */
import { AN1T_BLOCS, aggregatePresidentialPctByBloc } from '../lib/an1t';
import {
  an1tMultiScrutinClientPayload,
  getAn1tScrutinMode,
} from '../lib/an1t-multi-scrutin';
import pres2022 from '../data/elections/2022-presidentielle-1er-tour-national.json';

interface Props {
  totalSeats?: number;
  defaultThreshold?: number;
}

const { totalSeats = 577, defaultThreshold = 3 } = Astro.props;

// Blocs officiels pour les contrôles (labels, couleurs, ids canoniques)
const BLOCS = AN1T_BLOCS.map((b) => ({
  id: b.id,
  label: b.label,
  color: b.color,
}));

/** Calibrage T1 2022 présidentielle — open data archives Intérieur (voix → blocs pédagogiques). */
const PRESET_T1_2022 = aggregatePresidentialPctByBloc(
  pres2022.national.candidats,
  pres2022.national.exprimes,
);

/** Multi-scrutins P10-5 — présidentielles 2017/2022 + légis 2024 + projection 2027 */
const MULTI_SCRUTIN = an1tMultiScrutinClientPayload();
const PRESET_T1_2017 = getAn1tScrutinMode('presidentielle-2017')!.blocPcts;

// Valeurs par défaut initiales (agrégat T1 2024 approx + arrondi pédagogique)
const DEFAULT_PCTS: Record<string, number> = {
  rn: 33.0,
  nfp: 28.0,
  ensemble: 20.0,
  lr: 6.5,
  autres: 12.5,
};

// Sièges réels 2024 (après 2nd tour, regroupés blocs) — source: assemblee-premier-tour-2024.json
const REELLE_SEATS: Record<string, number> = {
  nfp: 182,
  ensemble: 99,
  rn: 125,
  lr: 47,
  autres: 124,
};
---

<section class="an1t-simulator card" aria-labelledby="an1t-sim-title">
  <h3 id="an1t-sim-title">Simulateur interactif AN1T — % voix &amp; seuil</h3>

  <p class="meta">
    Modifiez les intentions de vote au <strong>premier tour</strong> par bloc et le <strong>seuil d'éligibilité</strong>.
    Le calcul utilise la méthode
    <button type="button" class="tooltip-trigger" aria-describedby="tip-sainte-lague" id="btn-tip-sl">
      Sainte-Laguë
    </button>
    (diviseurs impairs) identique à <code>allocateSainteLague</code> et <code>simulateFromVoteShares</code>.
    <strong>Illustration pédagogique uniquement.</strong> Les chiffres ne prédisent rien.
    Multi-scrutins (P10-5)&nbsp;: basculez entre législatives et présidentielles historiques.
  </p>
  <div id="tip-sainte-lague" class="sim-tooltip" role="tooltip">
    <strong>Sainte-Laguë</strong> : méthode de répartition proportionnelle aux plus forts restes
    avec diviseurs 1, 3, 5, 7… Chaque siège va au quotient le plus élevé. Utilisée ici pour
    illustrer une Assemblée calée sur le 1er tour — pas une réforme en vigueur.
  </div>

  <div class="sim-controls">
    <!-- Multi-scrutin P10-5 -->
    <fieldset class="sim-fieldset" id="an1t-scrutin-fieldset">
      <legend class="sim-legend">0. Scrutin de référence (multi-scrutins)</legend>
      <label for="an1t-scrutin-mode" class="meta">Choisir le calibrage T1 + comparaison Assemblée réelle</label>
      <select id="an1t-scrutin-mode" aria-describedby="an1t-scrutin-desc">
        {MULTI_SCRUTIN.modes.map((m) => (
          <option value={m.id} selected={m.id === 'legislatives-2024'}>
            {m.label}
          </option>
        ))}
      </select>
      <p id="an1t-scrutin-desc" class="meta small" data-role="scrutin-note">
        {MULTI_SCRUTIN.modes.find((m) => m.id === 'legislatives-2024')?.sourceNote}
      </p>
      <p class="meta small">
        Comparaison&nbsp;: <span id="an1t-scrutin-real-label">Assemblée réelle 2024</span>
        · T1&nbsp;: <span id="an1t-scrutin-t1-label">1er tour législatives 2024</span>
      </p>
    </fieldset>

    <!-- Sliders pourcentages par bloc -->
    <fieldset class="sim-fieldset">
      <legend class="sim-legend">1. Parts de voix au 1er tour (% exprimés)</legend>

      <div class="sim-sliders" id="an1t-sliders">
        {BLOCS.map((b) => {
          const def = DEFAULT_PCTS[b.id] ?? 10;
          return (
            <div class="sim-row" data-bloc={b.id}>
              <label for={`an1t-pct-${b.id}`}>
                <span class="swatch" style={`background:${b.color}`}></span>
                {b.label}
                <span class="val" id={`an1t-val-${b.id}`}>{def.toFixed(1)}</span>%
              </label>
              <div class="input-row">
                <input
                  type="range"
                  id={`an1t-pct-${b.id}`}
                  min="0"
                  max="60"
                  step="0.1"
                  value={def}
                  aria-describedby={`an1t-val-${b.id} tip-slider-precision`}
                />
                <input
                  type="number"
                  id={`an1t-num-${b.id}`}
                  min="0"
                  max="100"
                  step="0.1"
                  value={def}
                  class="num-input"
                  aria-label={`Pourcentage ${b.label} (pas 0,1 %)`}
                />
              </div>
            </div>
          );
        })}
      </div>

      <div class="sim-total" aria-live="polite">
        <span id="an1t-total-text">Total : 100,0 %</span>
        <span id="an1t-total-warn" class="warn" hidden>⚠ Somme ≠ 100 % (normalisé automatiquement)</span>
      </div>
      <p id="tip-slider-precision" class="meta small">
        Précision des sliders : <strong>0,1&nbsp;%</strong>. La somme est normalisée à 100&nbsp;% avant Sainte-Laguë.
      </p>
      <p class="sim-mobile-hint meta">
        Mobile : glissez les curseurs (zones ≥ 44&nbsp;px) — les presets et exports sont sous les contrôles.
      </p>
    </fieldset>

    <!-- Seuil : sélecteur discret comme recommandé (0 / 3 / 5 %) -->
    <fieldset class="sim-fieldset">
      <legend class="sim-legend">2. Seuil d'éligibilité (exclusion en dessous)</legend>
      <div class="threshold-selector">
        <label for="an1t-threshold-select" class="meta">Choisir le seuil national :</label>
        <select id="an1t-threshold-select" aria-describedby="an1t-threshold-desc">
          <option value="0">0 % (aucun seuil — tous blocs éligibles)</option>
          <option value="3" selected>3 % (seuil pédagogique standard)</option>
          <option value="5">5 % (seuil plus restrictif)</option>
        </select>
        <span id="an1t-threshold-desc" class="meta small">Les valeurs correspondent aux simulations documentées (mécanismes, seuils 0/3/5 %). Seuil appliqué avant Sainte-Laguë.</span>
      </div>
    </fieldset>

    <!-- Presets rapides -->
    <div class="sim-presets">
      <div class="sim-legend">Profils rapides (pédagogiques — pas des prédictions)</div>
      <div class="preset-buttons" role="group" aria-label="Scénarios types">
        <button type="button" class="btn btn-secondary" data-preset="t1-2024">T1 2024 législatives</button>
        <button type="button" class="btn btn-secondary" data-preset="t1-2022">T1 2022 présidentielle</button>
        <button type="button" class="btn btn-secondary" data-preset="t1-2017">T1 2017 présidentielle</button>
        <button type="button" class="btn btn-secondary" data-preset="base-2027">Base sondages 2027</button>
        <button type="button" class="btn btn-secondary" data-preset="rn-forte">RN &amp; alliés forte</button>
        <button type="button" class="btn btn-secondary" data-preset="gauche-unie">Gauche unie</button>
        <button type="button" class="btn btn-secondary" data-preset="centre-elargi">Centre élargi</button>
        <button type="button" class="btn btn-secondary" data-preset="reset">Réinitialiser (3 %)</button>
      </div>
      <div class="sim-legend" style="margin-top:0.55rem">Scénarios candidats 2027 (hypothèses institutions — DOE)</div>
      <div class="preset-buttons" role="group" aria-label="Scénarios candidats 2027">
        <button type="button" class="btn btn-secondary" data-preset="cand-bardella">Bardella</button>
        <button type="button" class="btn btn-secondary" data-preset="cand-attal">Attal</button>
        <button type="button" class="btn btn-secondary" data-preset="cand-melenchon">Mélenchon</button>
        <button type="button" class="btn btn-secondary" data-preset="cand-philippe">Philippe</button>
        <button type="button" class="btn btn-secondary" data-preset="cand-retailleau">Retailleau</button>
      </div>
      <p class="meta small">
        Ces profils alignent des % de voix T1 sur des blocs législatifs à partir de lectures pédagogiques
        des programmes (pas un sondage). Voir aussi{' '}
        <a href="/analyses/assemblee-premier-tour-mecanismes">mécanismes</a> ·{' '}
        <a href="/soutenir">soutenir</a> · <a href="/pack-data-an1t">Pack Data AN1T</a>.
      </p>
    </div>

    <!-- Export -->
    <div class="sim-export">
      <div class="sim-legend" id="an1t-export-legend">Exporter les résultats (pédagogiques)</div>
      <div class="export-buttons" role="group" aria-labelledby="an1t-export-legend">
        <button
          type="button"
          id="an1t-export-csv"
          class="btn btn-secondary"
          aria-label="Exporter les sièges simulés en CSV (format ouvert pédagogique)"
        >Exporter CSV</button>
        <button
          type="button"
          id="an1t-export-json"
          class="btn btn-secondary"
          aria-label="Exporter les sièges simulés en JSON (format ouvert pédagogique)"
        >Exporter JSON</button>
        <button
          type="button"
          id="an1t-export-png"
          class="btn btn-secondary"
          aria-label="Exporter le mini-hémicycle en image PNG pédagogique"
        >Exporter PNG (hémicycle)</button>
        <button
          type="button"
          id="an1t-share-url"
          class="btn btn-secondary"
          aria-label="Copier le lien de partage avec les pourcentages et le seuil actuels"
        >Copier le lien</button>
      </div>
      <span class="meta small" id="an1t-export-help">
        Télécharge les sièges calculés + % voix actuels (CSV/JSON) ou le mini-hémicycle (PNG) —
        formats ouverts, usage pédagogique uniquement (pas de prédiction).
        Le lien reprend les % et le seuil dans l’URL (partage pédagogique).
      </span>
      <p id="an1t-share-status" class="meta small" role="status" aria-live="polite" hidden></p>
    </div>
  </div>

  <!-- Résultats live -->
  <div id="an1t-results" class="sim-results" aria-live="polite">
    <h4>
      Répartition calculée : <span id="an1t-result-meta">577 sièges — seuil <span id="an1t-result-seuil">3</span>%</span>
    </h4>

    <div id="an1t-table" class="seats-table" role="table" aria-label="Sièges simulés par bloc"></div>

    <!-- Simple visual : mini-hémicycle (SVG généré client, proportionnel aux sièges simulés ; utilise logique de couleurs des blocs existants) -->
    <div class="mini-hemicycle" aria-label="Mini visualisation hémicycle proportionnel">
      <h5>Mini-hémicycle (répartition des sièges simulés)</h5>
      <svg id="an1t-mini-hemicycle" width="100%" height="92" viewBox="0 0 400 100" aria-hidden="false" role="img"></svg>
      <p class="meta small">Chaque « siège » représente ~5-6 sièges réels (échelle pour lisibilité). Couleurs = blocs. Illustration uniquement.</p>
    </div>

    <!-- Comparaison -->
    <div class="compare-section">
      <h5>Comparaison avec l'Assemblée réelle (résultats 2nd tour 2024)</h5>
      <p class="meta small">
        Les sièges « réels » résultent du scrutin majoritaire uninominal à deux tours (désistements inclus). 
        L'AN1T simule une répartition purement proportionnelle sur les voix du 1er tour.
      </p>
      <div id="an1t-compare" class="compare-table" role="table"></div>
    </div>

    <div class="disclaimer">
      <strong>Illustration pédagogique et factuelle uniquement.</strong><br />
      Méthode : agrégation nationale par bloc → application seuil → Sainte-Laguë (1,3,5…). 
      Identique aux fonctions <code>allocateSainteLague</code> et <code>simulateFromVoteShares</code> de la librairie.
      Aucune valeur prédictive. Données de référence 2024 : Ministère de l'Intérieur / data.gouv.fr.
    </div>
  </div>
</section>


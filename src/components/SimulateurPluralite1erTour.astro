    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .delta.pos { color: #2d6a4f; }
  .delta.neg { color: #9b2226; }

  .mini-hemicycle {
    margin: 0.5rem 0;
    background: #111;
    border-radius: 6px;
    padding: 4px;
    border: 1px solid #333;
  }
  .mini-hemicycle svg { display: block; max-height: 110px; }

  .disclaimer {
    margin-top: 0.7rem;
    font-size: 0.78rem;
    line-height: 1.35;
    background: #fef3c7;
    border: 1px solid #d97706;
    padding: 0.5rem 0.6rem;
    border-radius: 4px;
    color: #451a03;
  }
  .disclaimer strong { color: #92400e; }

  .small { font-size: 0.75rem; }

  @media (max-width: 640px) {
    .sim-sliders { grid-template-columns: 1fr; }
    .compare-row { grid-template-columns: 1fr; gap: 0.15rem; }
    .compare-header { display: none; }
    .seat-row .label { min-width: 120px; font-size: 0.8rem; }
  }
</style>

<script>
  const TOTAL_SEATS = 577;
  const BLOCS = [
    { id: 'rn', label: 'Rassemblement national & alliés', color: '#0d378a' },
    { id: 'nfp', label: 'Nouveau Front populaire', color: '#cc2443' },
    { id: 'ensemble', label: 'Ensemble / centre', color: '#ffeb00' },
    { id: 'lr', label: 'Droite républicaine', color: '#0066cc' },
    { id: 'autres', label: 'Autres & divers', color: '#dddddd' },
  ];
  const REAL_2024 = { rn: 125, nfp: 182, ensemble: 99, lr: 47, autres: 124 };
  const T1_2024_PCTS = { rn: 33.0, nfp: 28.0, ensemble: 20.0, lr: 6.5, autres: 12.5 };

  const PRESETS = {
    't1-2024': T1_2024_PCTS,
    'equilibre': { rn: 22, nfp: 24, ensemble: 22, lr: 12, autres: 20 },
    'rn-fort': { rn: 38, nfp: 20, ensemble: 14, lr: 9, autres: 19 },
    'gauche-fort': { rn: 18, nfp: 35, ensemble: 16, lr: 8, autres: 23 },
    'centre': { rn: 16, nfp: 18, ensemble: 32, lr: 12, autres: 22 },
    'reset': { rn: 32, nfp: 24, ensemble: 14, lr: 10, autres: 20 }
  };

  function normalize(pcts) {
    const sum = Object.values(pcts).reduce((a, b) => a + b, 0);
    if (sum === 0) return pcts;
    const factor = 100 / sum;
    const out = {};
    Object.keys(pcts).forEach(k => { out[k] = Math.round((pcts[k] * factor) * 10) / 10; });
    return out;
  }

  /** Sainte-Laguë simplifiée — alignée sur allocateSainteLague (lib/an1t.ts) */
  function sainteLagueSim(proportions, totalSeats = TOTAL_SEATS) {
    // proportions: [{id, label, color, pct}]
    let sumPct = proportions.reduce((s, p) => s + Math.max(0, p.pct || 0), 0);
    if (sumPct < 0.001) sumPct = 1;
    const scaled = proportions.map(p => ({
      ...p,
      votes: (Math.max(0, p.pct || 0) / sumPct) * 100000
    }));

    // Pas de seuil pour la démo pluralité pure (comme demandé)
    const eligible = scaled.filter(s => s.votes > 0.001);
    if (eligible.length === 0) {
      return proportions.map(p => ({ ...p, seats: 0, pctSeats: '0.0' }));
    }

    let seatCounts = new Map(eligible.map(e => [e.id, 0]));
    let allocated = 0;

    while (allocated < totalSeats) {
      let bestQ = -1;
      let bestId = null;
      for (const item of eligible) {
        const s = seatCounts.get(item.id) || 0;
        const q = item.votes / (2 * s + 1);
        if (q > bestQ) {
          bestQ = q;
          bestId = item.id;
        }
      }
      if (!bestId) break;
      seatCounts.set(bestId, (seatCounts.get(bestId) || 0) + 1);
      allocated++;
      if (allocated > totalSeats * 1.5) break; // safety
    }

    return proportions.map(p => {
      const seats = seatCounts.get(p.id) || 0;
      const pctSeats = totalSeats > 0 ? ((seats / totalSeats) * 100).toFixed(1) : '0.0';
      return { ...p, seats, pctSeats };
    }).sort((a, b) => b.seats - a.seats || (b.pct - a.pct));
  }

  function updateTotals() {
    const ids = BLOCS.map(b => b.id);
    let total = 0;
    ids.forEach(id => {
      const range = document.getElementById('pct-' + id);
      const valSpan = document.getElementById('val-' + id);
      if (range && valSpan) {
        const v = parseFloat(range.value) || 0;
        valSpan.textContent = v.toFixed(1);
        total += v;
      }
    });
    const totEl = document.getElementById('sim-total-text');
    const warn = document.getElementById('sim-total-warning');
    if (totEl) totEl.textContent = `Total : ${total.toFixed(1)} %`;
    if (warn) {
      const diff = Math.abs(total - 100);
      warn.hidden = diff < 1.5;
    }
    return total;
  }

  function getCurrentShares() {
    return BLOCS.map(b => {
      const el = document.getElementById('pct-' + b.id);
      return {
        id: b.id,
        label: b.label,
        color: b.color,
        pct: parseFloat(el ? el.value : '0') || 0
      };
    });
  }

  function renderSeats(results) {
    const container = document.getElementById('sim-seats-table');
    if (!container) return;
    container.innerHTML = '';
    let totalS = 0;

    results.forEach(r => {
      totalS += r.seats;
      const row = document.createElement('div');
      row.className = 'seat-row';
      const barW = Math.max(3, Math.round((r.seats / TOTAL_SEATS) * 210));
      row.innerHTML = `
        <span class="swatch" style="background:${r.color};width:10px;height:10px;border-radius:2px;flex-shrink:0;"></span>
        <span class="label"><strong>${r.label}</strong></span>
        <span class="seat-bar" style="width:${barW}px; background:${r.color};" aria-hidden="true"></span>
        <span class="seat-num"><strong>${r.seats}</strong> sièges <span style="opacity:0.7;">(${r.pctSeats}%)</span></span>
      `;
      container.appendChild(row);
    });

    const tot = document.createElement('div');
    tot.className = 'meta';
    tot.style.marginTop = '0.25rem';
    tot.style.fontSize = '0.8rem';
    tot.textContent = `Total calculé : ${totalS} / ${TOTAL_SEATS} sièges`;
    container.appendChild(tot);
  }

  function renderCompare(results) {
    const box = document.getElementById('sim-compare');
    const tbl = document.getElementById('sim-compare-table');
    if (!box || !tbl) return;

    tbl.innerHTML = '';
    const header = document.createElement('div');
    header.className = 'compare-row compare-header';
    header.innerHTML = `<span>Bloc</span><span>Proportionnel (sim)</span><span>Système actuel (2024)</span><span>Δ</span>`;
    tbl.appendChild(header);

    let totalSim = 0;
    results.forEach(r => {
      totalSim += r.seats;
      const real = REAL_2024[r.id] || 0;
      const delta = r.seats - real;
      const row = document.createElement('div');
      row.className = 'compare-row';
      const deltaClass = delta > 0 ? 'pos' : (delta < 0 ? 'neg' : '');
      row.innerHTML = `
        <span><span class="swatch" style="background:${r.color};width:8px;height:8px;border-radius:1px;display:inline-block;margin-right:4px;"></span>${r.label}</span>
        <span><strong>${r.seats}</strong> <span class="meta">(${r.pctSeats}%)</span></span>
        <span>${real} <span class="meta">sièges</span></span>
        <span class="delta ${deltaClass}">${delta > 0 ? '+' : ''}${delta}</span>
      `;
      tbl.appendChild(row);
    });

    box.hidden = false;
  }

  /** Mini hémicycle proportionnel (SVG simple, intégration visuelle) */
  function renderMiniHemicycle(results) {
    const wrap = document.getElementById('sim-hemicycle');
    const svg = document.getElementById('mini-svg');
    if (!wrap || !svg) return;

    svg.innerHTML = ''; // clear

    // Background arc
    const bg = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    bg.setAttribute('d', 'M 30 95 Q 180 15 330 95');
    bg.setAttribute('fill', 'none');
    bg.setAttribute('stroke', '#333');
    bg.setAttribute('stroke-width', '18');
    bg.setAttribute('opacity', '0.6');
    svg.appendChild(bg);

    // Distribute seats visually (sample representative dots)
    const totalDots = 64; // visual scale, not literal 577
    let placed = 0;
    const dots = [];

    results.forEach(r => {
      const n = Math.max(1, Math.round((r.seats / TOTAL_SEATS) * totalDots));
      for (let i = 0; i < n && placed < totalDots; i++) {
        dots.push({ color: r.color, label: r.label, seats: r.seats });
        placed++;
      }
    });

    // Place along arc (parametric)
    dots.forEach((d, i) => {
      const t = i / Math.max(1, dots.length - 1);
      // arc approx
      const x = 30 + t * 300;
      const y = 95 - Math.sin(t * Math.PI) * 78;
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', x.toFixed(1));
      c.setAttribute('cy', y.toFixed(1));
      c.setAttribute('r', '2.8');
      c.setAttribute('fill', d.color);
      c.setAttribute('stroke', '#111');
      c.setAttribute('stroke-width', '0.4');
      c.innerHTML = `<title>${d.label} — ~${Math.round(d.seats)} sièges</title>`;
      svg.appendChild(c);
    });

    // Center label
    const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    txt.setAttribute('x', '180');
    txt.setAttribute('y', '102');
    txt.setAttribute('text-anchor', 'middle');
    txt.setAttribute('font-size', '12');
    txt.setAttribute('font-weight', '700');
    txt.setAttribute('fill', '#ddd');
    txt.textContent = `${TOTAL_SEATS}`;
    svg.appendChild(txt);

    wrap.hidden = false;
  }

  function runSimulation(showAll = true) {
    const shares = getCurrentShares();
    const results = sainteLagueSim(shares, TOTAL_SEATS);

    const resBox = document.getElementById('sim-results');
    if (resBox) resBox.hidden = false;

    renderSeats(results);

    if (showAll) {
      renderCompare(results);
      renderMiniHemicycle(results);
    }
  }

  function applyPreset(key) {
    const map = PRESETS[key] || PRESETS.reset;
    const normalized = normalize(map);

    BLOCS.forEach(b => {
      const val = normalized[b.id] ?? b.defaultPct;
      const r = document.getElementById('pct-' + b.id);
      const n = document.getElementById('num-' + b.id);
      if (r) r.value = val;
      if (n) n.value = val;
    });
    updateTotals();
    runSimulation(true);
  }

  function syncNumToRange(id, fromNum) {
    const r = document.getElementById('pct-' + id);
    const n = document.getElementById('num-' + id);
    const valEl = document.getElementById('val-' + id);
    if (!r || !n) return;
    const v = parseFloat(fromNum ? n.value : r.value) || 0;
    const clamped = Math.max(0, Math.min(100, Math.round(v * 2) / 2));
    r.value = clamped;
    n.value = clamped;
    if (valEl) valEl.textContent = clamped.toFixed(1);
    updateTotals();
  }

  function init() {
    const ids = BLOCS.map(b => b.id);

    // Sliders + numeric sync
    ids.forEach(id => {
      const range = document.getElementById('pct-' + id);
      const num = document.getElementById('num-' + id);
      const valSpan = document.getElementById('val-' + id);

      if (range) {
        range.addEventListener('input', () => {
          if (num) num.value = range.value;
          if (valSpan) valSpan.textContent = parseFloat(range.value).toFixed(1);
          updateTotals();
        });
      }
      if (num) {
        num.addEventListener('input', () => {
          syncNumToRange(id, true);
        });
        num.addEventListener('blur', () => {
          syncNumToRange(id, true);
        });
      }
    });

    // Presets
    document.querySelectorAll('.preset-buttons [data-preset]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-preset');
        applyPreset(key);
      });
    });

    // Actions
    const btnCalc = document.getElementById('btn-calc');
    const btnCompare = document.getElementById('btn-compare');
    if (btnCalc) btnCalc.addEventListener('click', () => runSimulation(true));
    if (btnCompare) btnCompare.addEventListener('click', () => runSimulation(true));

    // Keyboard support
    const container = document.querySelector('.simulator');
    if (container) {
      container.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && (e.target.tagName === 'INPUT' || e.target.tagName === 'BUTTON')) {
          e.preventDefault();
          runSimulation(true);
        }
      });
    }

    // Init values
    updateTotals();

    // Auto-run once on load for immediate value (pedagogical)
    setTimeout(() => {
      const res = document.getElementById('sim-results');
      if (res && res.hidden !== false) {
        // keep hidden until user action or first explicit calc; but show seats on load for demo
        // runSimulation(false); // disabled to respect "user triggers" preference
      }
    }, 80);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Expose for debugging / integration if needed
  window.__LMDPT_SimulateurPluralite = { runSimulation, applyPreset };
</script>

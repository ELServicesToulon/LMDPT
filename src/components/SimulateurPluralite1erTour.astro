---
/**
 * Simulateur pluralité 1er tour — Outil citoyen simple et pédagogique.
 * - Sélection de scores % ou profils types (candidats/blocs 1er tour)
 * - Calcul sièges proportionnels via Sainte-Laguë simplifiée (aligné sur src/lib/an1t.ts)
 * - Affichage comparatif avec système actuel (résultats réels 2024 après 2 tours)
 * - Intégration visuelle : mini hémicycle proportionnel (SVG)
 * - Neutre, accessible (WCAG), mobile-first. Disclaimer pédagogique fort.
 *
 * Intégré sur /analyses/assemblee-premier-tour (AN1T).
 * Ne constitue PAS une prédiction. Illustration uniquement.
 */
interface Props {
  totalSeats?: number;
  defaultThreshold?: number; // 0 pour pédagogie pure pluralité (pas de seuil)
}

const { totalSeats = 577, defaultThreshold = 0 } = Astro.props;

const BLOCS = [
  { id: 'rn', label: 'Rassemblement national & alliés', color: '#0d378a', defaultPct: 32 },
  { id: 'nfp', label: 'Nouveau Front populaire', color: '#cc2443', defaultPct: 24 },
  { id: 'ensemble', label: 'Ensemble / centre', color: '#ffeb00', defaultPct: 14 },
  { id: 'lr', label: 'Droite républicaine', color: '#0066cc', defaultPct: 10 },
  { id: 'autres', label: 'Autres & divers', color: '#dddddd', defaultPct: 20 },
];

// Réels 2024 (après 2nd tour, regroupés blocs comparables) — source analyse LMDPT / données officielles
const REAL_2024 = { rn: 125, nfp: 182, ensemble: 99, lr: 47, autres: 124 };

// Agrégat approximatif voix T1 2024 (blocs LMDPT, pour preset "Réel 1er tour 2024")
const T1_2024_PCTS = { rn: 33.0, nfp: 28.0, ensemble: 20.0, lr: 6.5, autres: 12.5 };
---

<section class="simulator card" aria-labelledby="sim-title">
  <h3 id="sim-title">Simulateur pluralité du 1er tour</h3>

  <p class="meta">
    Ajustez les parts de voix au <strong>premier tour</strong> (somme ~100&nbsp;%). 
    Le calculateur applique une <strong>répartition proportionnelle nationale simplifiée (méthode Sainte-Laguë du projet)</strong>.
  </p>

  <!-- Sélection scores ou profils types -->
  <div class="sim-controls">
    <fieldset class="sim-fieldset">
      <legend class="sim-legend">1. Scores au 1er tour (en %)</legend>

      <div class="sim-sliders" id="sim-sliders">
        {BLOCS.map((b) => (
          <div class="sim-row" data-id={b.id}>
            <label for={`pct-${b.id}`}>
              <span class="swatch" style={`background:${b.color}`}></span>
              {b.label}
              <span class="val" id={`val-${b.id}`}>{b.defaultPct}</span>%
            </label>
            <div class="input-row">
              <input
                type="range"
                id={`pct-${b.id}`}
                min="0"
                max="60"
                step="0.5"
                value={b.defaultPct}
                aria-describedby={`val-${b.id}`}
              />
              <input
                type="number"
                id={`num-${b.id}`}
                min="0"
                max="100"
                step="0.5"
                value={b.defaultPct}
                class="num-input"
                aria-label={`${b.label} pourcentage`}
              />
            </div>
          </div>
        ))}
      </div>

      <div class="sim-total" aria-live="polite">
        <span id="sim-total-text">Total : 100 %</span>
        <span id="sim-total-warning" class="warning-text" hidden>⚠ Ajustez pour approcher 100&nbsp;%</span>
      </div>
    </fieldset>

    <!-- Sélection candidat type / profils -->
    <div class="sim-presets">
      <div class="sim-legend">Ou choisissez un profil type</div>
      <div class="preset-buttons" role="group" aria-label="Profils types de pluralité 1er tour">
        <button type="button" class="btn btn-secondary" data-preset="t1-2024">Réel 1er tour 2024 (agrégé)</button>
        <button type="button" class="btn btn-secondary" data-preset="equilibre">Pluralité équilibrée</button>
        <button type="button" class="btn btn-secondary" data-preset="rn-fort">RN &amp; alliés fort</button>
        <button type="button" class="btn btn-secondary" data-preset="gauche-fort">Gauche unie forte</button>
        <button type="button" class="btn btn-secondary" data-preset="centre">Centre élargi</button>
        <button type="button" class="btn btn-secondary" data-preset="reset">Réinitialiser</button>
      </div>
      <p class="meta small">Ces profils sont des exemples pédagogiques basés sur des agrégats historiques ou hypothèses neutres.</p>
    </div>
  </div>

  <div class="sim-actions">
    <button type="button" id="btn-calc" class="btn btn-primary">Calculer les sièges proportionnels</button>
    <button type="button" id="btn-compare" class="btn btn-secondary">Afficher comparaison + hémicycle</button>
  </div>

  <!-- Résultats -->
  <div id="sim-results" class="sim-results" aria-live="polite" hidden>
    <h4>Répartition proportionnelle (Sainte-Laguë, {totalSeats} sièges)</h4>

    <div id="sim-seats-table" class="seats-table"></div>

    <!-- Comparatif système actuel -->
    <div id="sim-compare" class="compare-section" hidden>
      <h4>Comparaison avec le système actuel (résultats réels 2024)</h4>
      <p class="meta small">
        Le système français est <strong>uninominal majoritaire à deux tours</strong> (pas proportionnel). 
        Voici l’écart entre une répartition pure des voix T1 et les sièges réellement attribués après le 2nd tour.
      </p>
      <div id="sim-compare-table" class="compare-table"></div>
    </div>

    <!-- Intégration visuelle hémicycle hybride simplifié -->
    <div id="sim-hemicycle" class="mini-hemicycle" hidden>
      <h4>Visualisation : hémicycle proportionnel (basé sur vos scores)</h4>
      <div class="hemicycle-mini">
        <svg id="mini-svg" viewBox="0 0 360 120" width="100%" height="auto" role="img" aria-label="Mini hémicycle proportionnel — sièges distribués selon les parts de voix saisies">
          <desc>Chaque cercle représente des sièges (échelle réduite pour lisibilité). Couleurs par bloc.</desc>
          <!-- seats populated by JS -->
        </svg>
      </div>
      <p class="meta small">Hémicycle simplifié (pas hybride complet — structure proportionnelle pure). Pour l’hémicycle hybride détaillé (groupes actuels + projection), voir plus bas sur la page.</p>
    </div>

    <div class="disclaimer">
      <strong>⚠ Outil pédagogique uniquement.</strong><br>
      Ce simulateur illustre l’impact d’une répartition proportionnelle des voix du <em>premier tour</em> (Sainte-Laguë simplifiée, agrégation nationale, seuil 0&nbsp;% pour démonstration). 
      Il ne prédit rien. Il ne remplace pas le scrutin réel uninominal à deux tours. Les scores saisis sont fictifs ou illustratifs. 
      Données réelles 2024 : Ministère de l’Intérieur / data.gouv.fr. LMDPT documente la pluralité, sans recommandation.
    </div>
  </div>
</section>

<style>
  .simulator {
    border-left: 4px solid var(--accent);
  }
  .sim-fieldset {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 0.85rem;
    margin: 0.5rem 0;
  }
  .sim-legend {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0 0.35rem;
    color: var(--muted);
  }
  .sim-sliders {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .sim-row {
    font-size: 0.82rem;
  }
  .sim-row label {
    display: block;
    margin-bottom: 0.15rem;
    line-height: 1.25;
  }
  .sim-row .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    margin-right: 4px;
    vertical-align: middle;
  }
  .sim-row .val {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .input-row {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .sim-row input[type="range"] {
    flex: 1;
    accent-color: var(--accent);
    height: 26px;
  }
  .num-input {
    width: 62px;
    font-size: 0.82rem;
    padding: 2px 4px;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--card);
    color: inherit;
    font-variant-numeric: tabular-nums;
  }
  .sim-total {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    font-family: system-ui, sans-serif;
  }
  .warning-text {
    color: #b45309;
    margin-left: 0.5rem;
    font-size: 0.78rem;
  }
  .sim-presets {
    margin-top: 0.6rem;
  }
  .preset-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .preset-buttons .btn {
    font-size: 0.78rem;
    padding: 3px 8px;
  }
  .sim-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0.6rem 0 0.3rem;
  }
  .sim-results {
    margin-top: 0.8rem;
    padding: 0.7rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .sim-results h4 {
    margin: 0 0 0.4rem;
    font-size: 0.95rem;
  }
  .seats-table {
    font-size: 0.85rem;
    font-family: system-ui, sans-serif;
  }
  .seat-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0;
    border-bottom: 1px dotted var(--border);
  }
  .seat-row:last-child { border-bottom: none; }
  .seat-row .label { min-width: 170px; flex: 0 0 auto; }
  .seat-bar {
    height: 11px;
    border-radius: 2px;
    flex: 0 0 auto;
    min-width: 3px;
  }
  .seat-num {
    font-variant-numeric: tabular-nums;
    min-width: 3.2rem;
    text-align: right;
  }

  .compare-section {
    margin-top: 0.9rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }
  .compare-table {
    font-size: 0.82rem;
    margin-top: 0.4rem;
  }
  .compare-row {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 0.4rem;
    align-items: center;
    padding: 0.15rem 0;
  }

---
import type { CirconscriptionResult } from '../lib/election-types';
import { formatPct } from '../lib/elections';
import { legendForNuances, nuanceColor, nuanceLabel } from '../lib/circonscriptions';

interface Props {
  circonscriptions: CirconscriptionResult[];
  electionSlug: string;
  /** true = élus (T1/T2) plutôt que leaders du 1er tour */
  seatMode?: boolean;
}

const { circonscriptions, seatMode = false } = Astro.props;
const hasEluTour = seatMode || circonscriptions.some((c) => c.elu_tour != null);
const titleText = hasEluTour
  ? '577 circonscriptions — élus (2nd tour réel)'
  : '577 circonscriptions — leader au 1er tour';
const descText = hasEluTour
  ? 'Une ligne par siège : député élu, nuance et part des exprimés. 501 élus au 2nd tour, 76 dès le 1er. Données officielles Intérieur / data.gouv.fr.'
  : 'Une ligne par circonscription : candidat en tête, nuance et part des suffrages exprimés. Données officielles agrégées depuis data.gouv.fr. Utilisez les filtres pour explorer (clavier et lecteur d\'écran compatibles).';
const statsLabel = hasEluTour
  ? 'Répartition rapide des élus par circonscription'
  : 'Répartition rapide des leaders au 1er tour';
const captionText = hasEluTour
  ? `${circonscriptions.length} sièges — élu (nuance officielle, % exprimés, tour de pourvoi). Défilement horizontal disponible ; filtres département et recherche au-dessus.`
  : `${circonscriptions.length} circonscriptions — leader au 1er tour (nuance officielle, % exprimés, qualification T2). Défilement horizontal disponible ; filtres département et recherche au-dessus.`;

const nuanceCodes = [...new Set(circonscriptions.map((c) => c.leader_nuance_code))];
const legend = legendForNuances(nuanceCodes);

const byDept = new Map<string, CirconscriptionResult[]>();
for (const c of circonscriptions) {
  const list = byDept.get(c.departement) ?? [];
  list.push(c);
  byDept.set(c.departement, list);
}
const departements = [...byDept.keys()].sort();
---

<section class="card circo-block" aria-labelledby="circo-title">
  <h3 id="circo-title">{titleText}</h3>
  <p class="meta" id="circo-desc">
    {descText}
  </p>

  <!-- Stats rapides pédagogiques pour lisibilité -->
  <div class="circo-stats" aria-label={statsLabel}>
    <span class="stat">Total circonscriptions : <strong>{circonscriptions.length}</strong></span>
    <span class="stat">Départements : <strong>{departements.length}</strong></span>
  </div>

  <div class="legend" aria-label="Légende des nuances">
    {
      legend.slice(0, 8).map((item) => (
        <span class="legend-item">
          <span class="swatch" style={`background:${item.color}`} />
          {item.label}
        </span>
      ))
    }
  </div>

  <div class="filters" role="search" aria-label="Filtrer les circonscriptions">
    <label class="filter">
      Filtrer par département
      <select id="dept-filter" aria-controls="circo-table">
        <option value="">Tous ({circonscriptions.length})</option>
        {
          departements.map((d) => (
            <option value={d}>
              {d} ({byDept.get(d)?.length ?? 0})
            </option>
          ))
        }
      </select>
    </label>

    <label class="filter">
      Rechercher (nom, candidat, nuance)
      <input 
        type="search" 
        id="circo-search" 
        placeholder="Ex: Paris, Bardella, RN..." 
        aria-controls="circo-table"
        autocomplete="off"
      />
    </label>
    <div id="filter-count" class="meta" aria-live="polite" style="margin-top:0.25rem; font-size:0.82rem;"></div>
  </div>

  <div
    class="table-wrap"
    role="region"
    aria-labelledby="circo-title"
    tabindex="0"
  >
    <table id="circo-table" aria-describedby="circo-desc">
      <caption class="table-caption">
        {captionText}
      </caption>
      <thead>
        <tr>
          <th scope="col">Circonscription</th>
          <th scope="col">Dépt.</th>
          <th scope="col">{hasEluTour ? 'Élu' : 'Leader'}</th>
          <th scope="col">Nuance</th>
          <th scope="col">%</th>
          <th scope="col">{hasEluTour ? 'Tour' : 'T2'}</th>
        </tr>
      </thead>
      <tbody>
        {
          circonscriptions.map((c) => (
            <tr data-dept={c.departement}>
              <th scope="row">
                <span class="circo-name">{c.nom}</span>
                <span class="meta circo-code">{c.code}</span>
              </th>
              <td>{c.departement}</td>
              <td>
                {c.leader_prenom} {c.leader_nom}
              </td>
              <td>
                <span class="nuance-pill" style={`--nuance-color:${nuanceColor(c.leader_nuance_code)}`}>
                  {nuanceLabel(c.leader_nuance_code, c.leader_nuance)}
                </span>
              </td>
              <td class="num">{formatPct(c.leader_pct)}</td>
              <td>
                {hasEluTour
                  ? c.elu_tour === 1
                    ? 'Élu T1'
                    : 'Élu T2'
                  : c.qualifie_t2
                    ? 'Oui'
                    : '—'}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const select = document.getElementById('dept-filter') as HTMLSelectElement | null;
  const searchInput = document.getElementById('circo-search') as HTMLInputElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#circo-table tbody tr'));
  const countEl = document.getElementById('filter-count');

  function applyFilters() {
    const dept = select?.value || '';
    const q = (searchInput?.value || '').toLowerCase().trim();

    let visible = 0;
    rows.forEach((row) => {
      const rowDept = row.dataset.dept || '';
      const text = row.textContent?.toLowerCase() || '';
      const matchDept = !dept || rowDept === dept;
      const matchSearch = !q || text.includes(q);
      const show = matchDept && matchSearch;
      row.hidden = !show;
      if (show) visible++;
    });

    if (countEl) {
      countEl.textContent = `${visible} circonscription${visible > 1 ? 's' : ''} affichée${visible > 1 ? 's' : ''}`;
    }
  }

  select?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);

  // init count
  if (countEl) countEl.textContent = `${rows.length} circonscriptions au total`;
</script>

<style>
  .circo-block {
    margin: 1.5rem 0;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.75rem 0 1rem;
    font-size: 0.85rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    display: inline-block;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: flex-end;
  }
  .filter {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
    min-width: 180px;
    flex: 1 1 220px;
  }
  .filter select,
  .filter input[type="search"] {
    max-width: 100%;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--border, #ccc);
    border-radius: 4px;
    font-size: 0.9rem;
  }
  .filter input[type="search"] {
    min-width: 160px;
  }
  .table-wrap {
    overflow: auto;
    max-height: min(70vh, 36rem);
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border, #ddd);
    border-radius: 8px;
    outline-offset: 2px;
  }
  .table-wrap:focus {
    outline: 2px solid var(--accent, #2c5282);
  }
  .table-caption {
    caption-side: top;
    text-align: left;
    padding: 0.5rem 0.65rem;
    font-size: 0.82rem;
    color: var(--muted, #555);
    line-height: 1.4;
    background: var(--card, #fff);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    min-width: 520px;
  }
  th,
  td {
    padding: 0.45rem 0.6rem;
    text-align: left;
    border-bottom: 1px solid var(--border, #eee);
    vertical-align: top;
  }
  thead th {
    position: sticky;
    top: 0;
    background: var(--card-bg, var(--bg, var(--card)));
    color: var(--fg);
    z-index: 2;
    box-shadow: 0 1px 0 var(--border, #ddd);
  }
  tbody th[scope='row'] {
    font-weight: 600;
    position: sticky;
    left: 0;
    background: var(--card, #fff);
    z-index: 1;
    min-width: 9rem;
  }
  .num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .circo-name {
    display: block;
  }
  .circo-code {
    font-size: 0.75rem;
  }
  .nuance-pill {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--nuance-color) 18%, transparent);
    border-left: 3px solid var(--nuance-color);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .circo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.4rem 0 0.6rem;
    font-size: 0.82rem;
    font-family: system-ui, sans-serif;
  }
  .circo-stats .stat {
    background: var(--accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
  }

  /* Mobile responsiveness for circo table viz */
  @media (max-width: 640px) {
    .table-wrap { max-height: 22rem; }
    table { font-size: 0.78rem; min-width: 480px; }
    th, td { padding: 0.3rem 0.4rem; }
    .filters { flex-direction: column; }
    .filter { width: 100%; }
    .circo-stats { font-size: 0.76rem; }
  }
  @media (max-width: 420px) {
    table { font-size: 0.72rem; min-width: 440px; }
  }
</style>
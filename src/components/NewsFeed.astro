---
import type { RenifleurItem } from '../lib/renifleur';
import { ensureItemPoliticalHue } from '../lib/renifleur';
import { hueBadgesForText, type HueBadge } from '../lib/comment-politics';
import PoliticalHueBadges from './PoliticalHueBadges.astro';

interface Props {
  items: RenifleurItem[];
  limit?: number;
  disclaimer?: string;
  fetchedAt?: string;
  feedsOk?: number;
  moreHref?: string;
}

const {
  items,
  limit = 6,
  disclaimer,
  fetchedAt,
  feedsOk,
  moreHref = '/analyses/presidentielle-2027-preparation#renifleur-presse',
} = Astro.props;

function huesForItem(item: RenifleurItem): HueBadge[] {
  const fromText = hueBadgesForText(`${item.title}\n${item.summary ?? ''}`, 3);
  if (fromText.length > 0) return fromText;
  if (item.politicalHue?.slug && item.politicalHue?.color) {
    return [
      {
        slug: item.politicalHue.slug,
        label: item.politicalHue.label,
        color: item.politicalHue.color,
        rationale: item.politicalHue.rationale,
        confidence: item.politicalHue.confidence,
      },
    ];
  }
  return [{ slug: 'pluraliste', label: 'Pluraliste / transversal 1er tour', color: '#5a6570' }];
}

const visible = items.slice(0, limit).map((raw) => {
  const item = ensureItemPoliticalHue(raw);
  return { item, hues: huesForItem(item) };
});
const updatedLabel = fetchedAt
  ? new Date(fetchedAt).toLocaleString('fr-FR', { dateStyle: 'long', timeStyle: 'short' })
  : null;
const [featured, ...rest] = visible;
---

<section class="news-section" aria-labelledby="news-heading">
  <div class="section-head">
    <div>
      <p class="eyebrow">Veille presse</p>
      <h2 id="news-heading">Dernières actualités</h2>
    </div>
    {
      updatedLabel && (
        <p class="sync-meta">
          <time datetime={fetchedAt}>{updatedLabel}</time>
          {feedsOk != null && <span> · {feedsOk} flux</span>}
        </p>
      )
    }
  </div>

  {disclaimer && <p class="news-disclaimer">{disclaimer}</p>}
  {
    featured && (
      <article
        class="news-featured card"
        style={`border-left: 4px solid ${featured.hues[0]?.color ?? '#5a6570'}`}
        data-hue={featured.hues[0]?.slug}
      >
        <div class="news-meta-row">
          <time class="news-date" datetime={featured.item.published}>
            {new Date(featured.item.published).toLocaleDateString('fr-FR', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          <span class="news-source">{featured.item.source_label}</span>
          <PoliticalHueBadges hues={featured.hues} size="sm" />
        </div>
        <h3>
          <a href={featured.item.url} rel="noopener noreferrer">
            {featured.item.title}
          </a>
        </h3>
        {featured.item.summary && <p class="news-summary">{featured.item.summary}</p>}
      </article>
    )
  }

  {
    rest.length > 0 && (
      <ul class="news-grid">
        {
          rest.map(({ item, hues }) => (
            <li>
              <article
                class="news-card card"
                style={`border-left: 4px solid ${hues[0]?.color ?? '#5a6570'}`}
                data-hue={hues[0]?.slug}
              >
                <div class="news-meta-row">
                  <time class="news-date" datetime={item.published}>
                    {new Date(item.published).toLocaleDateString('fr-FR', {
                      day: 'numeric',
                      month: 'short',
                    })}
                  </time>
                  <span class="news-source">{item.source_label}</span>
                  <PoliticalHueBadges hues={hues} size="sm" />
                </div>
                <h4>
                  <a href={item.url} rel="noopener noreferrer">
                    {item.title}
                  </a>
                </h4>
                {item.summary && <p class="news-summary">{item.summary.slice(0, 140)}…</p>}
              </article>
            </li>
          ))
        }
      </ul>
    )
  }

  <p class="news-more">
    <a href={moreHref}>Toute la veille 2027 →</a>
    {' '}·{' '}
    <a href="/analyses/presidentielle-2027-preparation">Dossier présidentielle</a>
    {' '}·{' '}
    <a href="/charte">Charte des couleurs</a>
  </p>
</section>

<style>
  /* =====================================================
     VEILLE PRESSE — cartes + teinte politique IA
     - Swatch / pastille couleur 1er tour
     - Bordure latérale = même teinte
     - WCAG friendly (label texte + title)
  ===================================================== */
  .news-section {
    margin-bottom: 2.5rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0.75rem;
  }

  .section-head h2 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
  }

  .sync-meta {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .news-disclaimer {
    margin: 0 0 0.55rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    max-width: 70ch;
  }

  .news-featured {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.25rem;
    margin-bottom: 1rem;
  }

  .news-featured h3 {
    margin: 0.35rem 0 0.6rem;
    font-size: 1.18rem;
    line-height: 1.3;
    font-weight: 600;
  }

  .news-featured h3 a {
    text-decoration: none;
    color: inherit;
  }

  .news-featured h3 a:hover {
    color: var(--accent);
  }

  .news-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.55rem;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .news-date {
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .news-source {
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--accent-soft);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .news-summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg);
  }

  .news-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .news-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.95rem 1.1rem;
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .news-card:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    box-shadow: 0 4px 14px -4px rgb(0 0 0 / 0.1);
  }

  .news-card a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .news-card h4 {
    margin: 0.25rem 0 0.35rem;
    font-size: 1.02rem;
    line-height: 1.35;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .news-section {
      margin-bottom: 1.75rem;
    }
    .section-head h2 {
      font-size: 1.28rem;
    }
    .news-featured {
      padding: 0.95rem 1rem;
    }
    .news-featured h3 {
      font-size: 1.08rem;
    }
    .news-card {
      padding: 0.85rem 0.95rem;
    }
    .news-summary {
      font-size: 0.95rem;
    }
  }

  .news-card h4 a {
    text-decoration: none;
    color: inherit;
  }

  .news-card h4 a:hover {
    color: var(--accent);
  }

  .news-card .news-summary {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .news-more {
    margin: 1.1rem 0 0;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }
</style>

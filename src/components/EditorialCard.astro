---
import EditorialCoverImage from './EditorialCoverImage.astro';
import { coverFileExists, editorialKindLabel, resolveCover, type EditorialPost } from '../lib/editorial';
import { withTrailingSlash } from '../lib/internal-path';

interface Props {
  post: EditorialPost;
  badge?: string;
  /** Libellé devant la date, ex. « Ouvert le ». */
  datePrefix?: string;
}

const { post, badge, datePrefix } = Astro.props;
const cover = resolveCover(post.cover);
const showCover = !cover.missing && coverFileExists(cover.src);
const kindLabel = editorialKindLabel(post.kind);
const dateLabel = new Date(post.date).toLocaleDateString('fr-FR', { dateStyle: 'long' });
---

<article class="card editorial-card" data-editorial-kind={post.kind} data-editorial-slug={post.slug}>
  {
    showCover && (
      <a class="editorial-card-media" href={withTrailingSlash(post.href)} tabindex="-1" aria-hidden="true">
        <EditorialCoverImage cover={post.cover} />
      </a>
    )
  }
  <p class="eyebrow">{kindLabel}</p>
  <h3>
    <a href={withTrailingSlash(post.href)}>{post.title}</a>
    {badge && <span class="status-badge status-badge--open">{badge}</span>}
  </h3>
  <p>{post.description}</p>
  <p class="meta">
    {datePrefix}
    <time datetime={post.date}>{dateLabel}</time>
  </p>
</article>

<style>
  .editorial-card-media {
    display: block;
    text-decoration: none;
  }
  .editorial-card-media :global(.editorial-cover) {
    margin-bottom: 0.75rem;
  }
</style>

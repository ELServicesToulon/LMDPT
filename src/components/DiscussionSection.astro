---
import { discussionConfig, getDiscussionUrl, getGiscusEmbed } from '../config/discussion';

interface Props {
  discussionId?: string;
  question: string;
}

const { discussionId, question } = Astro.props;
const showEmbed = discussionConfig.enabled && discussionId;
const discussionUrl = discussionId ? getDiscussionUrl(discussionId) : discussionConfig.discussionsUrl;
const giscus = discussionId ? getGiscusEmbed(discussionId) : null;
const nextPath = Astro.url.pathname.replace(/\/+$/, '') || '/debats';
const nextQ = encodeURIComponent(`${nextPath}#commentaires-citoyens`);
---

<section class="discussion-section" aria-labelledby="discussion-title">
  <h3 id="discussion-title">Poursuivre le débat</h3>
  <p>
    Identifiez-vous avec votre <strong>compte lecteur LMDPT</strong> (Google, X ou email) — un seul
    compte pour commenter sur le site. Teinte politique liée au <em>message</em>, pas à votre
    identité de compte.
  </p>
  <p class="discussion-cta">
    <a class="btn" href={`/connexion?next=${nextQ}`}>Se connecter</a>
    <a class="btn btn-secondary" href="#commentaires-citoyens">Commentaires citoyens ↓</a>
  </p>
  <p class="meta">
    Charte :{' '}
    <a href="/charte">participation</a>
    {' '}·{' '}
    <a href="/compte">Mon compte</a>
    {' '}· archive technique GitHub (hors identité site) :{' '}
    <a href={discussionUrl} rel="noopener noreferrer">« {question} » →</a>
  </p>

  {
    showEmbed ? (
      <div class="giscus-wrap">
        <p class="meta">
          Embed Giscus activé (opt-in <code>PUBLIC_GISCUS_EMBED=1</code>) — login GitHub distinct du
          compte LMDPT.
        </p>
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={discussionConfig.repo}
          data-repo-id={discussionConfig.repoId}
          data-category={discussionConfig.category}
          data-category-id={discussionConfig.categoryId}
          data-mapping={giscus?.mapping ?? discussionConfig.mapping}
          data-term={giscus?.term ?? discussionId}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme={discussionConfig.theme}
          data-lang={discussionConfig.lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    ) : null
  }
</section>

<style>
  .discussion-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .discussion-section h3 {
    margin: 0 0 0.75rem;
  }
  .discussion-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  .giscus-wrap {
    margin-top: 1.25rem;
    min-height: 8rem;
  }
  .btn {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
  }
  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
</style>

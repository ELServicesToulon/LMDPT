---
import { discussionConfig, getDiscussionUrl, getGiscusEmbed } from '../config/discussion';

interface Props {
  discussionId?: string;
  question: string;
}

const { discussionId, question } = Astro.props;
const showEmbed = discussionConfig.enabled && discussionId;
const discussionUrl = discussionId ? getDiscussionUrl(discussionId) : discussionConfig.discussionsUrl;
const giscus = discussionId ? getGiscusEmbed(discussionId) : null;
---

<section class="discussion-section">
  <h3>Poursuivre le débat</h3>
  <p>
    Utilisez le module <strong>Commentaires citoyens</strong> en bas de page (reformulation IA,
    teinte d’idées du 1er tour, validation, modération). Charte :{' '}
    <a href="https://github.com/ELServicesToulon/LMDPT/blob/Main/docs/EDITORIAL.md" rel="noopener noreferrer">
      éditorial LMDPT
    </a>.
  </p>
  <p class="meta">
    Option GitHub Discussions :
    <a href={discussionUrl} rel="noopener noreferrer">ouvrir « {question} » →</a>
  </p>

  {
    showEmbed ? (
      <div class="giscus-wrap">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={discussionConfig.repo}
          data-repo-id={discussionConfig.repoId}
          data-category={discussionConfig.category}
          data-category-id={discussionConfig.categoryId}
          data-mapping={giscus?.mapping ?? discussionConfig.mapping}
          data-term={giscus?.term ?? discussionId}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme={discussionConfig.theme}
          data-lang={discussionConfig.lang}
          data-loading="lazy"
          crossorigin="anonymous"
          async
        />
      </div>
    ) : null
  }
</section>

<style>
  .discussion-section {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .discussion-section h3 {
    margin: 0 0 0.75rem;
  }
  .giscus-wrap {
    margin-top: 1.25rem;
    min-height: 8rem;
  }
  .discussion-fallback {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--border);
    border-radius: 6px;
  }
  .btn {
    display: inline-block;
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
  }
  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
</style>

---
import type { CirconscriptionElectionDataset } from '../lib/election-types';
import deptPaths from '../data/geo/departments-paths.json';
import {
  aggregateDepartmentLeadersFromCircos,
  legendForNuances,
  nuanceColor,
  nuanceLabel,
} from '../lib/circonscriptions';

interface Props {
  dataset: CirconscriptionElectionDataset;
  electionSlug: string;
  /** Légende pédagogique (ex. « 1er tour 2024 » ou « élus 2024 (T1+T2) »). */
  tourLabel?: string;
}

const { dataset, electionSlug, tourLabel = '1er tour 2024' } = Astro.props;

const departmentNames = new Map(deptPaths.departements.map((d) => [d.code, d.nom]));
const departements = aggregateDepartmentLeadersFromCircos(dataset, departmentNames);
const byCode = new Map(departements.map((d) => [d.code, d]));

const payload = departements.map((d) => ({
  code: d.code,
  nom: d.nom,
  leader: d.leader_nuance_code,
  circoCount: d.circo_count,
  breakdown: d.breakdown.map((b) => ({
    code: b.code,
    count: b.count,
    avgPct: b.avg_pct,
  })),
}));

const leaderCodes = [...new Set(departements.map((d) => d.leader_nuance_code))];
const legend = legendForNuances(leaderCodes);
const allNuanceCodes = [...new Set(departements.flatMap((d) => d.breakdown.map((b) => b.code)))];
const nuanceLabelMap = Object.fromEntries(
  legendForNuances(allNuanceCodes).map((item) => [item.code, item.label]),
);

const svgPaths = deptPaths.departements
  .map((p) => {
    const result = byCode.get(p.code);
    const leader = result?.leader_nuance_code ?? 'unknown';
    const color = result ? nuanceColor(leader) : '#cccccc';
    const top = result?.breakdown[0];
    return {
      code: p.code,
      nom: p.nom,
      d: p.d,
      leader,
      color,
      circoCount: result?.circo_count ?? 0,
      topCount: top?.count ?? 0,
      hasData: Boolean(result),
    };
  })
  .filter((p) => p.hasData);

const overseas = departements.filter(
  (d) => !deptPaths.departements.some((p) => p.code === d.code),
);
---

<section class="dept-map" aria-labelledby="leg-dept-map-title">
  <h3 id="leg-dept-map-title">Carte — nuances en tête par département</h3>
  <p class="meta">
    Couleur = nuance en tête dans le plus de circonscriptions du département ({tourLabel}).
    Survolez ou cliquez pour le détail par circonscription. Traçabilité : {deptPaths.source_label}.
  </p>

  <div class="legend" aria-label="Légende des nuances">
    {
      legend.slice(0, 10).map((item) => (
        <span class="legend-item">
          <span class="swatch" style={`background:${item.color}`} />
          {item.label}
        </span>
      ))
    }
  </div>

  <label class="search-label">
    Rechercher
    <input
      type="search"
      id={`leg-dept-search-${electionSlug}`}
      placeholder="Nom ou code (ex. 13, Bouches-du-Rhône)"
      autocomplete="off"
    />
  </label>

  <div class="map-wrap">
    <svg
      viewBox={deptPaths.viewBox}
      role="img"
      aria-label={`Carte de France par département, colorée selon la nuance en tête (${tourLabel})`}
      class="france-map"
      id={`leg-france-map-${electionSlug}`}
    >
      {
        svgPaths.map((p) => (
          <path
            id={`leg-dept-path-${electionSlug}-${p.code}`}
            data-code={p.code}
            data-nom={p.nom.toLowerCase()}
            data-leader={p.leader}
            d={p.d}
            fill={p.color}
            fill-opacity="0.72"
            stroke="var(--border)"
            stroke-width="0.4"
            tabindex="0"
          >
            <title>
              {p.nom} ({p.code}) — {nuanceLabel(p.leader)} · {p.topCount}/{p.circoCount} circo.
            </title>
          </path>
        ))
      }
    </svg>
  </div>

  {
    overseas.length > 0 && (
      <section class="overseas">
        <h4>Outre-mer et circonscriptions spéciales</h4>
        <p class="meta">Non représentées sur la carte métropolitaine — résultats officiels identiques.</p>
        <ul class="overseas-list">
          {overseas.map((d) => {
            const top = d.breakdown[0];
            return (
              <li>
                <span class="swatch" style={`background:${nuanceColor(d.leader_nuance_code)}`} />
                <strong>{d.nom}</strong> ({d.code}) — {nuanceLabel(d.leader_nuance_code)} ·{' '}
                {top?.count ?? 0}/{d.circo_count} circo.
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <aside class="card dept-detail" id={`leg-dept-detail-${electionSlug}`} hidden>
    <h4 id={`leg-dept-detail-title-${electionSlug}`}>Détail</h4>
    <ol id={`leg-dept-detail-list-${electionSlug}`}></ol>
  </aside>
</section>

<script define:vars={{ payload, electionSlug, nuanceLabelMap }}>
  const search = document.getElementById(`leg-dept-search-${electionSlug}`);
  const svg = document.getElementById(`leg-france-map-${electionSlug}`);
  const detail = document.getElementById(`leg-dept-detail-${electionSlug}`);
  const detailTitle = document.getElementById(`leg-dept-detail-title-${electionSlug}`);
  const detailList = document.getElementById(`leg-dept-detail-list-${electionSlug}`);
  const byCode = new Map(payload.map((d) => [d.code, d]));

  function showDetail(code) {
    const data = byCode.get(code);
    if (!data || !detail || !detailTitle || !detailList) return;
    detail.hidden = false;
    detailTitle.textContent = `${data.nom} (${data.code}) — ${data.circoCount} circonscriptions`;
    detailList.replaceChildren();
    for (const b of data.breakdown) {
      const li = document.createElement('li');
      li.textContent = `${nuanceLabelMap[b.code] ?? b.code} — ${b.count} circo. (moy. ${b.avgPct.toFixed(1)} %)`;
      detailList.appendChild(li);
    }
  }

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    svg?.querySelectorAll('path[data-code]').forEach((path) => {
      const el = path;
      const nom = el.getAttribute('data-nom') ?? '';
      const code = el.getAttribute('data-code') ?? '';
      const match = !q || nom.includes(q) || code.includes(q);
      el.style.opacity = match ? '1' : '0.15';
    });
  });

  function bindPath(path) {
    path.addEventListener('click', () => {
      const code = path.getAttribute('data-code');
      if (code) showDetail(code);
    });
    path.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const code = path.getAttribute('data-code');
        if (code) showDetail(code);
      }
    });
  }

  svg?.querySelectorAll('path[data-code]').forEach((path) => bindPath(path));
</script>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    display: inline-block;
  }
  .search-label {
    display: block;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .search-label input {
    display: block;
    width: 100%;
    max-width: 24rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.5rem;
    font-size: 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--card);
    color: var(--fg);
  }
  .map-wrap {
    overflow-x: auto;
    margin-bottom: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem;
  }
  .france-map {
    width: 100%;
    max-width: 32rem;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .france-map path {
    cursor: pointer;
    transition: fill-opacity 0.15s ease;
  }
  .france-map path:hover,
  .france-map path:focus-visible {
    fill-opacity: 1;
    outline: 2px solid var(--accent);
    outline-offset: 0;
  }
  .dept-detail ol {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
  .overseas {
    margin-bottom: 1rem;
  }
  .overseas h4 {
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
  }
  .overseas-list {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
  }
  .overseas-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
</style>

---
/**
 * Bloc accueil compact — personnalités sourcées, prochaines dates,
 * classements d’intentions de vote 1er tour (une table par sondage,
 * mentions de la loi n° 77-808), dernière Une.
 */
import campagneJson from '../data/campagne.json';
import candidaturesDeclarees from '../data/elections/2027-candidatures-declarees.json';
import { SONDAGES_LIGNE } from '../lib/sondages-ligne';
import {
  cartesClinDoeil,
  formatCampagneDate,
  formatPeriodeEnquete,
  formatScore,
  getUneLienApercu,
  groupPersonnalites,
  ligneDeclaresSousCondition,
  personnaliteChipTitle,
  rankResultats,
  scrutinsMasquage,
  shouldHideSondage,
  statutPastille,
  type CampagneData,
} from '../lib/campagne';
import { withTrailingSlash } from '../lib/internal-path';

const campagne = campagneJson as CampagneData;
const groupes = groupPersonnalites(campagne.personnalites);
const hideSondage = shouldHideSondage(new Date(), campagne);
const une = getUneLienApercu();
const cartes = cartesClinDoeil({ data: campagne, une, now: new Date() });
const declaresSousCondition = ligneDeclaresSousCondition(
  candidaturesDeclarees.entries,
  campagne.liste_complete_href,
);
const updatedLabel = formatCampagneDate(campagne.updated, { weekday: false });
const uneHref = une ? withTrailingSlash(une.href) : '';
const semaineHref = cartes.semaine ? withTrailingSlash(cartes.semaine.href) : '';
const scrutinsDates = scrutinsMasquage(campagne).join(',');
const finMasquage = campagne.sondage.fin_masquage_heure || '20:00';
const miseAuPoint = campagne.sondage.mise_au_point;

function phrase(text: string): string {
  const trimmed = text.trim();
  if (!trimmed) return '';
  return /[.!?…]$/.test(trimmed) ? trimmed : `${trimmed}.`;
}
---

<section
  class="apercu-campagne card"
  id="apercu-campagne"
  aria-labelledby="apercu-campagne-title"
>
  <div class="apercu-head">
    <h2 id="apercu-campagne-title">{campagne.title}</h2>
  </div>

  <ul class="apercu-cartes" aria-labelledby="apercu-campagne-title">
    <li>
      <article class="apercu-carte" aria-labelledby="apercu-carte-candidats">
        <h3 id="apercu-carte-candidats">
          <a href={cartes.candidats.href}>Qui est candidat</a>
        </h3>
        <p class="apercu-carte-fait">{cartes.candidats.ligne}</p>
        <p class="apercu-carte-action">
          <a href={cartes.candidats.href}>{cartes.candidats.listeLabel}</a>
        </p>
        {
          declaresSousCondition ? (
            <p class="apercu-carte-sous-condition">
              <a href={declaresSousCondition.href}>{declaresSousCondition.libelle}</a>
            </p>
          ) : null
        }
      </article>
    </li>
    {
      cartes.semaine && (
        <li>
          <article class="apercu-carte" aria-labelledby="apercu-carte-semaine">
            <h3 id="apercu-carte-semaine">Ce qui a bougé cette semaine</h3>
            <p class="apercu-carte-when">
              <time datetime={cartes.semaine.date}>{cartes.semaine.dateLabel}</time>
            </p>
            <p class="apercu-carte-titre">
              <a href={semaineHref}>{cartes.semaine.uneTitle}</a>
            </p>
            {
              cartes.semaine.description ? (
                <p class="apercu-carte-chapo">{cartes.semaine.description}</p>
              ) : null
            }
          </article>
        </li>
      )
    }
    {
      cartes.dateCle && (
        <li>
          <article class="apercu-carte" aria-labelledby="apercu-carte-date">
            <h3 id="apercu-carte-date">Prochaine date clé</h3>
            <p class="apercu-carte-when">
              <time datetime={cartes.dateCle.date}>{cartes.dateCle.dateLabel}</time>
            </p>
            <p class="apercu-carte-label">{cartes.dateCle.label}</p>
            {
              cartes.dateCle.mentionDecret ? (
                <p class="apercu-carte-decret">{cartes.dateCle.mentionDecret}</p>
              ) : null
            }
            <p class="apercu-carte-action">
              <a href={cartes.dateCle.sourceUrl} rel="noopener noreferrer">
                {cartes.dateCle.sourceLabel}
              </a>
            </p>
          </article>
        </li>
      )
    }
  </ul>

  <p class="apercu-disclaimer meta" id="apercu-disclaimer" title={campagne.disclaimer}>
    {campagne.disclaimer}
  </p>

  <div class="apercu-block">
    <div class="apercu-personnalites-head">
      <h3 id="apercu-personnalites-title">Personnalités</h3>
      <p class="apercu-legend meta">D déclaré·e · Dé désigné·e</p>
    </div>
    {
      groupes.map((groupe) => (
        <div class="apercu-groupe">
          <details class="apercu-details apercu-groupe-sources">
            <summary aria-label={`Détail des sources par courant — ${groupe.groupe}`}>
              <span class="apercu-groupe-label">{groupe.groupe}</span>
              <span class="apercu-sources-cta" aria-hidden="true">
                <span class="apercu-sources-cta-short">Sources</span>
                <span class="apercu-sources-cta-full">Détail des sources par courant</span>
              </span>
            </summary>
            <ul class="apercu-sources-list">
              {groupe.membres.map((personne) => {
                const sourceDate = formatCampagneDate(personne.source_date, { weekday: false });
                return (
                  <li>
                    <span class="apercu-source-nom">{personne.nom}</span>
                    <span class="apercu-source-courant">{personne.courant}</span>
                    <span>{personne.statut_label}</span>
                    <a href={personne.source_url} rel="noopener noreferrer">
                      {personne.source_label}
                    </a>
                    <time datetime={personne.source_date}>{sourceDate}</time>
                  </li>
                );
              })}
            </ul>
          </details>
          <ul class="apercu-chips">
            {groupe.membres.map((personne) => {
              const chipTitle = personnaliteChipTitle(personne);
              const pastille = statutPastille(personne.statut);
              return (
                <li>
                  <a
                    class="apercu-chip"
                    href={personne.source_url}
                    rel="noopener noreferrer"
                    title={chipTitle}
                  >
                    <span class="apercu-chip-name">{personne.nom}</span>
                    <span class="apercu-chip-pill" aria-label={personne.statut_label}>
                      {pastille}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <p class="apercu-more">
      <a class="apercu-liste" href={campagne.liste_complete_href}>Liste complète</a>
    </p>
  </div>

  <div class="apercu-block">
    <h3 id="apercu-dates-title">Prochaines dates</h3>
    <ol class="apercu-dates">
      {
        campagne.dates.map((item) => (
          <li title={item.label}>
            <time class="apercu-date-when" datetime={item.date}>
              {formatCampagneDate(item.date, { weekday: false })}
            </time>
            <span class="apercu-date-label">{item.label}</span>
            <a
              class="apercu-date-source-inline"
              href={item.source_url}
              rel="noopener noreferrer"
            >
              {item.source_label}
            </a>
          </li>
        ))
      }
    </ol>
    <details class="apercu-details">
      <summary>Détail des dates</summary>
      <ol class="apercu-dates-full">
        {
          campagne.dates.map((item) => (
            <li>
              <p>
                <time datetime={item.date}>{formatCampagneDate(item.date)}</time>
                {' — '}
                {item.label}
              </p>
              <a href={item.source_url} rel="noopener noreferrer">
                {item.source_label}
              </a>
            </li>
          ))
        }
      </ol>
    </details>
  </div>

  {
    !hideSondage && (
      <div
        class="apercu-block apercu-sondage"
        id="apercu-sondage"
        data-scrutins={scrutinsDates}
        data-fin-masquage={finMasquage}
      >
        <h3 id="apercu-sondage-title">{campagne.sondage.titre}</h3>
        {
          miseAuPoint?.texte ? (
            <p class="apercu-sondage-map" role="note">
              {miseAuPoint.texte}
              {
                miseAuPoint.lien_url?.startsWith('https://') && miseAuPoint.lien_label ? (
                  <>
                    {' '}
                    <a href={miseAuPoint.lien_url} rel="noopener noreferrer">
                      {miseAuPoint.lien_label}
                    </a>
                  </>
                ) : null
              }
            </p>
          ) : null
        }
        {
          campagne.sondage.classements.map((classement, index) => {
            const lignes = rankResultats(classement.resultats);
            const figure = (
              <figure class="apercu-sondage-figure">
                <table class="apercu-sondage-table">
                  <caption>
                    {classement.institut} pour {classement.commanditaire}
                    <span class="apercu-sondage-periode">
                      {formatPeriodeEnquete(classement.terrain_debut, classement.terrain_fin)} (en ligne)
                    </span>
                    <span class="apercu-sondage-hypothese">{classement.hypothese}</span>
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Rang</th>
                      <th scope="col">Candidat</th>
                      <th scope="col">Intentions de vote</th>
                    </tr>
                  </thead>
                  <tbody>
                    {lignes.map((ligne) => (
                      <tr>
                        <td>{ligne.rang ?? ''}</td>
                        <th scope="row">{ligne.nom}</th>
                        <td class="apercu-sondage-score">{formatScore(ligne)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="apercu-sondage-marge meta">
                  Entre candidats voisins, un écart de quelques points peut rester dans la marge
                  d’erreur indiquée par la notice.
                </p>
                <p class="apercu-sondage-hypotheses meta">
                  D’autres hypothèses ont été testées, voir la notice.
                </p>
                <p class="apercu-sondage-mentions meta">
                  Institut : {phrase(classement.institut)} Commanditaire :{' '}
                  {phrase(classement.commanditaire)} Publication :{' '}
                  {phrase(formatCampagneDate(classement.publication, { weekday: false }))} Terrain :{' '}
                  {phrase(classement.terrain)} Échantillon : {phrase(classement.echantillon)} Méthode
                  : {phrase(classement.methode)} Marge d’erreur : {phrase(classement.marge_erreur)}
                  {classement.non_exprimes ? ` ${phrase(classement.non_exprimes)}` : ''}{' '}
                  {phrase(classement.source_label)}
                </p>
                <p class="apercu-sondage-notice meta">
                  <a href={classement.notice_url} rel="noopener noreferrer">Notice consultable sur le site de la Commission des sondages</a>
                  {` (n° ${classement.notice_numero}).`}
                </p>
              </figure>
            );
            if (index === 0) return figure;
            return (
              <details class="apercu-details">
                <summary>
                  Autre sondage récent : {classement.institut} pour {classement.commanditaire}
                </summary>
                {figure}
              </details>
            );
          })
        }
        <p class="apercu-sondage-note meta">{campagne.sondage.note}</p>
        <p class="apercu-sondage-ligne meta">{SONDAGES_LIGNE}</p>
        <script is:inline>
          (function () {
            var el = document.getElementById('apercu-sondage');
            if (!el) return;

            // Aligné sur isMasqueAt (src/lib/campagne.ts) : veille UTC + jour < 20:00 Paris.
            var raw = el.getAttribute('data-scrutins') || '';
            var finRaw = el.getAttribute('data-fin-masquage') || '20:00';
            var scrutins = raw.split(',');
            var finBits = finRaw.split(':');
            var finMinutes = Number(finBits[0]) * 60 + Number(finBits[1] || 0);
            var clockParts = new Intl.DateTimeFormat('en-CA', {
              timeZone: 'Europe/Paris',
              year: 'numeric',
              month: '2-digit',
              day: '2-digit',
              hour: '2-digit',
              minute: '2-digit',
              hourCycle: 'h23',
            }).formatToParts(new Date());
            function clockPart(type) {
              for (var i = 0; i < clockParts.length; i++) {
                if (clockParts[i].type === type) return clockParts[i].value;
              }
              return '';
            }
            var parisDate =
              clockPart('year') + '-' + clockPart('month') + '-' + clockPart('day');
            var parisMinutes = Number(clockPart('hour')) * 60 + Number(clockPart('minute'));
            function veilleOf(iso) {
              var bits = iso.split('-');
              var utc = Date.UTC(Number(bits[0]), Number(bits[1]) - 1, Number(bits[2]) - 1);
              return new Date(utc).toISOString().slice(0, 10);
            }
            var masque = false;
            for (var s = 0; s < scrutins.length; s++) {
              var scrutin = scrutins[s];
              if (!scrutin) continue;
              if (parisDate === scrutin && parisMinutes < finMinutes) masque = true;
              if (parisDate === veilleOf(scrutin)) masque = true;
            }
            if (masque) el.hidden = true;

            fetch('/sondages-interrupteur.json', { cache: 'no-store' })
              .then(function (res) {
                return res.json();
              })
              .then(function (data) {
                if (!data || typeof data !== 'object') return;
                if (data.masquer === true) el.hidden = true;
                var map = data.mise_au_point;
                if (!map || typeof map.texte !== 'string' || !map.texte) return;
                if (el.querySelector('.apercu-sondage-map')) return;
                var p = document.createElement('p');
                p.className = 'apercu-sondage-map';
                p.setAttribute('role', 'note');
                p.textContent = map.texte;
                if (
                  typeof map.lien_url === 'string' &&
                  map.lien_url.indexOf('https://') === 0 &&
                  typeof map.lien_label === 'string' &&
                  map.lien_label
                ) {
                  p.appendChild(document.createTextNode(' '));
                  var a = document.createElement('a');
                  a.href = map.lien_url;
                  a.rel = 'noopener noreferrer';
                  a.textContent = map.lien_label;
                  p.appendChild(a);
                }
                var title = document.getElementById('apercu-sondage-title');
                if (title && title.parentNode === el) {
                  title.insertAdjacentElement('afterend', p);
                } else {
                  el.insertBefore(p, el.firstChild);
                }
              })
              .catch(function () {});
          })();
        </script>
      </div>
    )
  }

  <p class="apercu-foot meta">
    {
      une && (
        <>
          Dernière Une · <time datetime={une.date}>{une.dateLabel}</time>
          {' — '}
          <a href={uneHref}>{une.title}</a>
          <span aria-hidden="true"> · </span>
        </>
      )
    }
    Bloc mis à jour le <time datetime={campagne.updated}>{updatedLabel}</time>
  </p>
</section>

<style>
  .apercu-campagne {
    margin: 0 0 0.85rem;
    padding: 0.55rem 0.7rem 0.5rem;
    border-radius: var(--radius-lg);
  }

  .apercu-head {
    margin-bottom: 0.12rem;
  }

  .apercu-campagne h2 {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .apercu-disclaimer {
    margin: 0 0 0.28rem;
    max-width: 72ch;
    font-size: 0.74rem;
    line-height: 1.28;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apercu-personnalites-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 0.75rem;
    margin-bottom: 0.15rem;
  }

  .apercu-legend {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.25;
  }

  .apercu-block {
    margin: 0 0 0.35rem;
  }

  .apercu-cartes {
    list-style: none;
    margin: 0 0 0.4rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .apercu-cartes > li {
    min-width: 0;
    width: auto;
    max-width: none;
  }

  .apercu-carte {
    height: 100%;
    margin: 0;
    padding: 0.5rem 0.6rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent-soft) 40%, var(--card));
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
  }

  .apercu-carte h3 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    text-transform: none;
    color: var(--fg);
  }

  .apercu-carte h3 a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .apercu-carte-fait,
  .apercu-carte-when,
  .apercu-carte-titre,
  .apercu-carte-label,
  .apercu-carte-chapo,
  .apercu-carte-decret,
  .apercu-carte-action,
  .apercu-carte-sous-condition {
    margin: 0;
    color: var(--fg);
  }

  .apercu-carte-fait {
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .apercu-carte-when {
    font-family: system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .apercu-carte-titre {
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .apercu-carte-titre a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
    color: var(--fg);
  }

  .apercu-carte-chapo,
  .apercu-carte-label {
    font-size: 0.8rem;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apercu-carte-decret {
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.35;
    padding: 0.2rem 0 0.2rem 0.5rem;
    border-left: 3px solid var(--accent);
  }

  .apercu-carte-action {
    margin-top: auto;
  }

  .apercu-carte-action a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .apercu-carte-sous-condition {
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .apercu-carte-sous-condition a {
    font-family: system-ui, sans-serif;
    font-weight: 650;
    text-decoration: none;
  }

  .apercu-carte a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .apercu-block h3 {
    margin: 0;
    font-size: 0.7rem;
    font-family: system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .apercu-groupe {
    margin: 0 0 0.2rem;
  }

  .apercu-groupe-label {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .apercu-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.18rem;
  }

  .apercu-chips li {
    flex: 0 0 auto;
    width: auto;
    max-width: 100%;
  }

  .apercu-chip {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.22rem;
    min-height: 1.55rem;
    padding: 0.08rem 0.22rem 0.08rem 0.42rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-soft) 70%, var(--card));
    text-decoration: none;
    color: var(--fg);
    font-family: system-ui, sans-serif;
    font-size: 0.74rem;
    line-height: 1.15;
  }

  .apercu-chip:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  .apercu-chip:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .apercu-chip-name {
    font-weight: 700;
    white-space: nowrap;
  }

  .apercu-chip-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.15rem;
    padding: 0 0.28rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .apercu-more {
    margin: 0.05rem 0 0;
  }

  .apercu-liste {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    font-family: system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .apercu-liste:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .apercu-dates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.06rem;
  }

  .apercu-dates li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.5rem;
    align-items: baseline;
    padding: 0.05rem 0 0.05rem 0.5rem;
    border-left: 3px solid var(--accent);
    min-width: 0;
  }

  .apercu-date-when {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .apercu-date-label {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.3;
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apercu-date-source-inline {
    display: none;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .apercu-dates-full {
    margin: 0.35rem 0 0;
    padding: 0 0 0 1.1rem;
    display: grid;

---
import type { ElectionNationalResults } from '../lib/election-types';
import { formatPct, formatVoix } from '../lib/elections';

interface Props {
  national: ElectionNationalResults;
}

const { national } = Astro.props;
---

<dl class="summary-grid">
  <div>
    <dt>Inscrits</dt>
    <dd>{formatVoix(national.inscrits)}</dd>
  </div>
  <div>
    <dt>Votants</dt>
    <dd>{formatVoix(national.votants)}</dd>
  </div>
  <div>
    <dt>Abstention</dt>
    <dd>{formatPct(national.abstention_pct)}</dd>
  </div>
  <div>
    <dt>Suffrages exprimés</dt>
    <dd>{formatVoix(national.exprimes)}</dd>
  </div>
  <div>
    <dt>Blancs</dt>
    <dd>{formatVoix(national.blancs)}</dd>
  </div>
  <div>
    <dt>Nuls</dt>
    <dd>{formatVoix(national.nuls)}</dd>
  </div>
</dl>

<style>
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem 1rem;
    margin: 1rem 0 1.5rem;
    font-family: system-ui, sans-serif;
  }
  .summary-grid dt {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0;
  }
  .summary-grid dd {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
</style>

---
import type { DepartmentResults } from '../lib/election-types';
import { CANDIDATE_COLORS, CANDIDATE_LABELS, type CandidateSlug } from '../lib/departments';

interface Props {
  departements: DepartmentResults[];
}

const { departements } = Astro.props;

const payload = departements.map((d) => ({
  code: d.code,
  nom: d.nom,
  leader: d.leader_slug,
  leaderPct: d.candidats[0]?.pourcentage_exprimes ?? 0,
  top3: d.candidats.slice(0, 3).map((c) => ({
    slug: c.slug,
    nom: c.nom,
    pct: c.pourcentage_exprimes,
  })),
}));

const legend = Object.entries(CANDIDATE_LABELS).map(([slug, label]) => ({
  slug,
  label,
  color: CANDIDATE_COLORS[slug as CandidateSlug],
}));
---

<section class="dept-map" aria-labelledby="dept-map-title">
  <h3 id="dept-map-title">Carte des têtes de listes par département</h3>
  <p class="meta">
    Couleur = candidat en tête (% des suffrages exprimés). Cliquez un département pour le détail.
    {departements.length} départements et collectivités.
  </p>

  <div class="legend" aria-label="Légende candidats">
    {
      legend.map((item) => (
        <span class="legend-item">
          <span class="swatch" style={`background:${item.color}`} />
          {item.label}
        </span>
      ))
    }
  </div>

  <label class="search-label">
    Rechercher
    <input type="search" id="dept-search" placeholder="Nom ou code (ex. 13, Bouches-du-Rhône)" autocomplete="off" />
  </label>

  <div class="dept-grid" id="dept-grid" role="list">
    {
      payload.map((d) => (
        <button
          type="button"
          class="dept-cell"
          role="listitem"
          data-code={d.code}
          data-nom={d.nom.toLowerCase()}
          data-leader={d.leader}
          style={`--leader-color:${CANDIDATE_COLORS[d.leader as CandidateSlug] ?? '#888'}`}
          aria-label={`${d.nom} (${d.code}) — tête : ${CANDIDATE_LABELS[d.leader as CandidateSlug] ?? d.leader} ${d.leaderPct.toFixed(1)} %`}
        >
          <span class="dept-code">{d.code}</span>
          <span class="dept-pct">{d.leaderPct.toFixed(1)} %</span>
        </button>
      ))
    }
  </div>

  <aside class="card dept-detail" id="dept-detail" hidden>
    <h4 id="dept-detail-title">Détail</h4>
    <ol id="dept-detail-list"></ol>
  </aside>
</section>

<script define:vars={{ payload, labels: CANDIDATE_LABELS }}>
  const search = document.getElementById('dept-search');
  const grid = document.getElementById('dept-grid');
  const detail = document.getElementById('dept-detail');
  const detailTitle = document.getElementById('dept-detail-title');
  const detailList = document.getElementById('dept-detail-list');

  const byCode = new Map(payload.map((d) => [d.code, d]));

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    grid?.querySelectorAll('.dept-cell').forEach((cell) => {
      const el = cell;
      const nom = el.getAttribute('data-nom') ?? '';
      const code = el.getAttribute('data-code') ?? '';
      const match = !q || nom.includes(q) || code.includes(q);
      el.hidden = !match;
    });
  });

  grid?.addEventListener('click', (event) => {
    const target = event.target.closest('.dept-cell');
    if (!target || !(target instanceof HTMLElement)) return;
    const code = target.getAttribute('data-code');
    if (!code) return;
    const data = byCode.get(code);
    if (!data || !detail || !detailTitle || !detailList) return;

    detail.hidden = false;
    detailTitle.textContent = `${data.nom} (${data.code})`;
    detailList.replaceChildren();
    for (const c of data.top3) {
      const li = document.createElement('li');
      li.textContent = `${labels[c.slug] ?? c.nom} — ${c.pct.toFixed(2)} %`;
      detailList.appendChild(li);
    }
  });
</script>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .swatch {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    display: inline-block;
  }
  .search-label {
    display: block;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .search-label input {
    display: block;
    width: 100%;
    max-width: 24rem;
    margin-top: 0.25rem;
    padding: 0.4rem 0.5rem;
    font-size: 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--card);
    color: var(--fg);
  }
  .dept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr));
    gap: 0.35rem;
    margin-bottom: 1rem;
  }
  .dept-cell {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.2rem;
    background: color-mix(in srgb, var(--leader-color) 35%, var(--card));
    cursor: pointer;
    font-family: system-ui, sans-serif;
    font-size: 0.7rem;
    line-height: 1.2;
    text-align: center;
    color: var(--fg);
  }
  .dept-cell:hover,
  .dept-cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .dept-code {
    display: block;
    font-weight: 700;
  }
  .dept-pct {
    display: block;
    color: var(--muted);
    font-size: 0.65rem;
  }
  .dept-detail ol {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
</style>

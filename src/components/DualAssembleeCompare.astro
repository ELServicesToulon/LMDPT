---
/**
 * Comparaison visuelle côte à côte :
 *  - Gauche : Assemblée 100 % 1er tour (Sainte-Laguë AN1T, modèle Wikimedia, couleurs proximité programmes)
 *  - Droite : Assemblée réelle issue des législatives qui ont suivi ce 1er tour
 */
import groupsRaw from '../data/assemblee-current-groups-2025.json';
import {
  programProximityColor,
  realAssemblyColor,
  spectrumSortKey,
} from '../lib/program-proximity';

interface SeatRow {
  id: string;
  label: string;
  seats: number;
  color?: string;
  pctExprimes?: number;
  pctSeats?: number;
}

interface Props {
  /** Sièges AN1T depuis voix du 1er tour uniquement */
  firstRoundAlloc: SeatRow[];
  /** Sièges réels après législatives (2nd tour / composition) */
  realAlloc: SeatRow[];
  totalSeats?: number;
  firstRoundTitle?: string;
  realTitle?: string;
  firstRoundMeta?: string;
  realMeta?: string;
  /** Date / libellé du scrutin T1 */
  t1Label?: string;
  t2Label?: string;
  /** Résultat réel pas encore connu (ex. présidentielle 2027) */
  realPending?: boolean;
}

const {
  firstRoundAlloc,
  realAlloc,
  totalSeats = 577,
  firstRoundTitle = 'Assemblée 100 % 1er tour',
  realTitle = 'Assemblée réelle (législatives)',
  firstRoundMeta = 'Répartition Sainte-Laguë nationale sur les suffrages exprimés du 1er tour uniquement — modèle de sièges Wikimedia. Couleurs = proximité de programmes / idées (spectre gauche → droite).',
  realMeta = 'Composition issue du second tour et des duels uninominaux qui ont suivi le 1er tour. Couleurs = groupes / blocs institutionnels.',
  t1Label = '1er tour',
  t2Label = 'Après législatives',
  realPending = false,
} = Astro.props;

// Positions officielles (modèle établi Wikimedia)
type Pos = { x: number; y: number };
const allPositions: Pos[] = [];
for (const g of groupsRaw as Array<{ circles: Array<{ x: number; y: number }> }>) {
  for (const c of g.circles) {
    allPositions.push({ x: c.x, y: c.y });
  }
}

/** Trie les sièges le long de l’arc : gauche (x bas) → droite (x haut), y pour stabilité */
function sortHemicyclePositions(positions: Pos[]): Pos[] {
  return [...positions].sort((a, b) => {
    // Angle depuis le centre bas de l’hémicycle (approx. 180, 185)
    const cx = 180;
    const cy = 185;
    const angA = Math.atan2(cy - a.y, a.x - cx);
    const angB = Math.atan2(cy - b.y, b.x - cx);
    return angA - angB;
  });
}

const orderedSeats = sortHemicyclePositions(allPositions);

function buildDots(
  alloc: SeatRow[],
  colorFn: (id: string, fallback?: string) => string,
): Array<{ x: number; y: number; color: string; label: string; id: string }> {
  // Ordonner les blocs le long du spectre (gauche → droite)
  const sorted = [...alloc]
    .filter((a) => (a.seats ?? 0) > 0)
    .sort((a, b) => spectrumSortKey(a.id) - spectrumSortKey(b.id));

  // Si un id n’est pas dans SPECTRUM_SEAT_ORDER, garder son ordre relatif
  const dots: Array<{ x: number; y: number; color: string; label: string; id: string }> = [];
  let cursor = 0;
  for (const bloc of sorted) {
    const n = Math.max(0, Math.floor(bloc.seats));
    const color = bloc.color || colorFn(bloc.id, bloc.color);
    for (let i = 0; i < n && cursor < orderedSeats.length; i++) {
      const pos = orderedSeats[cursor++];
      dots.push({
        x: pos.x,
        y: pos.y,
        color,
        label: bloc.label,
        id: bloc.id,
      });
    }
  }
  // Sièges non attribués (seuil / reste) → gris
  while (cursor < orderedSeats.length) {
    const pos = orderedSeats[cursor++];
    dots.push({ x: pos.x, y: pos.y, color: '#d0d0d0', label: 'Non attribué / seuil', id: 'vacant' });
  }
  return dots;
}

const firstDots = buildDots(firstRoundAlloc, programProximityColor);
const realDots = buildDots(realAlloc, (id, fb) => realAssemblyColor(id, fb));

function legendFrom(alloc: SeatRow[], colorFn: (id: string, fb?: string) => string) {
  return [...alloc]
    .filter((a) => (a.seats ?? 0) > 0)
    .sort((a, b) => spectrumSortKey(a.id) - spectrumSortKey(b.id))
    .map((a) => ({
      id: a.id,
      label: a.label,
      seats: a.seats,
      color: colorFn(a.id, a.color),
      pct: totalSeats > 0 ? ((a.seats / totalSeats) * 100).toFixed(1) : '0',
      voix: a.pctExprimes != null ? a.pctExprimes.toFixed(1) : null,
    }));
}

const firstLegend = legendFrom(firstRoundAlloc, programProximityColor);
const realLegend = legendFrom(realAlloc, (id, fb) => realAssemblyColor(id, fb));

const firstSeatsSum = firstRoundAlloc.reduce((s, a) => s + (a.seats || 0), 0);
const realSeatsSum = realAlloc.reduce((s, a) => s + (a.seats || 0), 0);

const viewBoxW = 360;
const viewBoxH = 185;
const uid = `dual-${Math.random().toString(36).slice(2, 9)}`;
---

<section class="dual-assemblee" aria-labelledby={`dual-title-${uid}`}>
  <header class="dual-header">
    <h3 id={`dual-title-${uid}`}>Deux Assemblées, un même 1er tour</h3>
    <p class="dual-lead">
      À gauche : ce que donnerait une Assemblée <strong>entièrement calée sur les voix du 1er tour</strong>
      (modèle AN1T / Sainte-Laguë, hémicycle Wikimedia). Couleurs = <strong>proximité de programmes</strong>
      (spectre d’idées gauche → droite). À droite : l’Assemblée <strong>réelle</strong> issue des
      législatives qui ont suivi ce premier tour.
    </p>
  </header>

  <div class="dual-grid">
    <!-- GAUCHE : 100% 1er tour -->
    <article class="dual-panel dual-panel--t1" aria-labelledby={`t1-title-${uid}`}>
      <div class="panel-badge panel-badge--t1">{t1Label}</div>
      <h4 id={`t1-title-${uid}`}>{firstRoundTitle}</h4>
      <p class="panel-meta">{firstRoundMeta}</p>
      <div class="hemi-wrap">
        <svg
          viewBox={`0 0 ${viewBoxW} ${viewBoxH}`}
          width="100%"
          height="auto"
          role="img"
          aria-label={`${firstRoundTitle} — ${firstSeatsSum} sièges attribués sur ${totalSeats}`}
        >
          <desc>
            Hémicycle 100 % premier tour. Sièges placés de gauche à droite selon le spectre
            de proximité de programmes. Méthode Sainte-Laguë, seuil 3 %.
          </desc>
          {
            firstDots.map((d) => (
              <circle cx={d.x} cy={d.y} r="2.9" fill={d.color} stroke="none">
                <title>
                  {d.label} — siège 1er tour (proximité programmes)
                </title>
              </circle>
            ))
          }
          <text x="180" y="178" text-anchor="middle" class="hemi-cap" fill="#1c1a17" font-size="8" font-weight="600">
            {firstSeatsSum}/{totalSeats} sièges · spectre programmes
          </text>
        </svg>
      </div>
      <ul class="dual-legend" aria-label="Légende 1er tour">
        {
          firstLegend.map((item) => (
            <li>
              <span class="swatch" style={`background:${item.color}`}></span>
              <span class="leg-label">{item.label}</span>
              <span class="leg-seats">
                <strong>{item.seats}</strong>
                <span class="meta"> ({item.pct}%)</span>
                {item.voix != null && <span class="meta"> · {item.voix}% voix T1</span>}
              </span>
            </li>
          ))
        }
      </ul>
    </article>

    <!-- DROITE : résultat réel (ou en attente) -->
    <article class="dual-panel dual-panel--real" aria-labelledby={`real-title-${uid}`}>
      <div class="panel-badge panel-badge--real">{t2Label}</div>
      <h4 id={`real-title-${uid}`}>{realTitle}</h4>
      <p class="panel-meta">{realMeta}</p>
      {
        realPending || realAlloc.length === 0 ? (
          <div class="hemi-wrap hemi-pending" role="status">
            <p class="pending-msg">
              <strong>Résultat réel en attente</strong><br />
              Le fil directeur LMDPT documente d’abord le 1er tour.
              La comparaison binaire / post-scrutin s’affichera dès les résultats officiels.
            </p>
          </div>
        ) : (
          <>
            <div class="hemi-wrap">
              <svg
                viewBox={`0 0 ${viewBoxW} ${viewBoxH}`}
                width="100%"
                height="auto"
                role="img"
                aria-label={`${realTitle} — ${realSeatsSum} sièges sur ${totalSeats}`}
              >
                <desc>
                  Hémicycle du résultat réel qui a suivi le 1er tour (T2 ou Assemblée élue).
                  Même géométrie Wikimedia ; couleurs institutionnelles.
                </desc>
                {
                  realDots.map((d) => (
                    <circle cx={d.x} cy={d.y} r="2.9" fill={d.color} stroke="none">
                      <title>
                        {d.label} — siège résultat réel
                      </title>
                    </circle>
                  ))
                }
                <text x="180" y="178" text-anchor="middle" class="hemi-cap" fill="#1c1a17" font-size="8" font-weight="600">
                  {realSeatsSum}/{totalSeats} sièges · résultat réel
                </text>
              </svg>
            </div>
            <ul class="dual-legend" aria-label="Légende résultat réel">
              {
                realLegend.map((item) => (
                  <li>
                    <span class="swatch" style={`background:${item.color}; border:1px solid rgba(0,0,0,0.12)`}></span>
                    <span class="leg-label">{item.label}</span>
                    <span class="leg-seats">
                      <strong>{item.seats}</strong>
                      <span class="meta"> ({item.pct}%)</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </>
        )
      }
    </article>
  </div>

  <aside class="dual-footnote" aria-label="Lecture">
    <p>
      <strong>Lecture DOE</strong> — Même 1er tour, deux traductions en sièges. À gauche : pluralité des
      voix T1 convertie proportionnellement (Sainte-Laguë). À droite : filtre du second tour, des
      désistements et du uninominal. Les couleurs de gauche suivent la <em>proximité des programmes</em>
      (teintes proches = familles d’idées proches) ; celles de droite les blocs institutionnels.
      Illustration pédagogique — pas une prédiction ni un jugement sur le mode de scrutin.
    </p>
    <p class="spectrum-key" aria-hidden="true">
      <span class="sk-label">Proximité programmes</span>
      <span class="sk-bar"></span>
      <span class="sk-ends"><span>Gauche</span><span>Centre</span><span>Droite</span></span>
    </p>
  </aside>
</section>

<style>
  .dual-assemblee {
    margin: 1.25rem 0 1.75rem;
    padding: 1.15rem 1.2rem 1.35rem;
    background: var(--card, #fff);
    border: 1px solid var(--border, #e5e2dc);
    border-radius: var(--radius-lg, 12px);
  }
  .dual-header h3 {
    margin: 0 0 0.45rem;
    font-size: 1.28rem;
    color: var(--fg, #0a0a0a);
  }
  .dual-lead {
    margin: 0 0 1rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--fg, #0a0a0a);
    max-width: 58rem;
  }
  .dual-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  @media (max-width: 820px) {
    .dual-grid {
      grid-template-columns: 1fr;
    }
  }
  .dual-panel {
    border: 1px solid var(--border, #e5e2dc);
    border-radius: 10px;
    padding: 0.85rem 0.9rem 1rem;
    background: var(--bg, #faf9f7);
  }
  .dual-panel--t1 {
    border-top: 3px solid #c0392b;
  }
  .dual-panel--real {
    border-top: 3px solid #0d378a;
  }
  .panel-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    margin-bottom: 0.4rem;
  }
  .panel-badge--t1 {
    background: #fde8e8;
    color: #7a1f1f;
  }
  .panel-badge--real {
    background: #e3eaf8;
    color: #0d378a;
  }
  .dual-panel h4 {
    margin: 0 0 0.35rem;
    font-size: 1.05rem;
    color: var(--fg, #0a0a0a);
  }
  .panel-meta {
    margin: 0 0 0.65rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted, #1c1a17);
  }
  .hemi-wrap {
    background: #0f1419;
    border-radius: 8px;
    padding: 0.4rem 0.3rem 0.2rem;
    margin-bottom: 0.65rem;
  }
  .hemi-wrap svg text.hemi-cap {
    fill: #e8e6e1 !important;
  }
  .dual-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }
  .dual-legend li {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    gap: 0.45rem;
    align-items: center;
    font-size: 0.86rem;
    color: var(--fg, #0a0a0a);
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    display: inline-block;
  }
  .leg-label {
    line-height: 1.25;
  }
  .leg-seats {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .dual-footnote {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border, #e5e2dc);
  }
  .dual-footnote p {
    margin: 0 0 0.65rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--fg, #0a0a0a);
  }
  .spectrum-key {
    display: grid;
    gap: 0.25rem;
    max-width: 28rem;
  }
  .sk-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted, #1c1a17);
  }
  .sk-bar {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #c0392b 0%,
      #e67e22 28%,
      #f1c40f 50%,
      #2980b9 75%,
      #0d378a 100%
    );
  }
  .sk-ends {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--muted, #1c1a17);
  }
  .hemi-pending {
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .pending-msg {
    margin: 0;
    text-align: center;
    color: #e8e6e1;
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 22rem;
  }
  @media (prefers-color-scheme: dark) {
    .dual-panel {
      background: rgba(255, 255, 255, 0.03);
    }
    .panel-badge--t1 {
      background: rgba(192, 57, 43, 0.25);
      color: #f5c4c4;
    }
    .panel-badge--real {
      background: rgba(13, 55, 138, 0.35);
      color: #c5d4f5;
    }
  }
</style>

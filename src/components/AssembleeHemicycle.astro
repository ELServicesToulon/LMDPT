---
interface SeatAllocation {
  id?: string;
  label: string;
  color: string;
  seats: number;
  pct?: number;
  pollPct?: number | null;
}

interface Props {
  title: string;
  allocations: SeatAllocation[];   // Projection 2027
  totalSeats?: number;
  subtitle?: string;
  sourceNote?: string;
  hybrid?: boolean; // default true for this viz
  initialMode?: 'hybrid' | 'projection' | 'current';
  initialGranularity?: 'major' | 'detailed';
  showControls?: boolean;
}

const {
  title,
  allocations: projectionAllocations,
  totalSeats = projectionAllocations.reduce((sum, a) => sum + (a.seats || 0), 0),
  subtitle,
  sourceNote,
  hybrid = true,
  // New for modes & granularity (interactive)
  initialMode = 'hybrid' as 'hybrid' | 'projection' | 'current',
  initialGranularity = 'major' as 'major' | 'detailed',
  showControls = true,
} = Astro.props;

// === Load official current groups layout (exact quarters from Wikimedia reference) ===
import groupsRaw from '../data/assemblee-current-groups-2025.json';
import {
  MAJOR_BLOC_COLORS,
  WIKI_GROUP_COLOR_BY_TITLE,
  colorForProjectionId,
} from '../lib/assemblee-wiki-colors';

// Major bloc mapping for current groups (to match projection categories)
const GROUP_TO_MAJOR: Record<string, string> = {
  'Groupe GDR': 'nfp',
  'Groupe La France Insoumise': 'nfp',
  'Groupe Écologiste et Social': 'nfp',
  'Groupe Socialiste': 'nfp',
  'Groupe LIOT': 'ensemble',
  'Groupe Les Démocrates': 'ensemble',
  'Groupe Ensemble pour la République': 'ensemble',
  'Groupe Horizons': 'ensemble',
  'Groupe Droite Républicaine': 'lr',
  'Groupe Union des droites pour la République': 'lr',
  'Groupe Rassemblement national': 'rn',
  'Indépendants': 'autres',
};

/** Couleurs Wiki officielles (XVIIe législature) pour blocs majeurs + légende projection */
const MAJOR_COLORS: Record<string, string> = {
  nfp: MAJOR_BLOC_COLORS.nfp,
  ensemble: MAJOR_BLOC_COLORS.ensemble,
  lr: MAJOR_BLOC_COLORS.lr,
  rn: MAJOR_BLOC_COLORS.rn,
  autres: MAJOR_BLOC_COLORS.autres,
};

const MAJOR_LABELS: Record<string, string> = {
  nfp: 'Nouveau Front populaire',
  ensemble: 'Ensemble / centre',
  lr: 'Droite républicaine',
  rn: 'Rassemblement national & alliés',
  autres: 'Autres & divers',
};

const SHORT_BLOC_LABELS: Record<string, string> = {
  nfp: 'NFP',
  ensemble: 'Ensemble',
  lr: 'LR',
  rn: 'RN',
  autres: 'Autres',
};

// Build all positions with their current major bloc
interface Position { x: number; y: number; major: string; currentColor: string; }

const allPositions: Position[] = [];
(groupsRaw as any[]).forEach((g: any) => {
  const major = GROUP_TO_MAJOR[g.title] || 'autres';
  // Couleur exacte du groupe (SVG Wikimedia), pas la teinte agrégée du bloc
  const currentColor =
    WIKI_GROUP_COLOR_BY_TITLE[g.title] || g.color || MAJOR_COLORS[major] || '#dddddd';  g.circles.forEach((c: any) => {
    allPositions.push({
      x: c.x,
      y: c.y,
      major,
      currentColor,
    });
  });
});

// Group positions by major zone for projection placement
const positionsByMajor: Record<string, {x:number; y:number}[]> = {
  nfp: [], ensemble: [], lr: [], rn: [], autres: []
};

allPositions.forEach(p => {
  if (positionsByMajor[p.major]) positionsByMajor[p.major].push({ x: p.x, y: p.y });
});

// Helper: deterministic spread sampling of positions in a zone for natural fill (avoids corner clustering)
function spreadZonePositions(zone: {x:number;y:number}[], n: number): {x:number;y:number}[] {
  if (n <= 0 || zone.length === 0) return [];
  // Deterministic pseudo-shuffle using position hash (stable across renders)
  const indexed = zone.map((p, idx) => ({ p, sortKey: ((p.x * 31 + p.y * 17 + idx * 7) % 1000) }));
  indexed.sort((a, b) => a.sortKey - b.sortKey);
  const shuffled = indexed.map(item => item.p);
  const take = Math.min(n, shuffled.length);
  // Even spread sampling if fewer than zone size
  const result: {x:number;y:number}[] = [];
  for (let i = 0; i < take; i++) {
    const idx = Math.floor((i * shuffled.length) / take) % shuffled.length;
    result.push(shuffled[idx]);
  }
  return result;
}

// === Build front layer dots (projection) placed in matching quarters ===
const frontDots: Array<{ x: number; y: number; color: string; label: string; major: string }> = [];

projectionAllocations.forEach((proj) => {
  // Determine major zone for this projection bloc
  let major = proj.id as string;
  if (!major) {
    const l = proj.label.toLowerCase();
    if (l.includes('rn') || l.includes('rassemblement')) major = 'rn';
    else if (l.includes('nfp') || l.includes('nouveau') || l.includes('front')) major = 'nfp';
    else if (l.includes('ensemble') || l.includes('centre')) major = 'ensemble';
    else if (l.includes('droite') || l.includes('lr')) major = 'lr';
    else major = 'autres';
  }

  const zone = positionsByMajor[major] || allPositions.map(p => ({x: p.x, y: p.y}));
  const positions = spreadZonePositions(zone, proj.seats);
  const wikiColor = colorForProjectionId(proj.id, proj.color || MAJOR_COLORS[major] || '#dddddd');

  positions.forEach((pos) => {
    frontDots.push({
      x: pos.x,
      y: pos.y,
      color: wikiColor,
      label: proj.label,
      major,
    });
  });
});

// === Detailed groups (for granularity option: sous-blocs / 12 groupes parlementaires) ===
const detailedGroups: Array<{ title: string; color: string; seats: number; positions: { x: number; y: number }[] }> = (groupsRaw as any[]).map((g: any) => {
  const major = GROUP_TO_MAJOR[g.title] || 'autres';
  return {
    title: g.title,
    color: WIKI_GROUP_COLOR_BY_TITLE[g.title] || g.color || MAJOR_COLORS[major],
    seats: g.seats || 0,
    positions: g.circles.map((c: any) => ({ x: c.x, y: c.y })),
  };
});

// Pure projection dots (spread globally, no zone bias — for "vue pure projection" mode)
const pureProjectionDots: Array<{ x: number; y: number; color: string; label: string; major: string }> = (() => {
  const dots: any[] = [];
  if (projectionAllocations.length === 0 || allPositions.length === 0) return dots;
  // Stable pseudo-shuffle of all positions
  const indexed = allPositions.map((p, i) => ({ p, key: ((p.x * 47 + p.y * 19 + i * 11) % 2000) }));
  indexed.sort((a, b) => a.key - b.key);
  const shuffled = indexed.map(it => it.p);
  let cursor = 0;
  projectionAllocations.forEach((proj) => {
    const n = Math.max(0, Math.floor(proj.seats || 0));
    const wikiColor = colorForProjectionId(proj.id, proj.color || '#dddddd');
    for (let k = 0; k < n; k++) {
      const pos = shuffled[(cursor + k) % shuffled.length];
      dots.push({
        x: pos.x,
        y: pos.y,
        color: wikiColor,
        label: proj.label,
        major: 'pure',
      });
    }
    cursor += n;
  });
  return dots;
})();

const legendProjection = projectionAllocations.map((a) => {
  const seats = Math.max(0, Math.floor(a.seats || 0));
  const pct = totalSeats > 0 ? ((seats / totalSeats) * 100).toFixed(1) : '0';
  return {
    label: a.label,
    color: colorForProjectionId(a.id, a.color || '#dddddd'),
    seats,
    pct,
  };
});

// Current groups for legend (aggregated) — counts from modèle Wikimedia positions
const CURRENT_SEATS = allPositions.reduce(
  (acc, p) => {
    acc[p.major] = (acc[p.major] || 0) + 1;
    return acc;
  },
  { nfp: 0, ensemble: 0, lr: 0, rn: 0, autres: 0 } as Record<string, number>,
);

const currentLegend = [
  { key: 'nfp', label: 'Nouveau Front populaire (gauche)', color: MAJOR_COLORS.nfp, currentSeats: CURRENT_SEATS.nfp },
  { key: 'ensemble', label: 'Ensemble / centre', color: MAJOR_COLORS.ensemble, currentSeats: CURRENT_SEATS.ensemble },
  { key: 'lr', label: 'Droite républicaine', color: MAJOR_COLORS.lr, currentSeats: CURRENT_SEATS.lr },
  { key: 'rn', label: 'Rassemblement national & alliés', color: MAJOR_COLORS.rn, currentSeats: CURRENT_SEATS.rn },
  { key: 'autres', label: 'Autres & divers', color: MAJOR_COLORS.autres, currentSeats: CURRENT_SEATS.autres },
];

// Detailed legend for granular view (sous-blocs / groupes parlementaires actuels)
const detailedCurrentLegend = detailedGroups.map((g) => ({
  key: g.title.replace(/[^a-zA-Z0-9]/g, '_'),
  label: g.title,
  color: g.color,
  currentSeats: g.seats,
}));

const instanceId = `hybrid-hemicycle-${Math.random().toString(36).slice(2, 10)}`;
const viewBoxW = 360;
const viewBoxH = 185;

const compactLegend = !showControls;
const showCurrentLegend = !compactLegend || initialMode === 'hybrid' || initialMode === 'current';
const showProjectionLegend = !compactLegend || initialMode === 'hybrid' || initialMode === 'projection';

const compactCurrentTitle =
  initialMode === 'current' ? 'Composition actuelle' : 'Référence actuelle (transparence)';
const compactProjectionTitle =
  initialMode === 'projection' ? 'Répartition projetée' : 'Projection (couleurs pleines)';
---

<section class="hemicycle" aria-labelledby={`hemicycle-title-${instanceId}`}>
  <h3 id={`hemicycle-title-${instanceId}`}>{title}</h3>
  {subtitle && <p class="meta">{subtitle}</p>}

  <div class="hemicycle-wrapper">
    <svg
      viewBox={`0 0 ${viewBoxW} ${viewBoxH}`}
      width="100%"
      height="auto"
      preserveAspectRatio="xMidYMid meet"
      style="max-height: 210px; display: block;"
      aria-label={`Hémicycle hybride — Couche arrière : structure actuelle des groupes (transparence) + Couche avant : projection 1er tour — ${totalSeats} sièges`}
      role="img"
      aria-describedby={`desc-${instanceId}`}
    >
      <desc id={`desc-${instanceId}`}>Hémicycle pédagogique fidèle au modèle officiel (577 positions Wikimedia). Mode hybride : arrière = structure actuelle en transparence (repères spatiaux), avant = projection 1er tour placée dans les quartiers. Mode projection pure : répartition sans ancrage aux zones actuelles. Mode structure actuelle : uniquement la répartition officielle. Granularité major (5 blocs) ou détaillée (12 groupes). La superposition aide à voir l'impact de la pluralité des voix du 1er tour sur les positions dans l'hémicycle existant. Neutre : illustration comparative, pas une prédiction.</desc>

      <!-- Couche 1 — arrière-plan : groupes actuels (couleurs Wiki exactes, transparence) -->
      <g id={`back-${instanceId}`} class="back-layer back-major" opacity="0.34">
        {
          allPositions.map((pos) => (
            <circle
              cx={pos.x}
              cy={pos.y}
              r="2.82"
              fill={pos.currentColor}
              fill-opacity="1"
              stroke="none"
              data-major={pos.major}
              role="img"
              aria-label={`Couche 1 (transparence) — siège actuel bloc ${MAJOR_LABELS[pos.major] || pos.major}`}
            >
              <title>Couche 1 — arrière-plan (transparence) : {MAJOR_LABELS[pos.major] || pos.major} — couleur officielle Wikimedia (XVIIe législature). Repère spatial ; n’est pas la projection.</title>
            </circle>
          ))
        }
      </g>

      <!-- Couche 1 détaillée (12 groupes) -->
      <g id={`back-detailed-${instanceId}`} class="back-layer back-detailed" opacity="0.36" style="display:none;">
        {
          detailedGroups.map((grp) => (
            <g data-group={grp.title} class="detailed-group">
              {grp.positions.map((pos) => (
                <circle
                  cx={pos.x}
                  cy={pos.y}
                  r="2.82"
                  fill={grp.color}
                  fill-opacity="1"
                  stroke="none"
                  role="img"
                  aria-label={`Couche 1 détaillée — ${grp.title}`}
                >
                  <title>Couche 1 — groupes actuels détaillés : {grp.title} — {grp.seats} sièges (modèle officiel).</title>
                </circle>
              ))}
            </g>
          ))
        }
      </g>

      <!-- Subtle zone labels for improved lisibilité des quartiers (neutral, small, non-intrusive) -->
      <g class="zone-labels" opacity="0.42" font-family="system-ui, sans-serif" font-size="7.2" font-weight="600" fill="#e6e6e6" text-anchor="middle">
        <text x="48" y="102">NFP</text>
        <text x="138" y="102">Centre</text>
        <text x="215" y="102">LR</text>
        <text x="302" y="102">RN</text>
      </g>

      <!-- Couche 2 — avant-plan : projections 1er tour (couleurs pleines) dans quartiers correspondants -->
      <g id={`front-${instanceId}`} class="front-layer front-zone">
        {
          frontDots.map((pos, i) => (
            <circle
              class="seat seat-projection"
              cx={pos.x}
              cy={pos.y}
              r="3.05"
              fill={pos.color}
              fill-opacity="1"
              stroke="#0a0a0a"
              stroke-width="0.55"
              data-bloc={pos.label}
              data-major={pos.major}
              tabindex="0"
              role="button"
              aria-label={`Couche 2 (pleine) — siège projeté ${pos.label} (quartier ${pos.major || 'mixte'})`}
            >
              <title>Couche 2 — avant-plan (couleur pleine) : {pos.label} — siège projeté (Sainte-Laguë 1er tour), placé dans le quartier correspondant du modèle officiel. Se distingue de la transparence de la couche 1.</title>
            </circle>
          ))
        }
      </g>

      <!-- Projection pure (sans ancrage quartiers) -->
      <g id={`front-pure-${instanceId}`} class="front-layer front-pure" style="display:none;">
        {
          pureProjectionDots.map((pos, i) => (
            <circle
              class="seat seat-projection"
              cx={pos.x}
              cy={pos.y}
              r="3.05"
              fill={pos.color}
              fill-opacity="1"
              stroke="#0a0a0a"
              stroke-width="0.55"
              data-bloc={pos.label}
              data-major={pos.major}
              tabindex="0"
              role="button"
              aria-label={`Projection pure : ${pos.label}`}
            >
              <title>Projection pure : {pos.label} — sans ancrage aux quartiers actuels.</title>
            </circle>
          ))
        }
      </g>

      <!-- Total sièges projetés (577 ou 150 selon la simulation) -->
      <text
        x="180"
        y="175"
        text-anchor="middle"
        font-size={totalSeats >= 300 ? 33 : 28}
        font-weight="700"
        fill="#f4f4f4"
        stroke="#0a0a0a"
        stroke-width="1.05"
        stroke-linejoin="round"
        font-family="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        style="paint-order: stroke fill;"
      >
        {totalSeats}
      </text>
    </svg>

    <!-- Alternative textuelle accessible (résumé neutre pour lecteurs d'écran, impression, ou basculement) -->
    <div id={`text-alt-${instanceId}`} class="text-alt-summary" aria-hidden="false">
      <span class="sr-only">Résumé textuel :</span>
      Projection : {projectionAllocations.map((a: any) => `${a.label} ${Math.floor(a.seats || 0)} sièges`).join('; ')}. 
      Total : {totalSeats} sièges. Référence spatiale : 577 positions du modèle officiel de l’Assemblée nationale (Wikimedia). Cette viz illustre la répartition proportionnelle aux suffrages du premier tour.
    </div>
  </div>

  <nav class="hemi-atlas-links" aria-label="Liens atlas, carte et analyses liées">
    <span class="hemi-atlas-label">Explorer :</span>
    <a href="/analyses/assemblee-premier-tour#dual-compare">Hémicycles T1 vs réelle</a>
    <a href="/analyses/assemblee-premier-tour#hemicycle-scale">Échelle 577 / 150</a>
    <a href="/analyses/assemblee-premier-tour#an1t-map-geo">Carte nuances / blocs</a>
    <a href="/analyses/assemblee-premier-tour#an1t-sim-title">Simulateur AN1T</a>
    <a href="/atlas/2024-legislatives/">Atlas législatives 2024</a>
    <a href="/atlas/2027-presidentielle/">Atlas présidentielle 2027</a>
    <a href="/atlas/2022-presidentielle/">Atlas présidentielle 2022</a>
    <a href="/analyses/assemblee-premier-tour-mecanismes">Mécanismes (seuils, dose…)</a>
  </nav>

  <!-- Légende — compacte (pages comparatif) ou interactive (simulateur) -->
  <div class={`hybrid-legend${compactLegend ? ' hybrid-legend--compact' : ''}`} data-hemicycle-id={instanceId}>
    {compactLegend ? (
      <>
        {showCurrentLegend && (
          <div class="legend-section layer1-section" data-layer="current">
            <div class="legend-title">{compactCurrentTitle}</div>
            <ul class="legend-compact-list">
              {currentLegend.map((item) => (
                <li class="legend-compact-row">
                  <span class="swatch swatch-layer1" style={`background:${item.color}`} aria-hidden="true"></span>
                  <span class="legend-compact-label">{SHORT_BLOC_LABELS[item.key] ?? item.key}</span>
                  <span class="legend-compact-value">{item.currentSeats}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {showProjectionLegend && (
          <div class="legend-section layer2-section" data-layer="projection">
            <div class="legend-title">{compactProjectionTitle}</div>
            <ul class="legend-compact-list">
              {legendProjection.map((item, idx) => {
                const blocId = projectionAllocations[idx]?.id || '';
                return (
                  <li class="legend-compact-row">
                    <span class="swatch swatch-layer2" style={`background:${item.color}`} aria-hidden="true"></span>
                    <span class="legend-compact-label">{SHORT_BLOC_LABELS[blocId] ?? item.label}</span>
                    <span class="legend-compact-value">{item.seats} <span class="legend-compact-pct">({item.pct}&nbsp;%)</span></span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </>
    ) : (
      <>
        {showCurrentLegend && (
          <div class="legend-section layer1-section" data-layer="current">
            <div class="legend-title">Couche 1 — Arrière-plan (transparence / faible opacité)</div>
            <p class="legend-explain">
              <strong>Les groupes actuels de l’Assemblée nationale</strong> (législature en cours). Les positions et « quartiers »
              (gauche NFP, centre, LR, RN à droite, etc.) sont exactement celles du <strong>modèle officiel Wikimedia
              (XVIIe législature)</strong>. Affichées en <strong>transparence</strong> pour ne pas masquer la couche avant,
              elles fournissent les repères spatiaux familiers.
            </p>
            <p class="legend-explain role-pedago">
              <em>Rôle pédagogique :</em> ancrer la lecture dans la réalité actuelle. Vous reconnaissez immédiatement
              « où » les groupes siègent aujourd’hui. Chiffres entre parenthèses = sièges actuels dans ce quartier.
            </p>
            <div class="legend-items current-legend">
              {
                currentLegend.map((item) => (
                  <button
                    type="button"
                    class="legend-item current"
                    data-key={item.key}
                    data-bloc={item.label}
                    aria-pressed="false"
                    title={`Couche 1 (transparence) : ${item.label} — ${item.currentSeats} sièges actuels (modèle Wikimedia). Cliquez pour surligner le quartier.`}
                  >
                    <span class="swatch swatch-layer1" style={`background:${item.color}`}></span>
                    <span class="label">{item.label}</span>
                    <span class="current-count">({item.currentSeats})</span>
                  </button>
                ))
              }
            </div>
          </div>
        )}

        {showProjectionLegend && (
          <div class="legend-section layer2-section" data-layer="projection">
            <div class="legend-title">Couche 2 — Avant-plan (couleurs pleines)</div>
            <p class="legend-explain">
              <strong>Les sièges projetés</strong> selon les voix ou intentions du <strong>premier tour</strong>
              (répartition <strong>Sainte-Laguë</strong>). Placés dans les quartiers correspondants du modèle officiel :
              les projections « NFP » vont dans la zone gauche actuelle, les projections « RN » dans la zone droite, etc.
              (<strong>mapping déterministe des blocs</strong>).
            </p>
            <p class="legend-explain role-pedago">
              <em>Rôle pédagogique :</em> visualiser l’impact direct de la pluralité du 1er tour sur la <strong>même carte</strong>.
              Les couleurs pleines se distinguent clairement de la transparence de la couche 1.
            </p>
            <div class="legend-items projection-legend">
              {
                legendProjection.map((item, idx) => (
                  <button
                    type="button"
                    class="legend-item projection"
                    data-bloc={item.label}
                    data-color={item.color}
                    data-key={projectionAllocations[idx]?.id || ''}
                    aria-pressed="false"
                    title={`Couche 2 (pleine) : ${item.label} — ${item.seats} sièges (${item.pct} %). Placée dans le quartier correspondant. Cliquez pour sélectionner.`}
                  >
                    <span class="swatch swatch-layer2" style={`background:${item.color}`}></span>
                    <span class="label">{item.label}</span>
                    <span class="numbers">{item.seats} sièges ({item.pct}%)</span>
                  </button>
                ))
              }
            </div>
          </div>
        )}
      </>
    )}

    {showControls && (
      <div class="granularity-section" aria-label="Niveau de granularité">
        <span class="legend-title">Granularité d’affichage</span>
        <div class="granularity-toggle" role="group">
          <button type="button" class="gran-btn active" data-gran="blocs" aria-pressed="true">5 blocs majeurs (recommandé pour lisibilité)</button>
          <button type="button" class="gran-btn" data-gran="nuances" aria-pressed="false">Plus de nuances (si données détaillées)</button>
        </div>
        <p class="legend-explain small">Les 5 blocs (NFP, Ensemble, LR, RN, Autres) agrègent les nuances officielles. La couche arrière (transparence) montre les groupes actuels ; la couche avant (couleurs pleines) reste placée dans les quartiers correspondants pour comparaison directe. Basculer n’affecte pas les calculs de projection. Pour données détaillées 2024 par nuance : voir l’atlas.</p>
      </div>
    )}
  </div>

  {showControls && (
    <p class="meta hemicycle-a11y-hint" id={`hemi-a11y-${instanceId}`}>
      Clavier : Tab vers la légende et les sièges focusables · Entrée/Espace pour sélectionner · Échap pour effacer la sélection.
    </p>
    <div class="hemicycle-controls viz-mode-controls" data-hemicycle-id={instanceId} role="group" aria-label="Options d'affichage : mode de vue et granularité" aria-describedby={`hemi-a11y-${instanceId}`}>
      <fieldset class="mode-selector">
        <legend>Mode de vue</legend>
        <label class="ctrl-label"><input type="radio" name={`viewmode-${instanceId}`} value="hybrid" checked={initialMode === 'hybrid'} aria-describedby="mode-help"> Hybride</label>
        <label class="ctrl-label"><input type="radio" name={`viewmode-${instanceId}`} value="projection" checked={initialMode === 'projection'}> Projection pure</label>
        <label class="ctrl-label"><input type="radio" name={`viewmode-${instanceId}`} value="current" checked={initialMode === 'current'}> Structure actuelle</label>
      </fieldset>
      <fieldset class="gran-selector">
        <legend>Granularité quartiers</legend>
        <label class="ctrl-label"><input type="radio" name={`gran-${instanceId}`} value="major" checked={initialGranularity === 'major'}> 5 grands blocs</label>
        <label class="ctrl-label"><input type="radio" name={`gran-${instanceId}`} value="detailed" checked={initialGranularity === 'detailed'}> Groupes détaillés (12)</label>
      </fieldset>
      <button type="button" class="ctrl-btn reset-btn" data-action="reset" title="Réinitialise surbrillances et sélections">Réinitialiser</button>
      <span class="ctrl-hint" id="mode-help">Hybride = Couche 1 (transparence : groupes actuels Wikimedia) + Couche 2 (pleines : projections Sainte-Laguë 1er tour dans les mêmes quartiers). Pure = projection seule. Actuelle = structure réelle seule.</span>
    </div>
  )}

  {showControls && (
  <details class="pedagogy-faq" data-hemicycle-id={instanceId}>
    <summary>Explications claires — Comment lire l’hémicycle hybride et pourquoi le 1er tour pour la représentation ? (cliquez)</summary>
    <div class="faq-content">
      <p><strong>Les deux couches :</strong> <strong>Couche 1 (arrière-plan, transparence)</strong> = groupes actuels de l’Assemblée (positions officielles du modèle Wikimedia). Sert de carte de référence fidèle à la géographie parlementaire réelle. <strong>Couche 2 (avant-plan, couleurs pleines)</strong> = projections issues du premier tour (répartition proportionnelle), placées dans les mêmes quartiers correspondants (NFP dans zone gauche, RN dans zone droite, etc.). La superposition permet de voir directement où et de combien la pluralité du 1er tour « remplirait » différemment les zones.</p>
      <p><strong>Pourquoi le 1er tour compte pour la représentation :</strong> Le premier tour enregistre les préférences brutes de tous les électeurs (pluralité complète, plusieurs forces). Le second tour + désistements recomposent cette pluralité en duels. L’hémicycle hybride visualise l’écart mesurable : ce que donnerait une Assemblée plus alignée sur les suffrages T1 (placés dans les repères existants) versus la composition issue du scrutin majoritaire à deux tours.</p>
      <p><strong>Tooltip et détails :</strong> Survol ou clic sur légende/sièges affiche le nombre, l’écart avec la zone actuelle et le sens de la superposition.</p>
      <p><strong>Granularité :</strong> « 5 grands blocs » agrège pour lisibilité. « Groupes détaillés » révèle les 12 groupes parlementaires réels dans la couche structure. Les projections restent en blocs car basées sur agrégats, mais la référence spatiale est plus fine.</p>
      <p><strong>Les 3 vues :</strong> Hybride = les deux couches (référence transparente + projection pleine dans quartiers). Projection pure = sièges projetés répartis librement (pour voir la forme sans biais de zone). Structure actuelle = la photo officielle des 577, sans projection.</p>
      <p class="meta">Outil pédagogique neutre. Illustre l’impact de la prise en compte des voix du premier tour sur la représentation (couches : transparence actuelle + couleurs pleines dans quartiers). Pas de jugement sur le mode de scrutin, pas de prédiction. Voir <a href="/analyses/assemblee-premier-tour-mecanismes">Mécanismes pour une Assemblée du Premier Tour</a> pour seuils, doses proportionnelles (5-25 %), mixtes, meilleurs perdants et intégration Code électoral.</p>
    </div>
  </details>
  )}

  <div class="hemicycle-details" id={`details-${instanceId}`} aria-live="polite" role="status" style={showControls ? undefined : 'display:none'}>
    <p class="details-placeholder">Survolez ou cliquez sur la légende (améliorée : couche 1 transparence vs couche 2 pleine) ou un siège. Utilisez Hybride / Projection / Actuelle + granularité. Clavier : Tab + Entrée pour sélection ; Échap pour reset.</p>
  </div>

  {sourceNote && <p class="meta source-note">{sourceNote}</p>}
</section>

<style>
  /* Mobile responsiveness improvements for hemicycle viz */
  .hemicycle-wrapper {
    overflow: hidden;
  }
  .hemicycle-wrapper svg {
    max-height: 205px;
    width: 100%;
    height: auto;
  }
  .hybrid-legend {
    font-size: 0.82rem;
  }
  .legend-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .legend-item {
    min-height: 32px; /* touch */
    padding: 0.2rem 0.4rem;
  }
  .hemicycle-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.82rem;
  }
  @media (max-width: 640px) {
    .hemicycle-wrapper svg { max-height: 158px; }
    .hybrid-legend, .hemicycle-controls, .pedagogy-faq { font-size: 0.76rem; }
    .legend-item { font-size: 0.76rem; padding: 0.15rem 0.3rem; min-height: 36px; }
    .granularity-toggle, .mode-selector { flex-wrap: wrap; }
    .ctrl-label, .gran-btn { font-size: 0.76rem; }
  }
  @media (max-width: 420px) {
    .hemicycle-wrapper svg { max-height: 132px; }
    .legend-title { font-size: 0.8rem; }
  }
  .text-alt-summary { font-size: 0.78rem; }
</style>

<script define:vars={{ instanceId, CURRENT_SEATS, MAJOR_LABELS, detailedCurrentLegend, legendProjection, initialMode, initialGranularity }}>
  function initHybridHemicycle(id) {
    const container = document.querySelector(`[data-hemicycle-id="${id}"]`);
    if (!container) return;

    const wrapper = container.closest('.hemicycle-wrapper');
    const svg = wrapper ? wrapper.querySelector('svg') : null;
    if (!svg) return;

    const details = document.getElementById(`details-${id}`);
    if (!details) return;

    // Layers
    const backMajor = svg.querySelector(`#back-${id}`);
    const backDetailed = svg.querySelector(`#back-detailed-${id}`);
    const frontZone = svg.querySelector(`#front-${id}`);
    const frontPure = svg.querySelector(`#front-pure-${id}`);
    const seats = Array.from(svg.querySelectorAll('.seat'));
    const legendItems = Array.from(container.querySelectorAll('.legend-item'));
    const controls = container.querySelector(`.hemicycle-controls[data-hemicycle-id="${id}"]`);

    // New selectors
    const modeRadios = Array.from(container.querySelectorAll(`input[name="viewmode-${id}"]`));
    const granRadios = Array.from(container.querySelectorAll(`input[name="gran-${id}"]`));

    let currentMode = initialMode || 'hybrid';
    let currentGran = initialGranularity || 'major';
    let selectedKey = null;

    function updateSeatStyles(highlightLabel = null, dimOthers = false) {
      seats.forEach(seat => {
        const seatLabel = seat.getAttribute('data-bloc') || '';
        const isMatch = !highlightLabel || seatLabel === highlightLabel;
        if (isMatch && highlightLabel) {
          seat.setAttribute('stroke', '#fff');
          seat.setAttribute('stroke-width', '1.15');
          seat.setAttribute('r', '3.05');
        } else if (highlightLabel && dimOthers) {
          seat.setAttribute('stroke', '#222');
          seat.setAttribute('stroke-width', '0.3');
          seat.setAttribute('opacity', '0.35');
        } else {
          seat.setAttribute('stroke', '#111');
          seat.setAttribute('stroke-width', '0.42');
          seat.setAttribute('r', '2.9');
          seat.removeAttribute('opacity');
        }
      });
    }

    function highlightZoneBack(majorKey, active) {
      const targetBack = (currentGran === 'detailed' && backDetailed) ? backDetailed : (backMajor || backDetailed);
      if (!targetBack) return;
      // Support both major data-major and detailed (highlight approximate by major mapping if needed)
      let zoneGs = targetBack.querySelectorAll(`g[data-major="${majorKey}"]`);
      if (zoneGs.length === 0 && currentGran === 'detailed') {
        // fallback: highlight all detailed for simplicity on selection, or skip fine
        zoneGs = targetBack.querySelectorAll('g.detailed-group');
      }
      zoneGs.forEach(g => {
        if (active) {
          g.setAttribute('opacity', '0.85');
          g.querySelectorAll('circle').forEach(c => {
            c.setAttribute('stroke', '#fff');
            c.setAttribute('stroke-width', '0.65');
            c.setAttribute('stroke-opacity', '0.55');
          });
        } else {
          g.setAttribute('opacity', currentMode === 'current' ? '1' : (currentGran === 'detailed' ? '0.28' : '0.26'));
          g.querySelectorAll('circle').forEach(c => {
            c.removeAttribute('stroke');
            c.removeAttribute('stroke-width');
            c.removeAttribute('stroke-opacity');
          });
        }
      });
    }

    function applyViewMode(mode, gran) {
      currentMode = mode;
      currentGran = gran;

      // Toggle layers visibility and opacity
      const useDetailed = gran === 'detailed';
      if (backMajor) backMajor.style.display = (mode === 'projection') ? 'none' : (useDetailed ? 'none' : '');
      if (backDetailed) backDetailed.style.display = (mode === 'projection' || !useDetailed) ? 'none' : '';
      if (frontZone) frontZone.style.display = (mode === 'current' || mode === 'projection') ? 'none' : '';
      if (frontPure) frontPure.style.display = (mode === 'projection') ? '' : 'none';

      // Opacity adjustments
      if (backMajor && backMajor.style.display !== 'none') {
        backMajor.style.opacity = (mode === 'current') ? '1' : '0.26';
      }
      if (backDetailed && backDetailed.style.display !== 'none') {
        backDetailed.style.opacity = (mode === 'current') ? '1' : '0.28';
      }
      if (frontZone && frontZone.style.display !== 'none') frontZone.style.opacity = '1';
      if (frontPure && frontPure.style.display !== 'none') frontPure.style.opacity = '1';

      // Update SVG aria for current mode
      svg.setAttribute('aria-label', `Hémicycle — Vue ${mode} (${gran}) — ${legendProjection ? legendProjection.length : 5} blocs — ${totalSeats || 577} sièges. Pluralité 1er tour.`);

      // Update legend dynamically (simple rebuild for mode)
      const legendContainer = container.querySelector('.hybrid-legend');
      if (legendContainer) {
        const projSection = legendContainer.querySelector('[data-layer="projection"]');
        const currentSection = legendContainer.querySelector('[data-layer="current"]');
        if (mode === 'current') {
          if (projSection) projSection.style.display = 'none';
          if (currentSection) {
            currentSection.style.display = '';
            const title = currentSection.querySelector('.legend-title');
            if (title) title.textContent = useDetailed ? 'Structure actuelle — Groupes détaillés (12)' : 'Structure actuelle — 5 grands blocs';
          }
        } else if (mode === 'projection') {
          if (currentSection) currentSection.style.display = 'none';
          if (projSection) {
            projSection.style.display = '';
            const title = projSection.querySelector('.legend-title');
            if (title) title.textContent = 'Projection pure — sièges projetés (répartition globale)';
          }
        } else {
          // hybrid
          if (currentSection) currentSection.style.display = '';
          if (projSection) projSection.style.display = '';
          if (currentSection) {
            const title = currentSection.querySelector('.legend-title');
            if (title) title.textContent = useDetailed ? 'Structure actuelle (détail 12 groupes, transparence)' : 'Structure actuelle (transparence) : 5 blocs';
          }
          if (projSection) {
            const ptitle = projSection.querySelector('.legend-title');
            if (ptitle) ptitle.textContent = 'Projection (avant) placée dans les quartiers';
          }
        }
      }

      // Re-attach or ensure seats visible have correct listeners (already there)
      resetDetails();
    }

    function showDetailsEnhanced(label, color, seatsCount, pct, currentInZone = null, majorKey = null) {
      let html = `
        <div style="display:flex; align-items:center; gap:0.5rem;">
          <span class="swatch" style="background:${color}; width:14px; height:14px; border-radius:2px; border:1px solid #444;"></span>
          <strong>${label}</strong>
        </div>
        <div style="margin-top:2px; font-size:0.9rem;">
          <strong>${seatsCount} sièges projetés</strong> <span style="opacity:0.8;">(${pct}%)</span>
        </div>`;
      if (currentInZone !== null) {
        const delta = Number(seatsCount) - currentInZone;
        const deltaStr = delta > 0 ? `+${delta}` : (delta < 0 ? `${delta}` : '0');
        html += `<div style="font-size:0.78rem; margin-top:1px; opacity:0.85;">Sièges actuels dans ce quartier : <strong>${currentInZone}</strong> · Écart avec projection 1er tour : <strong>${deltaStr}</strong></div>`;
      }
      html += `<div style="font-size:0.72rem; margin-top:2px; opacity:0.65;">Superposition sur le modèle officiel : la comparaison visuelle montre ce que la pluralité du 1er tour produirait par rapport à l’Assemblée issue du 2nd tour.</div>`;
      details.innerHTML = html;
      details.style.borderLeft = `3.5px solid ${color}`;
      details.style.paddingLeft = '0.55rem';
    }

    function resetDetails() {
      details.innerHTML = '<p class="details-placeholder">Survolez ou cliquez un bloc (légende) ou un siège pour explorer les deux couches. La sélection met en surbrillance le quartier et affiche l’écart sièges actuels vs projetés. Cela aide à comprendre pourquoi superposer révèle la pluralité du 1er tour.</p>';
      details.style.borderLeft = '';
      details.style.paddingLeft = '';
    }

    function setLegendPressed(targetItem, pressed) {
      legendItems.forEach(li => {
        li.setAttribute('aria-pressed', (li === targetItem && pressed) ? 'true' : 'false');
        if (li === targetItem && pressed) {
          li.classList.add('selected');
        } else {
          li.classList.remove('selected');
        }
      });
    }

    function selectBloc(label, color, seatsCount, pct, majorKey = null, currentCount = null) {
      if (selectedKey === label) {
        // toggle off
        selectedKey = null;
        updateSeatStyles(null, false);
        if (majorKey) highlightZoneBack(majorKey, false);
        legendItems.forEach(li => li.setAttribute('aria-pressed', 'false') && li.classList.remove('selected'));
        resetDetails();
        return;
      }
      selectedKey = label;
      updateSeatStyles(label, true);
      if (majorKey) highlightZoneBack(majorKey, true);
      setLegendPressed(legendItems.find(li => li.getAttribute('data-bloc') === label), true);
      showDetailsEnhanced(label, color, seatsCount, pct, currentCount, majorKey);
    }

    function resetAll() {
      selectedKey = null;
      updateSeatStyles(null);
      [backMajor, backDetailed].forEach(b => {
        if (b) {
          b.style.opacity = (currentMode === 'current' ? '1' : (b.classList.contains('back-detailed') ? '0.28' : '0.26'));
          b.querySelectorAll('g').forEach(g => {
            g.setAttribute('opacity', '1');
            g.querySelectorAll('circle').forEach(c => { c.removeAttribute('stroke'); c.removeAttribute('stroke-width'); c.removeAttribute('stroke-opacity'); });
          });
        }
      });
      legendItems.forEach(li => {
        li.setAttribute('aria-pressed', 'false');
        li.classList.remove('selected');
      });
      resetDetails();
      applyViewMode(currentMode, currentGran);
    }

    // Wire selectors for full mode switch + granularity
    function wireSelectors() {
      modeRadios.forEach(r => {
        r.addEventListener('change', () => {
          if (r.checked) {
            const newMode = r.value as any;
            applyViewMode(newMode, currentGran);
            if (selectedKey) { selectedKey = null; updateSeatStyles(null); }
          }
        });
      });
      granRadios.forEach(r => {
        r.addEventListener('change', () => {
          if (r.checked) {
            const newGran = r.value as any;
            applyViewMode(currentMode, newGran);
          }
        });
      });
      const resetBtn = controls ? controls.querySelector('.reset-btn, [data-action="reset"]') : null;
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          resetAll();
          modeRadios.forEach(r => (r.checked = r.value === currentMode));
          granRadios.forEach(r => (r.checked = r.value === currentGran));
        });
      }
    }
    wireSelectors();

    // Initial apply (respect props initialMode / initialGranularity)
    setTimeout(() => applyViewMode(currentMode, currentGran), 25);

    // Legend interactions (click = select, hover = preview)
    legendItems.forEach(item => {
      const label = item.getAttribute('data-bloc') || '';
      const color = item.getAttribute('data-color') || item.querySelector('.swatch')?.style.background || '#666';
      const numbersEl = item.querySelector('.numbers');
      const text = numbersEl ? numbersEl.textContent || '' : '';
      const match = text.match(/(\d+)\s*sièges\s*\((\d+\.?\d*)%\)/);
      const seatsCount = match ? match[1] : '?';
      const pct = match ? match[2] : '?';

      const key = item.getAttribute('data-key') || '';
      // map label to major for zone highlight (robust matching)
      let majorKey = key;
      if (!majorKey || !['nfp','ensemble','lr','rn','autres'].includes(majorKey)) {
        const l = label.toLowerCase();
        if (l.includes('rn') || l.includes('rassemblement')) majorKey = 'rn';
        else if (l.includes('nfp') || l.includes('nouveau') || l.includes('front') || l.includes('gauche')) majorKey = 'nfp';
        else if (l.includes('ensemble') || l.includes('centre')) majorKey = 'ensemble';
        else if (l.includes('droite') || l.includes('lr')) majorKey = 'lr';
        else majorKey = 'autres';
      }
      const currentCount = (CURRENT_SEATS && CURRENT_SEATS[majorKey]) ? CURRENT_SEATS[majorKey] : null;

      // Hover preview (non destructive)
      item.addEventListener('mouseenter', () => {
        if (!selectedKey) {
          updateSeatStyles(label, false);
          showDetailsEnhanced(label, color, seatsCount, pct, currentCount, majorKey);
          if (majorKey) highlightZoneBack(majorKey, true);
        }
      });
      item.addEventListener('mouseleave', () => {
        if (!selectedKey) {
          updateSeatStyles(null);
          resetDetails();
          if (majorKey) highlightZoneBack(majorKey, false);
        }
      });

      // Click = toggle selection (advanced interaction)
      item.addEventListener('click', () => {
        selectBloc(label, color, seatsCount, pct, majorKey, currentCount);
      });

      // Keyboard support
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          selectBloc(label, color, seatsCount, pct, majorKey, currentCount);
        }
        if (e.key === 'Escape' && selectedKey) {
          resetAll();
        }
      });
    });

    // Seat interactions (click to select the bloc, hover preview)
    seats.forEach(seat => {
      const label = seat.getAttribute('data-bloc') || '';
      const color = seat.getAttribute('fill') || '#666';
      const major = seat.getAttribute('data-major') || '';

      const legendItem = legendItems.find(li => li.getAttribute('data-bloc') === label);
      let seatsCount = '?', pct = '?', currentCount = null;
      if (legendItem) {
        const numbersEl = legendItem.querySelector('.numbers');
        const t = numbersEl ? numbersEl.textContent || '' : '';
        const m = t.match(/(\d+)\s*sièges\s*\((\d+\.?\d*)%\)/);
        if (m) { seatsCount = m[1]; pct = m[2]; }
      }
      if (major && CURRENT_SEATS) currentCount = CURRENT_SEATS[major];

      seat.addEventListener('mouseenter', () => {
        if (!selectedKey) {
          seats.forEach(s => {
            if (s.getAttribute('data-bloc') === label) {
              s.setAttribute('stroke', '#fff');
              s.setAttribute('stroke-width', '1.1');
            }
          });
          showDetailsEnhanced(label, color, seatsCount, pct, currentCount, major);
          if (major) highlightZoneBack(major, true);
        }
      });

      seat.addEventListener('mouseleave', () => {
        if (!selectedKey) {
          seats.forEach(s => {
            if (s.getAttribute('data-bloc') === label) {
              s.setAttribute('stroke', '#111');
              s.setAttribute('stroke-width', '0.42');
            }
          });
          resetDetails();
          if (major) highlightZoneBack(major, false);
        }
      });

      seat.addEventListener('click', (e) => {
        e.stopPropagation();
        const matchingLegend = legendItems.find(li => li.getAttribute('data-bloc') === label);
        if (matchingLegend) {
          // trigger same as legend click
          const col = matchingLegend.getAttribute('data-color') || color;
          selectBloc(label, col, seatsCount, pct, major, currentCount);
        }
      });
    });

    // Click on wrapper / svg background deselects
    svg.addEventListener('click', (e) => {
      if (e.target === svg || (e.target.tagName === 'svg')) {
        if (selectedKey) resetAll();
      }
    });

    // Global keyboard escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && container.contains(document.activeElement)) {
        resetAll();
      }
    }, { once: false });

    // Granularité toggle (5 blocs vs 12 groupes) — synchronise boutons + radios + couche structure
    const granBtns = container.querySelectorAll('.gran-btn');
    function setGranularity(mode) {
      // mode: 'blocs'|'nuances' (boutons) ou 'major'|'detailed' (radios)
      const detailed = mode === 'nuances' || mode === 'detailed';
      const gran = detailed ? 'detailed' : 'major';
      currentGran = gran;
      granBtns.forEach((b) => {
        const isNuances = b.getAttribute('data-gran') === 'nuances';
        const on = detailed ? isNuances : !isNuances;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      granRadios.forEach((r) => {
        r.checked = r.value === gran;
      });
      const hemicycleRoot = container.closest('.hemicycle');
      if (hemicycleRoot) {
        hemicycleRoot.setAttribute('data-granularity', detailed ? 'nuances' : 'blocs');
      }
      applyViewMode(currentMode || 'hybrid', gran);
      if (details) {
        if (detailed) {
          details.innerHTML = '<p class="details-placeholder">Granularité détaillée : couche structure = 12 groupes parlementaires actuels. Projections restent en 5 blocs civiques (agrégats T1). Carte par nuance / circo : <a href="/atlas/2024-legislatives/">atlas législatives 2024</a>.</p>';
        } else {
          resetDetails();
        }
      }
    }
    granBtns.forEach((btn) => {
      btn.addEventListener('click', () => setGranularity(btn.getAttribute('data-gran') || 'blocs'));
    });
    // Radios déjà branchés dans wireSelectors — on aligne aussi les boutons gran-btn
    granRadios.forEach((r) => {
      r.addEventListener('change', () => {
        if (r.checked) setGranularity(r.value);
      });
    });

    // Initial state transitions
    setTimeout(() => {
      [backMajor, backDetailed, frontZone, frontPure].forEach(l => {
        if (l) l.style.transition = 'opacity 130ms ease, display 0ms';
      });
    }, 90);
  }

  if (typeof window !== 'undefined') {
    setTimeout(() => initHybridHemicycle('${instanceId}'), 70);
  }
</script>

<style>
  .hemicycle {
    margin-bottom: 1rem;
  }
  .hemicycle h3 {
    margin: 0 0 0.2rem;
    font-size: 1.02rem;
  }
  .hemi-atlas-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.65rem;
    align-items: center;
    margin: 0.45rem 0 0.65rem;
    font-size: 0.82rem;
  }
  .hemi-atlas-links a {
    color: var(--link, #1d4ed8);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
  }
  .hemi-atlas-links a:hover { text-decoration: underline; }
  .hemi-atlas-label {
    font-weight: 600;
    color: var(--muted, #5c574f);
  }

  .hemicycle-wrapper {
    background: #0a0a0a;
    border-radius: 6px;
    padding: 6px 4px 2px;
    margin: 0.35rem 0;
    border: 1px solid #222;
  }

  .hybrid-legend {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--fg);
  }

  .hybrid-legend--compact {
    font-size: 0.88rem;
    margin-top: 0.55rem;
    padding: 0.55rem 0.65rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .hybrid-legend--compact .legend-section {
    margin-bottom: 0.45rem;
  }

  .hybrid-legend--compact .legend-section:last-child {
    margin-bottom: 0;
  }

  .legend-compact-list {
    list-style: none;
    margin: 0.2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .legend-compact-row {
    display: grid;
    grid-template-columns: 14px 1fr auto;
    align-items: center;
    gap: 0.45rem;
    line-height: 1.35;

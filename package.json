{
  "name": "le-media-du-premier-tour",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run sync:all && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:data": "tsx scripts/sync-data.ts",
    "renifleur": "tsx scripts/renifleur-run.ts",
    "programme-chiffrage-lint": "tsx scripts/programme-chiffrage-lint.ts",
    "programme-veille": "tsx scripts/programme-veille-run.ts",
    "renifleur:draft": "tsx scripts/renifleur-social-draft.ts",
    "renifleur:draft:refresh": "tsx scripts/renifleur-social-draft.ts --refresh",
    "sync:all": "tsx scripts/sync-all.ts",
    "sync:all:social": "LMDPT_SYNC_SOCIAL_DRAFT=1 tsx scripts/sync-all.ts",
    "import:dept-2022": "tsx scripts/import-presidentielle-2022-departements.ts",
    "import:dept-2017": "tsx scripts/import-presidentielle-2017-departements.ts",
    "import:legislatives-2024": "tsx scripts/import-legislatives-2024.ts",
    "build:geo": "tsx scripts/build-dept-svg.ts",
    "import:elections": "npm run import:dept-2022 && npm run import:dept-2017 && npm run build:geo",
    "dns:iarbre": "node scripts/setup-dns-iarbre.mjs",
    "brand:png": "rsvg-convert -w 400 -h 400 public/brand/lmdpt-avatar-x.svg -o public/brand/lmdpt-avatar-x.png && rsvg-convert -w 1500 -h 500 public/brand/lmdpt-banner-x.svg -o public/brand/lmdpt-banner-x.png && rsvg-convert -w 1200 -h 630 public/brand/og-default.svg -o public/brand/og-default.png",
    "giscus:setup": "node scripts/setup-giscus.mjs"
  },
  "dependencies": {
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}

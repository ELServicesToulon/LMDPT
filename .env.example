# Le Média du Premier Tour — overlay projet (EXEMPLE — ne pas committer les valeurs)
#
# Base minimale workspace : C:\Users\ELS\mediconvoi\backend\.env
#   → CLOUDFLARE_API_TOKEN, MISTRAL_*, GITHUB_TOKEN, etc.
# Ce fichier : surcharges LMDPT — NE PAS SUPPRIMER l'existant.
#
# Chargement (npm run dns:iarbre) : base mediconvoi puis .env local
# Doc : mediconvoi/docs/WORKSPACE-ENV-DB-HOMOGENEITE.md

# --- Surcharges LMDPT uniquement ---

ASTRO_SITE=https://lmdpt.iarbre.org
ASTRO_BASE=/

# YouTube — off par défaut (handle @LMDuPremierTour pas encore créé / 404).
# Après création chaîne + handle revendiqué :
# PUBLIC_YOUTUBE_ENABLED=true
# PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@LMDuPremierTour
# Live ponctuel (watch URL) sans activer le footer chaîne :
# PUBLIC_YOUTUBE_LIVE_URL=https://www.youtube.com/watch?v=VIDEO_ID
# (UTM ajoutés automatiquement par DebateLiveBanner)

# Optionnel si différent de CLOUDFLARE_API_TOKEN dans la base mediconvoi
IARBE_CLOUDFLARE_API_TOKEN=

# --- Monétisation DOE (build-time, URLs HTTPS publiques seulement) ---
# Don citoyen (HelloAsso ou Stripe Payment Link)
# PUBLIC_LMDPT_DONATE_URL=https://www.helloasso.com/associations/…/formulaires/…
# Pack Data AN1T 49 €/an (Stripe Payment Link)
# PUBLIC_LMDPT_PACK_CHECKOUT_URL=https://buy.stripe.com/…

# Don citoyen (HelloAsso ou Stripe Payment Link HTTPS)
# PUBLIC_LMDPT_DONATE_URL=https://www.helloasso.com/associations/…/formulaires/…

# --- Google SEO (outils gratuits — docs/GOOGLE-SEO.md) ---
# Search Console (balise meta) — token fourni par GSC
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# Fichier HTML optionnel (ex. google123abc.html) écrit par npm run seo:assets
# PUBLIC_GOOGLE_SITE_VERIFICATION_FILE=
# GA4 (OFF par défaut — RGPD / Consent Mode denied)
# PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXX
# Tag Manager (OFF par défaut)
# PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
# Google Ads tag seul (rare)
# PUBLIC_GOOGLE_ADS_ID=AW-000000000
# Consent Mode : denied (défaut) | granted (uniquement avec bannière + consentement)
# PUBLIC_GOOGLE_CONSENT_MODE_DEFAULT=denied


# Le Média du Premier Tour — overlay projet (EXEMPLE — ne pas committer les valeurs)
#
# Base minimale workspace : C:\Users\ELS\mediconvoi\backend\.env
#   → CLOUDFLARE_API_TOKEN, MISTRAL_*, GITHUB_TOKEN, etc.
# Ce fichier : surcharges LMDPT — NE PAS SUPPRIMER l'existant.
#
# Chargement (npm run dns:iarbre) : base mediconvoi puis .env local
# Doc : mediconvoi/docs/WORKSPACE-ENV-DB-HOMOGENEITE.md

# --- Surcharges LMDPT uniquement ---

ASTRO_SITE=https://lmdpt.iarbre.org
ASTRO_BASE=/

# YouTube — off par défaut (handle @LMDuPremierTour pas encore créé / 404).
# Après création chaîne + handle revendiqué :
# PUBLIC_YOUTUBE_ENABLED=true
# PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@LMDuPremierTour
# Live ponctuel (watch URL) sans activer le footer chaîne :
# PUBLIC_YOUTUBE_LIVE_URL=https://www.youtube.com/watch?v=VIDEO_ID
# (UTM ajoutés automatiquement par DebateLiveBanner)

# Optionnel si différent de CLOUDFLARE_API_TOKEN dans la base mediconvoi
IARBE_CLOUDFLARE_API_TOKEN=

# Cloudflare Web Analytics (jeton public — cookieless, hors consentement pubs GA4/GTM).
# Prod KS-5-B : passer au build Astro (Mediconvoi/backend/.env + npm run deploy-lmdpt-ovh).
# Unset → le site utilise ce même jeton (fallback, comme les IDs Giscus).
# Désactiver : PUBLIC_CF_WEB_ANALYTICS_TOKEN=off
PUBLIC_CF_WEB_ANALYTICS_TOKEN=72ab49a17241420da6d8a97cee1f62e2

# --- comments-api : jetons de modération (OBLIGATOIRES en production) ---
# Aucune valeur par défaut dans le code. Sans ces variables, ou sans
# data/moderators.json hors git contenant des jetons propres, le serveur
# refuse toute action de modération ou d'édition et journalise un avertissement.
# Ne pas réutiliser les exemples ci-dessous : ils sont refusés tels quels.
# Générer un secret long par rôle (Bitwarden) avant le déploiement.
LMDPT_MOD_TOKEN_REDACTION=__REMPLACER_JETON_REDACTION__
LMDPT_MOD_TOKEN_MODO_SENIOR=__REMPLACER_JETON_MODO_SENIOR__
LMDPT_MOD_TOKEN_MODO=__REMPLACER_JETON_MODO__
